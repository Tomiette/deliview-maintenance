---
// « Qui est derrière » (accueil) : la vraie photo de Tom, trois phrases, son e-mail, LinkedIn et Qui sommes-nous.
// Aucun faux témoignage : la preuve humaine, c'est quelqu'un de réel avec son e-mail.
import Polaroid from './Polaroid.astro';
import { SITE, lien } from '../lib/site';
---

<section class="dv-section bg-grey" aria-labelledby="fondateur-titre">
  <div class="dv-container flex max-w-[1000px] flex-col items-center gap-x-[72px] gap-y-10 md:flex-row">
    <Polaroid class="shrink-0" />
    <div class="max-w-[620px] flex-1">
      <p class="dv-overline">Qui est derrière</p>
      <h2 id="fondateur-titre" class="dv-h2 mt-2.5 md:mt-3">Deliview est né d’un&nbsp;an sur le terrain</h2>
      <p class="mt-3.5 text-[17px] leading-[1.6] md:mt-5 md:text-[19px]">
        Je m’appelle Tom et j’ai moi-même été sur Uber Eats et Deliveroo. J’ai passé un&nbsp;an auprès des restaurants qui livrent&nbsp;: partout, deux tablettes en plein rush et des prix fixés à l’instinct. Je fais la mise en place avec vous, et quand vous écrivez, c’est moi qui réponds.
      </p>
      <ul class="mt-4 flex flex-col gap-0.5 text-[16px] md:mt-6 md:flex-row md:flex-wrap md:gap-x-7 md:text-[17px]">
        <li><a href={`mailto:${SITE.email}`} class="dv-lien">{SITE.email}</a></li>
        <li><a href={SITE.linkedinTom} class="dv-lien" rel="noopener">Tom sur LinkedIn</a></li>
        <li><a href={lien('/qui-sommes-nous/')} class="dv-lien">Qui sommes-nous</a></li>
      </ul>
    </div>
  </div>
</section>
