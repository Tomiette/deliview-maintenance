---
import Base from "../../layouts/Base.astro";
import Capture from "../../components/Capture.astro";
import SectionDemo from "../../components/SectionDemo.astro";
import { PILIERS, PROFILS, type Profil } from "../../content/contenu";

export function getStaticPaths() {
  return PROFILS.map((profil) => ({ params: { slug: profil.slug }, props: { profil } }));
}

const { profil } = Astro.props as { profil: Profil };
---

<Base title={profil.metaTitle} description={profil.metaDescription} ariane={[{ nom: profil.nomMenu, chemin: `/pour/${profil.slug}` }]}>
  <section class="relative overflow-hidden" aria-labelledby="titre-hero">
    <div aria-hidden="true" class="absolute -top-40 -right-40 size-[560px] rounded-full bg-blue-2/12"></div>
    <div class="container-dv relative grid items-center gap-8 pt-8 pb-16 md:pt-12 md:pb-24 lg:grid-cols-[1fr_1.15fr] lg:gap-12">
      <div>
        <p class="surtitre text-blue">{profil.surtitre}</p>
        <h1 id="titre-hero" class="mt-3">{profil.h1}</h1>
        <p class="texte mt-4 text-lg md:mt-6 md:text-xl">{profil.sousTitre}</p>
        <a href="#demo" class="btn btn-plein mt-6 md:mt-8" data-cta={`profil-${profil.slug}-hero`}>Demander une démo</a>
        <p class="mt-3 text-[15px] font-semibold texte-secondaire md:text-base" data-repere-barre>15 min · Sans engagement</p>
      </div>
      <Capture src={`/captures/pour-${profil.slug}.webp`} alt={`Recommandations Deliview vues par les ${profil.nomMenu.toLowerCase()}`} prioritaire />
    </div>
  </section>

  <section class="section bg-grey" aria-labelledby="titre-blocs">
    <div class="container-dv">
      <h2 id="titre-blocs" class="sr-only">Ce que Deliview change pour les {profil.nomMenu.toLowerCase()}</h2>
      <ul class="grid gap-6 md:grid-cols-2">
        {
          profil.blocs.map((b) => (
            <li class="carte">
              <h3>{b.titre}</h3>
              <p class="mt-3 texte-secondaire">{b.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="titre-fonctionnalites">
    <div class="container-dv">
      <h2 id="titre-fonctionnalites">Ce que Deliview vous apporte</h2>
      <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-4">
        {
          PILIERS.map((p) => (
            <li class="carte flex flex-col">
              <p class="surtitre text-blue">{p.surtitre}</p>
              <h3 class="mt-3 flex-1 text-xl">{p.titre}</h3>
              <a href={`/solution/${p.slug}`} class="mt-6 inline-flex min-h-11 items-center font-semibold underline underline-offset-2">
                Découvrir {p.complement}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <SectionDemo />
</Base>
