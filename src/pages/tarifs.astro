  .dv-offre-liste :global(svg),
  .dv-comparatif-oui :global(svg) {
    color: var(--color-blue);
  }

  /* Raccourcis vers les offres (téléphone et tablette) : deux pastilles en relief, l'offre recommandée au contour Bleu 1.
