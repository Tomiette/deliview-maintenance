---
// Écran de démo (dernier écran des pages) : le formulaire devient un « bon de démo » posé sur le papier gris,
// à côté « Ce qui se passe ensuite » en 3 étapes et la vraie photo de Tom, avec son e-mail.
// Refonte en relief (3 octobre 2026) : le bon devient une carte en relief posée sur un plateau à points (Bleu 1 à 8 %),
// les numéros des étapes dans des tuiles.
import DemoForm from './DemoForm.astro';
import { SITE, lien } from '../lib/site';

interface Props {
  // Section d'origine envoyée avec la demande (mesure des boutons).
  section: string;
  titre?: string;
  surtitre?: string;
  sousTitre?: string;
  // Niveau du titre : h2 sur les pages, h1 sur la page Démo.
  niveau?: 'h1' | 'h2';
  id?: string;
  // « commencer » : formulaire de départ (choix de l'offre) et étapes de l'ouverture du compte (page /commencer/).
  // « parrainage » : formulaire avec « Qui vous recommande ? » (page /parrainage/).
  variante?: 'demo' | 'commencer' | 'parrainage';
}
const { section, titre = 'Demandez votre démo gratuite', surtitre = 'Démo', sousTitre, niveau = 'h2', id = 'demo', variante = 'demo' } = Astro.props;
const Titre = niveau;
const SousTitre = niveau === 'h1' ? 'h2' : 'h3';
const depart = variante === 'commencer';
const etapes = depart
  ? [
      { titre: 'Tom vous appelle sous 3 h', texte: 'Il confirme avec vous l’offre qui convient à vos restaurants.' },
      { titre: 'Il ouvre votre compte avec vous', texte: 'La mise en place est offerte : vous voyez vos prix, vos concurrents et votre note sur un seul écran.' },
      { titre: 'Vous vous abonnez en ligne', texte: 'Tom vous envoie le lien de paiement. Sans engagement : vous arrêtez quand vous voulez.' },
    ]
  : [
      { titre: 'Tom vous rappelle sous 3 h', texte: 'On choisit ensemble un moment hors de vos services.' },
      { titre: 'La démo', texte: 'Présentation de Deliview pour votre activité.' },
      { titre: 'Si vous continuez', texte: 'Vous choisissez votre offre, et Tom vous accompagne pour la mise en place.' },
    ];
const entete = depart ? ['Votre compte', 'Sans engagement'] : ['Bon de démo', '30 min'];
---

<section id={id} class={`bg-white ${niveau === 'h1' ? 'pb-16 pt-8 md:pb-[104px] md:pt-12' : 'dv-section'}`} aria-labelledby={`${id}-titre`}>
  <div class="dv-container">
    <p class="dv-overline dv-pastille"><span class="dv-pastille-point" aria-hidden="true" />{surtitre}</p>
    <Titre id={`${id}-titre`} class={`${niveau === 'h1' ? 'dv-h1' : 'dv-h2'} mt-4 max-w-[22ch] md:mt-5`}>{titre}</Titre>
    {sousTitre && <p class="dv-lead mt-4 max-w-[56ch]">{sousTitre}</p>}
    <div class="mt-7 grid items-start gap-10 md:mt-12 lg:grid-cols-2 lg:gap-14">
      <div id={`${id}-formulaire`} class="dv-demo-plateau dv-points-bleus px-3 py-5 sm:p-8 lg:p-10">
        <div class="dv-relief px-[18px] pb-[22px] pt-5 md:px-7 md:pb-7 md:pt-6">
          <p class="dv-ticket-entete mb-4"><span>{entete[0]}</span><span>{entete[1]}</span></p>
          <DemoForm section={section} variante={variante} />
        </div>
      </div>
      <div class="lg:pt-3">
        <SousTitre class="font-accent text-[21px] font-bold leading-[1.25] md:text-[24px]">Ce qui se passe ensuite</SousTitre>
        <ol class="mt-5 grid gap-5 md:mt-7 md:gap-7">
          {
            etapes.map((e, i) => (
              <li class="flex gap-4 md:gap-5">
                <span class="dv-tuile dv-tuile-numero shrink-0" aria-hidden="true">{i + 1}</span>
                <span class="pt-1 md:pt-2">
                  <span class="block font-accent text-[18px] font-bold leading-[1.3] md:text-[20px]">{e.titre}</span>
                  <span class="mt-1.5 block text-[16px] leading-[1.55] dv-muted md:text-[17px]">{e.texte}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <div class="mt-8 flex items-center gap-4 border-t border-grey-2/15 pt-7 md:mt-9">
          <span class="dv-tom-en-ligne">
            <img src={lien('/images/tom-voisin.webp')} alt="Tom Voisin" width="400" height="400" loading="lazy" decoding="async" class="h-14 w-14 rounded-full object-cover md:h-16 md:w-16" />
            <span class="dv-tom-en-ligne-pastille"><i aria-hidden="true"></i>En ligne</span>
          </span>
          <a href={`mailto:${SITE.email}`} class="inline-flex min-h-11 items-center text-[16px] font-semibold leading-[1.5] md:text-[17px] xl:inline xl:min-h-0">{SITE.email}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Photo de Tom avec la mention « En ligne » (demande de Tom, 4 octobre 2026). Point en Bleu 1 : la charte du site
     n'a que cinq couleurs. */
  .dv-tom-en-ligne {
    position: relative;
    flex-shrink: 0;
    padding-bottom: 10px;
  }
  .dv-tom-en-ligne-pastille {
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 3px 8px;
    border: 1px solid var(--dv-bord);
    border-radius: 999px;
    background: var(--color-white);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--color-grey-2);
  }
  /* 14 px sur téléphone et tablette (8 octobre 2026, audit responsive), 12 px à partir de 768 px comme avant. */
  @media (min-width: 768px) {
    .dv-tom-en-ligne-pastille {
      font-size: 12px;
    }
  }
  .dv-tom-en-ligne-pastille i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-blue);
  }
</style>
