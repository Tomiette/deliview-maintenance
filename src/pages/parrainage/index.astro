---
// Parrainage (4 octobre 2026, décision de Tom) : 2 restaurateurs parrainés = 1 mois offert au parrain. Un filleul compte
// quand il a payé son premier mois. Le parrain crée son lien (?par=Prénom, restaurant) et le partage ; le filleul arrive
// sur cette page, son formulaire est prérempli avec le parrain, et la fonction « lead » range le parrain dans les notes
// de la demande. Tom retire lui-même le mois offert de la facture suivante du parrain.
// Mise en page reprise de la page d'affiliation de taap.it (6 octobre 2026, demande de Tom) : haut de page avec curseur,
// trois cartes illustrées, bande « à qui », lien, questions en deux colonnes, bandeau final. Illustrations au trait et
// petites interfaces aux couleurs de la charte, jamais de photo de banque d'images ; contenu propre à Deliview.
import Base from '../../layouts/Base.astro';
import Pastille from '../../components/Pastille.astro';
import SectionDemo from '../../components/SectionDemo.astro';
import Plus from '../../icons/plus.astro';
import Moins from '../../icons/moins.astro';
import Message from '../../icons/message.astro';
import Telephone from '../../icons/telephone.astro';
import Duo from '../../icons/duo.astro';
import BoutiqueArret from '../../icons/boutique-arret.astro';
import Toque from '../../icons/toque.astro';
import SacLivraison from '../../icons/sac-livraison.astro';
import { OFFRES, SITE, lien } from '../../lib/site';
import { logoPlateforme } from '../../lib/logos';

const PAR_MOIS = 2;
const pro = OFFRES.find((o) => o.slug === 'pro') ?? OFFRES[0];
const logoUber = logoPlateforme('uber-eats');
const logoDeliveroo = logoPlateforme('deliveroo');
const description =
  'Clients Deliview : recommandez Deliview à 2 restaurateurs et gagnez 1 mois d’abonnement offert. Sans limite : 4 parrainages, 2 mois offerts.';
const etapes = [
  { titre: 'Créez votre lien', texte: 'Votre prénom et votre restaurant, c’est tout. Votre lien est prêt en 10 secondes.' },
  { titre: 'Partagez-le', texte: 'Par WhatsApp, par SMS ou de vive voix, à un restaurateur que vous connaissez.' },
  { titre: 'Votre mois est offert', texte: 'Dès que 2 filleuls ont payé leur premier mois, Tom le retire de votre prochaine facture.' },
];
const cibles = [
  { titre: 'Le restaurant d’à côté', texte: 'Un voisin de rue sur les mêmes plateformes. Vous vous croisez chaque jour.' },
  { titre: 'Une dark kitchen', texte: 'Plusieurs marques, une seule cuisine. Deliview les suit toutes au même endroit.' },
  { titre: 'Un ami du métier', texte: 'Un ancien associé, un ami d’école hôtelière, un confrère du quartier.' },
];
const faq = [
  { q: 'Est-ce que je peux parrainer ?', r: 'Oui, si vous êtes client de Deliview, avec un abonnement payant en cours.' },
  {
    q: 'Quand est-ce que mon filleul compte ?',
    r: 'Quand il a payé son premier mois. Il doit être un nouveau client&nbsp;: un restaurateur déjà abonné à Deliview ne compte pas.',
  },
  { q: 'Est-ce que j’ai une limite de filleuls ?', r: 'Non. 2 filleuls, 1 mois offert&nbsp;; 4 filleuls, 2 mois offerts&nbsp;; et ainsi de suite.' },
  { q: 'Comment le mois m’est-il offert ?', r: 'Tom le retire de votre prochaine facture, sur votre offre actuelle. Vous n’avez rien à demander.' },
  {
    q: 'Mon filleul a oublié d’utiliser mon lien.',
    r: `Écrivez à Tom (<a href="mailto:${SITE.email}">${SITE.email}</a>) avec le nom de son restaurant&nbsp;: il le rattache à votre parrainage.`,
  },
  { q: 'Est-ce que je peux être payé en argent ?', r: 'Non. Le parrainage donne des mois d’abonnement offerts, pas de versement.' },
];
const erreurs = [
  { id: 'erreur-champs', texte: 'Un champ est incomplet. Vérifiez vos informations, puis renvoyez le formulaire.' },
  { id: 'erreur-limite', texte: `Trop de demandes sont parties de cette connexion. Écrivez à Tom : ${SITE.email}.` },
  { id: 'erreur-serveur', texte: `Votre demande n’a pas pu être enregistrée. Écrivez à Tom : ${SITE.email}.` },
];
const pageUrl = SITE.url + '/parrainage/';
const euros = (n: number) => `${n.toLocaleString('fr-FR')} €`;
---

<Base title="Parrainage : 2 restaurateurs, 1 mois offert | Deliview" description={description} ariane={[{ nom: 'Parrainage', chemin: '/parrainage/' }]} fondHaut="blanc">
  {
    erreurs.map((e) => (
      <div id={e.id} class="dv-erreur-ancre dv-container pt-6" role="alert">
        <p class="rounded-[12px] border-2 border-grey-2 bg-grey p-4 font-semibold">
          <span class="dv-erreur block">{e.texte}</span>
        </p>
      </div>
    ))
  }

  <!-- Haut de page : l'offre et le curseur (mise en page de taap.it : titre centré, colonnes en fond, curseur pleine
       largeur avec la bulle sous le bouton du curseur et le gain en grand à droite) -->
  <section class="dv-parr-hero overflow-x-clip pb-16 pt-6 md:pb-[104px] md:pt-12" aria-labelledby="parrainage-titre" data-haut-de-page>
    <div class="dv-container max-w-[1100px] text-center">
      <h1 id="parrainage-titre" class="dv-h1 mx-auto max-w-[20ch]">
        <span class="text-blue">2&nbsp;parrainages</span> = 1&nbsp;mois offert.<br class="hidden sm:block" /> Sans limite.
      </h1>
      <p class="dv-lead mx-auto mt-4 max-w-[38ch] md:mt-5">
        Vos amis restaurateurs. Notre produit. Un mois d’abonnement offert tous les 2&nbsp;filleuls abonnés.
      </p>
      <a href="#lien" class="dv-btn-sombre mt-7 md:mt-8">Créer mon lien de parrainage</a>

      <div class="dv-parr-calcul mt-12 md:mt-16">
        <div class="dv-parr-piste">
          <label for="parr-nombre" class="sr-only">Nombre de restaurateurs parrainés</label>
          <input id="parr-nombre" type="range" min="0" max="20" step="1" value="10" class="dv-parr-curseur w-full" aria-describedby="parr-resultat" />
          <output for="parr-nombre" class="dv-parr-bulle" aria-hidden="true" data-parr-bulle><span id="parr-nombre-valeur">10</span>&nbsp;parrainages</output>
        </div>
        <div id="parr-resultat" class="dv-parr-gain" aria-live="polite">
          <p class="dv-parr-chiffre"><span data-parr-mois>5</span>&nbsp;mois</p>
          <p class="dv-parr-sous">offerts</p>
          <p class="mt-1 text-[15px] leading-[1.4] dv-muted">soit <strong class="font-chiffres font-semibold text-grey-2" data-parr-euros>{5 * pro.prix}&nbsp;€</strong> HT en offre {pro.nom}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comment ça marche : trois cartes, chacune avec sa petite interface (lien, partage, facture) -->
  <section class="dv-section" aria-labelledby="parr-etapes-titre">
    <div class="dv-container">
      <div class="text-center">
        <Pastille>En 3 étapes</Pastille>
        <h2 id="parr-etapes-titre" class="dv-h2 mx-auto mt-4 max-w-[22ch] md:mt-5">Comment ça marche&nbsp;?</h2>
      </div>
      <ol class="mx-auto mt-10 grid max-w-[560px] gap-5 md:mt-12 lg:max-w-none lg:grid-cols-3 lg:gap-6">
        <li class="dv-parr-carte">
          <div class="dv-parr-illu" aria-hidden="true">
            <div class="dv-parr-champ">
              <span class="dv-parr-champ-libelle">Votre lien</span>
              <span class="dv-parr-champ-url">deliview.fr/parrainage?par=<b class="text-blue">votre_nom</b></span>
            </div>
          </div>
          <h3 class="dv-parr-carte-titre">{etapes[0].titre}</h3>
          <p class="dv-parr-carte-texte">{etapes[0].texte}</p>
        </li>
        <li class="dv-parr-carte">
          <div class="dv-parr-illu dv-parr-illu-partage" aria-hidden="true">
            <svg class="dv-parr-fils" viewBox="0 0 100 100" preserveAspectRatio="none" focusable="false">
              <path d="M24 50 C 40 50, 40 22, 57 22" />
              <path d="M24 50 L 57 50" />
              <path d="M24 50 C 40 50, 40 78, 57 78" />
            </svg>
            <span class="dv-parr-centre"><img src={lien('/favicon.svg')} alt="" width="44" height="44" /></span>
            <span class="dv-parr-canal" style="top: 22%"><Message taille={24} /> WhatsApp</span>
            <span class="dv-parr-canal" style="top: 50%"><Telephone taille={24} /> SMS</span>
            <span class="dv-parr-canal" style="top: 78%"><Duo taille={24} /> De vive voix</span>
          </div>
          <h3 class="dv-parr-carte-titre">{etapes[1].titre}</h3>
          <p class="dv-parr-carte-texte">{etapes[1].texte}</p>
        </li>
        <li class="dv-parr-carte">
          <div class="dv-parr-illu" aria-hidden="true">
            <div class="dv-parr-facture">
              <p class="dv-parr-facture-tete"><span>Prochaine facture</span><span>HT</span></p>
              <p class="dv-parr-facture-ligne"><span>Abonnement {pro.nom}</span><span>{euros(pro.prix)}</span></p>
              <p class="dv-parr-facture-ligne text-blue"><span>Parrainage · 2 filleuls</span><span>−{euros(pro.prix)}</span></p>
              <p class="dv-parr-facture-total"><span>À payer</span><span>0&nbsp;€</span></p>
            </div>
          </div>
          <h3 class="dv-parr-carte-titre">{etapes[2].titre}</h3>
          <p class="dv-parr-carte-texte">{etapes[2].texte}</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- À qui le recommander : la bande de taap.it (« Cibles »), en colonnes séparées par des filets -->
  <section class="dv-parr-cibles" aria-labelledby="parr-cibles-titre">
    <div class="dv-parr-cibles-grille">
      <div class="dv-parr-cibles-intro">
        <div>
          <Pastille>Pour qui</Pastille>
          <h2 id="parr-cibles-titre" class="dv-h2 mt-4 max-w-[14ch] md:mt-5">À qui le recommander&nbsp;?</h2>
          <p class="mt-4 max-w-[38ch] text-[17px] leading-[1.6] md:text-[18px]">À un restaurateur qui vend sur Uber&nbsp;Eats ou Deliveroo. Vous le connaissez, il vous fait confiance.</p>
        </div>
        <div class="dv-parr-plateau" aria-hidden="true">
          <span class="dv-parr-piece"><span class="dv-parr-piece-chiffre">+1</span><span class="dv-parr-piece-mot">mois</span></span>
          <span class="dv-puce dv-parr-flotte dv-flotte" style="left: -14%; top: 8px; --duree: 7s">
            {logoUber ? <img class="dv-puce-logo" src={logoUber.src} alt="" width={logoUber.largeur} height={logoUber.hauteur} /> : <i />}
            Uber&nbsp;Eats
          </span>
          <span class="dv-puce dv-parr-flotte dv-flotte" style="right: -14%; top: 30px; --duree: 6s; --delai: -2s">
            {logoDeliveroo ? <img class="dv-puce-logo" src={logoDeliveroo.src} alt="" width={logoDeliveroo.largeur} height={logoDeliveroo.hauteur} /> : <i />}
            Deliveroo
          </span>
          <span class="dv-puce dv-parr-flotte dv-flotte" style="left: -18%; bottom: 30px; --duree: 8s; --delai: -4s"><Message taille={24} /> WhatsApp</span>
          <span class="dv-puce dv-parr-flotte dv-flotte" style="right: -8%; bottom: 4px; --duree: 6.5s; --delai: -1s"><Telephone taille={24} /> SMS</span>
        </div>
      </div>

      <div class="dv-parr-cible">
        <div class="dv-parr-cible-dessin" aria-hidden="true">
          <span class="dv-parr-fil-haut"></span>
          <div class="dv-parr-vignette">
            <BoutiqueArret taille={48} />
            <span class="dv-parr-vignette-logos">
              {logoUber && <img src={logoUber.src} alt="" width={logoUber.largeur} height={logoUber.hauteur} />}
              {logoDeliveroo && <img src={logoDeliveroo.src} alt="" width={logoDeliveroo.largeur} height={logoDeliveroo.hauteur} />}
            </span>
          </div>
          <span class="dv-parr-medaillon"><SacLivraison taille={32} /></span>
          <span class="dv-parr-accolade"></span>
        </div>
        <h3 class="dv-parr-carte-titre">{cibles[0].titre}</h3>
        <p class="dv-parr-carte-texte">{cibles[0].texte}</p>
      </div>

      <div class="dv-parr-cible">
        <div class="dv-parr-cible-dessin" aria-hidden="true">
          <span class="dv-parr-fil-haut"></span>
          <div class="dv-parr-vignette dv-parr-vignette-marques">
            <span><i></i>Marque 1</span>
            <span><i></i>Marque 2</span>
            <span><i></i>Marque 3</span>
          </div>
          <span class="dv-parr-medaillon"><Toque taille={32} /></span>
          <span class="dv-parr-accolade"></span>
        </div>
        <h3 class="dv-parr-carte-titre">{cibles[1].titre}</h3>
        <p class="dv-parr-carte-texte">{cibles[1].texte}</p>
      </div>

      <div class="dv-parr-cible">
        <div class="dv-parr-cible-dessin" aria-hidden="true">
          <span class="dv-parr-fil-haut"></span>
          <div class="dv-parr-vignette dv-parr-vignette-messages">
            <span class="dv-parr-msg">Le logiciel dont je parlais&nbsp;:</span>
            <span class="dv-parr-msg dv-parr-msg-lien">deliview.fr/parrainage…</span>
          </div>
          <span class="dv-parr-medaillon"><Duo taille={32} /></span>
          <span class="dv-parr-accolade"></span>
        </div>
        <h3 class="dv-parr-carte-titre">{cibles[2].titre}</h3>
        <p class="dv-parr-carte-texte">{cibles[2].texte}</p>
      </div>
    </div>
  </section>

  <!-- Créer son lien : le texte à gauche, la carte à droite ; le lien s'écrit dans le champ illustré -->
  <section id="lien" class="dv-section bg-grey" aria-labelledby="parr-lien-titre">
    <div class="dv-container">
      <div class="dv-parr-lien-grille">
        <div>
          <Pastille>Votre lien</Pastille>
          <h2 id="parr-lien-titre" class="dv-h2 mt-4 max-w-[16ch] md:mt-5">Créez votre lien de parrainage</h2>
          <p class="dv-lead mt-4 max-w-[42ch]">Votre filleul verra votre nom en demandant sa démo. C’est ainsi que Tom sait qu’il vient de vous.</p>
          <ul class="dv-parr-coches mt-6">
            <li>Gratuit, sans inscription</li>
            <li>Un lien pour tous vos filleuls</li>
            <li>Rien à demander pour votre mois</li>
          </ul>
        </div>
        <div class="dv-parr-carte-lien dv-relief px-5 py-7 sm:px-8 md:px-9 md:py-9">
          <label for="parr-qui" class="block text-[16px] font-semibold leading-[1.3]">Votre prénom et votre restaurant</label>
          <input id="parr-qui" type="text" maxlength="160" autocomplete="off" placeholder="Exemple : Karim, Burger Factory Lyon" class="dv-champ mt-2 placeholder:text-grey-2/70" aria-describedby="parr-qui-aide" />
          <p id="parr-qui-aide" class="mt-2 text-[15px] leading-[1.4] dv-muted">Vous êtes client de Deliview&nbsp;: indiquez le nom sous lequel Tom vous connaît.</p>

          <div class="dv-parr-apercu mt-6" aria-hidden="true" data-parr-apercu>
            deliview.fr/parrainage?par=<span class="text-blue" data-parr-apercu-nom>votre_nom</span>
          </div>

          <div class="mt-6" data-parr-sortie hidden>
            <p class="block text-[16px] font-semibold leading-[1.3]" id="parr-lien-libelle">Votre lien</p>
            <p class="dv-parr-lien mt-2" aria-labelledby="parr-lien-libelle"><span data-parr-lien></span></p>
            <div class="mt-4 flex flex-wrap gap-3">
              <button type="button" class="dv-btn dv-btn-plein flex-auto" data-parr-copier>Copier le lien</button>
              <a href="#" class="dv-btn dv-btn-contour flex-auto" target="_blank" rel="noopener" data-parr-whatsapp>Envoyer par WhatsApp<span class="sr-only"> (nouvel onglet)</span></a>
            </div>
            <p class="mt-3 min-h-[1.5em] text-[15px] font-semibold" role="status" data-parr-statut></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Les conditions : questions en deux colonnes (titre et bouton à gauche, réponses à droite), comme taap.it -->
  <section id="conditions" class="dv-section dv-faq" aria-labelledby="conditions-titre">
    <div class="dv-container">
      <div class="dv-parr-faq-grille">
        <div class="dv-parr-faq-intro">
          <Pastille>Questions</Pastille>
          <h2 id="conditions-titre" class="dv-h2 mt-4 max-w-[13ch] md:mt-5">Les conditions, en clair</h2>
          <p class="mt-4 max-w-[34ch] text-[17px] leading-[1.6] md:text-[18px]">
            Une autre question&nbsp;? Écrivez à Tom&nbsp;: <a href={`mailto:${SITE.email}`} class="dv-lien">{SITE.email}</a>
          </p>
          <a href="#lien" class="dv-btn-sombre mt-7">Créer mon lien de parrainage</a>
        </div>
        <div class="grid gap-3.5 md:gap-4">
          {
            faq.map((x, i) => (
              <details class="dv-relief dv-faq-carte" open={i === 0}>
                <summary class="flex min-h-12 items-center justify-between gap-6 py-5">
                  <h3 class="font-accent text-[18px] font-bold leading-[1.35] md:text-[20px]">{x.q}</h3>
                  <Plus taille={24} class="dv-faq-plus" />
                  <Moins taille={24} class="dv-faq-moins" />
                </summary>
                <p class="mb-6 max-w-[64ch] text-[17px] leading-[1.6] md:text-[18px]" set:html={x.r} />
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Bandeau final : la promesse en deux lignes, sur le fond à colonnes du haut de page -->
  <section aria-labelledby="parr-fin-titre">
    <div class="dv-container">
      <div class="dv-parr-final">
        <h2 id="parr-fin-titre" class="dv-h2 mx-auto max-w-[24ch]">Vos amis restaurateurs méritent Deliview. <span class="text-blue">Vous, un mois offert.</span></h2>
        <p class="dv-lead mx-auto mt-4 max-w-[56ch]">2&nbsp;filleuls abonnés, 1&nbsp;mois offert. Sans limite, et sans rien à demander.</p>
        <a href="#lien" class="dv-btn-sombre mt-7">Créer mon lien de parrainage</a>
      </div>
    </div>
  </section>

  <SectionDemo
    section="page-parrainage"
    variante="parrainage"
    id="demo"
    surtitre="Vous êtes recommandé"
    titre="Un restaurateur vous a parlé de Deliview ?"
    sousTitre={'Demandez votre démo gratuite de 30 minutes. Indiquez qui vous recommande : c’est ce qui lui offre son mois.'}
  />
</Base>

<!-- Valeurs du script en JSON (jamais exécuté) : un script à variables injectées (define:vars) n'aurait pas d'empreinte
     dans la politique de sécurité des contenus (6 octobre 2026). -->
<script type="application/json" id="dv-vars-parrainage" set:html={JSON.stringify({ PAR_MOIS, prixPro: pro.prix, pageUrl })} />

<script>
  // @ts-nocheck : script repris tel quel, valeurs lues dans le bloc JSON ci-dessus.
  const { PAR_MOIS, prixPro, pageUrl } = JSON.parse(document.getElementById('dv-vars-parrainage')?.textContent || '{}');
  // Curseur : mois offerts = parrainages ÷ 2 (arrondi en dessous), et leur valeur sur l'offre Pro.
  const curseur = document.getElementById('parr-nombre');
  const valeur = document.getElementById('parr-nombre-valeur');
  const mois = document.querySelector('[data-parr-mois]');
  const euros = document.querySelector('[data-parr-euros]');
  const bulle = document.querySelector('[data-parr-bulle]');
  const nf = new Intl.NumberFormat('fr-FR');
  function majCurseur() {
    const n = Number(curseur.value);
    const m = Math.floor(n / PAR_MOIS);
    valeur.textContent = String(n);
    mois.textContent = String(m);
    euros.textContent = nf.format(m * prixPro) + ' €';
    const pct = (n / Number(curseur.max)) * 100;
    curseur.style.setProperty('--parr-rempli', pct + '%');
    bulle.lastChild.textContent = n > 1 ? ' parrainages' : ' parrainage';
    placerBulle();
    curseur.setAttribute('aria-valuetext', n + ' restaurateurs parrainés, ' + m + ' mois offerts');
  }
  // La bulle suit le bouton du curseur (32 px de large), sans jamais sortir de la piste.
  function placerBulle() {
    const w = curseur.clientWidth;
    const bw = bulle.offsetWidth;
    const x = 16 + (Number(curseur.value) / Number(curseur.max)) * (w - 32);
    bulle.style.left = Math.min(Math.max(x, bw / 2), w - bw / 2) + 'px';
  }
  addEventListener('resize', placerBulle);
  curseur.addEventListener('input', majCurseur);
  majCurseur();

  // Lien de parrainage : adresse de cette page avec ?par=…, renvoie au formulaire de démo. Le champ illustré au-dessus
  // montre le nom au fur et à mesure.
  const qui = document.getElementById('parr-qui');
  const sortie = document.querySelector('[data-parr-sortie]');
  const lienTexte = document.querySelector('[data-parr-lien]');
  const copier = document.querySelector('[data-parr-copier]');
  const whatsapp = document.querySelector('[data-parr-whatsapp]');
  const statut = document.querySelector('[data-parr-statut]');
  const apercu = document.querySelector('[data-parr-apercu]');
  const apercuNom = document.querySelector('[data-parr-apercu-nom]');
  let lienActuel = '';
  function majLien() {
    const v = qui.value.replace(/\s+/g, ' ').trim().slice(0, 160);
    apercuNom.textContent = v ? encodeURIComponent(v).replace(/%20/g, '+') : 'votre_nom';
    sortie.hidden = v.length < 2;
    apercu.hidden = v.length >= 2;
    statut.textContent = '';
    if (v.length < 2) return;
    lienActuel = pageUrl + '?par=' + encodeURIComponent(v) + '#demo';
    lienTexte.textContent = lienActuel;
    const message = 'J’utilise Deliview pour mes prix et mes promos sur Uber Eats et Deliveroo. Demande ta démo gratuite avec mon lien : ' + lienActuel;
    whatsapp.href = 'https://wa.me/?text=' + encodeURIComponent(message);
  }
  qui.addEventListener('input', majLien);
  copier.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(lienActuel);
      statut.textContent = 'Lien copié. Collez-le dans un SMS ou un message.';
    } catch {
      const r = document.createRange();
