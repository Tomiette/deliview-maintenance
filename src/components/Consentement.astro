---
// Bandeau de choix pour le suivi des visites (8 octobre 2026, demande de Tom : voir la navigation de chaque lead ; choix
// « Bandeau + parcours »). Règles de la CNIL : « Refuser » aussi visible et aussi simple qu'« Accepter », aucun suivi
// avant le choix, rien de coché d'avance, choix gardé 6 mois et modifiable à tout moment (« Gérer les cookies » en bas de
// chaque page). Le bandeau ne bloque pas la page. Sans choix, la visite est comptée de façon anonyme seulement.
// Sans JavaScript, le bandeau reste caché : aucune mesure n'est faite.
import { lien } from '../lib/site';
---

<section id="dv-consentement" class="dv-consentement" aria-label="Votre choix pour le suivi des visites" hidden>
  <p class="dv-consentement-texte">
    Nous comptons les visites de façon anonyme. Avec votre accord, nous retenons aussi les pages que vous lisez, pour
    améliorer le site et préparer votre démo.
  </p>
  <p class="dv-consentement-note">
    <span data-consentement-actuel></span>Choix gardé 6&nbsp;mois, modifiable en bas de page.
    <a href={lien('/confidentialite/#cookies')}>En savoir plus</a>
  </p>
  <div class="dv-consentement-boutons">
    <button type="button" class="dv-consentement-bouton" data-choix="non">Refuser</button>
    <button type="button" class="dv-consentement-bouton" data-choix="oui">Accepter</button>
  </div>
</section>

<script>
  import { choixEnregistre, enregistrerChoix, type Choix } from '../lib/suivi';

  const bandeau = document.getElementById('dv-consentement');
  if (bandeau) {
    const actuel = bandeau.querySelector<HTMLElement>('[data-consentement-actuel]');
    let ouvertPar: HTMLElement | null = null;
    const montrer = (depuis: HTMLElement | null) => {
      const c = choixEnregistre();
      if (actuel) {
        const le = c ? new Date(c.le).toLocaleDateString('fr-FR', { day: 'numeric', month: 'long' }) : '';
        actuel.textContent = c ? (c.choix === 'oui' ? `Vous avez accepté le ${le}. ` : `Vous avez refusé le ${le}. `) : '';
      }
      ouvertPar = depuis;
      bandeau.hidden = false;
      if (depuis) bandeau.querySelector<HTMLButtonElement>('[data-choix]')?.focus();
    };
    if (!choixEnregistre()) montrer(null);
    bandeau.querySelectorAll<HTMLButtonElement>('[data-choix]').forEach((b) =>
      b.addEventListener('click', () => {
        const choix: Choix = b.dataset.choix === 'oui' ? 'oui' : 'non';
        enregistrerChoix(choix);
        bandeau.hidden = true;
        ouvertPar?.focus();
        ouvertPar = null;
      }),
    );
    // « Gérer les cookies » (pied de page, page Confidentialité) : le bandeau revient, avec le choix en cours.
    document.querySelectorAll<HTMLElement>('[data-gerer-cookies]').forEach((b) =>
      b.addEventListener('click', (e) => {
        e.preventDefault();
        montrer(b);
      }),
    );
  }
</script>

<style>
  /* Carte blanche en bas de l'écran, à droite sur ordinateur (le bouton démo du haut de page est à gauche) ; sur
     téléphone, toute la largeur, au-dessus de la barre « Demander une démo ». */
  .dv-consentement {
    position: fixed;
    right: 12px;
    bottom: 12px;
    left: 12px;
    z-index: 50;
    max-height: calc(100dvh - 24px);
    overflow-y: auto;
    padding: 14px 14px 12px;
    border: 1px solid color-mix(in srgb, var(--color-grey-2) 15%, transparent);
    border-radius: 16px;
    background: var(--color-white);
    box-shadow: 0 12px 32px rgba(76, 76, 76, 0.12);
    animation: dv-consentement-entre 0.2s ease-out;
  }
  .dv-consentement[hidden] {
    display: none;
  }
  @media (min-width: 640px) {
    .dv-consentement {
      right: 20px;
      bottom: 20px;
      left: auto;
      width: min(420px, calc(100vw - 40px));
      padding: 18px 18px 16px;
    }
  }
  @keyframes dv-consentement-entre {
    from {
      opacity: 0;
      translate: 0 8px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dv-consentement {
      animation: none;
    }
  }
  .dv-consentement-texte {
    font-size: 15px;
    line-height: 1.45;
  }
  .dv-consentement-note {
    margin-top: 6px;
    font-size: 14px;
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-grey-2) 85%, transparent);
  }
  .dv-consentement-note a {
    color: var(--color-grey-2);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* Deux boutons identiques : refuser est aussi simple qu'accepter. */
  .dv-consentement-boutons {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 12px;
  }
  .dv-consentement-bouton {
    min-height: 46px;
    padding: 0 12px;
    border: 1.5px solid var(--color-grey-2);
    border-radius: 12px;
    background: var(--color-white);
    color: var(--color-grey-2);
    font-size: 17px;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
  }
  .dv-consentement-bouton:hover {
    background: var(--color-grey);
  }
  .dv-consentement-bouton:focus-visible,
  .dv-consentement-note a:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }
</style>
