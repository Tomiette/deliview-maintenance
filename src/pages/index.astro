---
// Accueil (aperçu validé par Tom le 10 octobre 2026), repris du site compilé de l'aperçu, fait à la main, sans rien
// changer de visible. Ordre de la page :
// 1. haut de page : « Plus de rentabilité sur Uber Eats et Deliveroo », écran incliné, « Voir la vidéo » (AccueilHero) ;
// 2. « Ils utilisent Deliview » : Pizza Cosy (AccueilClients) ;
// 3. « Comment fonctionne Deliview » : le moteur (AccueilMoteur) ;
// 4. « Vous n’avez pas le temps » puis « Votre rentabilité part à 3 endroits » (AccueilQuotidien) ;
// 5. « La solution » : quatre pertes réelles, deux voies, Autonomie et Délégation (AccueilSolution, #solution, #formules) ;
// 6. « Avant, après » : Pizza Démo remonte de la 6e à la 1re place (AccueilClassement) ;
// 7. « Votre activité livraison depuis votre poche » : l'app sur un vrai téléphone (AccueilAppli) ;
// 8. questions (même fond gris que l'app, collée à elle) ;
// 9. démo (AccueilDemo, #demo).
// Section Tarifs retirée de l'accueil (décision de Tom) : les offres restent sur la page /tarifs/. Bloc fondateur retiré.
// Chiffres affichés : compte de démonstration (Pizza Démo). Pizza Cosy : logo, devanture et « Nous fait confiance depuis
// le premier jour. » seulement, avec l'accord du restaurant.
// Chaque section importe son CSS (src/styles/accueil/) et son script (src/scripts/accueil/) : jamais de <style> scopé,
// jamais de <script is:inline> (CSP).
import Base from '../layouts/Base.astro';
import AccueilHero from '../components/accueil/AccueilHero.astro';
import AccueilClients from '../components/accueil/AccueilClients.astro';
import AccueilMoteur from '../components/accueil/AccueilMoteur.astro';
import AccueilQuotidien from '../components/accueil/AccueilQuotidien.astro';
import AccueilSolution from '../components/accueil/AccueilSolution.astro';
import AccueilClassement from '../components/accueil/AccueilClassement.astro';
import AccueilAppli from '../components/accueil/AccueilAppli.astro';
import AccueilDemo from '../components/accueil/AccueilDemo.astro';
import Faq from '../components/Faq.astro';
import { FAQ_ACCUEIL } from '../lib/faq';
import { SITE, jsonldLogiciel } from '../lib/site';

const description = 'Deliview centralise vos chiffres Uber Eats et Deliveroo : promos, fraude client et prix, pour une livraison plus rentable. Sans engagement.';

// Le film Deliview (V29, 55 s, voix de PADG), en ligne depuis le 8 octobre 2026 à la place de la V15 (1 min 10).
// Il s'ouvre dans la fenêtre vidéo du site (« Voir la vidéo » du haut de page, « Lire la vidéo » du menu).
const video = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'Deliview en 60 secondes',
  description: 'Présentation de Deliview : vos données Uber Eats et Deliveroo centralisées, les prix, notes et promos de vos concurrents, quoi faire pour votre rentabilité, les remboursements injustes contestés en un clic, les réponses à vos avis et, chaque lundi, ce que Deliview vous a rapporté.',
  thumbnailUrl: SITE.url + '/video/deliview-film-couverture-1920.webp',
  uploadDate: '2026-10-08T17:30:00+02:00',
  duration: 'PT55S',
  contentUrl: SITE.url + '/video/deliview-film.mp4',
  width: 1920,
  height: 1080,
  inLanguage: 'fr-FR',
};
---

<Base title="Logiciel restaurant Uber Eats et Deliveroo | Deliview" description={description} jsonld={[jsonldLogiciel(SITE.definition, SITE.url + '/'), video]}>
  <AccueilHero />
  <AccueilClients />
  <AccueilMoteur />
  <AccueilQuotidien />
  <AccueilSolution />
  <AccueilClassement />
  <AccueilAppli />
  <Faq questions={FAQ_ACCUEIL} titre="Ce qu’on demande à Tom avant une démo" id="questions" collee />
  <AccueilDemo />
</Base>
