---
// Carte d'un article, la même partout (Ressources, « À lire aussi », « Pour aller plus loin » des pages Solution),
// 6 octobre 2026 : la photo de l'article en haut (16:9, décorative ici : le titre dit de quoi parle l'article), le thème
// si demandé, le titre (lien étiré sur toute la carte), la description courte et la date de mise à jour.
import type { CollectionEntry } from 'astro:content';
import { THEMES, dateFr, lien, tempsLecture } from '../lib/site';

interface Props {
  article: CollectionEntry<'ressources'>;
  niveau?: 'h2' | 'h3';
  // Thème au-dessus du titre (listes qui mélangent les thèmes).
  theme?: boolean;
  // Date de mise à jour et temps de lecture.
  infos?: boolean;
  // Carte du premier écran (premières cartes de /ressources/) : photo chargée tout de suite (8 octobre 2026, audit SEO).
  priorite?: boolean;
}

const { article: a, niveau = 'h3', theme = false, infos = true, priorite = false } = Astro.props;
const Titre = niveau;
const photo = a.data.image;
const base = photo ? lien(photo.src) : '';
---

<li class="dv-card dv-carte-lien dv-carte-article flex flex-col">
  {
    photo && (
      <img
        class="dv-carte-article-photo"
        src={`${base}-${photo.largeurs[0]}.webp`}
        srcset={photo.largeurs.map((w) => `${base}-${w}.webp ${w}w`).join(', ')}
        sizes="(min-width: 1200px) 370px, (min-width: 1024px) 31vw, (min-width: 768px) 46vw, calc(100vw - 32px)"
        alt=""
        width="800"
        height="450"
        loading={priorite ? 'eager' : 'lazy'}
        decoding="async"
      />
    )
  }
  <div class="flex flex-1 flex-col p-5 md:p-6">
    {theme && <p class="dv-overline mb-3">{THEMES[a.data.theme]}</p>}
    <Titre class="font-accent text-[19px] font-bold leading-[1.3] [text-wrap:balance] md:text-[20px]">
      <a href={lien(`/ressources/${a.id}/`)} class="dv-etire hover:underline">{a.data.titre}</a>
    </Titre>
    <p class="mt-2 flex-1 text-[16px] leading-[1.5] dv-muted">{a.data.description}</p>
    {
      infos && (
        <p class="mt-4 text-[14px] leading-[1.4] dv-muted">
          Mis à jour le {dateFr(a.data.misAJourLe)} · {tempsLecture(a.body || '')}&nbsp;min de lecture
        </p>
      )
    }
  </div>
</li>
