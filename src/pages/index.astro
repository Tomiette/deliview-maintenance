---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import CaptureTablette from '../components/CaptureTablette.astro';
import PhotoIA from '../components/PhotoIA.astro';
import HeroVideo from '../components/HeroVideo.astro';
import BandeauPlateformes from '../components/BandeauPlateformes.astro';
import BlocFondateur from '../components/BlocFondateur.astro';
import SectionDemo from '../components/SectionDemo.astro';
import Faq from '../components/Faq.astro';
import Icone from '../components/Icone.astro';
import { FAQ_ACCUEIL } from '../lib/faq';
import { PILIERS, PRIX_ENTREE, SITE, THEMES, jsonldLogiciel, lien, type ImageIA, type NomIcone } from '../lib/site';

const articles = (await getCollection('ressources', (a) => !a.data.brouillon))
  .sort((a, b) => b.data.publieLe.getTime() - a.data.publieLe.getTime())
  .slice(0, 3);

const douleurs: { icone: NomIcone; titre: string; texte: string }[] = [
  {
    icone: 'tablette',
    titre: 'Deux tablettes, deux cartes',
    texte: 'Deux grilles de prix à tenir à jour, et des écarts entre vos deux fiches qui passent inaperçus.',
  },
  {
    icone: 'prix',
    titre: 'Des prix fixés à l’instinct',
    texte: 'Relever les prix des voisins, vérifier les tailles, recommencer sur l’autre plateforme : personne n’a le temps entre deux services.',
  },
  {
    icone: 'promo',
    titre: 'Des promos repérées après coup',
    texte: 'Un voisin lance une offre le vendredi soir. Vous la découvrez souvent la semaine suivante, en regardant vos ventes.',
  },
];

// Les trois temps de la promesse : vos données réunies, vos concurrents visibles, vos prix et vos promos ajustés.
const etapes = [
  { titre: 'Vos données sur une seule tablette', texte: 'Le nom et la ville de votre restaurant suffisent : Deliview retrouve vos fiches Uber Eats et Deliveroo et les réunit au même endroit.' },
  { titre: 'Vous voyez ce que font vos concurrents', texte: 'Leurs prix plat par plat, leurs notes et leurs promos, chez jusqu’à 20 restaurants de votre secteur, sur les deux plateformes.' },
  { titre: 'Vous ajustez vos prix et vos promos', texte: 'Chaque plat reçoit un statut et, quand la comparaison le permet, un prix proposé avec ses sources. Vous décidez, plat par plat.' },
];

const benefices: { icone: NomIcone; titre: string; texte: string }[] = [
  { icone: 'oeil', titre: 'Voyez ce que font vos concurrents', texte: 'Leurs prix, leurs notes et leurs promos face aux vôtres, chez les restaurants qui livrent les mêmes rues.' },
  { icone: 'courbe', titre: 'Ajustez vos prix plat par plat', texte: 'Les plats vendus trop bas repérés, un prix proposé avec ses sources et ce qu’il rapporte pour 100 ventes.' },
  { icone: 'alerte', titre: 'Ajustez vos promos à temps', texte: 'Nouvelle promo, prix changé, nouveau concurrent : vous le voyez à chaque analyse, avant de décider des vôtres.' },
  { icone: 'tablette', titre: 'Tout sur une seule tablette', texte: 'Vos données Uber Eats et Deliveroo au même endroit, sans ouvrir les fiches une par une entre deux services.' },
];

const cibles: { id: string; nom: ImageIA; titre: string; texte: string; alt: string }[] = [
  {
    id: 'pizzerias',
    nom: 'pizzeria',
    titre: 'Pizzerias',
    texte: 'Chaque pizza comparée aux pizzas de même taille autour de vous, sur Uber Eats comme sur Deliveroo.',
    alt: 'Pizzaiolo qui enfourne une pizza dans un four à bois, une tablette de commande posée sur le comptoir',
  },
  {
    id: 'burgers-snacks',
    nom: 'burger',
    titre: 'Burgers et snacks',
    texte: 'Burgers, menus, boissons : chaque article comparé au même article chez les restaurants de votre zone.',
    alt: 'Employée qui ferme un sac de livraison au comptoir d’un restaurant de burgers, à côté d’une tablette de commande',
  },
  {
    id: 'dark-kitchens',
    nom: 'dark-kitchen',
    titre: 'Dark kitchens',
    texte: 'Sans salle ni vitrine, tout se joue sur la fiche : vos prix et votre note face à vos voisins, sur les deux plateformes.',
    alt: 'Cuisine dédiée à la livraison : cuisiniers au travail, sacs de livraison alignés et tablette fixée au mur',
  },
];

const description = `Vos données Uber Eats et Deliveroo sur une seule tablette : voyez vos concurrents, ajustez vos prix et vos promos. Dès ${PRIX_ENTREE} € HT par mois.`;

const video = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'Deliview en 1 minute',
  description: 'Présentation de Deliview : vos fiches Uber Eats et Deliveroo réunies, la veille de vos concurrents, un prix suggéré pour chaque plat et les alertes.',
  thumbnailUrl: SITE.url + '/video/deliview-video-couverture-16x9.webp',
  uploadDate: '2026-10-01',
  duration: 'PT1M10S',
  contentUrl: SITE.url + '/video/deliview-video-16x9.mp4',
  width: 1920,
  height: 1080,
  inLanguage: 'fr-FR',
};
---

<Base
  title="Logiciel restaurant Uber Eats et Deliveroo | Deliview"
  description={description}
  jsonld={[jsonldLogiciel(SITE.definition, SITE.url + '/'), video]}
  precharger="/video/deliview-video-couverture-16x9.webp"
>
  <!-- Hero : promesse de rentabilité, deux boutons, réducteur de risque, vidéo de présentation à droite. -->
  <section class="relative overflow-hidden bg-white">
    <div aria-hidden="true" class="pointer-events-none absolute -right-40 -top-40 hidden h-[560px] w-[560px] rounded-full bg-blue-2/12 md:block"></div>
    <div class="dv-container relative grid items-center gap-x-12 gap-y-10 pb-14 pt-8 md:pb-20 md:pt-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.05fr)]">
      <div>
        <p class="dv-overline dv-muted">{SITE.slogan}</p>
        <h1 class="dv-h1 mt-3 md:mt-4 max-w-[15ch]">Augmentez votre rentabilité sur Uber Eats et Deliveroo</h1>
        <p class="dv-lead mt-5 max-w-[54ch]">{SITE.definition}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a href="#demo" class="dv-btn dv-btn-plein sm:whitespace-nowrap" data-cta="hero" data-cta-principal>Demander une démo</a>
          <a href={lien('/simulateur/')} class="dv-btn dv-btn-contour sm:whitespace-nowrap">Simuler ma rentabilité</a>
        </div>
        <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-1 text-[15px] font-semibold">
          <span>Sans engagement</span><span aria-hidden="true">·</span><span>Mise en place offerte</span><span aria-hidden="true">·</span><span>Dès {PRIX_ENTREE}&nbsp;€&nbsp;HT par mois</span>
        </p>
      </div>
      <HeroVideo />
    </div>
  </section>

  <BandeauPlateformes fond="gris" />

  <!-- Le problème : la situation au comptoir (illustration IA) et trois difficultés vécues. -->
  <section class="dv-section bg-white" aria-labelledby="probleme-titre">
    <div class="dv-container">
      <p class="dv-overline dv-muted">Le problème</p>
      <h2 id="probleme-titre" class="dv-h2 mt-3 max-w-[22ch]">Deux tablettes, et toujours pas de vue d’ensemble</h2>
      <p class="dv-lead mt-4 max-w-[60ch]">Uber Eats d’un côté, Deliveroo de l’autre, les prix des voisins nulle part. Vos clients, eux, comparent tout en quelques secondes.</p>
      <div class="mt-10 grid items-center gap-8 lg:grid-cols-[1.05fr_1fr] lg:gap-12">
        <PhotoIA
          nom="rush-tablettes"
          alt="Comptoir de pizzeria en plein service : trois tablettes de commande côte à côte, des tickets et des sacs de livraison"
          sizes="(min-width: 1200px) 590px, (min-width: 1024px) 50vw, 100vw"
          ratio="3 / 2"
        />
        <ul class="space-y-6">
          {
            douleurs.map((d) => (
              <li class="flex gap-4">
                <span class="inline-flex h-12 w-12 shrink-0 items-center justify-center rounded-[12px] bg-blue/10 text-blue">
                  <Icone nom={d.icone} />
                </span>
                <div>
                  <h3 class="dv-h3">{d.titre}</h3>
                  <p class="mt-1 dv-muted">{d.texte}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <!-- Comment ça marche : trois étapes numérotées + vraie capture du tableau de bord sur tablette. -->
  <section id="comment-ca-marche" class="dv-section bg-grey" aria-labelledby="etapes-titre">
    <div class="dv-container grid items-center gap-12 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <p class="dv-overline dv-muted">Comment ça marche</p>
        <h2 id="etapes-titre" class="dv-h2 mt-3 max-w-[18ch]">De vos données à une livraison plus rentable</h2>
        <p class="dv-lead mt-4 max-w-[52ch]">Rien à installer, aucun identifiant à donner&nbsp;: Deliview part des informations publiques de vos fiches. Il s’ouvre sur votre tablette, votre ordinateur ou votre téléphone.</p>
        <ol class="mt-8 space-y-6">
          {
            etapes.map((e, i) => (
              <li class="flex gap-4">
                <span class="dv-figure w-12 shrink-0 text-blue" aria-hidden="true">{i + 1}</span>
                <span>
                  <span class="block dv-h3">{e.titre}</span>
                  <span class="mt-1 block dv-muted">{e.texte}</span>
                </span>
              </li>
            ))
          }
        </ol>
        <p class="mt-8">
          <a href={lien('/integrations/')} class="inline-flex items-center gap-2 text-[19px] font-bold underline underline-offset-4">
            Voir les plateformes compatibles <Icone nom="fleche" taille={20} />
          </a>
        </p>
      </div>
      <CaptureTablette
        src="/images/capture-tableau"
        largeurs={[800, 1300]}
        largeur={1300}
        hauteur={812}
        alt="Tableau de bord Deliview sur une tablette : vos fiches Uber Eats et Deliveroo côte à côte, avec votre note, votre prix médian et votre rang dans la zone, puis les actions à fort impact plat par plat"
        sizes="(min-width: 1200px) 620px, (min-width: 1024px) 50vw, 100vw"
      />
    </div>
  </section>

  <!-- Les 4 piliers, chacun avec sa page. -->
  <section class="dv-section bg-white" aria-labelledby="piliers-titre">
    <div class="dv-container">
      <p class="dv-overline dv-muted">Nos fonctionnalités</p>
      <h2 id="piliers-titre" class="dv-h2 mt-3 max-w-[24ch]">Vos prix, votre carte et votre note face à votre zone</h2>
      <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          PILIERS.map((p) => (
            <li class="dv-card flex flex-col p-6 md:p-8">
              <div class="flex flex-wrap items-center gap-3">
                <span class="inline-flex h-11 w-11 items-center justify-center rounded-[12px] bg-blue/10 text-blue">
                  <Icone nom={p.icone} taille={22} />
                </span>
                <p class="dv-overline">{p.surtitre}</p>
              </div>
              <h3 class="dv-h3 mt-4">{p.titre}</h3>
              <p class="mt-2 flex-1 dv-muted">{p.phrase}</p>
              <a href={lien(`/solution/${p.slug}/`)} class="mt-5 inline-flex items-center gap-2 font-bold underline underline-offset-4">
                Voir {p.surtitre.toLowerCase()} <Icone nom="fleche" taille={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Bénéfices + simulateur (motif Flynt) : à gauche l'appel au simulateur, à droite 4 bénéfices sans chiffre inventé. -->
  <section class="dv-section bg-grey" aria-labelledby="benefices-titre">
    <div class="dv-container grid items-center gap-12 lg:grid-cols-[0.9fr_1.1fr]">
      <div>
        <p class="inline-flex rounded-[10px] border-2 border-blue px-4 py-1.5 dv-overline">Simulateur de rentabilité</p>
        <h2 id="benefices-titre" class="dv-h2 mt-5 max-w-[16ch]">Vos prix, votre premier levier de rentabilité</h2>
        <p class="mt-8">
          <a href={lien('/simulateur/')} class="inline-flex items-center gap-2 text-[19px] font-bold text-blue underline-offset-4 hover:underline">
            Simulez votre gain en moins d’une minute <Icone nom="fleche" taille={20} />
          </a>
        </p>
      </div>
      <ul class="grid gap-x-10 sm:grid-cols-2">
        {
          benefices.map((b, i) => (
            <li class={`border-grey-2/20 py-6 ${i === 1 ? 'border-t sm:border-t-0' : i >= 2 ? 'border-t' : ''}`}>
              <span class="text-blue"><Icone nom={b.icone} taille={26} /></span>
              <h3 class="dv-h3 mt-3">{b.titre}</h3>
              <p class="mt-2 text-[16px] dv-muted">{b.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Pour qui : les trois profils de la cible, illustrés (images IA, origine indiquée dans les mentions légales). -->
  <section id="pour-qui" class="dv-section bg-white" aria-labelledby="cibles-titre">
    <div class="dv-container">
      <p class="dv-overline dv-muted">Pour qui</p>
      <h2 id="cibles-titre" class="dv-h2 mt-3 max-w-[24ch]">Pour les restaurants qui comptent sur Uber Eats et Deliveroo</h2>
      <p class="dv-lead mt-4 max-w-[60ch]">Indépendants, dark kitchens ou petites chaînes&nbsp;: chaque plat est comparé au même plat chez les restaurants de votre zone.</p>
      <ul class="mt-10 grid gap-6 md:grid-cols-3">
        {
          cibles.map((c) => (
            <li id={c.id} class="dv-card flex flex-col overflow-hidden scroll-mt-28">
              <PhotoIA nom={c.nom} alt={c.alt} sizes="(min-width: 1200px) 370px, (min-width: 768px) 31vw, 100vw" ratio="4 / 3" cadre="carte" />
              <div class="p-6">
                <h3 class="dv-h3">{c.titre}</h3>
                <p class="mt-2 dv-muted">{c.texte}</p>
              </div>
            </li>
          ))
        }
      </ul>
      <p id="chaines" class="mt-8 scroll-mt-28 font-semibold">
        Plusieurs établissements&nbsp;? Chacun est comparé aux restaurants de sa propre zone, et les offres
        <a href={lien('/tarifs/')} class="underline underline-offset-2">Pro et Premium</a> couvrent jusqu’à 10&nbsp;restaurants.
      </p>
    </div>
  </section>

  <BlocFondateur fond="gris" />

  {
    articles.length > 0 && (
      <section class="dv-section bg-white" aria-labelledby="ressources-titre">
        <div class="dv-container">
          <div class="flex flex-wrap items-end justify-between gap-4">
            <div>
              <p class="dv-overline dv-muted">Ressources</p>
              <h2 id="ressources-titre" class="dv-h2 mt-3">Guides pour vendre mieux en livraison</h2>
            </div>
            <a href={lien('/ressources/')} class="font-bold underline underline-offset-4">
              Toutes les ressources
            </a>
          </div>
          <ul class="mt-10 grid gap-6 md:grid-cols-3">
            {articles.map((a) => (
              <li class="dv-card flex flex-col p-6">
                <p class="dv-overline dv-muted">{THEMES[a.data.theme]}</p>
                <h3 class="dv-h3 mt-3">
                  <a href={lien(`/ressources/${a.id}/`)} class="hover:underline">
                    {a.data.titre}
                  </a>
                </h3>
                <p class="mt-2 flex-1 text-[16px] dv-muted">{a.data.description}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <Faq questions={FAQ_ACCUEIL} filet lien={{ href: lien('/questions-frequentes/'), libelle: 'Toutes les questions fréquentes' }} />

  <SectionDemo section="accueil-formulaire" />
</Base>
