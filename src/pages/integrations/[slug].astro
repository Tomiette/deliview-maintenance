---
// Page par plateforme (motif Zapier) : ce que Deliview lit aujourd'hui, ce qui arrive, comment démarrer, FAQ.
import Base from '../../layouts/Base.astro';
import SectionDemo from '../../components/SectionDemo.astro';
import Faq from '../../components/Faq.astro';
import Icone from '../../components/Icone.astro';
import { PLATEFORMES, SITE, jsonldLogiciel, lien } from '../../lib/site';

export function getStaticPaths() {
  return PLATEFORMES.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}

const { slug } = Astro.props as { slug: string };
const p = PLATEFORMES.find((x) => x.slug === slug)!;
const autres = PLATEFORMES.filter((x) => x.slug !== slug);

const SOURCE_UBER_DIRECT = 'https://merchants.ubereats.com/fr/fr/services/uber-direct/';

const CONTENU: Record<string, { title: string; description: string; h1: string; lead: string; etapes?: { titre: string; texte: string }[]; encart?: string; faq: { q: string; r: string }[] }> = {
  'uber-eats': {
    title: 'Uber Eats : vos prix face à vos concurrents | Deliview',
    description:
      'Deliview lit votre fiche Uber Eats et celles des restaurants autour de vous : prix de toute la carte, notes, avis, offres. Sans identifiant à donner.',
    h1: 'Uber Eats : vos prix et votre note face à votre zone',
    lead: 'Deliview retrouve votre fiche Uber Eats à partir du nom et de la ville de votre restaurant, puis la compare aux fiches des restaurants autour de vous.',
    etapes: [
      { titre: 'Donnez le nom et la ville du restaurant', texte: 'Ajoutez l’adresse si plusieurs établissements portent le même nom.' },
      { titre: 'Deliview retrouve votre fiche', texte: 'Il lit toute votre carte, votre note, vos avis et vos offres.' },
      { titre: 'L’analyse de votre zone suit', texte: 'Vos prix et votre note face aux restaurants autour de vous, en quelques minutes.' },
    ],
    faq: [
      {
        q: 'Faut-il donner mes identifiants Uber Eats ?',
        r: 'Non. Deliview lit les informations publiques de votre fiche&nbsp;: prix, note, nombre d’avis, offres. Aucun accès à votre espace restaurant n’est demandé.',
      },
      {
        q: 'Deliview est-il un partenaire officiel d’Uber Eats ?',
        r: 'Non. Deliview est un logiciel indépendant. La connexion officielle à votre compte, pour les commandes et les menus, arrivera plus tard.',
      },
      {
        q: 'Et si mon restaurant n’est que sur Uber Eats ?',
        r: 'Deliview fonctionne aussi avec une seule plateforme&nbsp;: l’analyse porte alors sur Uber Eats uniquement.',
      },
    ],
  },
  deliveroo: {
    title: 'Deliveroo : vos prix face à vos concurrents | Deliview',
    description:
      'Deliview lit votre fiche Deliveroo et celles de votre zone : prix, notes, offres, et les écarts avec votre fiche Uber Eats. Sans identifiant à donner.',
    h1: 'Deliveroo : vos prix et votre note face à votre zone',
    lead: 'Les mêmes analyses que sur Uber Eats, plus les écarts de prix entre vos deux fiches, plat par plat.',
    etapes: [
      { titre: 'Donnez le nom et la ville du restaurant', texte: 'Ajoutez l’adresse si plusieurs établissements portent le même nom.' },
      { titre: 'Deliview retrouve votre fiche', texte: 'Il lit toute votre carte, votre note, vos avis et vos offres.' },
      { titre: 'L’analyse de votre zone suit', texte: 'Vos prix et votre note face aux restaurants autour de vous, en quelques minutes.' },
    ],
    faq: [
      {
        q: 'Faut-il donner mes identifiants Deliveroo ?',
        r: 'Non. Deliview lit les informations publiques de votre fiche&nbsp;: prix, note, nombre d’avis, offres. Aucun accès à votre espace restaurant n’est demandé.',
      },
      {
        q: 'Deliview est-il un partenaire officiel de Deliveroo ?',
        r: 'Non. Deliview est un logiciel indépendant. La connexion officielle à votre compte, pour les commandes et les menus, arrivera plus tard.',
      },
      {
        q: 'Mes prix ne sont pas les mêmes sur Deliveroo et sur Uber Eats. Deliview le voit-il ?',
        r: 'Oui. Deliview liste les plats vendus à un prix différent sur vos deux fiches, avec les deux prix. À vous de voir lesquels sont voulus.',
      },
    ],
  },
  'uber-direct': {
    title: 'Uber Direct : livrer les commandes de votre site | Deliview',
    description:
      'Bientôt dans Deliview : les commandes de votre propre site livrées par Uber Direct, suivies au même endroit que vos commandes Uber Eats et Deliveroo.',
    h1: 'Uber Direct : livrez les commandes de votre propre site',
    lead: 'Vos clients commandent chez vous, sur votre site ou par téléphone. Un coursier Uber livre. Deliview réunira ces livraisons avec vos commandes Uber Eats et Deliveroo.',
    encart: `D’après Uber, Uber Direct est une «&nbsp;solution de livraison à la demande pour les entreprises qui reçoivent des commandes via leur site web, application ou téléphone&nbsp;». Le commerçant paie un montant fixe par livraison, à partir de 5,90&nbsp;€&nbsp;HT selon la distance, le type de commande et le délai (<a href="${SOURCE_UBER_DIRECT}" rel="noopener">page Uber Direct</a>, consultée le 1er&nbsp;octobre 2026).`,
    faq: [
      {
        q: 'Uber Direct remplace-t-il Uber Eats ?',
        r: 'Non, ce sont deux services différents. Sur Uber Eats, les clients vous trouvent dans l’appli d’Uber. Avec Uber Direct, ils commandent chez vous et Uber se charge seulement de la livraison.',
      },
      {
        q: 'Combien coûte une livraison Uber Direct ?',
        r: `Selon Uber, à partir de 5,90&nbsp;€&nbsp;HT par livraison, avec un prix qui varie selon la distance, le type de commande et le délai (<a href="${SOURCE_UBER_DIRECT}" rel="noopener">source</a>). Deliview vous montrera ce coût par commande, face aux commissions des plateformes.`,
      },
      {
        q: 'Quand Uber Direct arrive-t-il dans Deliview ?',
        r: 'Après les commandes Uber Eats et Deliveroo. Les restaurants abonnés seront prévenus en premier.',
      },
    ],
  },
};
const c = CONTENU[slug];
---

<Base
  title={c.title}
  description={c.description}
  ariane={[
    { nom: 'Intégrations', chemin: '/integrations/' },
    { nom: p.nom, chemin: `/integrations/${p.slug}/` },
  ]}
  jsonld={[jsonldLogiciel(c.description, `${SITE.url}/integrations/${p.slug}/`)]}
>
  <section class="bg-white">
    <div class="dv-container pb-12 pt-8 md:pb-16 md:pt-12">
      <div class="flex flex-wrap items-center gap-3">
        <p class="dv-overline dv-muted">Intégration</p>
        <span class={`dv-badge ${p.statut === 'bientot' ? 'dv-badge-bientot' : 'dv-badge-dispo'}`}>{p.statut === 'bientot' ? 'Bientôt' : 'Disponible'}</span>
      </div>
      <h1 class="dv-h1 mt-4 max-w-[20ch]">{c.h1}</h1>
      <p class="dv-lead mt-5 max-w-[60ch]">{c.lead}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#demo" class="dv-btn dv-btn-plein" data-cta={`integration-${p.slug}`} data-cta-principal>
          Demander une démo
        </a>
        <a href={lien('/integrations/')} class="dv-btn dv-btn-contour">Toutes les intégrations</a>
      </div>
    </div>
  </section>

  {
    c.encart && (
      <section class="bg-white pb-12" aria-label="Uber Direct en bref">
        <div class="dv-container">
          <p class="dv-card max-w-[80ch] bg-grey p-6 md:p-8" set:html={c.encart} />
        </div>
      </section>
    )
  }

  <section class="dv-section bg-grey" aria-labelledby="perimetre-titre">
    <div class="dv-container">
      <h2 id="perimetre-titre" class="dv-h2 max-w-[24ch]">Ce que Deliview fait avec {p.nom}</h2>
      <div class={`mt-10 grid gap-6 ${p.disponible.length ? 'md:grid-cols-2' : ''}`}>
        {
          p.disponible.length > 0 && (
            <div class="dv-card p-6 md:p-8">
              <div class="flex items-center gap-3">
                <h3 class="dv-h3">Aujourd’hui</h3>
                <span class="dv-badge dv-badge-dispo">Disponible</span>
              </div>
              <ul class="mt-5 space-y-3">
                {p.disponible.map((x) => (
                  <li class="flex gap-3">
                    <span class="mt-1 text-blue"><Icone nom="check" taille={20} /></span>
                    {x}
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="dv-card p-6 md:p-8">
          <div class="flex items-center gap-3">
            <h3 class="dv-h3">Ensuite</h3>
            <span class="dv-badge dv-badge-bientot">Bientôt</span>
          </div>
          <ul class="mt-5 space-y-3">
            {
              p.bientot.map((x) => (
                <li class="flex gap-3">
                  <span class="mt-1 dv-muted"><Icone nom="horloge" taille={20} /></span>
                  {x}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  {
    c.etapes && (
      <section class="dv-section bg-white" aria-labelledby="demarrer-titre">
        <div class="dv-container">
          <h2 id="demarrer-titre" class="dv-h2">Démarrer avec {p.nom}</h2>
          <ol class="mt-10 grid gap-8 md:grid-cols-3">
            {c.etapes.map((e, i) => (
              <li>
                <span class="dv-figure text-blue" aria-hidden="true">{i + 1}</span>
                <h3 class="dv-h3 mt-3">{e.titre}</h3>
                <p class="mt-2 dv-muted">{e.texte}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <Faq questions={c.faq} />

  <section class="dv-section bg-grey" aria-labelledby="autres-integrations">
    <div class="dv-container">
      <h2 id="autres-integrations" class="dv-h2">Les autres intégrations</h2>
      <ul class="mt-8 grid gap-6 md:grid-cols-3">
        {
          autres.map((x) => (
            <li class="dv-card flex flex-col p-6">
              <div class="flex items-center justify-between gap-3">
                <p class="text-[22px] font-bold">{x.nom}</p>
                <span class={`dv-badge ${x.statut === 'bientot' ? 'dv-badge-bientot' : 'dv-badge-dispo'}`}>{x.statut === 'bientot' ? 'Bientôt' : 'Disponible'}</span>
              </div>
              <p class="mt-3 flex-1 dv-muted">{x.resume}</p>
              <a href={lien(`/integrations/${x.slug}/`)} class="mt-4 inline-flex items-center gap-2 font-bold underline underline-offset-4">
                Voir {x.nom} <Icone nom="fleche" taille={18} />
              </a>
            </li>
          ))
        }
        <li class="dv-card flex flex-col p-6">
          <p class="text-[22px] font-bold">Uber Eats et Deliveroo ensemble</p>
          <p class="mt-3 flex-1 dv-muted">Vos deux fiches côte à côte, et bientôt vos commandes sur la même tablette.</p>
          <a href={lien('/integrations/uber-eats-et-deliveroo/')} class="mt-4 inline-flex items-center gap-2 font-bold underline underline-offset-4">
            Voir les deux ensemble <Icone nom="fleche" taille={18} />
          </a>
        </li>
      </ul>
      <p class="mt-8 text-[15px] dv-muted">Uber Eats, Uber Direct et Deliveroo sont des marques de leurs propriétaires respectifs. Deliview est un logiciel indépendant, ni affilié ni approuvé par ces sociétés.</p>
    </div>
  </section>

  <SectionDemo section={`integration-${p.slug}-formulaire`} />
</Base>
