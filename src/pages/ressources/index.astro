---
// Ressources : articles classés par thème, du plus récent au plus ancien. Refonte en relief du 3 octobre 2026 ;
// 6 octobre 2026 : une photo par article sur chaque carte (CarteArticle, la même carte partout sur le site).
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionDemo from '../../components/SectionDemo.astro';
import Pastille from '../../components/Pastille.astro';
import CarteArticle from '../../components/CarteArticle.astro';
import Fleche from '../../icons/fleche.astro';
import { PILIERS, THEMES, lien } from '../../lib/site';

const articles = (await getCollection('ressources', (a) => !a.data.brouillon)).sort((a, b) => b.data.misAJourLe.getTime() - a.data.misAJourLe.getTime());
const parTheme = Object.entries(THEMES)
  .map(([slug, nom]) => ({ slug, nom, articles: articles.filter((a) => a.data.theme === slug) }))
  .filter((t) => t.articles.length);
const description =
  'Guides pratiques pour les restaurateurs sur Uber Eats et Deliveroo : prix, commissions, promotions, avis. Chaque chiffre est sourcé et daté.';
---

<Base title="Ressources pour restaurateurs en livraison | Deliview" description={description} ariane={[{ nom: 'Ressources', chemin: '/ressources/' }]}>
  <section class="bg-grey pb-12 pt-6 md:pb-16 md:pt-10" aria-labelledby="ressources-titre" data-haut-de-page>
    <div class="dv-container">
      <Pastille>Ressources</Pastille>
      <h1 id="ressources-titre" class="dv-h1 mt-5 max-w-[20ch] md:mt-6">Ressources pour les restaurants sur Uber Eats et Deliveroo</h1>
      <p class="dv-lead mt-4 max-w-[60ch] md:mt-6">Des guides pratiques sur les prix, les commissions, les promotions et les avis en livraison. Chaque chiffre est sourcé et daté.</p>
      {
        parTheme.length > 1 && (
          <nav aria-label="Thèmes" class="mt-8">
            <ul class="flex flex-wrap gap-2">
              {parTheme.map((t) => (
                <li>
                  <a href={`#${t.slug}`} class="dv-puce-lien">
                    {t.nom}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
    </div>
  </section>

  {
    parTheme.length === 0 && (
      <section class="dv-section bg-grey">
        <div class="dv-container">
          <p class="dv-lead">Les premiers guides arrivent très vite.</p>
        </div>
      </section>
    )
  }

  {
    parTheme.map((t, i) => (
      <section id={t.slug} class={`dv-section scroll-mt-20 ${i % 2 === 0 ? 'bg-white' : 'bg-grey dv-points'}`} aria-labelledby={`theme-${t.slug}`}>
        <div class="dv-container">
          <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2">
            <h2 id={`theme-${t.slug}`} class="dv-h2">{t.nom}</h2>
            {/* Thème sans page pilier (« Gestion au quotidien », identifiant commandes) : Deliview ne gère pas les commandes, le lien mène à la vue d'ensemble. */}
            {PILIERS.some((p) => p.slug === t.slug) ? (
              <a href={lien(`/solution/${t.slug}/`)} class="dv-lien-fort">
                Voir {t.nom.toLowerCase()} dans Deliview<Fleche taille={24} />
              </a>
            ) : (
              <a href={lien('/solution/')} class="dv-lien-fort">
                Voir ce que fait Deliview<Fleche taille={24} />
              </a>
            )}
          </div>
          <ul class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            {t.articles.map((a) => (
              <CarteArticle article={a} />
            ))}
          </ul>
        </div>
      </section>
    ))
  }

  <SectionDemo section="ressources-formulaire" />
</Base>
