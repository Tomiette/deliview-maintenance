---
// Hero de l'accueil : vidéo de présentation en paysage (16:9), à droite du texte (comme Flynt).
// 1 min 10, sans voix off, avec musique. Seul l'aperçu (45 Ko) se charge avec la page ; la vidéo
// (5 à 7 Mo) ne se télécharge qu'au clic et se lance avec le son, jamais en automatique.
// Toute l'image est cliquable ; la pastille blanche « Voir la vidéo » laisse au hero un seul bouton plein.
// Sans JavaScript, les contrôles natifs restent affichés. Le texte de la vidéo est repris dessous.
import { lien } from '../lib/site';

interface Props {
  class?: string;
}
const { class: classe = '' } = Astro.props;

const texte = [
  'Bon, j’ai 1 minute pour vous convaincre. Alors je vous la fais courte.',
  'Restaurateur, on vous a promis que la livraison serait rentable. Eh oui.',
  'Mais au quotidien ? Trop de tablettes. Pas le temps de tout analyser. Trop de concurrents. Trop de promos.',
  'Et surtout : être présent, mais être rentable… non.',
  'Alors on a créé Deliview. Toutes vos données livraison centralisées : votre carte, vos avis, vos concurrents, leurs prix.',
  'Deliview surveille vos concurrents : leurs prix, leurs notes, leurs promos.',
  'Et surtout, Deliview vous dit quoi faire : un prix suggéré pour chaque plat, face au prix de la zone.',
  'L’IA Deliview vous rend plus visible, plus rentable. À la question « Que font mes concurrents dans ma zone ? », elle répond par exemple : « Napoli Express lance −30 % sur ses pizzas. Passez votre Margherita à 10,90 € pour rester bien référencé et compétitif. »',
  'Et dès que ça bouge, Deliview vous alerte : promotions des concurrents, changements de prix, nouveau concurrent, avis négatif reçu.',
  'Résultat : vous réagissez immédiatement. Pas la semaine d’après.',
  'Deliview : votre activité livraison sur un seul écran. Demandez une démo sur deliview.fr.',
];
---

<div class={`hv ${classe}`}>
  <figure class="m-0">
    <div class="hv-cadre">
      <video
        class="hv-lecteur"
        controls
        playsinline
        preload="none"
        width="1920"
        height="1080"
        poster={lien('/video/deliview-video-hero-16x9.webp')}
        aria-label="Vidéo de présentation de Deliview, 1 minute 10, sans voix off"
        aria-describedby="hv-legende"
      >
        <source src={lien('/video/deliview-video-16x9.webm')} type='video/webm; codecs="vp9, opus"' />
        <source src={lien('/video/deliview-video-16x9.mp4')} type="video/mp4" />
        <a href={lien('/video/deliview-video-16x9.mp4')}>Télécharger la vidéo de présentation (MP4, 7 Mo)</a>
      </video>
      <button class="hv-lire" type="button" aria-label="Voir la vidéo, 1 min 10" hidden>
        <span class="hv-pastille">
          <span class="hv-icone" aria-hidden="true">
            <svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
          </span>
          Voir la vidéo
        </span>
      </button>
    </div>
    <figcaption id="hv-legende" class="hv-legende">1&nbsp;min&nbsp;10 · Restaurants et chiffres d’exemple</figcaption>
  </figure>
  <details class="hv-texte">
    <summary>Lire le contenu de la vidéo</summary>
    <ol>
      {texte.map((t) => <li>{t}</li>)}
    </ol>
  </details>
</div>

<script>
  // Lecture au clic, avec le son. À la fin, retour à l'aperçu et à la pastille.
  document.querySelectorAll<HTMLElement>('.hv-cadre').forEach((cadre) => {
    const video = cadre.querySelector('video');
    const bouton = cadre.querySelector<HTMLButtonElement>('.hv-lire');
    if (!video || !bouton) return;
    video.controls = false;
    bouton.hidden = false;
    const lire = () => {
      bouton.hidden = true;
      video.controls = true;
      void video.play();
      video.focus();
    };
    bouton.addEventListener('click', lire);
    video.addEventListener('ended', () => {
      video.controls = false;
      video.load();
      bouton.hidden = false;
      bouton.focus();
    });
  });
</script>

<style>
  .hv {
    width: 100%;
    max-width: 720px;
    margin-inline: auto;
  }
  .hv-cadre {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    border-radius: 20px;
    overflow: hidden;
    container-type: inline-size;
    background: var(--color-grey);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-grey-2) 8%, transparent),
      0 18px 44px rgba(76, 76, 76, 0.14);
  }
  .hv-lecteur {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hv-lire {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    background: transparent;
    cursor: pointer;
  }
  .hv-lire[hidden] {
    display: none;
  }
  /* Pastille placée dans la colonne gauche de l'aperçu, sous « 12 concurrents détectés » ; elle suit la taille de la vidéo. */
  .hv-pastille {
    position: absolute;
    left: 22.9%;
    top: 68%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    gap: max(6px, 1.4cqw);
    height: 40px;
    height: max(32px, 6.6cqw);
    padding: 0 16px 0 5px;
    padding: 0 max(12px, 2.8cqw) 0 max(4px, 0.9cqw);
    border: 1px solid color-mix(in srgb, var(--color-grey-2) 10%, transparent);
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-grey-2);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 15px;
    font-size: max(14px, 2.8cqw);
    line-height: 1;
    white-space: nowrap;
    box-shadow: 0 10px 26px rgba(76, 76, 76, 0.22);
    transition: transform 0.15s ease;
  }
  .hv-lire:hover .hv-pastille {
    transform: translateX(-50%) scale(1.05);
  }
  .hv-lire:focus-visible {
    outline: none;
  }
  /* Focus visible même sur l'aperçu clair : contour Blue 1 entouré de blanc. */
  .hv-lire:focus-visible .hv-pastille {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
    box-shadow: 0 0 0 6px var(--color-white);
  }
  .hv-icone {
    display: grid;
    place-items: center;
    width: 28px;
    width: max(22px, 4.8cqw);
    height: 28px;
    height: max(22px, 4.8cqw);
    border-radius: 50%;
    background: var(--color-blue);
    color: var(--color-white);
  }
  .hv-icone svg {
    width: 55%;
    height: 55%;
  }
  .hv-legende {
    margin-top: 12px;
    text-align: center;
    font-size: 14px;
    color: color-mix(in srgb, var(--color-grey-2) 82%, transparent);
  }
  .hv-texte {
    margin-top: 6px;
    text-align: center;
    font-size: 14px;
  }
  .hv-texte summary {
    display: inline-block;
    cursor: pointer;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .hv-texte ol {
    margin: 12px auto 0;
    max-width: 60ch;
    padding-left: 1.25em;
    list-style: decimal;
    text-align: left;
    color: color-mix(in srgb, var(--color-grey-2) 82%, transparent);
  }
  .hv-texte li + li {
    margin-top: 6px;
  }
  @media (max-width: 767px) {
    .hv-cadre {
      border-radius: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hv-pastille {
      transition: none;
    }
  }
</style>
