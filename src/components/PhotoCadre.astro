---
// Vraie photo dans un cadre blanc en relief, légèrement incliné, sa légende en puce posée devant (Qui sommes-nous,
// histoire de Deliview, 7 octobre 2026). Photos des posts LinkedIn de Tom (public/images/linkedin/, 360 et 720 px).
// Option `plateformes` (demande de Tom, 7 octobre, 13 h 12) : les logos officiels d'Uber Eats et de Deliveroo
// flottent sur le côté droit de la photo, comme sur la page Affiliation. Décoratifs (masqués aux lecteurs d'écran).
import { lien } from '../lib/site';
import { logoPlateforme } from '../lib/logos';

interface Props {
  fichier: string; // nom de base dans public/images/linkedin/
  largeur: number;
  hauteur: number;
  alt: string;
  legende?: string;
  inclinaison?: number; // en degrés
  priorite?: boolean; // image du haut de page
  plateformes?: boolean; // logos d'Uber Eats et de Deliveroo qui flottent à droite
  class?: string;
}
const { fichier, largeur, hauteur, alt, legende, inclinaison = -2, priorite = false, plateformes = false, class: classe = '' } = Astro.props;
const src = (l: number) => lien(`/images/linkedin/${fichier}-${l}.webp`);
const logoUber = logoPlateforme('uber-eats');
const logoDeliveroo = logoPlateforme('deliveroo');
---

<div class={`dv-photo-scene ${classe}`}>
<figure class="dv-photo-cadre" style={`--incl:${inclinaison}deg`}>
  <img
    src={src(720)}
    srcset={`${src(360)} 360w, ${src(720)} 720w`}
    sizes="(min-width: 768px) 300px, 72vw"
    width={largeur}
    height={hauteur}
    alt={alt}
    loading={priorite ? 'eager' : 'lazy'}
    fetchpriority={priorite ? 'high' : undefined}
    decoding="async"
  />
  {
    legende && (
      <figcaption class="dv-photo-cadre-legende">
        <span class="dv-puce">
          <i />
          {legende}
        </span>
      </figcaption>
    )
  }
</figure>
{
  plateformes && (
    <div class="dv-photo-plateformes" aria-hidden="true">
      <span class="dv-puce dv-photo-logo dv-photo-logo-uber">
        {logoUber ? <img class="dv-puce-logo" src={logoUber.src} alt="" width={logoUber.largeur} height={logoUber.hauteur} /> : <i />}
        Uber&nbsp;Eats
      </span>
      <span class="dv-puce dv-photo-logo dv-photo-logo-deliveroo">
        {logoDeliveroo ? <img class="dv-puce-logo" src={logoDeliveroo.src} alt="" width={logoDeliveroo.largeur} height={logoDeliveroo.hauteur} /> : <i />}
        Deliveroo
      </span>
    </div>
  )
}
</div>

<style>
  /* Scène : le cadre incliné, et à côté les logos (droits, hors du cadre : pas de transformations imbriquées). */
  .dv-photo-scene {
    position: relative;
    width: min(100%, 300px);
  }
  .dv-photo-cadre {
    position: relative;
    margin: 0;
    width: 100%;
    padding: 10px;
    border: 1px solid var(--dv-bord);
    border-radius: 22px;
    background: var(--color-white);
    box-shadow: 0 5px 0 var(--dv-levre), var(--dv-ombre-flottante);
    rotate: var(--incl);
  }
  /* La photo seulement (pas les logos des puces). */
  .dv-photo-cadre > img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 13px;
  }
  .dv-photo-cadre-legende {
    position: absolute;
    left: -16px;
    bottom: -20px;
    rotate: calc(var(--incl) * -1);
  }
  .dv-photo-cadre-legende .dv-puce {
    gap: 8px;
    padding: 9px 16px;
    font-size: 15px;
    box-shadow: 0 4px 0 var(--dv-levre), var(--dv-ombre-flottante);
  }
  .dv-photo-cadre-legende .dv-puce i {
    width: 8px;
    height: 8px;
  }
  /* Logos des plateformes : à cheval sur le bord droit du cadre, ils montent et descendent doucement, chacun à son
     rythme (sauf si le visiteur a demandé moins d'animations). */
  .dv-photo-plateformes {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .dv-photo-logo {
    position: absolute;
    right: -6px;
    gap: 8px;
    padding: 8px 14px 8px 8px;
    font-size: 15px;
    box-shadow: 0 4px 0 var(--dv-levre), var(--dv-ombre-flottante);
  }
  .dv-photo-logo :global(.dv-puce-logo) {
    width: auto;
    height: 26px;
    border-radius: 7px;
  }
  .dv-photo-logo-uber {
    top: 12%;
    --duree: 6.4s;
    --delai: -1s;
  }
  .dv-photo-logo-deliveroo {
    top: 31%;
    right: -12px;
    --duree: 7.4s;
    --delai: -3.5s;
  }
  /* Grand écran seulement : les logos débordent davantage du cadre (en dessous, la photo touche presque le bord de
     l'écran et ils le dépasseraient). */
  @media (min-width: 1200px) {
    .dv-photo-logo {
      right: -22px;
    }
    .dv-photo-logo-deliveroo {
      right: -40px;
    }
  }
  :global(.dv-mouvement) .dv-photo-logo {
    animation: dv-flotte-px var(--duree) ease-in-out var(--delai) infinite alternate;
  }
</style>
