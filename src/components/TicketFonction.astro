---
// Ticket d'une fonction (6 octobre 2026, demande de Tom : chaque fonction claire en un coup d'œil, sans trop de texte).
// Le même ticket que l'exemple Margherita (TicketComparaison) : en tête ce que montre l'app et la plateforme (logo
// officiel), un titre, deux lignes alignées, le chiffre qui compte en grand, ce que ça change, et en note d'où viennent
// les chiffres (vraies captures de l'app : analyse anonymisée ou compte de démonstration).
// Marqueur facultatif : un seul par section (règle du marqueur), donc absent quand trois tickets sont côte à côte.
import Ticket from './Ticket.astro';
import Marqueur from './Marqueur.astro';
import { logoPlateforme } from '../lib/logos';
import type { TicketFonction } from '../lib/site';

interface Props {
  t: TicketFonction;
  inclinaison?: number;
  marqueur?: boolean;
  apparition?: 'defilement' | 'arrivee';
  class?: string;
}

const { t, inclinaison, marqueur = false, apparition = 'defilement', class: classe = '' } = Astro.props;
const logo = t.plateforme ? logoPlateforme(t.plateforme) : null;
const nomPlateforme = t.plateforme === 'deliveroo' ? 'Deliveroo' : t.plateforme === 'uber-eats' ? 'Uber Eats' : '';
---

<Ticket class={`dv-tc dv-tf ${classe}`} papier="dv-tc-papier" inclinaison={inclinaison} apparition={apparition}>
  <p class="dv-ticket-entete dv-tf-entete">
    <span>{t.entete}</span>
    {
      nomPlateforme && (
        <span class="dv-tf-plateforme">
          {logo && <img src={logo.src} alt="" width={logo.largeur} height={logo.hauteur} loading="lazy" decoding="async" />}
          {nomPlateforme}
        </span>
      )
    }
  </p>
  <p class="dv-tc-plat dv-tf-titre">{t.titre}</p>
  <div class="dv-pointilles dv-tc-sep" aria-hidden="true"></div>
  <dl class="dv-tc-lignes">
    {
      t.lignes.map((l) => (
        <>
          <dt>{l.libelle}</dt>
          <dd>{l.valeur}</dd>
        </>
      ))
    }
  </dl>
  <div class="dv-pointilles dv-tc-sep" aria-hidden="true"></div>
  <dl class="dv-tc-ecart">
    <dt>{t.cle.libelle}</dt>
    <dd>
      <span class="dv-tc-chiffre dv-tf-chiffre">{t.cle.valeur}{marqueur && <Marqueur forme="cercle" moment={apparition === 'arrivee' ? 'arrivee' : 'defilement'} />}</span>
    </dd>
  </dl>
  {t.gain && <p class="dv-tc-gain" set:html={t.gain} />}
  <p class="dv-tc-note">{t.note}</p>
</Ticket>
