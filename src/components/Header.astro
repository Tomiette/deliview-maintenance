---
// En-tête collant et flottant (4 octobre 2026, logique de taap.it) : une barre blanche arrondie posée au-dessus de la
// page, le logo, la navigation au centre avec les méga-menus « Solution » et « Ressources » (Intégrations rangée dans Ressources, 4 octobre 2026), « Se connecter » en
// lien souligné et « Demander une démo » en bouton sombre. Le bouton bleu en pastille reste celui des pages.
// Menus en <details> : utilisables sans JavaScript et au clavier (Entrée ou Espace pour ouvrir) ; Échap les ferme.
import Cadenas from '../icons/cadenas.astro';
import Chevron from '../icons/chevron.astro';
import BoutonDemo from './BoutonDemo.astro';
import Menu from '../icons/menu.astro';
import { ICONES, type NomIcone } from '../lib/registre-icones';
import { MENU_RESSOURCES, NAV, PILIERS, SITE, lien } from '../lib/site';

const MENUS: Record<string, { href: string; titre: string; phrase: string; icone?: NomIcone }[]> = {
  solution: PILIERS.map((p) => ({ href: `/solution/${p.slug}/`, titre: p.surtitre, phrase: p.phrase, icone: p.icone })),
  ressources: MENU_RESSOURCES.map((r) => ({ href: r.href, titre: r.libelle, phrase: r.phrase, icone: r.icone })),
};
// Page en cours (sans la base de l'aperçu), pour marquer l'entrée active de la navigation.
const chemin = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const actif = (href: string) => chemin === href;
const dansMenu = (menu: string) =>
  menu === 'solution' ? chemin.startsWith('/solution/') : MENU_RESSOURCES.some((r) => chemin.startsWith(r.href));
---

<header class="dv-entete sticky top-0 z-40">
  <div class="dv-container">
  <div class="dv-entete-barre flex h-16 items-center justify-between gap-4 xl:h-[72px] xl:gap-4">
    <a href={lien('/')} class="flex min-h-12 shrink-0 items-center" aria-label="Deliview, accueil">
      <img src={lien('/images/logo-deliview.svg')} alt="Deliview" width="140" height="27" />
    </a>

    <nav aria-label="Navigation principale" class="hidden flex-1 xl:block">
      <ul class="flex items-center justify-center gap-0 whitespace-nowrap text-[16px] font-medium leading-none">
        {
          NAV.map((item) =>
            item.menu ? (
              <li class="relative">
                <details class="dv-menu group">
                  <summary class={`dv-nav-lien flex min-h-12 cursor-pointer list-none items-center gap-1.5 rounded-[10px] px-3 hover:bg-grey [&::-webkit-details-marker]:hidden ${dansMenu(item.menu) ? 'dv-nav-actif' : ''}`}>
                    {item.libelle}
                    <Chevron taille={24} class="transition-transform group-open:rotate-180" />
                  </summary>
                  <div class="absolute left-0 top-full mt-2 w-[420px] rounded-[16px] border border-grey-2/15 bg-white p-3 shadow-[0_8px_24px_rgba(76,76,76,0.1)]">
                    <ul class="space-y-1">
                      {MENUS[item.menu].map((x) => {
                        const Icone = x.icone ? ICONES[x.icone] : null;
                        return (
                          <li>
                            <a href={lien(x.href)} class="flex gap-3 rounded-xl p-3 hover:bg-grey" aria-current={actif(x.href) ? 'page' : undefined}>
                              {Icone && <Icone taille={32} />}
                              <span class="whitespace-normal">
                                <span class="block font-semibold leading-snug">{x.titre}</span>
                                <span class="mt-1 block text-[15px] font-normal leading-snug dv-muted">{x.phrase}</span>
                              </span>
                            </a>
                          </li>
                        );
                      })}
                    </ul>
                    {item.menu === 'solution' && (
                      <p class="mt-1 border-t border-grey-2/10 px-3 pt-2 text-[16px]">
                        <a href={lien('/solution/')} class="dv-lien">Voir toute la solution</a>
                      </p>
                    )}
                  </div>
                </details>
              </li>
            ) : (
              <li>
                <a href={lien(item.href)} class={`dv-nav-lien flex min-h-12 items-center rounded-[10px] px-3 hover:bg-grey ${chemin.startsWith(item.href) ? 'dv-nav-actif' : ''}`} aria-current={actif(item.href) ? 'page' : undefined}>
                  {item.libelle}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 lg:gap-4">
      <a href={SITE.app} class="hidden min-h-12 items-center px-2 text-[17px] font-medium leading-none whitespace-nowrap rounded-[10px] px-3 hover:bg-grey sm:inline-flex">Se connecter</a>
      <a href={lien('/demo/')} class="dv-btn-sombre hidden sm:inline-flex" data-cta="header">Demander une démo</a>

      <details class="dv-menu xl:hidden">
        <summary class="flex h-12 w-12 cursor-pointer list-none items-center justify-center rounded-[12px] hover:bg-grey [&::-webkit-details-marker]:hidden" aria-label="Ouvrir le menu">
          <Menu taille={32} />
        </summary>
        <div class="fixed inset-x-2 top-[80px] max-h-[calc(100dvh-92px)] overflow-y-auto rounded-[18px] border border-grey-2/15 bg-white px-4 pb-6 pt-2 shadow-[0_12px_32px_rgba(76,76,76,0.12)]">
          <p class="dv-overline pt-3 pb-1">Solution</p>
          <ul>
            {
              PILIERS.map((p) => {
                const Icone = ICONES[p.icone];
                return (
                  <li>
                    <a href={lien(`/solution/${p.slug}/`)} class="flex min-h-12 items-center gap-3 border-b border-grey-2/10 py-2 font-semibold">
                      <Icone taille={32} />
                      {p.surtitre}
                    </a>
                  </li>
                );
              })
            }
            {
              NAV.filter((x) => !x.menu).map((item) => (
                <li>
                  <a href={lien(item.href)} class="flex min-h-12 items-center border-b border-grey-2/10 py-2 font-semibold" aria-current={actif(item.href) ? 'page' : undefined}>
                    {item.libelle}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="dv-overline pt-6 pb-1">Ressources</p>
          <ul>
            {
              MENU_RESSOURCES.map((r) => {
                const Icone = ICONES[r.icone];
                return (
                  <li>
                    <a href={lien(r.href)} class="flex min-h-12 items-center gap-3 border-b border-grey-2/10 py-2 font-semibold" aria-current={actif(r.href) ? 'page' : undefined}>
                      <Icone taille={32} />
                      {r.libelle}
                    </a>
                  </li>
                );
              })
            }
            <li>
              <a href={SITE.app} class="flex min-h-12 items-center gap-2 py-2 font-semibold"><Cadenas taille={24} />Se connecter</a>
            </li>
          </ul>
          <BoutonDemo href={lien('/demo/')} cta="menu-mobile" class="mt-5 w-full" />
        </div>
      </details>
    </div>
  </div>
  </div>
</header>

<style>
  /* Barre flottante : blanche, arrondie, bordure Gris 2 à 12 %, ombre très légère, posée 10 px sous le haut. */
  .dv-entete {
    padding-top: 10px;
  }
  .dv-entete-barre {
    padding-inline: 12px 8px;
    border: 1px solid color-mix(in srgb, var(--color-grey-2) 12%, transparent);
    border-radius: 18px;
    background: var(--color-white);
    box-shadow: 0 6px 24px rgba(76, 76, 76, 0.07);
  }
  @media (min-width: 640px) {
    .dv-entete-barre {
      padding-inline: 18px 10px;
    }
  }
  /* Entrée de la navigation correspondant à la page : soulignée en Bleu 1. */
  .dv-nav-actif {
    text-decoration: underline;
    text-decoration-color: var(--color-blue);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
</style>

<script>
  // Un seul menu ouvert à la fois ; Échap ou un clic ailleurs le referme.
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.dv-menu'));
  menus.forEach((m) =>
    m.addEventListener('toggle', () => {
      if (m.open) menus.filter((x) => x !== m).forEach((x) => (x.open = false));
    }),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    menus.forEach((m) => {
      if (m.open) {
        m.open = false;
        m.querySelector('summary')?.focus();
      }
    });
  });
  document.addEventListener('click', (e) => {
    menus.forEach((m) => {
      if (m.open && !m.contains(e.target as Node)) m.open = false;
    });
  });
</script>
