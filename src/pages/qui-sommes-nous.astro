---
// Qui sommes-nous : l'histoire de Deliview (7 octobre 2026, demande de Tom : « adopte la même stratégie que la page
// Qui sommes-nous de Flynt, crée un storytelling, ajoute des images »). On reprend la structure de Flynt (origine,
// constat, solution, valeurs, équipe, appels), jamais ses textes ni ses visuels : Flynt est un concurrent direct.
// Ordre : la mission et une vraie photo (Tom devant l’écran, septembre 2025 selon Tom) ; 01 le fondateur (ancre #tom : page auteur des articles) ; 02 le terrain ;
// 03 le constat ; 04 Deliview ; 05 la frise des vrais posts LinkedIn ; les engagements ; Deliview en bref ; la démo.
// Chaque fait vient des posts LinkedIn de Tom, des textes qu'il a validés ou de ce qu'il a dit le 7 octobre (passionné
// de foodtech, restaurateurs de toutes les tailles). Aucune scène, aucun chiffre ni aucun client inventé.
import BoutonDemo from '../components/BoutonDemo.astro';
import Base from '../layouts/Base.astro';
import PhotoTom from '../components/PhotoTom.astro';
import PhotoCadre from '../components/PhotoCadre.astro';
import LogoContact from '../components/LogoContact.astro';
import Pastille from '../components/Pastille.astro';
import Scene3D from '../components/Scene3D.astro';
import Frise from '../components/Frise.astro';
import Toque from '../icons/toque.astro';
import Courbe from '../icons/courbe.astro';
import Chef from '../icons/chef.astro';
import Fleche from '../icons/fleche.astro';
import Coche from '../icons/coche.astro';
import Cadenas from '../icons/cadenas.astro';
import Message from '../icons/message.astro';
import EtiquettePrix from '../icons/etiquette-prix.astro';
import { IDS, SITE, DEMO, lien, type CaptureApp } from '../lib/site';
import { CHRONOLOGIE, CHRONOLOGIE_APERCU } from '../lib/chronologie';

const description =
  'L’histoire de Deliview : un an sur le terrain auprès des restaurants qui livrent, un logiciel construit en public, et les engagements de son fondateur.';

const personne = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': IDS.tom,
  name: 'Tom Voisin',
  jobTitle: 'Fondateur de Deliview',
  description:
    'Fondateur de Deliview, entrepreneur depuis ses 17 ans, passionné par la foodtech. A lui-même été sur Uber Eats et Deliveroo, et a passé un an sur le terrain auprès des restaurants qui livrent.',
  knowsAbout: ['Foodtech', 'Uber Eats', 'Deliveroo', 'Livraison de repas', 'Prix des restaurants en livraison'],
  url: SITE.url + '/qui-sommes-nous/#tom',
  image: SITE.url + '/images/tom-voisin.jpg',
  email: SITE.email,
  sameAs: [SITE.linkedinTom],
  worksFor: { '@type': 'Organization', '@id': IDS.organisation, name: 'Deliview', url: SITE.url },
};
// Le titre de la frise suit ce qu'elle montre : le site public n'a que les posts dont on a le lien.
const posts = (import.meta.env.BASE_URL !== '/' ? CHRONOLOGIE_APERCU : CHRONOLOGIE).length;
const aPropos = { '@context': 'https://schema.org', '@type': 'AboutPage', name: 'Qui suis-je', url: SITE.url + '/qui-sommes-nous/', inLanguage: 'fr-FR', mainEntity: { '@id': IDS.organisation } };

// La même capture que la bascule de l'accueil (compte de démonstration « Pizza Démo »).
const captureAccueil: CaptureApp = {
  src: '/images/accueil-app',
  largeurs: [800, 1200, 1600],
  largeur: 1600,
  hauteur: 1000,
  alt: `Accueil de Deliview : les ventes du jour sur Uber Eats et Deliveroo, puis ce qu’il reste à faire et ce que Deliview applique pour vous. ${DEMO}`,
};

// Deliview en bref (7 octobre 2026, demande de Tom : « ajuste avec ce que tu sais, sois simple ») : six faits, chacun
// déjà affiché ailleurs sur le site (accueil, Tarifs, FAQ, mentions légales).
const bref = [
  { titre: 'Ce que fait Deliview', texte: 'Vos chiffres Uber&nbsp;Eats et Deliveroo sur un seul écran&nbsp;: promos, prix, fraude client et avis.' },
  { titre: 'Pour qui', texte: 'Les restaurants qui livrent en France, de l’indépendant à la chaîne.' },
  { titre: 'Fondateur', texte: 'Tom Voisin, qui fait votre mise en place.' },
  { titre: 'Prix', texte: 'Selon vos restaurants et vos besoins, fixé avec Tom. Sans engagement.' },
  { titre: 'Vos données', texte: 'Hébergées dans l’Union européenne (Irlande).' },
  { titre: 'Société', texte: `DELIVIEW&nbsp;SAS, <a href="${lien('/mentions-legales/')}" class="underline underline-offset-2">mentions légales</a>` },
];

// Engagements : uniquement des promesses déjà tenues par le service (FAQ, Tarifs, « Deliview est-il fiable ? »).
const engagements = [
  // 9 octobre 2026 (offres Autonomie et Délégation) : l'accord se donne à chaque changement, ou une fois par mois.
  { icone: Coche, titre: 'Rien ne change sans vous', texte: 'Avec Autonomie, vous validez chaque prix et chaque promo. Avec Délégation, Deliview suit la stratégie fixée avec vous chaque mois.' },
  { icone: Cadenas, titre: 'Jamais votre mot de passe', texte: 'Vous invitez Deliview dans Uber Eats et Deliveroo. Votre mot de passe reste à vous.' },
  { icone: Message, titre: 'Un humain qui répond', texte: 'Je fais la mise en place avec chaque restaurant. Quand vous écrivez, c’est moi qui réponds.' },
  { icone: EtiquettePrix, titre: 'Sans engagement', texte: 'Un prix fixe par mois. Vous arrêtez quand vous voulez.' },
];
---

<Base title="Qui suis-je : Tom Voisin, fondateur | Deliview" description={description} ariane={[{ nom: 'Qui suis-je', chemin: '/qui-sommes-nous/' }]} jsonld={[aPropos, personne]}>
  <section class="bg-grey pb-16 pt-6 md:pb-[104px] md:pt-10" aria-labelledby="projet-titre" data-haut-de-page>
    <div class="dv-container flex max-w-[1100px] flex-col items-center gap-x-20 gap-y-14 md:flex-row">
      <div class="flex-1">
        <Pastille icone={Toque}>Notre histoire</Pastille>
        <h1 id="projet-titre" class="dv-h1 mt-5 max-w-[18ch] md:mt-6">Rendre la livraison rentable pour chaque restaurant</h1>
        <p class="dv-lead mt-5 max-w-[52ch] md:mt-6">
          Deliview est né sur le terrain, au contact des restaurants qui livrent. Voici son histoire, du premier restaurant visité au logiciel d’aujourd’hui.
        </p>
      </div>
      <PhotoCadre
        fichier="le-projet-devient-public"
        largeur={522}
        hauteur={768}
        alt="Tom devant un grand écran où s’affiche une première version du logiciel"
        legende="Septembre 2025"
        inclinaison={3}
        priorite
        plateformes
        class="shrink-0"
      />
    </div>
  </section>

  <section id="tom" class="dv-section scroll-mt-24 bg-white" aria-labelledby="tom-titre">
    <div class="dv-container flex max-w-[1000px] flex-col items-center gap-x-[88px] gap-y-12 md:flex-row">
      <PhotoTom priorite />
      <div class="max-w-[620px] flex-1">
        <Pastille>01 · Le fondateur</Pastille>
        <h2 id="tom-titre" class="dv-h2 mt-4 md:mt-5">Ce que mes erreurs m’ont appris</h2>
        <div class="dv-histoire-texte mt-4 md:mt-5">
          <p>J’ai lancé mon premier projet à 17&nbsp;ans, sans expérience, sans réseau et sans argent.</p>
          <p>J’ai fait beaucoup d’erreurs, et à chaque fois une leçon m’est restée&nbsp;: comprendre la réalité du terrain avant de créer une solution.</p>
          <p>Deliview est né de cette leçon, avec une ambition&nbsp;: devenir le partenaire des restaurants en livraison.</p>
        </div>
        <ul class="mt-5 flex flex-wrap items-center gap-x-5 gap-y-1 text-[16px] md:mt-6 lg:flex-nowrap lg:whitespace-nowrap">
          <li><a href={`mailto:${SITE.email}`} class="dv-lien gap-2.5"><LogoContact type="email" />{SITE.email}</a></li>
          <li><a href={SITE.linkedinTom} class="dv-lien gap-2.5" rel="noopener"><LogoContact type="linkedin" />Tom sur LinkedIn</a></li>
          <li><a href={SITE.linkedinEntreprise} class="dv-lien gap-2.5" rel="noopener"><LogoContact type="deliview" />Deliview sur LinkedIn</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="dv-section bg-grey dv-points" aria-labelledby="terrain-titre">
    <div class="dv-container flex max-w-[1000px] flex-col items-center gap-x-[88px] gap-y-14 md:flex-row">
      <div class="max-w-[620px] flex-1">
        <Pastille>02 · Le terrain</Pastille>
        <h2 id="terrain-titre" class="dv-h2 mt-4 md:mt-5">Un&nbsp;an sur le terrain</h2>
        <div class="dv-histoire-texte mt-4 md:mt-5">
          <p>J’ai moi-même été sur Uber&nbsp;Eats et Deliveroo. Ensuite, je suis allé voir les restaurateurs.</p>
          <p>De l’indépendant à la chaîne, des restaurants de toutes les tailles.</p>
          <p>Je leur posais des questions sur la livraison&nbsp;: ce qui leur prenait du temps, de l’énergie, et ce qui rapportait vraiment.</p>
        </div>
      </div>
      <PhotoCadre
        fichier="le-meme-probleme-partout"
        largeur={588}
        hauteur={773}
        alt="Le comptoir d’un restaurant visité sur le terrain"
        legende="Sur le terrain"
        inclinaison={-3}
        class="shrink-0 md:order-first"
      />
    </div>
  </section>

  <section class="dv-section bg-grey dv-points !pt-4 md:!pt-6" aria-labelledby="constat-titre">
    <div class="dv-container flex max-w-[1000px] flex-col items-center gap-x-[88px] gap-y-12 lg:flex-row">
      <div class="max-w-[560px] flex-1">
        <Pastille>03 · Le constat</Pastille>
        <h2 id="constat-titre" class="dv-h2 mt-4 md:mt-5">Partout, la même histoire</h2>
        <div class="dv-histoire-texte mt-4 md:mt-5">
          <p>Un restaurateur qui jongle avec Deliveroo et Uber&nbsp;Eats.</p>
          <p>Une promo encore active un samedi soir, en plein rush, la cuisine débordée.</p>
          <p>Un client qui dit qu’il manque un produit, et une plateforme qui rembourse sans vérifier.</p>
          <p>La livraison leur ramène des clients. Mais à la fin du mois, ils se demandent où est passé l’argent.</p>
        </div>
      </div>
      <!-- Vrai message reçu par Tom sur WhatsApp (capture envoyée par Tom le 7 octobre 2026, 15 h 31, à la place de « Ce que
           j'ai entendu, partout ») : aucun nom ni numéro visible, barre de saisie retirée. -->
      <PhotoCadre
        fichier="whatsapp-fraude"
        dossier="terrain"
        tailles={[480, 960]}
        largeurMax={440}
        largeur={1156}
        hauteur={673}
        alt="Capture d’une conversation WhatsApp. Un restaurateur écrit à Tom : « tom j’en ai marre, les clients demandent le remboursement alors que la commande était complète et bien livré, je perds trop de chiffres à cause de ces fraudes... » Tom répond : « hello, oui je comprends... on a déjà posé le sujet avec deliview, ça arrive bientôt ! »"
        legende="Message d’un restaurateur"
        inclinaison={2}
        class="shrink-0"
      />
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="deliview-titre">
    <div class="dv-container grid max-w-[1100px] items-center gap-x-16 gap-y-10 md:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
      <div class="max-w-[560px]">
        <Pastille>04 · Deliview</Pastille>
        <h2 id="deliview-titre" class="dv-h2 mt-4 md:mt-5">Alors j’ai construit l’outil qui leur manquait</h2>
        <div class="dv-histoire-texte mt-4 md:mt-5">
          <p>Je commence à le construire à l’été 2025. Il s’appelle d’abord Viewly, puis devient Deliview début 2026.</p>
          <p>{SITE.definition.replace(/^Deliview est un logiciel français qui/, 'Deliview')}</p>
          <p>Mon ambition&nbsp;: améliorer la rentabilité de l’activité livraison de chaque restaurateur, et devenir le partenaire des restaurants en livraison.</p>
        </div>
      </div>
      <Scene3D capture={captureAccueil} sens="gauche" ratio={1.3} ratioMobile={1.4} appareil={{ x: 6, y: 10, largeur: 88 }} sizes="(min-width: 1200px) 600px, (min-width: 768px) 52vw, 92vw" />
    </div>
  </section>

  <section class="dv-section bg-grey dv-points" aria-labelledby="chronologie-titre">
    <div class="dv-container max-w-[880px]">
      <Pastille icone={Courbe}>05 · En public, sur LinkedIn</Pastille>
      <h2 id="chronologie-titre" class="dv-h2 mt-4 max-w-[22ch] md:mt-5">{posts ? 'La construction de Deliview, étape par étape' : 'Suivez la construction de Deliview'}</h2>
      <p class="mt-4 max-w-[60ch]">Je construis Deliview en public, avec les restaurateurs. Chaque étape est sur LinkedIn&nbsp;: ce qui marche, ce qui ne marche pas.</p>
      <Frise />
      <p class="mt-8">
        <a href={SITE.linkedinTom} class="dv-lien-fort dv-lien-fort-ligne" rel="noopener">Suivre la construction sur <span class="whitespace-nowrap">LinkedIn<Fleche taille={24} /></span></a>
      </p>
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="engagements-titre">
    <div class="dv-container max-w-[1100px]">
      <Pastille>Mes engagements</Pastille>
      <h2 id="engagements-titre" class="dv-h2 mt-4 max-w-[22ch] md:mt-5">Ce qui ne changera pas</h2>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 md:mt-10 lg:grid-cols-4">
        {
          engagements.map(({ icone: Icone, titre, texte }) => (
            <li class="flex flex-col rounded-[16px] bg-grey p-6">
              <span class="dv-tuile dv-tuile-petite">
                <Icone taille={24} />
              </span>
              <h3 class="dv-h3 mt-4">{titre}</h3>
              <p class="mt-2 text-[16px] leading-[1.55]">{texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="dv-section bg-grey" aria-labelledby="bref-titre">
    <div class="dv-container max-w-[880px]">
      <h2 id="bref-titre" class="dv-h2">Deliview en bref</h2>
      <dl class="dv-card mt-8 divide-y divide-grey-2/15 px-6 md:px-8">
        {
          bref.map((x) => (
            <div class="grid gap-1 py-4 sm:grid-cols-[200px_1fr]">
              <dt class="font-semibold">{x.titre}</dt>
              <dd set:html={x.texte} />
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section id="demo" class="dv-section bg-white" aria-labelledby="contact-titre">
    <div class="dv-container max-w-[760px] text-center">
      <span class="dv-tuile dv-tuile-chef"><Chef taille={48} /></span>
      <h2 id="contact-titre" class="dv-h2 mx-auto mt-5 max-w-[20ch]">Parlons de votre restaurant</h2>
      <p class="dv-lead mx-auto mt-4 max-w-[48ch]">Une démo de 30&nbsp;minutes, sur votre restaurant.</p>
      <p class="mt-7"><BoutonDemo href={lien('/demo/')} cta="qui-sommes-nous" principal class="w-full sm:w-auto" /></p>
    </div>
  </section>
</Base>

<style>
  /* Récit : paragraphes courts, aérés, un peu plus grands que le texte courant. */
  .dv-histoire-texte {
    display: grid;
    gap: 12px;
    font-size: 17px;
    line-height: 1.6;
    text-wrap: pretty;
  }
  @media (min-width: 768px) {
    .dv-histoire-texte {
      gap: 14px;
      font-size: 19px;
    }
  }
  /* Le chef de l'appel final : une tuile plus grande, l'icône en 48 px. */
  .dv-tuile-chef {
    width: 84px;
    height: 84px;
    border-radius: 22px;
  }
</style>
