---
// Preuve humaine au stade pilote : le fondateur, son visage, sa ligne directe (aucun faux témoignage).
import { SITE, lien } from '../lib/site';

interface Props {
  titre?: string;
  fond?: 'blanc' | 'gris';
}
const { titre = 'Vous parlez directement au fondateur', fond = 'blanc' } = Astro.props;
---

<section class={`dv-section ${fond === 'gris' ? 'bg-grey' : 'bg-white'}`} aria-labelledby="fondateur-titre">
  <div class="dv-container">
    <div class="dv-card grid gap-8 p-6 md:grid-cols-[160px_1fr] md:p-10">
      <img
        src={lien('/images/tom-voisin.webp')}
        alt="Portrait de Tom Voisin, fondateur de Deliview"
        width="200"
        height="200"
        loading="lazy"
        class="h-32 w-32 rounded-full object-cover md:h-40 md:w-40"
      />
      <div>
        <p class="dv-overline dv-muted">Programme pilote</p>
        <h2 id="fondateur-titre" class="dv-h2 mt-3">{titre}</h2>
        <div class="mt-5 max-w-[62ch] space-y-3">
          <p>Je m’appelle Tom. J’ai créé Deliview après avoir vu des restaurateurs jongler entre leurs tablettes Uber Eats et Deliveroo. Faute de temps, ils fixaient leurs prix à l’instinct, sans regarder ceux des voisins.</p>
          <p>Deliview se construit avec ses premiers restaurants pilotes. Je fais la mise en place avec vous, et vos retours décident des prochaines fonctionnalités.</p>
          <p>Quand vous appelez, c’est moi qui décroche.</p>
        </div>
        <p class="mt-5 font-semibold">Tom Voisin, fondateur de Deliview · étudiant-entrepreneur (réseau PEPITE)</p>
        <p class="mt-3 flex flex-wrap gap-x-6 gap-y-2">
          <a href={`tel:${SITE.telephoneLien}`} class="font-semibold underline underline-offset-2">{SITE.telephone}</a>
          <a href={SITE.linkedinTom} class="font-semibold underline underline-offset-2" rel="noopener">Tom sur LinkedIn</a>
          <a href={lien('/qui-sommes-nous/')} class="font-semibold underline underline-offset-2">Qui sommes-nous</a>
        </p>
      </div>
    </div>
  </div>
</section>
