---
// Intégrations : Uber Eats et Deliveroo, tableau de ce que Deliview récupère sur chacune.
import Base from '../../layouts/Base.astro';
import SectionDemo from '../../components/SectionDemo.astro';
import Icone from '../../components/Icone.astro';
import { PLATEFORMES, SITE, lien } from '../../lib/site';
import { logoPlateforme } from '../../lib/logos';

const description =
  'Uber Eats et Deliveroo : ce que Deliview lit sur chaque plateforme, vos prix, vos notes, vos offres et les fiches de vos concurrents. Sans identifiant à donner.';

type Etat = 'oui' | 'non';
const lignes: { libelle: string; etats: [Etat, Etat] }[] = [
  { libelle: 'Prix de toute votre carte', etats: ['oui', 'oui'] },
  { libelle: 'Note et nombre d’avis', etats: ['oui', 'oui'] },
  { libelle: 'Offres affichées sur les fiches', etats: ['oui', 'oui'] },
  { libelle: 'Fiches des concurrents de votre zone', etats: ['oui', 'oui'] },
  { libelle: 'Écarts de prix entre vos deux fiches', etats: ['oui', 'oui'] },
];
const libelleEtat: Record<Etat, string> = { oui: 'Disponible', non: 'Non' };
---

<Base title="Intégrations Uber Eats et Deliveroo | Deliview" description={description} ariane={[{ nom: 'Intégrations', chemin: '/integrations/' }]}>
  <section class="bg-white">
    <div class="dv-container pb-12 pt-8 md:pb-16 md:pt-12">
      <p class="dv-overline dv-muted">Intégrations</p>
      <h1 class="dv-h1 mt-4 max-w-[18ch]">Uber Eats et Deliveroo, réunis sur un seul écran</h1>
      <p class="dv-lead mt-5 max-w-[60ch]">Deliview lit vos fiches publiques sur les deux plateformes, sans identifiant à donner&nbsp;: vos prix, vos notes, vos offres et celles des restaurants autour de vous.</p>
      <div class="mt-8">
        <a href="#demo" class="dv-btn dv-btn-plein" data-cta="integrations" data-cta-principal>Demander une démo</a>
      </div>
    </div>
  </section>

  <section class="dv-section bg-grey" aria-labelledby="plateformes-titre">
    <div class="dv-container">
      <h2 id="plateformes-titre" class="dv-h2">Les plateformes prises en charge</h2>
      <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          PLATEFORMES.map((p) => ({ ...p, logo: logoPlateforme(p.slug) })).map((p) => (
            <li class="dv-card flex flex-col p-6 md:p-8">
              {p.logo && <img src={p.logo.src} alt="" width={p.logo.largeur} height={p.logo.hauteur} class="mb-4 h-14 w-auto self-start rounded-[12px]" loading="lazy" decoding="async" />}
              <h3 class="text-[26px] font-bold tracking-tight">{p.nom}</h3>
              <p class="mt-3 flex-1 dv-muted">{p.resume}</p>
              <a href={lien(`/integrations/${p.slug}/`)} class="mt-5 inline-flex items-center gap-2 font-bold underline underline-offset-4">
                Voir l’intégration {p.nom} <Icone nom="fleche" taille={18} />
              </a>
            </li>
          ))
        }
        <li class="dv-card flex flex-col p-6 md:p-8">
          <div class="flex items-center justify-between gap-3">
            <h3 class="text-[26px] font-bold tracking-tight">Uber Eats et Deliveroo ensemble</h3>
          </div>
          <p class="mt-3 flex-1 dv-muted">Vos deux fiches côte à côte&nbsp;: les écarts de prix entre elles, vos concurrents et votre note sur chaque plateforme.</p>
          <a href={lien('/integrations/uber-eats-et-deliveroo/')} class="mt-5 inline-flex items-center gap-2 font-bold underline underline-offset-4">
            Gérer les deux ensemble <Icone nom="fleche" taille={18} />
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="tableau-titre">
    <div class="dv-container">
      <h2 id="tableau-titre" class="dv-h2 max-w-[24ch]">Ce que Deliview récupère, plateforme par plateforme</h2>
      <div class="mt-8 overflow-x-auto rounded-[16px] border border-grey-2/15" tabindex="0" role="region" aria-label="Tableau des données récupérées, défile horizontalement">
        <table class="w-full min-w-[640px] border-collapse text-left text-[16px]">
          <caption class="sr-only">Données récupérées par Deliview sur Uber Eats et Deliveroo</caption>
          <thead class="bg-grey">
            <tr>
              <th scope="col" class="p-4 font-semibold">Donnée</th>
              {PLATEFORMES.map((p) => <th scope="col" class="p-4 font-semibold">{p.nom}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              lignes.map((l) => (
                <tr class="border-t border-grey-2/15">
                  <th scope="row" class="p-4 font-normal">{l.libelle}</th>
                  {l.etats.map((e) => (
                    <td class="p-4">
                      {e === 'oui' ? (
                        <span class="inline-flex items-center gap-2 font-semibold">
                          <span class="text-blue"><Icone nom="check" taille={20} /></span>
                          {libelleEtat[e]}
                        </span>
                      ) : (
                        <span class="dv-muted">{libelleEtat[e]}</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="mt-10 dv-card bg-grey p-6 md:p-8">
        <h3 class="dv-h3">Un outil vous manque&nbsp;?</h3>
        <p class="mt-2 max-w-[62ch]">Caisse, logiciel de réservation, site de commande&nbsp;: dites à Tom ce que vous utilisez. Les prochaines intégrations se décident avec les restaurants qui utilisent Deliview.</p>
        <p class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
          <a href={`tel:${SITE.telephoneLien}`} class="font-semibold underline underline-offset-2">{SITE.telephone}</a>
          <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Intégration à prévoir')}`} class="font-semibold underline underline-offset-2">{SITE.email}</a>
        </p>
      </div>
      <p class="mt-8 text-[15px] dv-muted">Uber Eats et Deliveroo sont des marques de leurs propriétaires respectifs. Deliview est un logiciel indépendant, ni affilié ni approuvé par ces sociétés.</p>
    </div>
  </section>

  <SectionDemo section="integrations-formulaire" />
</Base>
