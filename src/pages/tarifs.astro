---
// Tarifs : 3 abonnements selon le nombre de restaurants (OFFRES dans src/lib/site.ts), trois cartes en relief côte à côte
// (empilées sur téléphone), Pro mise en avant (bord Bleu 1, bandeau « Recommandé », légèrement surélevée), tableau
// comparatif, lien vers le simulateur, questions (FAQPage), bandeau final. Uniquement ce que Deliview fait aujourd'hui.
// 6 octobre 2026 (demande de Tom) : Essentiel 59 €, Pro 199 € (3 restaurants), Groupe 399 € (10 restaurants), offres
// et comparatif récrits en mots simples, questions à la première personne.
// Refonte en relief du 3 octobre 2026 (les tickets et la flèche au marqueur de la direction « le passe » sont retirés).
// 4 octobre 2026 (logique de taap.it, choix de Tom) : chaque offre a son bouton « Commencer maintenant » vers le
// formulaire de départ /commencer/?offre=… (pas de paiement sur le site) ; prix en Inter ; la démo reste proposée
// juste sous les offres et en bas de page, pour qui veut voir avant de choisir.
import Base from '../layouts/Base.astro';
import BoutonDemo from '../components/BoutonDemo.astro';
import Pastille from '../components/Pastille.astro';
import Faq from '../components/Faq.astro';
import Coche from '../icons/coche.astro';
import Pieces from '../icons/pieces.astro';
import Enveloppe from '../icons/enveloppe.astro';
import Fleche from '../icons/fleche.astro';
import { OFFRES, PRIX_ENTREE, SITE, jsonldLogiciel, lien } from '../lib/site';

const description = `Trois offres selon votre nombre de restaurants, dès ${PRIX_ENTREE} € HT par mois : sans engagement, mise en place offerte. Comparez Essentiel, Pro et Groupe.`;

type Case = 'oui' | 'non' | string;
// Comparatif en trois blocs (6 octobre 2026, demande de Tom) : ce que vous suivez, ce que Deliview fait pour vous,
// l'accompagnement. Mêmes mots que les cartes des offres.
const comparatif: { groupe: string; lignes: { libelle: string; valeurs: [Case, Case, Case] }[] }[] = [
  {
    groupe: 'Suivre votre rentabilité',
    lignes: [
      { libelle: 'Restaurants', valeurs: ['1', 'Jusqu’à 3', 'Jusqu’à 10'] },
      { libelle: 'Vos ventes Uber Eats et Deliveroo sur un seul écran', valeurs: ['oui', 'oui', 'oui'] },
      { libelle: 'Vos prix comparés à ceux de vos concurrents', valeurs: ['oui', 'oui', 'oui'] },
      { libelle: 'Les promos et les notes de votre zone', valeurs: ['oui', 'oui', 'oui'] },
      { libelle: 'Une réponse rédigée par l’IA pour chaque avis', valeurs: ['oui', 'oui', 'oui'] },
      { libelle: 'Alerte si vous êtes fermé en plein service', valeurs: ['oui', 'oui', 'oui'] },
      { libelle: 'Vos objectifs, et le point chaque lundi', valeurs: ['oui', 'oui', 'oui'] },
    ],
  },
  {
    groupe: 'Deliview agit pour vous',
    lignes: [
      { libelle: 'Promos conseillées, mises en ligne pour vous', valeurs: ['non', 'oui', 'oui'] },
      { libelle: 'Nouveaux prix mis en ligne pour vous', valeurs: ['non', 'oui', 'oui'] },
      { libelle: 'Remboursements Uber Eats contestés en un clic', valeurs: ['non', 'oui', 'oui'] },
      { libelle: 'Restaurant fermé relancé en un clic', valeurs: ['non', 'oui', 'oui'] },
      { libelle: 'Assistant IA et rapport pour vos équipes', valeurs: ['non', 'oui', 'oui'] },
    ],
  },
  {
    groupe: 'Accompagnement',
    lignes: [
      { libelle: 'Un point chaque mois avec Tom', valeurs: ['non', 'non', 'oui'] },
      { libelle: 'L’historique de vos décisions de prix', valeurs: ['non', 'non', 'oui'] },
      { libelle: 'Accès pour votre équipe', valeurs: ['2', '10', 'Illimités'] },
      { libelle: 'Mise en place avec Tom', valeurs: ['Offerte', 'Offerte', 'Offerte'] },
      { libelle: 'Engagement', valeurs: ['Aucun', 'Aucun', 'Aucun'] },
    ],
  },
];

// Questions à la première personne (6 octobre 2026, demande de Tom).
const faq = [
  {
    q: 'Est-ce que je m’engage sur une durée ?',
    r: 'Non. L’abonnement est mensuel et sans engagement&nbsp;: vous arrêtez quand vous voulez.',
  },
  {
    q: 'Est-ce que je paie la mise en place ?',
    r: 'Non, elle est offerte. Tom crée votre compte avec vous et vous montre comment lire les résultats. Rien à installer&nbsp;: Deliview s’ouvre dans le navigateur.',
  },
  {
    q: 'J’ai un seul restaurant : est-ce que je peux choisir Pro ou Groupe ?',
    r: 'Oui. Le nombre de restaurants de chaque offre est un maximum, pas un minimum. Vous pouvez changer d’offre à tout moment.',
  },
  {
    q: 'Est-ce que je garde mes tablettes Uber Eats et Deliveroo ?',
    r: 'Oui. Vos tablettes restent là pour recevoir les commandes. Deliview réunit vos chiffres, vos prix et ceux de vos concurrents sur un seul écran.',
  },
  {
    q: 'J’ai plus de 10 restaurants : comment je fais ?',
    r: `Tom vous fait une offre sur mesure. Écrivez-lui à <a href="mailto:${SITE.email}">${SITE.email}</a> ou demandez une démo.`,
  },
  {
    q: 'Où sont hébergées mes données ?',
    r: 'Dans l’Union européenne&nbsp;: la base de données de Deliview est hébergée en Irlande. Le détail est dans notre <a href="' + lien('/confidentialite/') + '">politique de confidentialité</a>.',
  },
];

const texteBrut = (h: string) => h.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ');
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: texteBrut(x.r) } })),
};
const logiciel = {
  ...jsonldLogiciel(SITE.definition, SITE.url + '/tarifs/'),
  offers: OFFRES.map((o) => ({
    '@type': 'Offer',
    name: `Deliview ${o.nom}`,
    description: `${o.restaurants}. ${o.pour}.`,
    price: o.prix.toFixed(2),
    priceCurrency: 'EUR',
    url: `${SITE.url}/tarifs/#${o.slug}`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: o.prix,
      priceCurrency: 'EUR',
      unitText: 'mois',
      valueAddedTaxIncluded: false,
    },
  })),
};
---

<Base title="Tarifs : 3 offres selon vos restaurants | Deliview" description={description} ariane={[{ nom: 'Tarifs', chemin: '/tarifs/' }]} jsonld={[logiciel, faqPage]}>
  <section id="offres" class="bg-grey pb-16 pt-8 md:pb-[104px] md:pt-12" aria-labelledby="tarifs-titre" data-haut-de-page>
    <div class="dv-container">
      <div class="text-center">
        <Pastille>Tarifs</Pastille>
        <h1 id="tarifs-titre" class="dv-h1 mx-auto mt-5 max-w-[20ch] md:mt-6">Un prix clair, selon le nombre de vos restaurants</h1>
        <p class="dv-lead mx-auto mt-4 max-w-[52ch] md:mt-5">Trois offres, selon le nombre de restaurants que vous suivez. Les prix sont HT, par mois.</p>
      </div>

      <ul class="dv-offres-page mt-12 grid items-stretch gap-6 md:mt-16 lg:mt-20 lg:grid-cols-3">
        {
          OFFRES.map((o) => (
            <li id={o.slug} class={`dv-relief dv-offre flex scroll-mt-32 flex-col ${o.recommandee ? 'dv-offre-pro' : ''}`}>
              {o.recommandee && (
                <p class="dv-offre-bandeau" aria-hidden="true">
                  Recommandé
                </p>
              )}
              <h2 class="font-accent text-[26px] font-bold leading-[1.2] md:text-[28px]">
                {o.nom}
                {o.recommandee && <span class="sr-only">, offre recommandée</span>}
              </h2>
              <p class="mt-1.5 text-[16px] font-semibold leading-[1.4]">{o.restaurants}</p>
              <p class="mt-1 text-[16px] leading-[1.5] dv-muted lg:min-h-[72px]">{o.pour}.</p>
              <p class="mt-5 flex items-baseline gap-2 border-t border-grey-2/15 pt-5">
                <span class="dv-offre-prix text-[46px] md:text-[54px]">{o.prix}&nbsp;€</span>
                <span class="text-[16px] leading-[1.3]">HT par mois</span>
              </p>
              <a
                href={lien(`/commencer/?offre=${o.slug}`)}
                class={`dv-btn mt-6 w-full ${o.recommandee ? 'dv-btn-plein' : 'dv-btn-contour'}`}
                data-cta={`tarifs-${o.slug}`}
                {...(o.recommandee ? { 'data-cta-principal': '' } : {})}
              >
                Commencer maintenant<span class="sr-only"> avec l’offre {o.nom}</span>
              </a>
              <p class="mt-3 text-center text-[15px] leading-[1.4] dv-muted">Rien à payer aujourd’hui</p>
              <div class="mt-6 border-t border-grey-2/15" aria-hidden="true" />
              {o.base && <p class="mt-5 text-[16px] font-bold leading-[1.4]">{o.base.replace(' :', ' :')}</p>}
              <ul class={`${o.base ? 'mt-3' : 'mt-5'} grid gap-3 text-[16px] leading-[1.5]`}>
                {o.inclus.map((x) => (
                  <li class="flex gap-2.5">
                    <Coche taille={24} />
                    <span>{x}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>

      <!-- Autre chemin, pour qui veut voir avant de choisir (le bouton de chaque offre mène au formulaire de départ). -->
      <div class="mt-10 flex flex-col items-center gap-1 text-center md:mt-12">
        <p class="text-[17px] leading-[1.5] md:text-[18px]">Vous préférez voir Deliview sur votre restaurant avant de choisir&nbsp;?</p>
        <a href={lien('/demo/')} class="dv-lien-fort" data-cta="tarifs-voir-avant">Demander une démo gratuite<Fleche taille={24} /></a>
      </div>

      <p class="mt-8 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center text-[17px] font-semibold leading-[1.5] md:mt-10 md:text-[18px]">
        <span class="dv-tuile"><Pieces taille={32} /></span>
        <span>Plus de 10&nbsp;restaurants&nbsp;? <a href={lien('/demo/')} class="dv-lien" data-cta="tarifs-plus-de-10">Parlons-en.</a></span>
      </p>
      <p class="mt-5 text-center text-[14px] dv-muted">
        Prix HT. Abonnement soumis aux <a href={lien('/cgv/')}>conditions générales de vente</a>.
      </p>
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="comparatif-titre">
    <div class="dv-container">
      <h2 id="comparatif-titre" class="dv-h2">Comparer les offres</h2>
      <div class="dv-card mt-8 overflow-x-auto md:mt-9" tabindex="0" role="region" aria-label="Comparatif des offres, défile horizontalement">
        <table class="w-full min-w-[740px] border-collapse text-[16px] leading-[1.45] tabular-nums" aria-labelledby="comparatif-titre">
          <thead class="bg-grey">
            <tr>
              <th scope="col" class="px-6 py-[18px] text-left font-bold">Ce qui est inclus</th>
              {OFFRES.map((o) => (
                <th scope="col" class={`w-[150px] px-4 py-[18px] text-center font-accent md:w-[200px] text-[20px] font-bold leading-[1.2] ${o.recommandee ? 'bg-blue/10' : ''}`}>
                  {o.nom}
                  <span class="mt-1 block font-sans text-[15px] font-normal">{o.prix}&nbsp;€&nbsp;HT</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {
              comparatif.map((g) => (
                <>
                  <tr class="border-t border-grey-2/12 bg-grey/60">
                    <th scope="colgroup" colspan={4} class="px-6 pb-3 pt-6 text-left font-accent text-[17px] font-bold">{g.groupe}</th>
                  </tr>
                  {g.lignes.map((l) => (
                    <tr class="border-t border-grey-2/12">
                      <th scope="row" class="px-6 py-4 text-left font-normal">{l.libelle}</th>
                      {l.valeurs.map((c, i) => (
                        <td class={`px-4 py-4 text-center ${OFFRES[i].recommandee ? 'bg-blue/10' : ''}`}>
                          {c === 'oui' ? (
                            <span class="inline-flex justify-center">
                              <Coche taille={24} />
                              <span class="sr-only">Inclus</span>
                            </span>
                          ) : c === 'non' ? (
                            <span>
                              <span aria-hidden="true">—</span>
                              <span class="sr-only">Non inclus</span>
                            </span>
                          ) : (
                            <span>{c}</span>
                          )}
                        </td>
                      ))}
                    </tr>
                  ))}
                </>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <Faq questions={faq} titre="Avant de choisir une offre" />

  <section id="demo" class="dv-section bg-white" aria-labelledby="final-titre">
    <div class="dv-container max-w-[760px] text-center">
      <span class="dv-tuile"><Enveloppe taille={32} /></span>
      <h2 id="final-titre" class="dv-h2 mt-5">Voyez d’abord ce que vos prix peuvent vous rapporter</h2>
      <p class="dv-lead mt-4">30&nbsp;minutes avec Tom, sur votre restaurant, avant tout paiement.</p>
      <BoutonDemo href={lien('/demo/')} cta="tarifs-final" principal class="mt-7 w-full sm:w-auto" />
    </div>
  </section>
</Base>
