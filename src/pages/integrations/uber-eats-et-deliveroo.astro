---
// Page combinée : Uber Eats et Deliveroo côte à côte dans Deliview. 8 octobre 2026 (audit SEO, cannibalisation) : la
// requête « gérer Uber Eats et Deliveroo ensemble » est laissée à l'article du blog, qui renvoie ici ; cette page vise
// « intégration Uber Eats et Deliveroo » (title, H1 et description).
// Refonte en relief (3 octobre 2026) : en haut, l'écran Ma carte (les deux plateformes dans la même liste) incliné en 3D.
import Base from '../../layouts/Base.astro';
import BoutonDemo from '../../components/BoutonDemo.astro';
import Scene3D from '../../components/Scene3D.astro';
import Flottant from '../../components/Flottant.astro';
import Bulle from '../../components/Bulle.astro';
import Pastille from '../../components/Pastille.astro';
import Coche from '../../icons/coche.astro';
import SectionDemo from '../../components/SectionDemo.astro';
import Faq from '../../components/Faq.astro';
import { CAPTURE_PRIX, SITE, jsonldLogiciel } from '../../lib/site';

const description =
  'Vos cartes Uber Eats et Deliveroo côte à côte : écarts de prix entre les deux, concurrents et note sur chaque plateforme. Mise en place sans mot de passe.';

const aujourdhui = [
  { titre: 'Les écarts de prix entre vos deux cartes', texte: 'Les plats vendus plus cher sur une plateforme que sur l’autre, avec les deux prix.' },
  { titre: 'Vos concurrents sur chaque plateforme', texte: 'Un restaurant absent de Deliveroo peut être votre premier rival sur Uber Eats. Deliview regarde les deux.' },
  { titre: 'Votre note ici et là', texte: 'Votre place au classement des notes de votre zone, plateforme par plateforme.' },
  { titre: 'Un seul écran pour les deux', texte: 'Plus besoin d’ouvrir deux espaces pour comparer. Tout est au même endroit.' },
];
const faq = [
  {
    q: 'Est-ce que je dois vendre au même prix sur Uber Eats et sur Deliveroo ?',
    r: 'Deliview ne choisit pas à votre place. Il vous montre, plat par plat, les écarts de prix entre vos deux cartes. Vous repérez ceux qui datent d’un oubli.',
  },
  {
    q: 'Est-ce que je garde mes tablettes Uber Eats et Deliveroo ?',
    r: 'Oui. Vos tablettes restent là pour recevoir les commandes. Deliview centralise vos chiffres, vos prix et votre note sur un seul écran.',
  },
  {
    q: 'Et si je ne suis que sur une des deux plateformes ?',
    r: 'Deliview fonctionne aussi avec une seule plateforme. Si vous ouvrez l’autre plus tard, la prochaine analyse la prendra en compte.',
  },
];
---

<Base
  title="Intégration Uber Eats et Deliveroo côte à côte | Deliview"
  description={description}
  ariane={[
    { nom: 'Intégrations', chemin: '/integrations/' },
    { nom: 'Uber Eats et Deliveroo', chemin: '/integrations/uber-eats-et-deliveroo/' },
  ]}
  jsonld={[jsonldLogiciel(description, `${SITE.url}/integrations/uber-eats-et-deliveroo/`)]}
>
  <section class="overflow-hidden bg-grey pb-14 pt-6 md:pb-[104px] md:pt-10" aria-labelledby="ensemble-titre" data-haut-de-page>
    <div class="dv-container grid items-center gap-x-12 gap-y-10 lg:grid-cols-[1fr_1.05fr]">
      <div>
        <Pastille>Intégration</Pastille>
        <h1 id="ensemble-titre" class="dv-h1 mt-5 max-w-[16ch] md:mt-6">Uber Eats et Deliveroo côte à côte</h1>
        <p class="dv-lead mt-4 max-w-[56ch] md:mt-6">{SITE.argument} Vos deux cartes côte à côte, vos concurrents et votre note sur chaque plateforme.</p>
        <div class="mt-7 md:mt-8">
          <BoutonDemo href="#demo" cta="integration-combinee" principal class="w-full sm:w-auto" />
        </div>
      </div>
      <div class="w-full">
        <Scene3D capture={CAPTURE_PRIX} priorite suiviPointeur ratio={1.14} ratioMobile={1.02} appareil={{ x: 4, y: 14, largeur: 92 }} sizes="(min-width: 1200px) 540px, (min-width: 1024px) 46vw, 92vw">
          <Flottant x={2} y={4} xm={0} ym={3} z={10} duree={6.2}><span class="dv-puce dv-puce-forte"><i></i>Uber&nbsp;Eats et Deliveroo, côte à côte</span></Flottant>
          <Flottant x={-4} y={60} xm={0} ym={66} droite z={15} duree={6.8} delai={-2}><Bulle sur="Dips Bacon · Deliveroo" fleche={['4,30 €', '5,60 €']} gain="+1,30 €" /></Flottant>
          <Flottant x={-4} y={72} z={12} duree={7.2} delai={-4} bureau><Bulle chiffre="21 plats" texte="moins chers que la zone" /></Flottant>
        </Scene3D>
      </div>
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="aujourdhui-titre">
    <div class="dv-container">
      <Pastille>Disponible</Pastille>
      <h2 id="aujourdhui-titre" class="dv-h2 mt-4 md:mt-5">Ce que vous avez dès aujourd’hui</h2>
      <ul class="mt-8 grid gap-6 md:mt-10 md:grid-cols-2">
        {
          aujourdhui.map((x) => (
            <li class="dv-card flex gap-4 p-6" data-apparition="">
              <span class="dv-tuile dv-tuile-petite">
                <Coche taille={24} />
              </span>
              <div>
                <h3 class="font-accent text-[20px] font-bold leading-[1.3] md:text-[22px]">{x.titre}</h3>
                <p class="mt-2 dv-muted">{x.texte}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq questions={faq} />

  <section class="bg-white pt-10" aria-label="Marques">
    <div class="dv-container">
      <p class="text-[15px] dv-muted">Uber Eats et Deliveroo sont des marques de leurs propriétaires respectifs. Deliview est un logiciel indépendant qui regroupe vos plateformes de livraison.</p>
    </div>
  </section>

  <SectionDemo section="integration-combinee-formulaire" />
</Base>
