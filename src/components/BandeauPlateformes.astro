---
// « Fonctionne avec » : les plateformes réellement prises en charge.
// Logo officiel seul (fichier déposé dans src/assets/logos/), nom en texte alternatif ; sans fichier, le nom seul (jamais un logo redessiné).
// Refonte en relief (3 octobre 2026) : chaque logo dans sa tuile blanche en relief.
import Pastille from './Pastille.astro';
import { PLATEFORMES, lien } from '../lib/site';
import { logoPlateforme } from '../lib/logos';

interface Props {
  fond?: 'blanc' | 'gris';
}
const { fond = 'blanc' } = Astro.props;
const plateformes = PLATEFORMES.map((p) => ({ ...p, logo: logoPlateforme(p.slug) }));
---

<section aria-label="Plateformes compatibles" class={`border-y border-grey-2/10 ${fond === 'gris' ? 'bg-grey' : 'bg-white'}`}>
  <div class="dv-container flex flex-col items-center gap-5 py-9 text-center md:flex-row md:justify-center md:gap-10">
    <Pastille>Fonctionne avec</Pastille>
    <ul class="flex flex-wrap items-center justify-center gap-x-5 gap-y-4">
      {
        plateformes.map((p) => (
          <li>
            <a href={lien(`/integrations/${p.slug}/`)} class="dv-plateforme-tuile">
              {p.logo ? <img src={p.logo.src} alt="" width={p.logo.largeur} height={p.logo.hauteur} class="h-11 w-auto rounded-[10px]" loading="lazy" decoding="async" /> : null}
              <span>{p.nom}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
