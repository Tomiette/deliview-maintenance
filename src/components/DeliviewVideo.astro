---
// Vidéo de présentation : 9:16, 1 min 10, sans voix off (tout le texte est à l'écran), avec musique.
// Seule l'image d'aperçu (37 Ko, image de la vidéo « Deliview surveille vos concurrents ») se charge avec la page ;
// la vidéo (5 à 7 Mo) ne se télécharge qu'au clic.
// Jamais de lecture automatique. Sans JavaScript, les contrôles natifs du navigateur restent affichés.
// Le texte de la vidéo est repris en dessous (alternative pour les personnes qui ne la voient pas).
import { lien } from '../lib/site';

interface Props {
  class?: string;
}
const { class: classe = '' } = Astro.props;

const texte = [
  'Bon, j’ai 1 minute pour vous convaincre. Alors je vous la fais courte.',
  'Restaurateur, on vous a promis que la livraison serait rentable. Eh oui.',
  'Mais au quotidien ? Trop de tablettes. Pas le temps de tout analyser. Trop de concurrents. Trop de promos.',
  'Et surtout : être présent, mais être rentable… non.',
  'Alors on a créé Deliview. Toutes vos données livraison centralisées : votre carte, vos avis, vos concurrents, leurs prix.',
  'Deliview surveille vos concurrents : leurs prix, leurs notes, leurs promos.',
  'Et surtout, Deliview vous dit quoi faire : un prix suggéré pour chaque plat, face au prix de la zone.',
  'L’IA Deliview vous rend plus visible, plus rentable. À la question « Que font mes concurrents dans ma zone ? », elle répond par exemple : « Napoli Express lance −30 % sur ses pizzas. Passez votre Margherita à 10,90 € pour rester bien référencé et compétitif. »',
  'Et dès que ça bouge, Deliview vous alerte : promotions des concurrents, changements de prix, nouveau concurrent, avis négatif reçu.',
  'Résultat : vous réagissez immédiatement. Pas la semaine d’après.',
  'Deliview : votre activité livraison sur un seul écran. Demandez une démo sur deliview.fr.',
];
---

<div class={`dv-video ${classe}`}>
<figure class="m-0">
  <div class="dv-video-cadre">
    <video
      class="dv-video-lecteur"
      controls
      playsinline
      preload="none"
      width="1080"
      height="1920"
      poster={lien('/video/deliview-video-apercu.webp')}
      aria-label="Vidéo de présentation de Deliview, 1 minute 10, sans voix off"
      aria-describedby="dv-video-legende"
    >
      <source src={lien('/video/deliview-video.webm')} type='video/webm; codecs="vp9, opus"' />
      <source src={lien('/video/deliview-video.mp4')} type="video/mp4" />
      <a href={lien('/video/deliview-video.mp4')}>Télécharger la vidéo de présentation (MP4, 7 Mo)</a>
    </video>
    <button class="dv-btn dv-btn-plein dv-video-lire" type="button" hidden>
      <span class="dv-video-icone" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="20" height="20"><path d="M8 5.5v13l11-6.5z" fill="currentColor"></path></svg>
      </span>
      Voir la vidéo · 1&nbsp;min&nbsp;10
    </button>
  </div>
  <figcaption id="dv-video-legende" class="mx-auto mt-3 max-w-[380px] text-center text-[14px] dv-muted">
    Deliview en 1&nbsp;min&nbsp;10, sans voix off. Restaurants et chiffres d’exemple.
  </figcaption>
</figure>
<details class="mx-auto mt-3 max-w-[380px] text-[15px]">
  <summary class="cursor-pointer font-semibold underline underline-offset-2">Lire le contenu de la vidéo</summary>
  <ol class="mt-3 list-decimal space-y-2 pl-5 dv-muted">
    {texte.map((t) => <li>{t}</li>)}
  </ol>
</details>
</div>

<script>
  // Lecture au clic, avec le son. À la fin, retour à l'image d'aperçu et au bouton.
  document.querySelectorAll<HTMLElement>('.dv-video-cadre').forEach((cadre) => {
    const video = cadre.querySelector('video');
    const bouton = cadre.querySelector<HTMLButtonElement>('.dv-video-lire');
    if (!video || !bouton) return;
    video.controls = false;
    bouton.hidden = false;
    const lire = () => {
      bouton.hidden = true;
      video.controls = true;
      void video.play();
      video.focus();
    };
    bouton.addEventListener('click', lire);
    video.addEventListener('click', () => {
      if (!video.controls) lire();
    });
    video.addEventListener('ended', () => {
      video.controls = false;
      video.load();
      bouton.hidden = false;
      bouton.focus();
    });
  });
</script>

<style>
  .dv-video {
    margin: 0;
  }
  .dv-video-cadre {
    position: relative;
    width: min(100%, 380px);
    aspect-ratio: 9 / 16;
    margin-inline: auto;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--color-grey);
    border: 1px solid color-mix(in srgb, var(--color-grey-2) 15%, transparent);
    box-shadow: var(--shadow-card);
  }
  .dv-video-lecteur {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .dv-video-lire {
    position: absolute;
    left: 50%;
    bottom: 6%;
    transform: translateX(-50%);
    gap: 12px;
    padding: 6px 22px 6px 6px;
    border-radius: 999px;
    white-space: nowrap;
  }
  /* Focus visible même sur l'aperçu bleu : contour Blue 1 entouré de blanc. */
  .dv-video-lire:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
    box-shadow: 0 0 0 6px var(--color-white);
  }
  .dv-video-lire[hidden] {
    display: none;
  }
  .dv-video-icone {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-blue);
  }
</style>
