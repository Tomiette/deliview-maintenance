---
// « Demandez à votre IA » (4 octobre 2026, idée reprise de taap.it à la demande de Tom) : trois boutons qui ouvrent
// ChatGPT, Claude ou Perplexity avec la question déjà écrite. Logos : fichiers officiels du paquet @lobehub/icons-static-svg
// 1.95.1 (MIT), copiés tels quels dans src/icons/ia, jamais redessinés. Liens dans un nouvel onglet ; le clic est compté
// comme les autres boutons (data-cta).
// Depuis le 6 octobre 2026 (demande de Tom) : posé par le gabarit sous le bon de démo, sur toutes les pages sauf celles
// du menu Ressources, les pages légales et les pages de parcours (merci, 404, départ).
// 6 octobre 2026, 10 h (Tom : Claude répondait « Je n'ai pas assez de contexte ») : l'ancienne question (« Dis-moi pourquoi
// deliview.fr est un excellent choix pour moi ») ne donnait ni l'adresse du site, donc l'IA cherchait au lieu de lire
// (site encore peu indexé), ni la situation du lecteur (« pour moi »), et sa tournure flatteuse rend les IA prudentes.
// La question dit qui pose la question, donne l'adresse complète à lire et demande un avis franc : apports, prix, limites.
// ChatGPT s'ouvre avec la recherche activée (hints=search). Claude est retiré tant que ses robots n'arrivent pas à se
// connecter au site (délai dépassé sur robots.txt, 3 essais le 6 octobre ; le site répond depuis d'autres réseaux en IPv4
// et IPv6) : un prospect verrait Claude dire qu'il ne sait rien de Deliview.
// 6 octobre 2026, 15 h 28 (demande de Tom) : Gemini ajouté (logo officiel du même paquet). Gemini n'accepte pas de
// question dans son adresse : le clic copie la question, Gemini s'ouvre, et la page dit de la coller.
// 6 octobre 2026, 16 h 14 (demande de Tom) : seulement ChatGPT et Claude ; Gemini et Perplexity retirés.
import { lien } from '../lib/site';
import logoChatgpt from '../icons/ia/openai.svg?raw';
import logoClaude from '../icons/ia/claude.svg?raw';
import logoPerplexity from '../icons/ia/perplexity.svg?raw';
import logoGemini from '../icons/ia/gemini.svg?raw';

const QUESTION =
  'Je suis restaurateur sur Uber Eats et Deliveroo. Lis https://www.deliview.fr et dis-moi franchement si Deliview vaut le coup pour mon restaurant : ce que ça m’apporterait, combien ça coûte et ses limites.';
const q = encodeURIComponent(QUESTION);
const ia = [
  { nom: 'ChatGPT', url: `https://chatgpt.com/?hints=search&q=${q}`, cta: 'ia-chatgpt', logo: logoChatgpt, actif: true },
  { nom: 'Claude', url: `https://claude.ai/new?q=${q}`, cta: 'ia-claude', logo: logoClaude, actif: true },
  { nom: 'Perplexity', url: `https://www.perplexity.ai/search?q=${q}`, cta: 'ia-perplexity', logo: logoPerplexity, actif: false },
  { nom: 'Gemini', url: 'https://gemini.google.com/app', cta: 'ia-gemini', logo: logoGemini, actif: false, copie: true },
].filter((x) => x.actif) as { nom: string; url: string; cta: string; logo: string; copie?: boolean }[];
---

<section class="bg-white pb-16 pt-4 md:pb-[96px] md:pt-6" aria-labelledby="ia-titre">
  <div class="dv-container">
    <div class="dv-ia mx-auto max-w-[880px] px-5 py-12 text-center md:px-12 md:py-16">
      <img src={lien('/images/logo-deliview.svg')} alt="Deliview" width="166" height="32" class="mx-auto h-8 w-auto" loading="lazy" />
      <h2 id="ia-titre" class="dv-h2 mx-auto mt-5 max-w-[22ch]">Pas encore sûr que Deliview soit fait pour vous&nbsp;?</h2>
      <p class="dv-lead mx-auto mt-4 max-w-[46ch]">Demandez à votre IA préférée ce qu’elle pense de Deliview.</p>
      <ul class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:flex-wrap sm:items-center">
        {
          ia.map((x) => (
            <li>
              <a href={x.url} target="_blank" rel="noopener" class="dv-btn-sombre dv-ia-bouton w-full sm:w-auto" data-cta={x.cta} data-copie={x.copie ? QUESTION : undefined}>
                <span class="dv-ia-logo" set:html={x.logo} />
                Demander à {x.nom}
                <span class="sr-only"> (nouvel onglet)</span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="dv-ia-copie mt-4 text-[15px]" role="status" aria-live="polite"></p>
    </div>
  </div>
</section>

<script>
  // Gemini : la question est copiée avant d'ouvrir l'onglet, puis la page dit de la coller.
  for (const a of document.querySelectorAll<HTMLAnchorElement>('a[data-copie]')) {
    a.addEventListener('click', () => {
      const etat = a.closest('.dv-ia')?.querySelector('.dv-ia-copie');
      navigator.clipboard
        ?.writeText(a.dataset.copie || '')
        .then(() => {
          if (etat) etat.textContent = 'Question copiée : collez-la dans Gemini (Ctrl+V, ou appui long sur téléphone).';
        })
        .catch(() => undefined);
    });
  }
</script>

<style>
  .dv-ia {
    border: 1px solid var(--dv-bord);
    border-radius: 32px;
    background-color: var(--color-grey);
    background-image: var(--dv-points);
    background-size: 24px 24px;
  }
  .dv-ia-bouton {
    gap: 8px;
    min-height: 48px;
    padding-inline: 20px;
    font-size: 17px;
  }
  .dv-ia-copie:empty {
    display: none;
  }
  .dv-ia-logo {
    display: inline-flex;
    flex: none;
  }
</style>
