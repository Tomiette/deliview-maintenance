---
// Tarifs : 3 abonnements selon le nombre de restaurants (OFFRES dans src/lib/site.ts), tableau comparatif, FAQ (FAQPage).
// Uniquement ce que Deliview fait aujourd'hui.
import Base from '../layouts/Base.astro';
import SectionDemo from '../components/SectionDemo.astro';
import Faq from '../components/Faq.astro';
import Icone from '../components/Icone.astro';
import { OFFRES, PRIX_ENTREE, SITE, jsonldLogiciel, lien } from '../lib/site';

const description = `Trois offres selon votre nombre de restaurants, dès ${PRIX_ENTREE} € HT par mois : sans engagement, mise en place offerte. Comparez Essentiel, Pro et Premium.`;

type Case = 'oui' | 'non' | string;
const comparatif: { libelle: string; valeurs: [Case, Case, Case] }[] = [
  { libelle: 'Restaurants inclus', valeurs: ['1', 'Jusqu’à 5', 'Jusqu’à 10'] },
  { libelle: 'Vos fiches Uber Eats et Deliveroo sur un seul écran', valeurs: ['oui', 'oui', 'oui'] },
  { libelle: 'Concurrents analysés par restaurant', valeurs: ['Jusqu’à 20', 'Jusqu’à 20', 'Jusqu’à 20'] },
  { libelle: 'Concurrents de votre choix suivis', valeurs: ['non', '3 par restaurant', '3 par restaurant'] },
  { libelle: 'Pricing Menu : chaque plat comparé, prix proposé avec ses sources', valeurs: ['oui', 'oui', 'oui'] },
  { libelle: 'Optimiseur menu : photos et descriptions passées en revue', valeurs: ['oui', 'oui', 'oui'] },
  { libelle: 'Promos des concurrents et classement des notes', valeurs: ['oui', 'oui', 'oui'] },
  { libelle: 'Changements depuis la dernière analyse', valeurs: ['oui', 'oui', 'oui'] },
  { libelle: 'Analyses', valeurs: ['1 par semaine', 'À la demande', 'À la demande'] },
  { libelle: 'Assistant Deliview', valeurs: ['non', 'oui', 'oui'] },
  { libelle: 'Historique des décisions de prix', valeurs: ['non', 'oui', 'oui'] },
  { libelle: 'Accès pour votre équipe', valeurs: ['2', '10', 'Illimités'] },
  { libelle: 'Un point chaque mois avec Tom', valeurs: ['non', 'non', 'oui'] },
  { libelle: 'Mise en place avec Tom', valeurs: ['Offerte', 'Offerte', 'Offerte'] },
  { libelle: 'Engagement', valeurs: ['Aucun', 'Aucun', 'Aucun'] },
];

const faq = [
  {
    q: 'Y a-t-il un engagement ?',
    r: 'Non. L’abonnement est mensuel et sans engagement&nbsp;: vous arrêtez quand vous voulez.',
  },
  {
    q: 'La mise en place est-elle payante ?',
    r: 'Non, elle est offerte. Tom crée votre compte avec vous, lance la première analyse et vous montre comment lire les résultats. Rien à installer&nbsp;: Deliview s’ouvre dans votre navigateur, sur tablette, ordinateur ou téléphone.',
  },
  {
    q: 'J’ai un seul restaurant : puis-je choisir Pro ou Premium ?',
    r: 'Oui. Le nombre de restaurants de chaque offre est un maximum, pas un minimum. Vous pouvez changer d’offre à tout moment.',
  },
  {
    q: 'Deliview remplace-t-il mes tablettes Uber Eats et Deliveroo ?',
    r: 'Non. Deliview réunit vos prix, vos notes et ceux de vos concurrents. Vos tablettes Uber Eats et Deliveroo restent là pour recevoir les commandes.',
  },
  {
    q: 'Faut-il donner mes identifiants Uber Eats ou Deliveroo ?',
    r: 'Non. Deliview lit les informations publiques de vos fiches&nbsp;: prix, notes, offres. Aucun accès à votre espace restaurant n’est demandé.',
  },
  {
    q: 'J’ai plus de 10 restaurants.',
    r: `Tom vous fait une offre sur mesure. Appelez-le au <a href="tel:${SITE.telephoneLien}">${SITE.telephone}</a> ou demandez une démo.`,
  },
  {
    q: 'Où sont hébergées mes données ?',
    r: 'Dans l’Union européenne&nbsp;: la base de données de Deliview est hébergée en Irlande. Le détail est dans notre <a href="' + lien('/confidentialite/') + '">politique de confidentialité</a>.',
  },
];

const texteBrut = (h: string) => h.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ');
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: texteBrut(x.r) } })),
};
const logiciel = {
  ...jsonldLogiciel(SITE.definition, SITE.url + '/tarifs/'),
  offers: OFFRES.map((o) => ({
    '@type': 'Offer',
    name: `Deliview ${o.nom}`,
    description: `${o.restaurants}. ${o.pour}.`,
    price: o.prix.toFixed(2),
    priceCurrency: 'EUR',
    url: `${SITE.url}/tarifs/#${o.slug}`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: o.prix,
      priceCurrency: 'EUR',
      unitText: 'mois',
      valueAddedTaxIncluded: false,
    },
  })),
};
---

<Base title="Tarifs : 3 offres selon vos restaurants | Deliview" description={description} ariane={[{ nom: 'Tarifs', chemin: '/tarifs/' }]} jsonld={[logiciel, faqPage]}>
  <section class="relative overflow-hidden bg-white">
    <div aria-hidden="true" class="pointer-events-none absolute -right-40 -top-40 hidden h-[520px] w-[520px] rounded-full bg-blue-2/12 md:block"></div>
    <div class="dv-container relative pb-10 pt-8 text-center md:pb-12 md:pt-12">
      <p class="dv-overline dv-muted">Tarifs</p>
      <h1 class="dv-h1 mx-auto mt-4 max-w-[20ch]">Un prix clair, selon le nombre de vos restaurants</h1>
      <p class="dv-lead mx-auto mt-5 max-w-[56ch]">Choisissez l’offre qui correspond à votre activité. Vous changez quand vous voulez, sans engagement.</p>
      <ul class="mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-[15px] font-semibold">
        <li class="inline-flex items-center gap-2"><span class="text-blue"><Icone nom="check" taille={18} /></span>Sans engagement</li>
        <li class="inline-flex items-center gap-2"><span class="text-blue"><Icone nom="check" taille={18} /></span>Mise en place offerte</li>
        <li class="inline-flex items-center gap-2"><span class="text-blue"><Icone nom="check" taille={18} /></span>Prix HT par mois</li>
      </ul>
    </div>
  </section>

  <section id="offres" class="bg-white pb-16 md:pb-24" aria-labelledby="offres-titre">
    <div class="dv-container">
      <h2 id="offres-titre" class="sr-only">Les trois offres</h2>
      <ul class="grid items-stretch gap-6 lg:grid-cols-3">
        {
          OFFRES.map((o) => (
            <li id={o.slug} class={`dv-card relative flex scroll-mt-28 flex-col p-6 md:p-8 ${o.recommandee ? 'border-2 !border-blue shadow-[0_12px_32px_rgba(76,76,76,0.10)]' : ''}`}>
              {o.recommandee && (
                <span class="absolute -top-3.5 left-6 rounded-full border-2 border-blue bg-white px-3 py-0.5 text-[14px] font-bold text-grey-2 md:left-8">Recommandé</span>
              )}
              <h3 class="dv-titre text-[28px]">{o.nom}</h3>
              <p class="mt-1 font-semibold">{o.restaurants}</p>
              <p class="mt-1 text-[16px] dv-muted lg:min-h-[52px]">{o.pour}</p>
              <p class="mt-6 flex items-end gap-2">
                <span class="dv-figure !text-[52px] !leading-none">{o.prix}&nbsp;€</span>
                <span class="pb-1 text-[16px] dv-muted">HT / mois</span>
              </p>
              <a
                href="#demo"
                class={`dv-btn mt-6 w-full ${o.recommandee ? 'dv-btn-plein' : 'dv-btn-contour'}`}
                data-cta={`tarifs-${o.slug}`}
                {...(o.recommandee ? { 'data-cta-principal': '' } : {})}
              >
                Choisir {o.nom}
              </a>
              {o.base && <p class="mt-6 font-semibold">{o.base}</p>}
              <ul class={`${o.base ? 'mt-3' : 'mt-6'} space-y-3 text-[16px]`}>
                {o.inclus.map((x) => (
                  <li class="flex gap-3">
                    <span class="mt-0.5 shrink-0 text-blue"><Icone nom="check" taille={20} /></span>
                    {x}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ul>
      <p class="mt-8 text-center dv-texte mx-auto">
        Plus de 10&nbsp;restaurants&nbsp;? Tom vous fait une offre sur mesure&nbsp;: <a href={`tel:${SITE.telephoneLien}`} class="font-semibold">{SITE.telephone}</a>.
      </p>
      <p class="mt-2 text-center text-[15px]">
        <a href={lien('/simulateur/')} class="font-semibold">Combien vous rapporte un prix mieux placé&nbsp;?</a>
      </p>
      <p class="mt-2 text-center text-[14px] dv-muted">
        Prix HT. Abonnement soumis aux <a href={lien('/cgv/')} class="underline underline-offset-2">conditions générales de vente</a>.
      </p>
    </div>
  </section>

  <section class="dv-section bg-grey" aria-labelledby="comparatif-titre">
    <div class="dv-container">
      <h2 id="comparatif-titre" class="dv-h2">Comparer les offres</h2>
      <div class="mt-8 overflow-x-auto rounded-[16px] border border-grey-2/15 bg-white" tabindex="0" role="region" aria-label="Comparatif des offres, défile horizontalement">
        <table class="w-full min-w-[680px] border-collapse text-left text-[16px]" aria-labelledby="comparatif-titre">
          <thead class="bg-grey">
            <tr>
              <th scope="col" class="p-4 font-semibold">Fonctionnalité</th>
              {OFFRES.map((o) => (
                <th scope="col" class="p-4 font-semibold">
                  {o.nom}
                  <span class="block text-[14px] font-normal dv-muted">{o.prix}&nbsp;€ HT / mois</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {
              comparatif.map((l) => (
                <tr class="border-t border-grey-2/15">
                  <th scope="row" class="p-4 font-normal">{l.libelle}</th>
                  {l.valeurs.map((c) => (
                    <td class="p-4">
                      {c === 'oui' ? (
                        <span class="inline-flex items-center gap-2 font-semibold">
                          <span class="text-blue"><Icone nom="check" taille={20} /></span>Inclus
                        </span>
                      ) : c === 'non' ? (
                        <span class="dv-muted">Non inclus</span>
                      ) : (
                        <span class="font-semibold">{c}</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <Faq questions={faq} />

  <SectionDemo section="tarifs-formulaire" titre="Choisissez votre offre avec Tom" sousTitre="Une démo de 15 minutes sur vos propres fiches : vous voyez ce que Deliview trouve pour votre restaurant, puis vous choisissez votre offre." />
</Base>
