---
// Accueil, direction « le passe » (maquettes validées le 2 octobre 2026, ordinateur et téléphone) : une seule histoire,
// dans l'ordre. Votre quotidien (deux tablettes qui sonnent), une seule tablette, vos chiffres face à votre zone
// (ticket Margherita), quelqu'un de réel pour vous accompagner, puis tarifs, questions et bon de démo.
import Base from '../layouts/Base.astro';
import CadreTablette from '../components/CadreTablette.astro';
import TicketComparaison from '../components/TicketComparaison.astro';
import Ticket from '../components/Ticket.astro';
import Marqueur from '../components/Marqueur.astro';
import Reassurance from '../components/Reassurance.astro';
import IllustrationTablettes from '../components/IllustrationTablettes.astro';
import HeroVideo from '../components/HeroVideo.astro';
import CarteFonctionnalite from '../components/CarteFonctionnalite.astro';
import BlocFondateur from '../components/BlocFondateur.astro';
import Faq from '../components/Faq.astro';
import SectionDemo from '../components/SectionDemo.astro';
import EtiquettePrix from '../icons/etiquette-prix.astro';
import Ardoise from '../icons/ardoise.astro';
import Etoile from '../icons/etoile.astro';
import Enveloppe from '../icons/enveloppe.astro';
import Toque from '../icons/toque.astro';
import Fleche from '../icons/fleche.astro';
import Lecture from '../icons/lecture.astro';
import { FAQ_ACCUEIL } from '../lib/faq';
import { EXEMPLE_MARGHERITA as ex, OFFRES, PILIERS, PRIX_ENTREE, SITE, euros, jsonldLogiciel, lien } from '../lib/site';

// Le quotidien : trois constats courts, accrochés à la barre du passe.
const constats = [
  { icone: EtiquettePrix, titre: 'Des prix fixés au feeling', texte: 'Votre voisin vend la même pizza plus cher. Vous ne le voyez pas.', inclinaison: -1.4 },
  { icone: Ardoise, titre: 'Une carte montée à la va-vite', texte: 'Des photos manquent, des descriptions sont vides. Personne n’a eu le temps d’y revenir.', inclinaison: 0.9 },
  { icone: Etoile, titre: 'Une note qui bouge', texte: 'Elle perd un dixième. Vous ne savez pas si c’est vous ou toute la zone.', inclinaison: -0.6 },
];

const etapes = [
  { icone: Enveloppe, titre: 'Une démo sur votre restaurant', texte: '15 minutes avec Tom, sur vos vrais prix.' },
  { icone: Toque, titre: 'La mise en place avec Tom', texte: 'Votre compte est prêt. Rien à installer.' },
  { icone: EtiquettePrix, titre: 'Vous ajustez vos prix et vos promos', texte: 'Plat par plat, avec les chiffres de votre zone.' },
];

// Fonctionnalités : une carte par pilier, dans l'ordre des maquettes.
const cartes = ['prix-et-concurrence', 'carte-et-marge', 'reputation'].map((slug) => PILIERS.find((p) => p.slug === slug)!);

const description = `Deliview centralise vos données Uber Eats et Deliveroo : vos prix face à votre zone, plat par plat, pour une livraison plus rentable. Dès ${PRIX_ENTREE} € HT par mois.`;

const video = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'Deliview en 1 minute',
  description: 'Présentation de Deliview : vos données Uber Eats et Deliveroo réunies, la veille de vos concurrents, un prix suggéré pour chaque plat et les alertes.',
  thumbnailUrl: SITE.url + '/video/deliview-video-couverture-16x9.webp',
  uploadDate: '2026-10-01',
  duration: 'PT1M10S',
  contentUrl: SITE.url + '/video/deliview-video-16x9.mp4',
  width: 1920,
  height: 1080,
  inLanguage: 'fr-FR',
};

const sousLaZone = euros(ex.mediane - ex.votrePrix, 0);
---

<Base title="Logiciel restaurant Uber Eats et Deliveroo | Deliview" description={description} jsonld={[jsonldLogiciel(SITE.definition, SITE.url + '/'), video]} precharger="/video/deliview-video-couverture-16x9.webp">
  <!-- Haut de page : slogan, promesse de rentabilité, définition, un seul bouton plein, réassurance ;
       la vidéo de présentation dans le cadre tablette (chargée au clic), le bouton « Voir Deliview en action » dessous,
       le ticket Margherita épinglé au coin de la vidéo (il s'écarte pendant la lecture), l'écart entouré au marqueur. -->
  <section class="overflow-hidden bg-grey pb-14 pt-7 md:pb-[104px] md:pt-[72px]" aria-labelledby="hero-titre" data-haut-de-page>
    <div class="dv-container grid items-center gap-x-14 gap-y-9 lg:grid-cols-2">
      <div>
        <p class="dv-overline">{SITE.slogan}</p>
        <h1 id="hero-titre" class="dv-h1 mt-3 md:mt-4 lg:max-w-[14ch]">Augmentez votre rentabilité sur Uber&nbsp;Eats et Deliveroo</h1>
        <p class="dv-lead mt-4 max-w-[50ch] md:mt-6">{SITE.definition}</p>
        <div class="mt-6 md:mt-8">
          <a href="#demo" class="dv-btn dv-btn-plein w-full sm:w-auto sm:px-7" data-cta="hero" data-cta-principal>Demander une démo</a>
        </div>
        <Reassurance class="mt-[18px] md:mt-6" />
      </div>
      <div class="dv-hero-visuel" data-video-zone>
        <HeroVideo />
        <div class="dv-hero-actions">
          <button type="button" class="dv-btn dv-btn-bleu dv-hero-voir" data-video-lire data-cta="video-haut-de-page" aria-controls="video-deliview">
            <Lecture taille={24} />Voir Deliview en action
          </button>
          <TicketComparaison exemple={ex} format="haut-de-page" apparition="arrivee" class="dv-hero-ticket" />
        </div>
      </div>
    </div>
  </section>

  <!-- Le quotidien : les deux tablettes qui sonnent, dessinées au trait, et trois constats accrochés à la barre. -->
  <section class="dv-section bg-white" aria-labelledby="quotidien-titre">
    <div class="dv-container dv-quotidien">
      <div class="dv-quotidien-intro">
        <p class="dv-overline">Le quotidien</p>
        <h2 id="quotidien-titre" class="dv-h2 mt-2.5 max-w-[16ch] md:mt-3">Vendredi, 20&nbsp;h&nbsp;30. Les deux tablettes sonnent.</h2>
        <p class="dv-lead mt-3.5 max-w-[46ch] md:mt-5">Vous êtes en plein service. Pendant ce temps, trois choses vous échappent.</p>
      </div>
      <figure class="dv-quotidien-dessin m-0">
        <IllustrationTablettes />
      </figure>
      <div class="dv-quotidien-bons">
        <div class="dv-barre" aria-hidden="true"></div>
        <ul class="grid gap-5 px-2.5 md:grid-cols-3 md:gap-9 md:px-7">
          {
            constats.map((c, i) => (
              <Ticket balise="li" dents="bas" inclinaison={c.inclinaison} class="origin-top" papier="px-5 pb-4 pt-[18px] md:px-6 md:pb-5 md:pt-[22px]" apparition="defilement">
                <p class="flex items-center justify-between">
                  <span class="font-accent text-[12px] font-semibold uppercase leading-none tracking-[0.08em] dv-muted md:text-[13px]">Bon n°&nbsp;0{i + 1}</span>
                  <c.icone taille={32} />
                </p>
                <h3 class="mt-3 font-accent text-[20px] font-bold leading-[1.25] md:mt-[18px] md:text-[23px]">{c.titre}</h3>
                <p class="mt-1.5 text-[16px] leading-[1.5] dv-muted md:mt-2.5 md:text-[17px] md:leading-[1.55]">{c.texte}</p>
              </Ticket>
            ))
          }
        </ul>
      </div>
      <p id="pour-qui" class="dv-quotidien-cible max-w-[46ch] scroll-mt-28 border-t border-grey-2/15 pt-5 text-[16px] font-semibold leading-[1.5] md:text-[17px]">
        Pizzerias, burgers, kebabs, snacks, dark kitchens&nbsp;: de 1 à 10&nbsp;restaurants.
      </p>
    </div>
  </section>

  <!-- La bascule : une seule tablette, la vraie capture de l'écran qui réunit Uber Eats et Deliveroo. -->
  <section class="dv-section bg-grey" aria-labelledby="bascule-titre">
    <div class="dv-container dv-bascule">
      <div class="dv-bascule-texte">
        <p class="dv-overline">La bascule</p>
        <h2 id="bascule-titre" class="mt-2.5 font-accent text-[34px] font-bold leading-[1.08] tracking-[-0.015em] md:mt-3 md:text-[52px]">Une seule tablette.</h2>
        <p class="dv-lead mt-3.5 md:mt-5">Uber&nbsp;Eats et Deliveroo réunis sur un seul écran. Vos prix, votre carte et votre note, face aux restaurants de votre zone.</p>
      </div>
      <div class="dv-bascule-tablette relative pt-[76px] md:pt-[84px]">
        <p class="dv-annotation absolute left-0 top-0 max-w-[230px] -rotate-2 md:left-1 md:top-1 md:max-w-none">Uber&nbsp;Eats et Deliveroo, côte à côte</p>
        <Marqueur forme="fleche" class="dv-bascule-fleche" />
        <CadreTablette
          capture={{
            src: '/images/capture-tableau',
            largeurs: [800, 1300],
            largeur: 1300,
            hauteur: 812,
            alt: 'Écran Mon restaurant dans Deliview : Uber Eats et Deliveroo côte à côte, avec la note, le prix médian et le rang dans la zone, puis les actions à fort impact',
          }}
          sizes="(min-width: 1200px) 700px, (min-width: 1024px) 58vw, 100vw"
        />
      </div>
      <p class="dv-bascule-note text-[16px] leading-[1.6] dv-muted md:text-[17px]">Rien à installer. Vos tablettes de commande restent là pour les commandes.</p>
    </div>
  </section>

  <!-- Comment ça marche : 3 étapes numérotées en Aspekta, une icône pour chacune (la vidéo est en haut de page). -->
  <section id="comment-ca-marche" class="dv-section bg-white" aria-labelledby="etapes-titre">
    <div class="dv-container">
      <p class="dv-overline">Comment ça marche</p>
      <h2 id="etapes-titre" class="dv-h2 mt-2.5 max-w-[22ch] md:mt-3">De la démo à vos premiers prix revus</h2>
      <ol class="mt-8 grid gap-8 md:mt-14 md:grid-cols-3 md:gap-12">
        {
          etapes.map((e, i) => (
            <li class="grid grid-cols-[48px_1fr] gap-x-4 md:block">
              <div class="row-span-2 md:flex md:items-center md:gap-[18px]">
                <span class="hidden font-accent text-[48px] font-bold leading-none text-blue md:inline" aria-hidden="true">{i + 1}</span>
                <e.icone taille={48} />
                {i < etapes.length - 1 && <span class="hidden flex-1 border-t-2 border-dashed border-grey-2/25 md:block" aria-hidden="true" />}
              </div>
              <div>
                <p class="font-accent text-[32px] font-bold leading-none text-blue md:hidden" aria-hidden="true">{i + 1}</p>
                <h3 class="mt-2 font-accent text-[20px] font-bold leading-[1.25] md:mt-[22px] md:text-[24px]">{e.titre}</h3>
                <p class="mt-1.5 text-[16px] leading-[1.55] dv-muted md:mt-2 md:text-[18px] md:leading-[1.6]">{e.texte}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Fonctionnalités : une carte par pilier, avec la vraie capture. -->
  <section class="dv-section bg-grey" aria-labelledby="fonctions-titre">
    <div class="dv-container">
      <p class="dv-overline">Ce que fait Deliview</p>
      <h2 id="fonctions-titre" class="dv-h2 mt-2.5 max-w-[24ch] md:mt-3">Vos prix, votre carte, votre note. Face à votre zone.</h2>
      <ul class="mt-8 grid gap-5 md:mt-12 lg:grid-cols-3 lg:gap-6">
        {cartes.map((p) => <CarteFonctionnalite icone={p.icone} nom={p.surtitre} benefice={p.carte.benefice} points={p.carte.points} capture={p.carte.capture} href={`/solution/${p.slug}/`} />)}
      </ul>
    </div>
  </section>

  <!-- Exemple réel : le ticket Margherita (vraie analyse, restaurant anonymisé), puis le simulateur. -->
  <section class="dv-section bg-white" aria-labelledby="exemple-titre">
    <div class="dv-container dv-exemple">
      <div class="dv-exemple-intro">
        <p class="dv-overline">Exemple réel</p>
        <h2 id="exemple-titre" class="dv-h2 mt-2.5 max-w-[18ch] md:mt-3">Une Margherita vendue {sousLaZone} sous le prix de sa zone</h2>
        <p class="dv-lead mt-3.5 max-w-[48ch] md:mt-5">
          Une pizzeria analysée le 1<sup>er</sup>&nbsp;octobre 2026 sur Uber&nbsp;Eats. {ex.concurrents}&nbsp;concurrents vendent la même pizza, à la même taille.
        </p>
      </div>
      <div class="dv-exemple-plateau dv-plateau flex flex-col items-center px-4 pb-7 pt-8 md:px-8 md:pb-10 md:pt-12">
        <TicketComparaison exemple={ex} proposition inclinaison={-1.5} />
        <p class="dv-annotation mt-6 -rotate-2 text-center md:mt-7">{sousLaZone} sous la zone, sur chaque pizza</p>
      </div>
      <div class="dv-exemple-suite">
        <p class="dv-lead max-w-[48ch]">
          Deliview propose {euros(ex.prixPropose)}, une première hausse avant la médiane si les ventes tiennent. Sur 100&nbsp;Margherita vendues, c’est {euros(ex.gainPour100, 0)} de plus.
        </p>
        <a href={lien('/simulateur/')} class="dv-btn dv-btn-contour mt-6 w-full sm:w-auto md:mt-8" data-cta="exemple-simulateur">Combien vous rapporte un prix bien placé&nbsp;?</a>
        <p class="mt-3.5 text-[14px] leading-[1.5] dv-muted md:mt-4 md:text-[15px]">Restaurant anonymisé. Chiffres tirés d’une vraie analyse Deliview.</p>
      </div>
    </div>
  </section>

  <BlocFondateur />

  <!-- Tarifs en bref : trois tickets d'offre, Pro souligné au marqueur. -->
  <section class="dv-section bg-white" aria-labelledby="tarifs-titre">
    <div class="dv-container">
      <p class="dv-overline">Tarifs</p>
      <h2 id="tarifs-titre" class="dv-h2 mt-2.5 max-w-[24ch] md:mt-3">Un prix fixe par mois, sans engagement</h2>
      <p class="dv-lead mt-3 md:mt-4">Selon votre nombre de restaurants. La mise en place est offerte.</p>
      <ul class="mt-8 grid items-end gap-6 px-1 md:mt-14 md:grid-cols-3 md:gap-8 md:px-0">
        {
          OFFRES.map((o) => (
            <Ticket balise="li" papier="px-5 pb-5 pt-[18px] md:px-[26px] md:pb-[26px] md:pt-[22px]">
              <div class="flex items-baseline justify-between gap-3">
                <h3 class="relative font-accent text-[22px] font-bold leading-[1.2] md:text-[24px]">
                  {o.nom}
                  {o.recommandee && <span class="sr-only">, offre recommandée</span>}
                  {o.recommandee && <Marqueur forme="soulignement" />}
                </h3>
                <span class="text-[15px] leading-[1.3] dv-muted md:hidden">{o.restaurants}</span>
                {o.recommandee && <span class="dv-annotation hidden md:inline" aria-hidden="true">Recommandé</span>}
              </div>
              <p class="mt-1.5 hidden text-[16px] leading-[1.4] dv-muted md:block">{o.restaurants}</p>
              <div class="dv-pointilles my-4 hidden md:block" aria-hidden="true" />
              <p class="mt-3 flex items-baseline gap-2 md:mt-0">
                <span class="font-accent text-[36px] font-bold leading-none md:text-[48px]">{o.prix}&nbsp;€</span>
                <span class="text-[15px] leading-[1.3] md:text-[16px]">HT par mois</span>
              </p>
              {o.recommandee && <p class="dv-annotation mt-2.5 md:hidden" aria-hidden="true">Recommandé</p>}
              <p class="mt-3.5 hidden text-[16px] leading-[1.5] md:block">{o.pour}.</p>
            </Ticket>
          ))
        }
      </ul>
      <a href={lien('/tarifs/')} class="dv-lien-fort mt-5 md:mt-8">Voir le détail des offres<Fleche taille={24} /></a>
    </div>
  </section>

  <Faq questions={FAQ_ACCUEIL} titre="Ce qu’on demande à Tom avant une démo" id="questions" />

  <SectionDemo section="accueil-formulaire" />
</Base>
