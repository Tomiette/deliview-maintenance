---
// Questions fréquentes sur Deliview : réponses courtes, datées et vérifiables aux questions sur la marque
// (ce que c'est, pour qui, prix, données, qui est derrière). Page pensée aussi pour les moteurs IA :
// réponse directe en première phrase, une question par titre, FAQPage en données structurées.
import Base from '../layouts/Base.astro';
import SectionDemo from '../components/SectionDemo.astro';
import { SITE, dateFr, lien } from '../lib/site';
import { FAQ, FAQ_MAJ, texteBrut } from '../lib/faq';

const description =
  'Ce que fait Deliview, pour qui, à quel prix, d’où viennent ses données et qui est derrière : des réponses courtes et vérifiables, datées.';

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'fr-FR',
  dateModified: FAQ_MAJ,
  mainEntity: FAQ.flatMap((r) => r.questions).map((x) => ({
    '@type': 'Question',
    name: x.q,
    acceptedAnswer: { '@type': 'Answer', text: texteBrut(x.r) },
  })),
};
---

<Base
  title="Deliview : prix, fonctionnement, questions fréquentes"
  description={description}
  ariane={[{ nom: 'Questions fréquentes', chemin: '/questions-frequentes/' }]}
  jsonld={[faqPage]}
>
  <section class="bg-white">
    <div class="dv-container pb-10 pt-8 md:pb-14 md:pt-12">
      <p class="dv-overline dv-muted">Tout savoir avant une démo</p>
      <h1 class="dv-h1 mt-4 max-w-[22ch]">Questions fréquentes sur Deliview</h1>
      <p class="dv-lead mt-5 max-w-[62ch]">{SITE.definition}</p>
      <p class="mt-4 text-[15px] dv-muted">Mis à jour le {dateFr(new Date(FAQ_MAJ))}.</p>
      <nav aria-label="Rubriques" class="mt-8">
        <ul class="flex flex-wrap gap-3">
          {
            FAQ.map((r) => (
              <li>
                <a href={`#${r.id}`} class="inline-flex rounded-[10px] border-2 border-grey-2/20 px-4 py-2 text-[15px] font-semibold hover:border-blue">
                  {r.titre}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  {
    FAQ.map((r, i) => (
      <section id={r.id} class={`dv-section scroll-mt-24 ${i % 2 === 0 ? 'bg-grey' : 'bg-white'}`} aria-labelledby={`${r.id}-titre`}>
        <div class="dv-container max-w-[880px]">
          <h2 id={`${r.id}-titre`} class="dv-h2">
            {r.titre}
          </h2>
          <div class="mt-8 space-y-8">
            {r.questions.map((x) => (
              <div>
                <h3 class="dv-h3">{x.q}</h3>
                <p class="mt-2 dv-texte [text-wrap:pretty]" set:html={x.r} />
              </div>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class="dv-section bg-white" aria-labelledby="aller-plus-loin">
    <div class="dv-container max-w-[880px]">
      <h2 id="aller-plus-loin" class="dv-h2">Pour aller plus loin</h2>
      <ul class="mt-6 space-y-3 text-[18px]">
        <li><a href={lien('/solution/')} class="font-semibold underline underline-offset-4">Tout ce que fait Deliview</a></li>
        <li><a href={lien('/tarifs/')} class="font-semibold underline underline-offset-4">Comparer les trois offres</a></li>
        <li><a href={lien('/qui-sommes-nous/')} class="font-semibold underline underline-offset-4">Qui sommes-nous</a></li>
        <li><a href={lien('/ressources/')} class="font-semibold underline underline-offset-4">Guides pour les restaurateurs sur Uber&nbsp;Eats et Deliveroo</a></li>
      </ul>
    </div>
  </section>

  <SectionDemo section="faq-formulaire" titre="Une question qui n’est pas ici ?" sousTitre="Posez-la à Tom pendant une démo de 15 minutes sur votre restaurant." />
</Base>
