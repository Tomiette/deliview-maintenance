---
// « Deliview est-il fiable ? » (4 octobre 2026, demande de Tom) : les faits vérifiables sur l'éditeur, les prix, les
// contrats, les données, l'accès aux comptes et le contact, chacun avec son lien. Page de marque pour les recherches
// « Deliview avis », « Deliview fiable », « Deliview arnaque » et pour les moteurs IA : réponse directe en tête,
// une question par titre, FAQPage en données structurées. Aucun concurrent cité, aucun chiffre non vérifiable.
import Base from '../layouts/Base.astro';
import SectionDemo from '../components/SectionDemo.astro';
import Pastille from '../components/Pastille.astro';
import Fleche from '../icons/fleche.astro';
import { OFFRES, SITE, dateFr, lien } from '../lib/site';
import { texteBrut } from '../lib/faq';

const MAJ = '2026-10-04';
// Fiche officielle de l'entreprise (registre national, data.gouv.fr).
const ANNUAIRE = 'https://annuaire-entreprises.data.gouv.fr/entreprise/102681509';
const prix = OFFRES.map((o) => `${o.nom}&nbsp;: ${o.prix}&nbsp;€&nbsp;HT par mois, ${o.restaurants.toLowerCase()}`).join(' ; ');

const reponse =
  'Deliview est édité par DELIVIEW SAS, une société française immatriculée au registre du commerce d’Alençon (SIREN 102&nbsp;681&nbsp;509) et présidée par son fondateur, Tom Voisin. Ses prix, ses contrats et l’hébergement de vos données sont publics. Deliview est un logiciel jeune&nbsp;: la démo se fait donc sur votre propre restaurant, avant tout paiement.';

const questions: { id: string; q: string; r: string; liens: { libelle: string; href: string }[] }[] = [
  {
    id: 'editeur',
    q: 'Qui est-ce que je paie, exactement ?',
    r: 'DELIVIEW, société par actions simplifiée dont le siège est au 9&nbsp;rue Maurice Hubert, 61340 Berd’Huis. Elle est immatriculée au registre du commerce et des sociétés d’Alençon sous le numéro 102&nbsp;681&nbsp;509. Numéro de TVA intracommunautaire&nbsp;: FR87102681509. Son président est Tom Voisin.',
    liens: [
      { libelle: 'Fiche officielle sur l’Annuaire des entreprises', href: ANNUAIRE },
      { libelle: 'Mentions légales', href: lien('/mentions-legales/') },
    ],
  },
  {
    id: 'fondateur',
    q: 'Qui est derrière Deliview ?',
    r: 'Tom Voisin, fondateur de Deliview. Il a lui-même été sur Uber&nbsp;Eats et Deliveroo. Deliview est le résultat d’un an sur le terrain, auprès des restaurants qui livrent. C’est lui qui fait les démos et la mise en place.',
    liens: [
      { libelle: 'Qui sommes-nous', href: lien('/qui-sommes-nous/') },
      { libelle: 'Tom Voisin sur LinkedIn', href: SITE.linkedinTom },
    ],
  },
  {
    id: 'prix',
    q: 'Combien me coûte Deliview, sans surprise ?',
    r: `Les prix sont publics&nbsp;: ${prix}. Au-delà de 10&nbsp;restaurants, Tom fait une offre sur mesure. La mise en place est offerte. L’abonnement est mensuel et sans engagement&nbsp;: vous arrêtez quand vous voulez.`,
    liens: [
      { libelle: 'Tarifs', href: lien('/tarifs/') },
      { libelle: 'Conditions générales de vente', href: lien('/cgv/') },
    ],
  },
  {
    id: 'contrats',
    q: 'Quels contrats est-ce que je peux lire avant de m’abonner ?',
    r: 'Tous, sans compte ni démo&nbsp;: les conditions générales de vente, les conditions d’utilisation, l’accord de sous-traitance des données (RGPD), la politique de confidentialité et les mentions légales.',
    liens: [
      { libelle: 'Conditions générales de vente', href: lien('/cgv/') },
      { libelle: 'Conditions d’utilisation', href: lien('/conditions-utilisation/') },
      { libelle: 'Accord de sous-traitance des données', href: lien('/accord-sous-traitance/') },
      { libelle: 'Politique de confidentialité', href: lien('/confidentialite/') },
    ],
  },
  {
    id: 'donnees',
    q: 'Où sont hébergées mes données ?',
    r: 'Dans l’Union européenne&nbsp;: la base de données de Deliview est hébergée en Irlande, chez Supabase. Le site et l’app sont hébergés par OVH, société française.',
    liens: [{ libelle: 'Politique de confidentialité', href: lien('/confidentialite/') }],
  },
  {
    id: 'acces',
    q: 'Comment Deliview accède à mes comptes Uber Eats et Deliveroo ?',
    r: 'Par une invitation d’utilisateur, que vous envoyez une fois depuis Uber&nbsp;Eats Manager et depuis le Partner Hub de Deliveroo. Jamais avec votre mot de passe. Vous retirez cet accès quand vous voulez, depuis la plateforme. Deliview est un logiciel indépendant, ni affilié ni approuvé par Uber&nbsp;Eats ou Deliveroo.',
    liens: [{ libelle: 'Questions fréquentes sur le fonctionnement', href: lien('/questions-frequentes/#fonctionnement') }],
  },
  {
    id: 'references',
    q: 'Est-ce que Deliview a des références ?',
    r: 'Deliview est récent et ne publie pas encore d’avis de clients. Pour juger sur pièces, la démo de 30&nbsp;minutes se fait sur votre restaurant, avec vos vrais prix et vos vrais concurrents, avant tout paiement. Ensuite, l’abonnement reste sans engagement.',
    liens: [{ libelle: 'Demander une démo', href: lien('/demo/') }],
  },
  {
    id: 'contact',
    q: 'Comment je joins Deliview ?',
    r: `Par e-mail à <a href="mailto:${SITE.email}">${SITE.email}</a>, une adresse du domaine deliview.fr, comme le site. C’est Tom qui répond. Après une demande de démo, il vous rappelle sous 3&nbsp;h.`,
    liens: [{ libelle: 'Demander une démo', href: lien('/demo/') }],
  },
];

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'fr-FR',
  dateModified: MAJ,
  about: { '@type': 'Organization', name: SITE.nom, url: SITE.url },
  mainEntity: [
    { '@type': 'Question', name: 'Deliview est-il fiable ?', acceptedAnswer: { '@type': 'Answer', text: texteBrut(reponse) } },
    ...questions.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: texteBrut(x.r) } })),
  ],
};
---

<Base
  title="Deliview est-il fiable ? Les faits à vérifier | Deliview"
  description="Société, SIREN, prix, contrats, hébergement des données et contact : tout ce que vous pouvez vérifier sur Deliview avant une démo, avec les liens."
  ariane={[{ nom: 'Deliview est-il fiable ?', chemin: '/deliview-est-il-fiable/' }]}
  jsonld={[faqPage]}
>
  <section class="bg-grey pb-12 pt-6 md:pb-16 md:pt-10" aria-labelledby="fiable-titre" data-haut-de-page>
    <div class="dv-container">
      <Pastille>Tout se vérifie</Pastille>
      <h1 id="fiable-titre" class="dv-h1 mt-5 max-w-[22ch] md:mt-6">Deliview est-il fiable ?</h1>
      <p class="dv-lead mt-4 max-w-[62ch] md:mt-6" set:html={reponse} />
      <p class="mt-4 text-[15px] dv-muted">Mis à jour le {dateFr(new Date(MAJ))}.</p>
      <nav aria-label="Rubriques" class="mt-8">
        <ul class="flex flex-wrap gap-2">
          {
            questions.map((x) => (
              <li>
                <a href={`#${x.id}`} class="dv-puce-lien">
                  {x.q}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="faits-titre">
    <div class="dv-container max-w-[860px]">
      <h2 id="faits-titre" class="sr-only">Les faits, un par un</h2>
      <div class="grid gap-4">
        {
          questions.map((x) => (
            <section id={x.id} class="dv-card scroll-mt-24 px-6 py-5 md:px-8 md:py-6" aria-labelledby={`${x.id}-q`}>
              <h3 id={`${x.id}-q`} class="font-accent text-[19px] font-bold leading-[1.35] md:text-[21px]">
                {x.q}
              </h3>
              <p class="mt-2 dv-texte text-[17px] leading-[1.6] [text-wrap:pretty] md:text-[18px]" set:html={x.r} />
              <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
                {x.liens.map((l) => (
                  <li>
                    <a href={l.href} class="dv-lien inline-flex min-h-11 items-center" rel={l.href.startsWith('http') ? 'noopener' : undefined}>
                      {l.libelle}
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>

  <section class="dv-section bg-grey dv-points" aria-labelledby="aller-plus-loin">
    <div class="dv-container max-w-[860px]">
      <h2 id="aller-plus-loin" class="dv-h2">Pour aller plus loin</h2>
      <ul class="mt-6 grid gap-1">
        <li><a href={lien('/solution/')} class="dv-lien-fort">Ce que fait Deliview<Fleche taille={24} /></a></li>
        <li><a href={lien('/questions-frequentes/')} class="dv-lien-fort">Questions fréquentes<Fleche taille={24} /></a></li>
        <li><a href={lien('/tarifs/')} class="dv-lien-fort">Comparer les trois offres<Fleche taille={24} /></a></li>
      </ul>
    </div>
  </section>

  <SectionDemo section="fiable-formulaire" titre="Voyez Deliview sur votre restaurant" sousTitre="30 minutes avec Tom, sur vos vrais prix et vos vrais concurrents, avant tout paiement." />
</Base>
