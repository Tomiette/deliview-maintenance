---
// Gabarit commun : balises, données structurées, en-tête, pied de page, mouvement discret (direction « le passe »).
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DemanderIA from '../components/DemanderIA.astro';
import { SITE, lien } from '../lib/site';
import aspekta400 from '../fonts/Aspekta-400.woff2?url';
import aspekta700 from '../fonts/Aspekta-700.woff2?url';

interface Props {
  title: string;
  description: string;
  // Fil d'Ariane (toutes les pages sauf l'accueil) : [{ nom, chemin }]
  ariane?: { nom: string; chemin: string }[];
  jsonld?: Record<string, unknown>[];
  ogType?: 'website' | 'article';
  // Pages sans intérêt dans les moteurs (merci, 404).
  noindex?: boolean;
  // Image principale du haut de page (LCP), préchargée : chemin du site, sans la base,
  // ou jeu d'images responsive (srcset et sizes déjà préfixés, comme dans la balise img).
  // `media` : préchargée seulement quand l'image est en haut de l'écran (ordinateur), jamais sur téléphone.
  precharger?: string | { srcset: string; sizes: string; media?: string };
  // Fond du haut de page (le fil d'Ariane le prolonge) : papier gris par défaut, comme les maquettes.
  fondHaut?: 'gris' | 'blanc';
  // Bouton démo fixé en bas de l'écran du téléphone (faux sur la page de départ /commencer/).
  barreDemo?: boolean;
  // Bloc « Demandez à votre IA » avant le pied de page (6 octobre 2026, demande de Tom) : partout sauf les pages du menu
  // Ressources, les pages légales et les pages de parcours. Forcé à vrai ou faux par la page si besoin.
  ia?: boolean;
}

const { title, description, ariane = [], jsonld = [], ogType = 'website', noindex = false, precharger, fondHaut = 'gris', barreDemo = true, ia } = Astro.props;
const chemin = '/' + Astro.url.pathname.replace(import.meta.env.BASE_URL, '').replace(/^\/+/, '');
const SANS_IA = /^\/(ressources|integrations|questions-frequentes|qui-sommes-nous|mentions-legales|cgv|conditions-utilisation|confidentialite|accord-sous-traitance|merci|commencer|analyse|404)(\/|$)/;
const avecIA = ia ?? (!noindex && !SANS_IA.test(chemin));
const canonical = new URL(Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/', SITE.url).href;
// Aperçu (SITE_BASE ≠ /) : jamais indexé.
const apercu = import.meta.env.BASE_URL !== '/';
// Pages indexables : extraits et aperçus d'images sans limite (résultats enrichis, réponses des moteurs IA).
const robots = apercu ? 'noindex, nofollow' : noindex ? 'noindex, follow' : 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1';
const ogImage = new URL(lien('/images/partage.png'), Astro.site).href;

const organisation = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.nom,
  legalName: 'DELIVIEW',
  url: SITE.url,
  logo: SITE.url + '/images/logo-deliview.png',
  vatID: 'FR87102681509',
  identifier: { '@type': 'PropertyValue', propertyID: 'SIREN', value: '102681509' },
  address: { '@type': 'PostalAddress', streetAddress: '9 rue Maurice Hubert', postalCode: '61340', addressLocality: 'Berd’Huis', addressCountry: 'FR' },
  description: SITE.definition,
  slogan: SITE.slogan,
  email: SITE.email,
  areaServed: 'FR',
  // Profils officiels et fiche au registre national des entreprises (même entité partout, 4 octobre 2026).
  sameAs: [SITE.linkedinEntreprise, 'https://annuaire-entreprises.data.gouv.fr/entreprise/102681509'],
  knowsAbout: ['Uber Eats', 'Deliveroo', 'Livraison de repas', 'Prix des restaurants en livraison', 'Analyse de la concurrence des restaurants'],
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    email: SITE.email,
    areaServed: 'FR',
    availableLanguage: 'French',
  },
  founder: { '@type': 'Person', name: 'Tom Voisin', url: SITE.url + '/qui-sommes-nous/#tom', sameAs: [SITE.linkedinTom] },
};
const siteWeb = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.nom,
  url: SITE.url,
  inLanguage: 'fr-FR',
  description: SITE.definition,
  publisher: { '@type': 'Organization', name: SITE.nom, url: SITE.url },
};
const fil = ariane.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ nom: 'Accueil', chemin: '/' }, ...ariane].map((x, i) => ({
        '@type': 'ListItem',
        position: i + 1,
        name: x.nom,
        item: new URL(x.chemin, SITE.url).href,
      })),
    }
  : null;
const donnees = [organisation, siteWeb, ...(fil ? [fil] : []), ...jsonld];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robots && <meta name="robots" content={robots} />}
    {!apercu && SITE.verificationGoogle && <meta name="google-site-verification" content={SITE.verificationGoogle} />}
    {!apercu && SITE.verificationBing && <meta name="msvalidate.01" content={SITE.verificationBing} />}
    <meta name="theme-color" content="#5282ff" />
    <link rel="icon" href={lien('/favicon.ico')} sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href={lien('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="192x192" href={lien('/favicon-192.png')} />
    <link rel="apple-touch-icon" href={lien('/apple-touch-icon.png')} />
    <link rel="preload" href={aspekta400} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={aspekta700} as="font" type="font/woff2" crossorigin />
    {typeof precharger === 'string' && <link rel="preload" as="image" href={lien(precharger)} fetchpriority="high" />}
    {precharger && typeof precharger === 'object' && <link rel="preload" as="image" imagesrcset={precharger.srcset} imagesizes={precharger.sizes} media={precharger.media} fetchpriority="high" />}
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Deliview" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Deliview, le partenaire des restaurants en livraison : vos données Uber Eats et Deliveroo face à votre zone" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="Deliview, le partenaire des restaurants en livraison : vos données Uber Eats et Deliveroo face à votre zone" />
    {donnees.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
    <!-- Mouvement discret seulement si le visiteur ne demande pas moins d'animations (posé avant le premier affichage). -->
    <script is:inline>
      if (window.matchMedia && matchMedia('(prefers-reduced-motion: no-preference)').matches) document.documentElement.classList.add('dv-mouvement');
    </script>
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 dv-btn dv-btn-contour">Aller au contenu</a>
    <Header />
    <main id="contenu" class="flex-1">
      {
        ariane.length > 0 && (
          <nav aria-label="Fil d’Ariane" class={`dv-ariane ${fondHaut === 'gris' ? 'bg-grey' : 'bg-white'}`}>
            <ol class="dv-container flex flex-wrap items-center gap-x-2 gap-y-1 pt-5 text-[15px] dv-muted md:pt-6">
              <li>
                <a href={lien('/')} class="underline underline-offset-2">Accueil</a>
              </li>
              {ariane.map((x, i) => (
                <li class="flex items-center gap-2">
                  <span aria-hidden="true">/</span>
                  {i === ariane.length - 1 ? (
                    <span aria-current="page">{x.nom}</span>
                  ) : (
                    <a href={lien(x.chemin)} class="underline underline-offset-2">{x.nom}</a>
                  )}
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <slot />
      {avecIA && <DemanderIA />}
    </main>
    <Footer barreDemo={barreDemo} />
    <script>
      import '../scripts/mouvement';
      import '../scripts/tableaux';
    </script>
  </body>
</html>
