---
// Page pilier (gabarit unique pour les 3 piliers) : hero, fonctionnalités, méthode, FAQ, autres piliers, démo.
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Capture from '../../components/Capture.astro';
import PhotoIA from '../../components/PhotoIA.astro';
import BandeauPlateformes from '../../components/BandeauPlateformes.astro';
import SectionDemo from '../../components/SectionDemo.astro';
import Faq from '../../components/Faq.astro';
import Icone from '../../components/Icone.astro';
import { PILIERS, SITE, jsonldLogiciel, lien, type Pilier } from '../../lib/site';

export function getStaticPaths() {
  return PILIERS.map((p) => ({ params: { slug: p.slug }, props: { pilier: p } }));
}

const { pilier } = Astro.props as { pilier: Pilier };
const autres = PILIERS.filter((p) => p.slug !== pilier.slug);
const articles = (await getCollection('ressources', (a) => !a.data.brouillon && a.data.theme === pilier.slug)).sort(
  (a, b) => b.data.misAJourLe.getTime() - a.data.misAJourLe.getTime(),
);

type Icon = 'prix' | 'zone' | 'alerte' | 'note' | 'carte' | 'commandes' | 'check' | 'source' | 'equipe' | 'promo' | 'plateformes';
const ICONES: Record<string, Icon[]> = {
  'prix-et-concurrence': ['prix', 'zone', 'check', 'promo', 'alerte'],
  'carte-et-marge': ['carte', 'source', 'prix', 'check', 'equipe'],
  reputation: ['note', 'equipe', 'note', 'source', 'alerte'],
};

// Méthode (réponse directe d'abord) et questions propres à chaque pilier.
const CONTENU: Record<string, { methodeTitre: string; reponse: string; points: string[]; faq: { q: string; r: string }[] }> = {
  'prix-et-concurrence': {
    methodeTitre: 'Comment Deliview compare vos prix',
    reponse:
      'Deliview ne compare que des plats comparables&nbsp;: même type, même taille. Votre pizza 33&nbsp;cm face aux pizzas 33&nbsp;cm des voisins, vos menus face à leurs menus. Il calcule la médiane des prix de la zone, puis l’écart entre votre prix et cette médiane.',
    points: [
      'Au moins 2 concurrents pour conclure. En dessous, Deliview le dit au lieu d’inventer une moyenne.',
      'Plus de 10&nbsp;% au-dessus de la médiane&nbsp;: trop cher. Plus de 10&nbsp;% en dessous&nbsp;: sous-évalué. Entre les deux&nbsp;: bien placé.',
      'Une recette que personne d’autre ne vend est située parmi les plats de sa famille&nbsp;: pizzas, pâtes, desserts, boissons de même contenance.',
      'Chaque prix cité renvoie à la fiche Uber Eats ou Deliveroo d’où il vient.',
    ],
    faq: [
      {
        q: 'Comment Deliview choisit-il mes concurrents ?',
        r: 'Il cherche sur Uber Eats et Deliveroo les restaurants de votre secteur, vérifie leur adresse et garde les plus proches et les plus complets, jusqu’à 20. Vous pouvez aussi imposer jusqu’à 3 restaurants à suivre, même plus loin.',
      },
      {
        q: 'D’où viennent les prix ?',
        r: 'Des fiches publiques Uber Eats et Deliveroo, lues au moment de l’analyse. Deliview ne demande aucun accès à votre compte, ni à ceux de vos concurrents.',
      },
      {
        q: 'À quelle fréquence les prix sont-ils mis à jour ?',
        r: 'À chaque analyse, que vous lancez quand vous voulez depuis l’app. Deliview vous montre ce qui a changé depuis la précédente&nbsp;: promos, prix, notes, nouveaux concurrents.',
      },
      {
        q: 'Mes prix en livraison sont plus chers qu’en salle. Est-ce un problème pour la comparaison ?',
        r: 'Non. Deliview compare vos prix de livraison aux prix de livraison des voisins, sur la même plateforme.',
      },
    ],
  },
  'carte-et-marge': {
    methodeTitre: 'Comment Deliview propose un prix',
    reponse:
      'Deliview propose un prix seulement quand au moins 2 concurrents vendent le même plat à taille égale. Trop cher de plus de 10&nbsp;%&nbsp;: il propose la médiane de la zone. Sous-évalué de plus de 10&nbsp;%&nbsp;: il propose une hausse en deux temps, d’abord à mi-chemin de la médiane.',
    points: [
      'Chaque proposition cite les plats comparés, leur restaurant et leur prix.',
      'L’impact est donné pour 100 ventes du plat&nbsp;: vous l’appliquez à vos propres volumes.',
      'Une recette unique n’a pas de prix proposé. Deliview la situe parmi les plats de sa famille chez vos voisins, à titre de repère.',
      'Vous validez ou écartez chaque proposition. Deliview garde votre décision et sa raison.',
    ],
    faq: [
      {
        q: 'Deliview modifie-t-il mes prix sur Uber Eats ou Deliveroo ?',
        r: 'Non. Vous décidez, puis vous reportez le nouveau prix dans votre espace Uber Eats ou Deliveroo.',
      },
      {
        q: 'Que faire d’un plat que personne d’autre ne vend ?',
        r: 'Deliview le compare aux plats de la même famille dans votre zone et vous dit s’il est moins cher que la plupart, dans la moyenne ou plus cher. C’est un repère, pas un prix conseillé.',
      },
    ],
  },
  reputation: {
    methodeTitre: 'Comment lire votre place au classement',
    reponse:
      'Deliview classe les restaurants de votre zone par note, plateforme par plateforme, puis par nombre d’avis en cas d’égalité. Vous voyez votre rang, la note moyenne de la zone et si vous êtes au-dessus, dans la moyenne ou en dessous.',
    points: [
      'Uber Eats et Deliveroo sont classés séparément&nbsp;: les clients et les notes n’y sont pas les mêmes.',
      'Le nombre d’avis compte aussi&nbsp;: un 4,8 sur 12 avis ne pèse pas comme un 4,6 sur 900.',
      'Les concurrents que vous suivez à la main entrent aussi dans la comparaison.',
    ],
    faq: [
      {
        q: 'Deliview lit-il mes avis clients ?',
        r: 'Non. Deliview compare votre note et votre nombre d’avis à ceux des restaurants de votre zone, plateforme par plateforme.',
      },
      {
        q: 'Pourquoi comparer ma note à celle des voisins ?',
        r: 'Parce que le client choisit parmi les restaurants qu’il voit dans l’appli. Une note de 4,5 n’a pas le même poids dans une zone où la plupart des restaurants sont à 4,7.',
      },
    ],
  },
};

const c = CONTENU[pilier.slug];
const icones = ICONES[pilier.slug];
const url = `${SITE.url}/solution/${pilier.slug}/`;
---

<Base
  title={pilier.meta.title}
  description={pilier.meta.description}
  ariane={[
    { nom: 'Solution', chemin: '/solution/' },
    { nom: pilier.surtitre, chemin: `/solution/${pilier.slug}/` },
  ]}
  jsonld={[jsonldLogiciel(pilier.description, url)]}
>
  <section class="relative overflow-hidden bg-white">
    <div aria-hidden="true" class="pointer-events-none absolute -right-40 -top-24 h-[480px] w-[480px] rounded-full bg-blue-2/12"></div>
    <div class={`dv-container relative grid items-center gap-12 pb-16 pt-8 md:pb-20 md:pt-12 ${pilier.capture || pilier.illustration ? 'lg:grid-cols-[1fr_1.1fr]' : ''}`}>
      <div>
        <p class="dv-overline dv-muted">{pilier.surtitre}</p>
        <h1 class="dv-h1 mt-4 max-w-[18ch]">{pilier.titre}</h1>
        <p class="dv-lead mt-5 max-w-[56ch]">{pilier.description}</p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href="#demo" class="dv-btn dv-btn-plein sm:whitespace-nowrap" data-cta={`pilier-${pilier.slug}`} data-cta-principal>
            Demander une démo
          </a>
          <a href={lien('/tarifs/')} class="dv-btn dv-btn-contour sm:whitespace-nowrap">Voir les tarifs</a>
        </div>
      </div>
      {pilier.capture && <Capture src={pilier.capture.src} alt={pilier.capture.alt} largeur={pilier.capture.largeur} hauteur={pilier.capture.hauteur} priorite />}
      {!pilier.capture && pilier.illustration && (
        <PhotoIA nom={pilier.illustration.nom} alt={pilier.illustration.alt} sizes="(min-width: 1200px) 600px, (min-width: 1024px) 50vw, 100vw" ratio="3 / 2" priorite />
      )}
    </div>
  </section>

  <section class="dv-section bg-grey" aria-labelledby="fonctions-titre">
    <div class="dv-container">
      <h2 id="fonctions-titre" class="dv-h2 max-w-[24ch]">Ce que vous pouvez faire avec Deliview</h2>
      <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {
          pilier.fonctionnalites.map((f, i) => (
            <li class="dv-card flex flex-col p-6">
              <span class="inline-flex h-12 w-12 items-center justify-center rounded-[12px] bg-blue/10 text-blue">
                <Icone nom={icones[i] || 'check'} />
              </span>
              <h3 class="dv-h3 mt-4">{f.titre}</h3>
              <p class="mt-2 dv-muted">{f.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="methode-titre">
    <div class="dv-container grid gap-10 lg:grid-cols-[1fr_1fr]">
      <div>
        <p class="dv-overline dv-muted">La méthode</p>
        <h2 id="methode-titre" class="dv-h2 mt-3 max-w-[20ch]">{c.methodeTitre}</h2>
        <p class="mt-5 dv-texte" set:html={c.reponse} />
      </div>
      <ul class="space-y-4 self-center">
        {
          c.points.map((p) => (
            <li class="flex gap-3">
              <span class="mt-1 inline-flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-blue/10 text-blue">
                <Icone nom="check" taille={18} />
              </span>
              <span set:html={p} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <BandeauPlateformes fond="gris" />

  <Faq questions={c.faq} />

  {
    articles.length > 0 && (
      <section class="dv-section bg-grey" aria-labelledby="articles-titre">
        <div class="dv-container">
          <h2 id="articles-titre" class="dv-h2">Pour aller plus loin</h2>
          <ul class="mt-8 grid gap-6 md:grid-cols-3">
            {articles.slice(0, 3).map((a) => (
              <li class="dv-card flex flex-col p-6">
                <h3 class="dv-h3">
                  <a href={lien(`/ressources/${a.id}/`)} class="hover:underline">
                    {a.data.titre}
                  </a>
                </h3>
                <p class="mt-2 flex-1 text-[16px] dv-muted">{a.data.description}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class="dv-section bg-white" aria-labelledby="autres-titre">
    <div class="dv-container">
      <h2 id="autres-titre" class="dv-h2">Le reste de Deliview</h2>
      <ul class="mt-8 grid gap-6 md:grid-cols-3">
        {
          autres.map((p) => (
            <li class="dv-card flex flex-col p-6">
              <p class="dv-overline">{p.surtitre}</p>
              <p class="mt-3 flex-1 dv-muted">{p.phrase}</p>
              <a href={lien(`/solution/${p.slug}/`)} class="mt-4 inline-flex items-center gap-2 font-bold underline underline-offset-4">
                Voir {p.surtitre.toLowerCase()} <Icone nom="fleche" taille={18} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <SectionDemo section={`pilier-${pilier.slug}-formulaire`} />
</Base>
