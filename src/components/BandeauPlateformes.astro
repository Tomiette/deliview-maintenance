---
import { CONTENU } from "../content/contenu";

const { libelle, plateformes } = CONTENU.bandeau;
---

<section class="border-y border-grey-2/15 bg-grey py-8" aria-label={libelle}>
  <div class="container-dv flex flex-col items-center gap-4 text-center md:flex-row md:justify-center md:gap-10">
    <p class="surtitre texte-secondaire">{libelle}</p>
    <ul class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
      {plateformes.map((p) => <li class="text-xl font-bold md:text-2xl">{p}</li>)}
    </ul>
  </div>
</section>
