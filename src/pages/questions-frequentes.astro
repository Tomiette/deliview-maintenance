---
// Questions fréquentes sur Deliview : réponses courtes, datées et vérifiables aux questions sur la marque
// (ce que c'est, pour qui, prix, données, qui est derrière). Page pensée aussi pour les moteurs IA :
// réponse directe en première phrase, une question par titre, FAQPage en données structurées.
import Base from '../layouts/Base.astro';
import SectionDemo from '../components/SectionDemo.astro';
import Pastille from '../components/Pastille.astro';
import Fleche from '../icons/fleche.astro';
import { SITE, dateFr, lien } from '../lib/site';
import { FAQ, FAQ_MAJ, texteBrut } from '../lib/faq';

const description =
  'Ce que fait Deliview, pour qui, à quel prix, d’où viennent ses données et qui est derrière : des réponses courtes et vérifiables, datées.';

const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'fr-FR',
  dateModified: FAQ_MAJ,
  mainEntity: FAQ.flatMap((r) => r.questions).map((x) => ({
    '@type': 'Question',
    name: x.q,
    acceptedAnswer: { '@type': 'Answer', text: texteBrut(x.r) },
  })),
};
---

<Base
  title="Deliview : prix, fonctionnement, questions fréquentes"
  description={description}
  ariane={[{ nom: 'Questions fréquentes', chemin: '/questions-frequentes/' }]}
  jsonld={[faqPage]}
>
  <section class="bg-grey pb-12 pt-6 md:pb-16 md:pt-10" aria-labelledby="faq-page-titre" data-haut-de-page>
    <div class="dv-container">
      <Pastille>Tout savoir avant une démo</Pastille>
      <h1 id="faq-page-titre" class="dv-h1 mt-5 max-w-[22ch] md:mt-6">Questions fréquentes sur Deliview</h1>
      <p class="dv-lead mt-4 max-w-[62ch] md:mt-6">{SITE.definition}</p>
      <p class="mt-4 text-[15px] dv-muted">Mis à jour le {dateFr(new Date(FAQ_MAJ))}.</p>
      <nav aria-label="Rubriques" class="mt-8">
        <ul class="flex flex-wrap gap-2">
          {
            FAQ.map((r) => (
              <li>
                <a href={`#${r.id}`} class="dv-puce-lien">
                  {r.titre}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  {
    FAQ.map((r, i) => (
      <section id={r.id} class={`dv-section scroll-mt-20 ${i % 2 === 0 ? 'bg-white' : 'bg-grey dv-points'}`} aria-labelledby={`${r.id}-titre`}>
        <div class="dv-container max-w-[860px]">
          <h2 id={`${r.id}-titre`} class="dv-h2">
            {r.titre}
          </h2>
          <div class="mt-8 grid gap-4">
            {r.questions.map((x) => (
              <div id={x.id} class="dv-card scroll-mt-24 px-6 py-5 md:px-8 md:py-6">
                <h3 class="font-accent text-[19px] font-bold leading-[1.35] md:text-[21px]">{x.q}</h3>
                <p class="mt-2 dv-texte text-[17px] leading-[1.6] [text-wrap:pretty] md:text-[18px]" set:html={x.r} />
              </div>
            ))}
          </div>
        </div>
      </section>
    ))
  }

  <section class={`dv-section ${FAQ.length % 2 === 0 ? 'bg-white' : 'bg-grey dv-points'}`} aria-labelledby="aller-plus-loin">
    <div class="dv-container max-w-[860px]">
      <h2 id="aller-plus-loin" class="dv-h2">Pour aller plus loin</h2>
      <ul class="mt-6 grid gap-1">
        <li><a href={lien('/solution/')} class="dv-lien-fort">Tout ce que fait Deliview<Fleche taille={24} /></a></li>
        <li><a href={lien('/tarifs/')} class="dv-lien-fort">Comparer les trois offres<Fleche taille={24} /></a></li>
        <li><a href={lien('/qui-sommes-nous/')} class="dv-lien-fort">Qui sommes-nous<Fleche taille={24} /></a></li>
        <li><a href={lien('/ressources/')} class="dv-lien-fort">Guides pour les restaurateurs sur Uber&nbsp;Eats et Deliveroo<Fleche taille={24} /></a></li>
      </ul>
    </div>
  </section>

  <SectionDemo section="faq-formulaire" titre="Une question qui n’est pas ici ?" sousTitre="Posez-la à Tom pendant une démo de 15 minutes sur votre restaurant." />
</Base>
