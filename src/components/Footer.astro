---
// Pied de page (maquettes « le passe ») : logo, slogan, e-mail (avec le logo de l'e-mail depuis le 7 octobre 2026, demande
// de Tom : « les vrais logos sur toutes les pages » ; le pictogramme au trait avait été retiré le 6), puis colonnes
// Solution, Pour qui, Ressources et Société ; LinkedIn sous l'e-mail, liens légaux en bas (7 octobre 2026, 23 h 29,
// demande de Tom : « Améliore le footer » : colonnes rangées par sujet, liens plus serrés, lien démo sous la marque). Plus de bandeau photo :
// chaque page finit par son propre écran de démo. Contact : l'e-mail de Tom seulement, aucun numéro de téléphone.
// Sur téléphone : bouton « Demander une démo » fixé en bas de l'écran une fois le haut de page dépassé.
import BoutonDemo from './BoutonDemo.astro';
import LogoContact from './LogoContact.astro';
import Fleche from '../icons/fleche.astro';
import { FONCTIONS, SITE, cheminFonction, lien } from '../lib/site';

interface Props {
  // Bouton démo fixé en bas de l'écran du téléphone (retiré sur la page de départ : un seul chemin à l'écran).
  barreDemo?: boolean;
}
const { barreDemo = true } = Astro.props;
const annee = new Date().getFullYear();

// Liens légaux : sur une ligne, dans le bas du pied de page (7 octobre 2026).
const legaux = [
  { libelle: 'Mentions légales', href: lien('/mentions-legales/') },
  { libelle: 'Confidentialité et cookies', href: lien('/confidentialite/') },
  { libelle: 'CGV', href: lien('/cgv/') },
  { libelle: 'Conditions d’utilisation', href: lien('/conditions-utilisation/') },
];

const colonnes: { id: string; titre: string; liens: { libelle: string; href: string; logo?: 'linkedin' | 'deliview' }[] }[] = [
  {
    id: 'pied-solution',
    titre: 'Solution',
    liens: [
      // Les sept fonctions, chacune vers sa page (7 octobre 2026), comme le menu Solution.
      ...FONCTIONS.map((x) => ({ libelle: x.nom, href: lien(cheminFonction(x.id)) })),
      { libelle: 'Tarifs', href: lien('/tarifs/') },
    ],
  },
  {
    id: 'pied-pour-qui',
    titre: 'Pour qui',
    // Tous les profils mènent à la réponse « À qui s'adresse Deliview ? » des questions fréquentes
    // (la phrase « Pour qui » de l'accueil a été retirée le 3 octobre 2026, à la demande de Tom).
    liens: ['Pizzerias', 'Burgers et snacks', 'Dark kitchens', 'Chaînes de restaurants'].map((libelle) => ({ libelle, href: lien('/questions-frequentes/#pour-qui') })),
  },
  {
    id: 'pied-ressources',
    titre: 'Ressources',
    liens: [
      { libelle: 'Blog', href: lien('/ressources/') },
      { libelle: 'Questions fréquentes', href: lien('/questions-frequentes/') },
      // Intégrations : dans Ressources, comme le menu du haut (7 octobre 2026).
      { libelle: 'Intégrations', href: lien('/integrations/') },
      { libelle: 'Simulateur de rentabilité', href: lien('/simulateur/') },
    ],
  },
  {
    id: 'pied-societe',
    titre: 'Société',
    liens: [
      { libelle: 'Qui suis-je', href: lien('/qui-sommes-nous/') },
      { libelle: 'Deliview est-il fiable ?', href: lien('/deliview-est-il-fiable/') },
      { libelle: 'Affiliation', href: lien('/parrainage/') },
      { libelle: 'Se connecter', href: SITE.app },
    ],
  },
];
---

<footer id="pied" class="border-t border-grey-2/15 bg-grey pb-9 pt-12 md:pt-[72px]">
  <div class="dv-container">
    <div class="grid grid-cols-2 gap-x-6 gap-y-8 md:grid-cols-4 lg:grid-cols-5 lg:gap-10">
      <div class="col-span-2 md:col-span-4 lg:col-span-1">
        <img src={lien('/images/logo-deliview.svg')} alt="Deliview" width="140" height="27" loading="lazy" decoding="async" />
        <p class="mt-4 max-w-[22ch] font-accent text-[17px] font-bold leading-[1.35] md:text-[18px]">{SITE.slogan}.</p>
        <p class="mt-3 text-[16px] font-semibold">
          <a href={`mailto:${SITE.email}`} class="dv-lien gap-2.5"><LogoContact type="email" />{SITE.email}</a>
        </p>
        <ul class="-ml-2.5 mt-2 flex items-center gap-1" aria-label="Deliview sur les réseaux">
          <li><a href={SITE.linkedinTom} rel="noopener" class="inline-flex size-11 items-center justify-center rounded-lg hover:bg-white" aria-label="Tom sur LinkedIn"><LogoContact type="linkedin" /></a></li>
          <li><a href={SITE.linkedinEntreprise} rel="noopener" class="inline-flex size-11 items-center justify-center rounded-lg hover:bg-white" aria-label="Deliview sur LinkedIn"><LogoContact type="deliview" /></a></li>
        </ul>
        <a href={lien('/demo/')} class="dv-lien-fort mt-3 w-fit whitespace-nowrap" data-cta="pied-demo">Demander une démo<Fleche taille={24} /></a>
      </div>
      {
        colonnes.map((c) => (
          <nav aria-labelledby={c.id}>
            <p id={c.id} class="text-[16px] font-bold leading-[1.3]">{c.titre}</p>
            <ul class="mt-2 grid gap-0.5 text-[16px] leading-[1.4] md:mt-3 md:gap-0">
              {c.liens.map((x) => (
                <li>
                  <a href={x.href} class="inline-flex min-h-11 items-center gap-2 hover:underline lg:min-h-9" rel={x.href.startsWith('http') ? 'noopener' : undefined}>
                    {x.logo && <LogoContact type={x.logo} />}
                    {x.libelle}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <div class="mt-10 border-t border-grey-2/15 pt-6 text-[14px] leading-[1.5] dv-muted md:mt-12">
      <div class="flex flex-col gap-2 md:flex-row md:items-center md:justify-between md:gap-10">
        <p class="md:shrink-0">© {annee} Deliview</p>
        <ul class="flex flex-wrap gap-x-5">
          {legaux.map((x) => (<li><a href={x.href} class="inline-flex min-h-11 items-center hover:underline md:min-h-0">{x.libelle}</a></li>))}
        </ul>
      </div>
      <p class="mt-3 md:max-w-[80ch]">Uber&nbsp;Eats et Deliveroo sont des marques de leurs propriétaires. Deliview est un logiciel indépendant qui regroupe vos plateformes de livraison.</p>
    </div>
  </div>
</footer>

{
  barreDemo && (
    <aside id="dv-barre-demo" aria-label="Raccourci vers la démo" class="fixed inset-x-0 bottom-0 z-30 hidden border-t border-grey-2/15 bg-white px-4 pb-4 pt-3 shadow-[0_-4px_16px_rgba(76,76,76,0.06)] sm:hidden" aria-hidden="true">
      <BoutonDemo href={lien('/demo/')} cta="barre-mobile" class="w-full" tabindex={-1} />
    </aside>
  )
}

<script>
  // Téléphone : bouton démo fixé en bas de l'écran, seulement une fois le haut de page dépassé, et caché dès qu'un
  // autre bouton démo plein, le formulaire de démo, la vidéo ou le pied de page sont à l'écran.
  const barre = document.getElementById('dv-barre-demo');
  const haut = document.querySelector('[data-haut-de-page]');
  const cibles = Array.from(document.querySelectorAll('[data-cta-principal], #demo, .dv-form, .hv-cadre, #pied'));
  if (barre && 'IntersectionObserver' in window) {
    const visibles = new Set<Element>();
    let hautDepasse = !haut;
    const maj = () => {
      const montrer = hautDepasse && visibles.size === 0 && window.scrollY > 200;
      barre.classList.toggle('hidden', !montrer);
      barre.setAttribute('aria-hidden', String(!montrer));
      barre.querySelector('a')?.setAttribute('tabindex', montrer ? '0' : '-1');
    };
    const obs = new IntersectionObserver((entrees) => {
      entrees.forEach((e) => {
        if (e.target === haut) {
          // Le haut de page est dépassé quand il est sorti de l'écran par le haut.
          hautDepasse = !e.isIntersecting && e.boundingClientRect.top < 0;
          return;
        }
        if (e.isIntersecting) visibles.add(e.target);
        else visibles.delete(e.target);
      });
      maj();
    });
    if (haut) obs.observe(haut);
    cibles.forEach((c) => obs.observe(c));
    window.addEventListener('scroll', maj, { passive: true });
  }
  // Clic sur un bouton démo : section d'origine gardée pour le formulaire (mesure, sans traceur).
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('[data-cta]');
    if (!a) return;
    try {
      sessionStorage.setItem('dv_section_cta', a.getAttribute('data-cta') || '');
    } catch {
      /* stockage indisponible */
    }
  });
</script>
