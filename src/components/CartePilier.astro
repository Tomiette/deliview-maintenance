---
// Carte d'un pilier (pages Solution détaillées, « Le reste de Deliview »). 6 octobre 2026 : la même carte que les leviers
// de l'accueil (CarteLevier), pour la cohérence : en haut, une vraie carte de l'app (restaurant anonymisé) posée à plat
// sur le plateau à points ; dessous, le nom, une phrase et « Voir comment ça marche ». Les 3 points ont été retirés
// (moins de texte, demande de Tom). Toute la carte est cliquable (lien étiré) ; au survol, elle se soulève.
import Fleche from '../icons/fleche.astro';
import { ICONES, type NomIcone } from '../lib/registre-icones';
import { lien, type CaptureApp } from '../lib/site';

interface Props {
  icone: NomIcone;
  nom: string;
  benefice: string;
  fragment: CaptureApp;
  href: string;
  niveau?: 'h2' | 'h3';
}

const { icone, nom, benefice, fragment, href, niveau = 'h3' } = Astro.props;
const Icone = ICONES[icone];
const Titre = niveau;
const base = lien(fragment.src);
---

<li class="dv-relief dv-relief-lien dv-levier">
  <div class="dv-levier-plateau">
    <img
      class="dv-fragment dv-levier-fragment"
      src={`${base}-${fragment.largeurs[fragment.largeurs.length - 1]}.webp`}
      srcset={fragment.largeurs.map((w) => `${base}-${w}.webp ${w}w`).join(', ')}
      sizes="(min-width: 1024px) 320px, (min-width: 640px) 46vw, 86vw"
      alt={fragment.alt}
      width={fragment.largeur}
      height={fragment.hauteur}
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="dv-levier-corps">
    <Titre class="flex items-center gap-3 font-accent text-[21px] font-bold leading-[1.25] md:text-[23px]">
      <span class="dv-tuile dv-tuile-petite"><Icone taille={24} /></span>
      {nom}
    </Titre>
    <p class="mt-3 text-[17px] leading-[1.5] dv-muted">{benefice}</p>
    <a href={lien(href)} class="dv-lien-fort dv-pilier-lien mt-auto self-start pt-3" aria-label={`Voir comment ça marche : ${nom.toLowerCase()}`}>
      Voir comment ça marche<Fleche taille={24} />
    </a>
  </div>
</li>
