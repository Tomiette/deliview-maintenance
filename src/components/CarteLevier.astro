---
// Carte d'un levier de rentabilité (accueil, 6 octobre 2026). En haut, la vitrine : l'écran de l'app qui fait le
// travail, sur l'appareil où le restaurateur le voit (tablette, téléphone, ordinateur), et une bulle avec le chiffre qui
// compte. Chaque levier a son appareil, pour que les trois cartes ne se ressemblent pas (demande de Tom). Dessous, le nom,
// une phrase et « Voir comment ça marche ». Toute la carte est cliquable (lien étiré) ; au survol, elle se soulève et
// l'appareil monte un peu. 8 octobre 2026 (audit SEO, ancre descriptive) : sous 1280 px, le lien dit où il mène
// (« Voir « Vos promotions » ») ; à partir de 1280 px, « Voir comment ça marche » reste affiché, complété pour les
// lecteurs d'écran et les moteurs par le nom de la fonction.
import Vitrine from './Vitrine.astro';
import Fleche from '../icons/fleche.astro';
import { ICONES } from '../lib/registre-icones';
import { lien, type Levier } from '../lib/site';

interface Props {
  levier: Levier;
  href: string;
  niveau?: 'h2' | 'h3';
}

const { levier: l, href, niveau = 'h3' } = Astro.props;
const Titre = niveau;
const Icone = ICONES[l.icone];
const v = l.vitrine;
---

<li class="dv-relief dv-relief-lien dv-levier">
  <div class="dv-levier-plateau">
    <Vitrine
      type={v.appareil}
      capture={v.capture}
      ratio={1.3}
      place={v.carte.place}
      bulles={[v.carte.bulle]}
      coupe
      coins="haut"
      sizes={v.appareil === 'navigateur' ? '(min-width: 1024px) 420px, 100vw' : '(min-width: 1024px) 230px, 60vw'}
    />
  </div>
  <div class="dv-levier-corps">
    <Titre class="flex items-center gap-3 font-accent text-[21px] font-bold leading-[1.25] md:text-[23px]">
      <span class="dv-tuile dv-tuile-petite"><Icone taille={24} /></span>
      {l.nom}
    </Titre>
    <p class="mt-3 text-[17px] leading-[1.5] dv-muted">{l.phrase}</p>
    <a href={lien(href)} class="dv-lien-fort dv-pilier-lien mt-auto self-start pt-3">
      <span class="xl:hidden">Voir «&nbsp;{l.nom}&nbsp;»</span><span class="hidden xl:inline">Voir comment ça marche<span class="sr-only"> : {l.nom}</span></span><Fleche taille={24} />
    </a>
  </div>
</li>
