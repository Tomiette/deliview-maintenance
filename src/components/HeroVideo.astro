---
// Vidéo de présentation (V15, 16:9, 1 min 10, sans voix off, avec musique), dans le cadre tablette dessiné au trait,
// en haut de l'accueil (demande de Tom, 2 octobre 2026). Seule la couverture (52 Ko) se charge avec la page ;
// la vidéo (5 à 7 Mo) ne se télécharge qu'au clic et se lance avec le son, jamais en automatique.
// Toute l'image est cliquable, avec au centre le signe « lecture » dessiné. Tout bouton [data-video-lire] placé dans le
// même bloc [data-video-zone] lance aussi la lecture ; pendant la lecture, ce bloc porte la classe « dv-video-en-lecture ».
// Sans JavaScript, les contrôles natifs restent affichés. Le contenu de la vidéo reste disponible pour les lecteurs
// d'écran (bloc masqué, relié par aria-describedby).
import Lecture from '../icons/lecture.astro';
import { lien } from '../lib/site';

interface Props {
  class?: string;
  // Couverture chargée plus tard (vidéo dans une fenêtre fermée au chargement) : posée par le script qui l'ouvre.
  couvertureDifferee?: boolean;
}
const { class: classe = '', couvertureDifferee = false } = Astro.props;
const couverture = lien('/video/deliview-video-couverture-v2-16x9.webp');

const texte = [
  'Bon, j’ai 1 minute pour vous convaincre. Alors je vous la fais courte.',
  'Restaurateur, on vous a promis que la livraison serait rentable. Eh oui.',
  'Mais au quotidien ? Trop de tablettes. Pas le temps de tout analyser. Trop de concurrents. Trop de promos.',
  'Et surtout : être présent, mais être rentable… non.',
  'Alors on a créé Deliview. Toutes vos données livraison centralisées : votre carte, vos avis, vos concurrents, leurs prix.',
  'Deliview surveille vos concurrents : leurs prix, leurs notes, leurs promos.',
  'Et surtout, Deliview vous dit quoi faire : un prix suggéré pour chaque plat, face au prix de la zone.',
  'L’IA Deliview vous rend plus visible, plus rentable. À la question « Que font mes concurrents dans ma zone ? », elle répond par exemple : « Napoli Express lance −30 % sur ses pizzas. Passez votre Margherita à 10,90 € pour rester bien référencé et compétitif. »',
  'Et dès que ça bouge, Deliview vous alerte : promotions des concurrents, changements de prix, nouveau concurrent, avis négatif reçu.',
  'Résultat : vous réagissez immédiatement. Pas la semaine d’après.',
  'Deliview, le partenaire des restaurants en livraison. Demandez une démo sur deliview.fr.',
];
---

<div class={`hv ${classe}`}>
  <div class="hv-cadre">
    <video
      id="video-deliview"
      class="hv-lecteur"
      controls
      playsinline
      preload="none"
      width="1920"
      height="1080"
      poster={couvertureDifferee ? undefined : couverture}
      data-couverture={couvertureDifferee ? couverture : undefined}
      aria-label="Vidéo de présentation de Deliview, 1 minute 10, sans voix off"
      aria-describedby="hv-legende"
    >
      <source src={lien('/video/deliview-video-v2-16x9.webm')} type='video/webm; codecs="vp9, opus"' />
      <source src={lien('/video/deliview-video-v2-16x9.mp4')} type="video/mp4" />
      <a href={lien('/video/deliview-video-v2-16x9.mp4')}>Télécharger la vidéo de présentation (MP4, 7 Mo)</a>
    </video>
    <button class="hv-lire" type="button" aria-label="Lancer la vidéo de présentation de Deliview, 1 minute 10" tabindex="-1" hidden>
      <span class="hv-pastille" aria-hidden="true">
        <Lecture taille={48} class="hv-icone-grande" />
        <Lecture taille={32} class="hv-icone-petite" />
      </span>
    </button>
  </div>
  <!-- Contenu de la vidéo pour les lecteurs d'écran uniquement. -->
  <div id="hv-legende" class="sr-only">
    <p>Restaurants et chiffres d’exemple. Contenu de la vidéo&nbsp;:</p>
    <ol>
      {texte.map((t) => <li>{t}</li>)}
    </ol>
  </div>
</div>

<script>
  // Lecture au clic, avec le son. À la fin, retour à la couverture et à la pastille.
  document.querySelectorAll<HTMLElement>('.hv-cadre').forEach((cadre) => {
    const video = cadre.querySelector('video');
    const pastille = cadre.querySelector<HTMLButtonElement>('.hv-lire');
    if (!video || !pastille) return;
    const zone = cadre.closest<HTMLElement>('[data-video-zone]');
    const boutons = zone ? Array.from(zone.querySelectorAll<HTMLElement>('[data-video-lire]')) : [];
    video.controls = false;
    pastille.hidden = false;
    // Avec un bouton visible sous la vidéo, la pastille reste un raccourci à la souris (hors tabulation).
    if (!boutons.length) pastille.tabIndex = 0;
    const lire = () => {
      pastille.hidden = true;
      video.controls = true;
      zone?.classList.add('dv-video-en-lecture');
      void video.play();
      video.focus({ preventScroll: true });
    };
    pastille.addEventListener('click', lire);
    // Un lien « Voir Deliview en action » (le fichier MP4 sans JavaScript) lance la vidéo sur place.
    boutons.forEach((b) =>
      b.addEventListener('click', (e) => {
        e.preventDefault();
        lire();
        cadre.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }),
    );
    video.addEventListener('play', () => zone?.classList.add('dv-video-en-lecture'));
    video.addEventListener('ended', () => {
      video.controls = false;
      video.load();
      pastille.hidden = false;
      zone?.classList.remove('dv-video-en-lecture');
      (boutons[0] ?? pastille).focus({ preventScroll: true });
    });
  });
</script>

<style>
  .hv {
    width: 100%;
  }
  /* Cadre tablette dessiné au trait (Gris 2, 2,2 px), comme les captures de l'app. */
  .hv-cadre {
    position: relative;
    padding: 6px;
    border: 2.2px solid var(--color-grey-2);
    border-radius: 16px;
    background: var(--color-white);
  }
  .hv-lecteur {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    object-fit: cover;
    background: var(--color-blue);
  }
  .hv-lire {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    border-radius: 16px;
    background: transparent;
    cursor: pointer;
  }
  .hv-lire[hidden] {
    display: none;
  }
  /* Signe « lecture » dessiné, dans un cercle blanc au trait, au centre de l'image. */
  .hv-pastille {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 60px;
    height: 60px;
    border: 2.2px solid var(--color-grey-2);
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-grey-2);
    translate: -50% -50%;
    transition: scale 0.15s ease;
  }
  .hv-lire:hover .hv-pastille {
    scale: 1.06;
  }
  .hv-lire:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 4px;
  }
  .hv-pastille :global(.hv-icone-grande) {
    display: none;
  }
  @media (min-width: 768px) {
    .hv-cadre {
      padding: 10px;
      border-radius: 22px;
    }
    .hv-lecteur {
      border-radius: 13px;
    }
    .hv-lire {
      border-radius: 22px;
    }
    .hv-pastille {
      width: 84px;
      height: 84px;
    }
    .hv-pastille :global(.hv-icone-grande) {
      display: block;
    }
    .hv-pastille :global(.hv-icone-petite) {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hv-pastille {
      transition: none;
    }
  }
</style>
