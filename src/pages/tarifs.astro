    font-size: 16px;
    font-weight: 700;
    line-height: 1.25;
  }

  /* Étiquette « Bientôt » : promis par l'offre, pas encore dans l'app (Bleu 1 à 12 %, texte Gris 2). */
  .dv-bientot {
    display: inline-block;
    padding: 1px 8px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-blue) 12%, transparent);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
    vertical-align: 1px;
  }

  /* Contenu de l'offre : sous un trait (téléphone, ordinateur) ; à droite d'un trait vertical sur tablette. */
  .dv-offre-contenu {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px solid var(--dv-bord);
  }
  @media (min-width: 768px) and (max-width: 1023px) {
