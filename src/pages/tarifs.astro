      padding-left: 28px;
      border-top: 0;
      border-left: 1px solid var(--dv-bord);
    }
  }

  /* Sous le nom de l'offre (9 octobre 2026) : qui décide, qui applique. Inter 600, comme une accroche. */
  .dv-offre-phrase {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.45;
    text-wrap: pretty;
  }

  /* À la place du prix (8 octobre 2026) : la même ligne sur les deux offres, donc plus discrète que le titre. */
  .dv-offre-sur-mesure {
    font-size: 17px;
    font-weight: 600;
    line-height: 1.4;
    color: color-mix(in srgb, var(--color-grey-2) 85%, transparent);
  }

  /* Ce que fait chaque offre face à une perte : deux lignes sous un trait. */
  .dv-fuite-offres {
    display: grid;
    gap: 10px;
    padding-top: 16px;
    border-top: 1px solid var(--dv-bord);
    font-size: 16px;
    line-height: 1.45;
  }
  .dv-fuite-offres dt {
    font-weight: 700;
  }

  /* ── Comparatif ──
     Bouton qui ouvre le tableau (téléphone, ou sans JavaScript) : carte en relief, signe plus ou moins dessiné. */
  .dv-comparatif-bouton {
    display: flex;
    min-height: 56px;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 20px;
    font-family: var(--font-accent);
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
    list-style: none;
    cursor: pointer;
  }
  .dv-comparatif-bouton::-webkit-details-marker {
    display: none;
  }
  .dv-comparatif-details :global(.dv-comparatif-moins),
  .dv-comparatif-details[open] :global(.dv-comparatif-plus) {
