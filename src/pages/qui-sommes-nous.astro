---
// Qui sommes-nous (décisions de Tom, 2 octobre 2026 ; direction « le passe ») : le projet en 3 phrases, la vraie photo
// de Tom, la frise de la construction (étapes fournies par Tom seulement, masquée tant qu'il n'y en a pas), les liens
// LinkedIn, puis un bouton démo et l'e-mail de Tom. Ancre #tom : page auteur des articles.
// Refonte en relief (3 octobre 2026) : pastilles, photo dans un cadre incliné en 3D, « Deliview en bref » en carte.
import Profil from '../icons/profil.astro';
import BoutonDemo from '../components/BoutonDemo.astro';
import Base from '../layouts/Base.astro';
import PhotoTom from '../components/PhotoTom.astro';
import Pastille from '../components/Pastille.astro';
import Frise from '../components/Frise.astro';
import Toque from '../icons/toque.astro';
import Courbe from '../icons/courbe.astro';
import Enveloppe from '../icons/enveloppe.astro';
import Fleche from '../icons/fleche.astro';
import { SITE, lien } from '../lib/site';
import { CHRONOLOGIE } from '../lib/chronologie';

const description =
  'Le projet Deliview, son fondateur Tom Voisin et la construction du logiciel, suivie en public, pour les restaurants sur Uber Eats et Deliveroo.';

const personne = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Tom Voisin',
  jobTitle: 'Fondateur de Deliview',
  description: 'Fondateur de Deliview. A lui-même été sur Uber Eats et Deliveroo, et a passé un an sur le terrain auprès des restaurants qui livrent.',
  knowsAbout: ['Uber Eats', 'Deliveroo', 'Livraison de repas', 'Prix des restaurants en livraison'],
  url: SITE.url + '/qui-sommes-nous/#tom',
  image: SITE.url + '/images/tom-voisin.jpg',
  email: SITE.email,
  sameAs: [SITE.linkedinTom],
  worksFor: { '@type': 'Organization', name: 'Deliview', url: SITE.url },
};
const aPropos = { '@context': 'https://schema.org', '@type': 'AboutPage', name: 'Qui sommes-nous', url: SITE.url + '/qui-sommes-nous/', inLanguage: 'fr-FR' };
---

<Base title="Qui sommes-nous : Tom Voisin, fondateur | Deliview" description={description} ariane={[{ nom: 'Qui sommes-nous', chemin: '/qui-sommes-nous/' }]} jsonld={[aPropos, personne]}>
  <section class="bg-grey pb-14 pt-6 md:pb-[104px] md:pt-10" aria-labelledby="projet-titre" data-haut-de-page>
    <div class="dv-container">
      <Pastille>{SITE.slogan}</Pastille>
      <h1 id="projet-titre" class="dv-h1 mt-5 max-w-[18ch] md:mt-6">Rendre la livraison rentable pour chaque restaurant</h1>
      <div class="dv-lead mt-5 max-w-[60ch] space-y-3 md:mt-6">
        <p>Sur Uber Eats et Deliveroo, les commissions pèsent sur chaque plat vendu.</p>
        <p>Les chiffres utiles sont éparpillés entre une tablette et un espace par plateforme.</p>
        <p>Deliview les réunit, pour que chaque restaurant vende au bon prix.</p>
      </div>
    </div>
  </section>

  <section id="tom" class="dv-section scroll-mt-24 bg-white" aria-labelledby="tom-titre">
    <div class="dv-container flex max-w-[1000px] flex-col items-center gap-x-[88px] gap-y-12 md:flex-row">
      <PhotoTom />
      <div class="max-w-[620px] flex-1">
        <Pastille icone={Toque}>Qui je suis</Pastille>
        <h2 id="tom-titre" class="dv-h2 mt-4 md:mt-5">Tom Voisin, fondateur de Deliview</h2>
        <div class="mt-4 space-y-3 text-[17px] leading-[1.6] [text-wrap:pretty] md:mt-5 md:text-[19px]">
          <p>J’ai moi-même été sur Uber Eats et Deliveroo.</p>
          <p>J’ai passé un&nbsp;an sur le terrain, auprès des restaurants qui livrent.</p>
          <p>Partout, deux tablettes en plein rush et des prix fixés à l’instinct.</p>
          <p>Deliview est le résultat de cette année. Je fais la mise en place avec chaque restaurant.</p>
        </div>
        <ul class="mt-4 flex flex-col gap-0.5 text-[16px] md:mt-6 md:text-[17px]">
          <li><a href={`mailto:${SITE.email}`} class="dv-lien gap-2"><Enveloppe taille={24} />{SITE.email}</a></li>
          <li><a href={SITE.linkedinTom} class="dv-lien gap-2" rel="noopener"><Profil taille={24} />Tom sur LinkedIn</a></li>
          <li><a href={SITE.linkedinEntreprise} class="dv-lien gap-2" rel="noopener"><Profil taille={24} />Deliview sur LinkedIn</a></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="dv-section bg-grey dv-points" aria-labelledby="chronologie-titre">
    <div class="dv-container max-w-[880px]">
      <Pastille icone={Courbe}>En public, sur LinkedIn</Pastille>
      <h2 id="chronologie-titre" class="dv-h2 mt-4 max-w-[22ch] md:mt-5">{CHRONOLOGIE.length ? 'La construction de Deliview, étape par étape' : 'Suivez la construction de Deliview'}</h2>
      <p class="mt-4 max-w-[60ch]">Je partage chaque étape sur LinkedIn&nbsp;: ce qui marche, ce qui ne marche pas.</p>
      <Frise />
      <p class="mt-8">
        <a href={SITE.linkedinEntreprise} class="dv-lien-fort" rel="noopener">Suivre la construction sur LinkedIn<Fleche taille={24} /></a>
      </p>
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="bref-titre">
    <div class="dv-container max-w-[880px]">
      <h2 id="bref-titre" class="dv-h2">Deliview en bref</h2>
      <dl class="dv-card mt-8 divide-y divide-grey-2/15 px-6 md:px-8">
        <div class="grid gap-1 py-4 sm:grid-cols-[220px_1fr]">
          <dt class="font-semibold">Ce que fait Deliview</dt>
          <dd>{SITE.argument} Vos prix, votre carte et votre note face à votre zone.</dd>
        </div>
        <div class="grid gap-1 py-4 sm:grid-cols-[220px_1fr]">
          <dt class="font-semibold">Fondateur</dt>
          <dd>Tom Voisin</dd>
        </div>
        <div class="grid gap-1 py-4 sm:grid-cols-[220px_1fr]">
          <dt class="font-semibold">Origine</dt>
          <dd>Un&nbsp;an sur le terrain, auprès des restaurants qui livrent</dd>
        </div>
        <div class="grid gap-1 py-4 sm:grid-cols-[220px_1fr]">
          <dt class="font-semibold">Plateformes</dt>
          <dd>Uber Eats et Deliveroo, en France</dd>
        </div>
        <div class="grid gap-1 py-4 sm:grid-cols-[220px_1fr]">
          <dt class="font-semibold">Hébergement des données</dt>
          <dd>Union européenne (Irlande)</dd>
        </div>
        <div class="grid gap-1 py-4 sm:grid-cols-[220px_1fr]">
          <dt class="font-semibold">Société</dt>
          <dd>DELIVIEW SAS, <a href={lien('/mentions-legales/')} class="underline underline-offset-2">mentions légales</a></dd>
        </div>
      </dl>
    </div>
  </section>

  <section id="demo" class="dv-section bg-grey dv-points" aria-labelledby="contact-titre">
    <div class="dv-container max-w-[760px] text-center">
      <span class="dv-tuile"><Enveloppe taille={32} /></span>
      <h2 id="contact-titre" class="dv-h2 mx-auto mt-5 max-w-[20ch]">Parlons de votre restaurant</h2>
      <p class="dv-lead mx-auto mt-4 max-w-[48ch]">Une démo de 30&nbsp;minutes, sur vos prix et votre zone.</p>
      <p class="mt-7"><BoutonDemo href={lien('/demo/')} cta="qui-sommes-nous" principal class="w-full sm:w-auto" /></p>
      <p class="mt-5">Ou écrivez-moi&nbsp;: <a href={`mailto:${SITE.email}`} class="font-semibold">{SITE.email}</a></p>
    </div>
  </section>
</Base>
