---
// Sur-titre en pastille (refonte en relief, 3 octobre 2026) : étiquette blanche en relief, point Bleu 1
// ou icône dessinée de 24 px, texte en Aspekta 600 capitales.
import type { ICONES, NomIcone } from '../lib/registre-icones';

interface Props {
  // Composant d'icône dessinée (src/icons/), affiché en 24 px à la place du point.
  icone?: (typeof ICONES)[NomIcone];
  balise?: 'p' | 'span';
  class?: string;
}
const { icone: Icone, balise: Balise = 'p', class: classe = '' } = Astro.props;
---

<Balise class={`dv-overline dv-pastille ${classe}`}>{Icone ? <Icone taille={24} /> : <span class="dv-pastille-point" aria-hidden="true" />}<slot /></Balise>
