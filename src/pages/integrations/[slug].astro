---
// Page par plateforme (motif Zapier) : ce que Deliview montre, comment démarrer, FAQ.
import Base from '../../layouts/Base.astro';
import SectionDemo from '../../components/SectionDemo.astro';
import Faq from '../../components/Faq.astro';
import Icone from '../../components/Icone.astro';
import { PLATEFORMES, SITE, jsonldLogiciel, lien } from '../../lib/site';

export function getStaticPaths() {
  return PLATEFORMES.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}

const { slug } = Astro.props as { slug: string };
const p = PLATEFORMES.find((x) => x.slug === slug)!;
const autres = PLATEFORMES.filter((x) => x.slug !== slug);

const ETAPES = [
  { titre: 'Une démo sur votre restaurant', texte: '15 minutes avec Tom, sur vos prix et votre zone.' },
  { titre: 'La mise en place, avec Tom', texte: 'Votre compte est prêt. Rien à installer.' },
  { titre: 'Vos données sur un seul écran', texte: 'Vos prix, votre note et vos concurrents, plat par plat.' },
];
const CONTENU: Record<string, { title: string; description: string; h1: string; lead: string; etapes?: { titre: string; texte: string }[]; faq: { q: string; r: string }[] }> = {
  'uber-eats': {
    title: 'Uber Eats : vos prix face à vos concurrents | Deliview',
    description:
      'Votre carte Uber Eats face aux restaurants autour de vous : prix plat par plat, notes, avis et offres. Demandez une démo.',
    h1: 'Uber Eats : vos prix et votre note face à votre zone',
    lead: 'Chaque plat de votre carte Uber Eats face au même plat chez vos voisins. Votre note et vos offres aussi.',
    etapes: ETAPES,
    faq: [
      {
        q: 'Deliview est-il un partenaire officiel d’Uber Eats ?',
        r: 'Non. Deliview est un logiciel indépendant, ni affilié ni approuvé par Uber Eats.',
      },
      {
        q: 'Et si mon restaurant n’est que sur Uber Eats ?',
        r: 'Deliview fonctionne aussi avec une seule plateforme. L’analyse porte alors sur Uber Eats seulement.',
      },
    ],
  },
  deliveroo: {
    title: 'Deliveroo : vos prix face à vos concurrents | Deliview',
    description:
      'Votre carte Deliveroo face aux restaurants autour de vous : prix, notes, offres, et les écarts avec votre carte Uber Eats.',
    h1: 'Deliveroo : vos prix et votre note face à votre zone',
    lead: 'Les mêmes analyses que sur Uber Eats. En plus, les écarts de prix entre vos deux cartes, plat par plat.',
    etapes: ETAPES,
    faq: [
      {
        q: 'Deliview est-il un partenaire officiel de Deliveroo ?',
        r: 'Non. Deliview est un logiciel indépendant, ni affilié ni approuvé par Deliveroo.',
      },
      {
        q: 'Mes prix ne sont pas les mêmes sur Deliveroo et sur Uber Eats. Deliview le voit-il ?',
        r: 'Oui. Deliview liste les plats à prix différent sur vos deux cartes, avec les deux prix. À vous de voir lesquels sont voulus.',
      },
    ],
  },
};
const c = CONTENU[slug];
---

<Base
  title={c.title}
  description={c.description}
  ariane={[
    { nom: 'Intégrations', chemin: '/integrations/' },
    { nom: p.nom, chemin: `/integrations/${p.slug}/` },
  ]}
  jsonld={[jsonldLogiciel(c.description, `${SITE.url}/integrations/${p.slug}/`)]}
>
  <section class="bg-white">
    <div class="dv-container pb-12 pt-8 md:pb-16 md:pt-12">
      <p class="dv-overline dv-muted">Intégration</p>
      <h1 class="dv-h1 mt-4 max-w-[20ch]">{c.h1}</h1>
      <p class="dv-lead mt-5 max-w-[60ch]">{c.lead}</p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="#demo" class="dv-btn dv-btn-plein" data-cta={`integration-${p.slug}`} data-cta-principal>
          Demander une démo
        </a>
        <a href={lien('/integrations/')} class="dv-btn dv-btn-contour">Toutes les intégrations</a>
      </div>
    </div>
  </section>

  <section class="dv-section bg-grey" aria-labelledby="perimetre-titre">
    <div class="dv-container">
      <h2 id="perimetre-titre" class="dv-h2 max-w-[24ch]">Ce que Deliview fait avec {p.nom}</h2>
      <ul class="mt-10 grid max-w-[80ch] gap-4 dv-card p-6 md:p-8">
        {p.disponible.map((x) => (
          <li class="flex gap-3">
            <span class="mt-1 text-blue"><Icone nom="check" taille={20} /></span>
            {x}
          </li>
        ))}
      </ul>
    </div>
  </section>

  {
    c.etapes && (
      <section class="dv-section bg-white" aria-labelledby="demarrer-titre">
        <div class="dv-container">
          <h2 id="demarrer-titre" class="dv-h2">Démarrer avec {p.nom}</h2>
          <ol class="mt-10 grid gap-8 md:grid-cols-3">
            {c.etapes.map((e, i) => (
              <li>
                <span class="dv-figure text-blue" aria-hidden="true">{i + 1}</span>
                <h3 class="dv-h3 mt-3">{e.titre}</h3>
                <p class="mt-2 dv-muted">{e.texte}</p>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  <Faq questions={c.faq} />

  <section class="dv-section bg-grey" aria-labelledby="autres-integrations">
    <div class="dv-container">
      <h2 id="autres-integrations" class="dv-h2">Les autres intégrations</h2>
      <ul class="mt-8 grid gap-6 md:grid-cols-2">
        {
          autres.map((x) => (
            <li class="dv-card flex flex-col p-6">
              <p class="text-[22px] font-bold">{x.nom}</p>
              <p class="mt-3 flex-1 dv-muted">{x.resume}</p>
              <a href={lien(`/integrations/${x.slug}/`)} class="mt-4 inline-flex items-center gap-2 font-bold underline underline-offset-4">
                Voir {x.nom} <Icone nom="fleche" taille={18} />
              </a>
            </li>
          ))
        }
        <li class="dv-card flex flex-col p-6">
          <p class="text-[22px] font-bold">Uber Eats et Deliveroo ensemble</p>
          <p class="mt-3 flex-1 dv-muted">Vos deux cartes côte à côte. Les écarts de prix, vos concurrents et votre note.</p>
          <a href={lien('/integrations/uber-eats-et-deliveroo/')} class="mt-4 inline-flex items-center gap-2 font-bold underline underline-offset-4">
            Voir les deux ensemble <Icone nom="fleche" taille={18} />
          </a>
        </li>
      </ul>
      <p class="mt-8 text-[15px] dv-muted">Uber Eats et Deliveroo sont des marques de leurs propriétaires respectifs. Deliview est un logiciel indépendant, ni affilié ni approuvé par ces sociétés.</p>
    </div>
  </section>

  <SectionDemo section={`integration-${p.slug}-formulaire`} />
</Base>
