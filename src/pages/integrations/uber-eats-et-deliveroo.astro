---
// Page combinée (requête qui décrit exactement le produit) : gérer Uber Eats et Deliveroo ensemble (direction « le passe »).
import Base from '../../layouts/Base.astro';
import CadreTablette from '../../components/CadreTablette.astro';
import Reassurance from '../../components/Reassurance.astro';
import Coche from '../../icons/coche.astro';
import SectionDemo from '../../components/SectionDemo.astro';
import Faq from '../../components/Faq.astro';
import { SITE, jsonldLogiciel } from '../../lib/site';

const description =
  'Uber Eats et Deliveroo sur un seul écran : écarts de prix entre vos deux cartes, concurrents et note sur chaque plateforme.';

const aujourdhui = [
  { titre: 'Les écarts de prix entre vos deux cartes', texte: 'Les plats vendus plus cher sur une plateforme que sur l’autre, avec les deux prix.' },
  { titre: 'Vos concurrents sur chaque plateforme', texte: 'Un restaurant absent de Deliveroo peut être votre premier rival sur Uber Eats. Deliview regarde les deux.' },
  { titre: 'Votre note ici et là', texte: 'Votre place au classement des notes de votre zone, plateforme par plateforme.' },
  { titre: 'Un seul écran pour les deux', texte: 'Plus besoin d’ouvrir deux espaces pour comparer. Tout est au même endroit.' },
];
const faq = [
  {
    q: 'Faut-il vendre au même prix sur Uber Eats et sur Deliveroo ?',
    r: 'Deliview ne choisit pas à votre place. Il vous montre, plat par plat, les écarts de prix entre vos deux cartes. Vous repérez ceux qui datent d’un oubli.',
  },
  {
    q: 'Deliview remplace-t-il les tablettes Uber Eats et Deliveroo ?',
    r: 'Non. Deliview centralise vos prix, votre carte et votre note. Vos tablettes restent là pour recevoir les commandes.',
  },
  {
    q: 'Et si je ne suis que sur une des deux plateformes ?',
    r: 'Deliview fonctionne aussi avec une seule plateforme. Si vous ouvrez l’autre plus tard, la prochaine analyse la prendra en compte.',
  },
];
---

<Base
  title="Gérer Uber Eats et Deliveroo ensemble | Deliview"
  description={description}
  ariane={[
    { nom: 'Intégrations', chemin: '/integrations/' },
    { nom: 'Uber Eats et Deliveroo', chemin: '/integrations/uber-eats-et-deliveroo/' },
  ]}
  jsonld={[jsonldLogiciel(description, `${SITE.url}/integrations/uber-eats-et-deliveroo/`)]}
>
  <section class="overflow-hidden bg-grey pb-14 pt-6 md:pb-[104px] md:pt-10" aria-labelledby="ensemble-titre" data-haut-de-page>
    <div class="dv-container grid items-center gap-x-14 gap-y-10 lg:grid-cols-[1fr_1.1fr]">
      <div>
        <p class="dv-overline">Intégration</p>
        <h1 id="ensemble-titre" class="dv-h1 mt-3 max-w-[16ch] md:mt-4">Gérer Uber Eats et Deliveroo ensemble</h1>
        <p class="dv-lead mt-4 max-w-[56ch] md:mt-6">{SITE.argument} Vos deux cartes côte à côte, vos concurrents et votre note sur chaque plateforme.</p>
        <div class="mt-7 md:mt-8">
          <a href="#demo" class="dv-btn dv-btn-plein w-full sm:w-auto sm:px-7" data-cta="integration-combinee" data-cta-principal>Demander une démo</a>
        </div>
        <Reassurance class="mt-[18px] md:mt-6" />
      </div>
      <CadreTablette
        capture={{
          src: '/images/capture-tableau',
          largeurs: [800, 1300],
          largeur: 1300,
          hauteur: 812,
          alt: 'Tableau de bord Deliview : vos données Uber Eats et Deliveroo côte à côte, avec votre note, votre prix médian, votre nombre d’avis et votre rang dans chaque zone',
        }}
        sizes="(min-width: 1200px) 600px, (min-width: 1024px) 50vw, 100vw"
        priorite
      />
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="aujourdhui-titre">
    <div class="dv-container">
      <p class="dv-overline">Disponible</p>
      <h2 id="aujourdhui-titre" class="dv-h2 mt-2.5 md:mt-3">Ce que vous avez dès aujourd’hui</h2>
      <ul class="mt-8 grid gap-6 md:mt-10 md:grid-cols-2">
        {
          aujourdhui.map((x) => (
            <li class="dv-card flex gap-3 p-6">
              <Coche taille={24} class="mt-1" />
              <div>
                <h3 class="font-accent text-[20px] font-bold leading-[1.3] md:text-[22px]">{x.titre}</h3>
                <p class="mt-2 dv-muted">{x.texte}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <Faq questions={faq} />

  <section class="bg-white pt-10" aria-label="Marques">
    <div class="dv-container">
      <p class="text-[15px] dv-muted">Uber Eats et Deliveroo sont des marques de leurs propriétaires respectifs. Deliview est un logiciel indépendant, ni affilié ni approuvé par ces sociétés.</p>
    </div>
  </section>

  <SectionDemo section="integration-combinee-formulaire" />
</Base>
