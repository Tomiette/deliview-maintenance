  }

  /* Téléphone : chaque ligne devient une grille de deux colonnes, l'intitulé sur toute la largeur au-dessus de ses
     deux cases ; l'en-tête (les deux offres) reste collé en haut. Aucun défilement horizontal. */
  @media (max-width: 767px) {
    .dv-comparatif,
    .dv-comparatif thead,
    .dv-comparatif tbody {
      display: block;
