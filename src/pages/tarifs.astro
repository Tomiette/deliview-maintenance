  }
  .dv-comparatif-details[open] :global(.dv-comparatif-moins) {
    display: block;
  }
  .dv-comparatif-ouvert > summary {
    display: none;
  }

  /* Ordinateur : vrai tableau, en-tête collant sous la barre du site (Linear), colonne recommandée teintée de Bleu 1 à 8 %.
     Le cadre coupe ses coins avec overflow: clip, qui ne crée pas de zone de défilement : l'en-tête reste collant. */
  .dv-comparatif-cadre {
    border: 1px solid var(--dv-bord);
