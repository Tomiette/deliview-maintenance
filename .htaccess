# www.deliview.fr sur l'hébergement web OVH (fichier versionné dans la branche site-source,
# copié tel quel à la racine du site par le build, puis envoyé par le déploiement GitHub Actions).

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html
# Accès refusé par le serveur (cas rare) : la page d'erreur du site, avec ses liens, plutôt que la page brute d'Apache.
ErrorDocument 403 /404.html
AddDefaultCharset utf-8
# Polices WOFF2 servies avec leur type (8 octobre 2026, audit SEO) : sans lui, la règle ExpiresByType font/woff2 (1 an)
# ne s'appliquait pas et les polices étaient retéléchargées après 1 h.
AddType font/woff2 .woff2

# Une seule adresse publique : https://www.deliview.fr
# (méthode recommandée par OVH : le port 80 signale une requête en HTTP).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{SERVER_PORT} 80 [OR]
  RewriteCond %{HTTP_HOST} !^www\.deliview\.fr$ [NC]
  RewriteRule ^(.*)$ https://www.deliview.fr/$1 [R=301,L]

  # Anciennes pages retirées (2 octobre 2026) : redirection définitive vers la page qui les remplace.
  # Les pages de renvoi restent dans public/ en secours.
  RewriteRule ^integrations/uber-direct/?$ https://www.deliview.fr/integrations/ [R=301,L]
  RewriteRule ^solution/commandes/?$ https://www.deliview.fr/solution/ [R=301,L]
  # Pages détaillées remplacées par les pages des fonctions (7 octobre 2026).
  RewriteRule ^solution/carte-et-marge/?$ https://www.deliview.fr/solution/prix/ [R=301,L]
  RewriteRule ^solution/prix-et-concurrence/?$ https://www.deliview.fr/solution/prix/ [R=301,L]
  RewriteRule ^solution/reputation/?$ https://www.deliview.fr/solution/avis/ [R=301,L]

  # Le blog s'appelle Ressources : /blog et /blog/<article> mènent à la bonne adresse (8 octobre 2026).
  RewriteRule ^blog/?$ https://www.deliview.fr/ressources/ [R=301,L]
  RewriteRule ^blog/(.+?)/?$ https://www.deliview.fr/ressources/$1/ [R=301,L]

  # Dossier sans page (images, polices, vidéo…) : la page 404 du site, jamais le « Forbidden » brut d'Apache
  # (8 octobre 2026, demande de Tom : des visiteurs voyaient « Forbidden »).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ - [R=404,L]

  # Adresse d'un dossier sans barre finale (/tarifs) : une seule redirection, vers l'adresse publique exacte
  # (la redirection automatique d'Apache ajoutait « :443 » à l'adresse, 4 octobre 2026).
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ https://www.deliview.fr/$1/ [R=301,L]
</IfModule>

# Pages HTML toujours fraîches ; fichiers à nom versionné (assets/) gardés un an.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 7 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType image/x-icon "access plus 7 days"
  ExpiresByType video/mp4 "access plus 7 days"
  # Bannière animée et film de l'accueil en WebM (8 octobre 2026) : même durée que le MP4.
  ExpiresByType video/webm "access plus 7 days"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript text/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Isolement de la fenêtre (6 octobre 2026) : une page d'un autre site ouverte depuis Deliview ne peut pas agir sur elle.
  Header always set Cross-Origin-Opener-Policy "same-origin"
  # HTTPS imposé par le navigateur pendant un an après la première visite (ignoré en HTTP, sans les sous-domaines).
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
