---
// Formulaire de démo : 5 champs, envoyé à la fonction Supabase « lead » (validation côté serveur).
// Sans JavaScript : envoi classique, la fonction redirige vers /merci/ ou vers /demo/#erreur-….
// Avec JavaScript : validation à la sortie de chaque champ, envoi sans rechargement, confirmation sur place.
// Habillé en « bon de démo » par SectionDemo (direction « le passe ») : champs de 52 px, bordure Gris 2 à 70 %,
// erreur signalée par le texte et l'icône alerte dessinée, jamais par la couleur seule.
// Variante « commencer » (4 octobre 2026, boutons « Commencer maintenant » des offres) : le choix de l'offre en tête
// (Pro par défaut, ou l'offre de l'adresse ?offre=…), les mêmes 5 champs, puis la confirmation d'ouverture de compte.
// La fonction « lead » reconnaît le champ « offre » : alerte « Nouveau départ » à Tom, retour vers /commencer/merci/.
// Variante « parrainage » (4 octobre 2026, page /parrainage/) : un champ de plus en tête, « Qui vous recommande ? »,
// prérempli par le lien de partage du parrain (?par=…). La fonction « lead » range le parrain dans les notes.
import Chevron from '../icons/chevron.astro';
import { OFFRES, SITE, lien } from '../lib/site';

interface Props {
  // Section d'origine par défaut (si le visiteur n'a cliqué sur aucun bouton démo avant).
  section: string;
  variante?: 'demo' | 'commencer' | 'parrainage';
}
const { section, variante = 'demo' } = Astro.props;
const depart = variante === 'commencer';
const parrainage = variante === 'parrainage';
const offreParDefaut = OFFRES.find((o) => o.recommandee) ?? OFFRES[0];
const retour = new URL(import.meta.env.BASE_URL, SITE.url).href;
const champ = 'dv-champ placeholder:text-grey-2/70';
const libelle = 'block text-[16px] font-semibold leading-[1.3]';
const erreur = 'dv-erreur mt-2 hidden text-[15px] font-semibold leading-[1.4]';
---

<div class="dv-form" data-section={section}>
  <form
    action={SITE.formulaire}
    method="post"
    class="grid gap-[18px]"
    aria-describedby="dv-form-rgpd"
    data-formulaire-demo
    data-endpoint={SITE.formulaire}
  >
    {
      depart && (
        <fieldset class="dv-choix-offre">
          <legend class={libelle}>
            Votre offre <span class="font-normal dv-muted">· prix HT par mois</span>
          </legend>
          <div class="mt-2 grid gap-2.5">
            {OFFRES.map((o) => (
              <label class="dv-choix-offre-carte">
                <input type="radio" name="offre" value={o.slug} checked={o.slug === offreParDefaut.slug} data-nom={o.nom} />
                <span class="dv-choix-offre-nom">{o.nom}</span>
                <span class="dv-choix-offre-detail dv-muted">{o.restaurants}</span>
                <span class="dv-choix-offre-prix">{o.prix}&nbsp;€</span>
              </label>
            ))}
          </div>
        </fieldset>
      )
    }

    {
      parrainage && (
        <div>
          <label for="dv-parrain" class={libelle}>Qui vous recommande&nbsp;?</label>
          <input id="dv-parrain" name="parrain" type="text" autocomplete="off" required minlength="2" maxlength="160" placeholder="Exemple : Karim, Burger Factory Lyon" class={champ + ' mt-2'} aria-describedby="dv-parrain-erreur" />
          <p id="dv-parrain-erreur" class={erreur} data-message="Indiquez le prénom et le restaurant de la personne qui vous recommande."></p>
        </div>
      )
    }

    <div>
      <label for="dv-nom" class={libelle}>Prénom et nom</label>
      <input id="dv-nom" name="nom" type="text" autocomplete="name" required minlength="2" maxlength="120" class={champ + ' mt-2'} aria-describedby="dv-nom-erreur" />
      <p id="dv-nom-erreur" class={erreur} data-message="Indiquez votre prénom et votre nom."></p>
    </div>

    <div>
      <label for="dv-restaurant" class={libelle}>Nom du restaurant et ville</label>
      <input id="dv-restaurant" name="restaurant" type="text" autocomplete="organization" required minlength="2" maxlength="200" placeholder="Exemple : Pizzeria Roma, Lyon 6e" class={champ + ' mt-2'} aria-describedby="dv-restaurant-erreur" />
      <p id="dv-restaurant-erreur" class={erreur} data-message="Indiquez le nom de votre restaurant et sa ville."></p>
    </div>

    <div>
      <label for="dv-telephone" class={libelle}>Téléphone</label>
      <input id="dv-telephone" name="telephone" type="tel" inputmode="tel" autocomplete="tel" required pattern="[0-9+\s\(\)\.\-]{10,20}" maxlength="40" class={champ + ' mt-2'} aria-describedby="dv-telephone-erreur" />
      <p id="dv-telephone-erreur" class={erreur} data-message="Ce numéro semble incomplet. Vérifiez qu’il a bien 10 chiffres."></p>
    </div>

    <div>
      <label for="dv-email" class={libelle}>E-mail</label>
      <input id="dv-email" name="email" type="email" autocomplete="email" required maxlength="200" class={champ + ' mt-2'} aria-describedby="dv-email-erreur" />
      <p id="dv-email-erreur" class={erreur} data-message="Cette adresse e-mail semble incomplète. Vérifiez-la."></p>
    </div>

    <div>
      <label for="dv-points" class={libelle}>Nombre d’établissements</label>
      <div class="relative mt-2">
        <select id="dv-points" name="points_de_vente" required class={champ} aria-describedby="dv-points-erreur">
          <option value="" selected disabled>Choisir</option>
          <option value="1">1</option>
          <option value="2-5">2 à 5</option>
          <option value="6-10">6 à 10</option>
          <option value="11-19">11 à 19</option>
          <option value="20+">20 et plus</option>
        </select>
        <Chevron taille={24} class="pointer-events-none absolute right-4 top-1/2 -translate-y-1/2" />
      </div>
      <p id="dv-points-erreur" class={erreur} data-message="Choisissez votre nombre d’établissements."></p>
    </div>

    <!-- Champ piège : invisible pour les visiteurs, rempli par les robots (masqué sur place : le ticket qui entoure
         le formulaire a une ombre, un élément placé loin hors de l'écran agrandirait la zone à dessiner). -->
    <div class="sr-only" aria-hidden="true">
      <label for="dv-site-web">Ne remplissez pas ce champ</label>
      <input id="dv-site-web" name="site_web" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <input type="hidden" name="utm_source" />
    <input type="hidden" name="utm_medium" />
    <input type="hidden" name="utm_campaign" />
    <input type="hidden" name="utm_content" />
    <input type="hidden" name="page_origine" />
    <input type="hidden" name="section_cta" value={section} />
    <input type="hidden" name="retour" value={retour} />

    <p class="dv-erreur-generale hidden rounded-[12px] border-2 border-grey-2 bg-white p-4 text-[16px] font-semibold" role="alert"></p>

    <button type="submit" class="dv-btn dv-btn-plein mt-1 w-full" data-bouton-envoi>{depart ? 'Commencer maintenant' : 'Demander ma démo'}</button>

    <p id="dv-form-rgpd" class="text-[14px] leading-[1.5] dv-muted">
      {depart ? 'Vos informations servent uniquement à ouvrir votre compte et à vous recontacter.' : 'Vos informations servent uniquement à vous recontacter pour la démo.'} Détails dans notre <a href={lien('/confidentialite/')}>politique de confidentialité</a>.
    </p>
  </form>

  <div class="dv-form-ok hidden" role="status" tabindex="-1">
    <p class="dv-h3">C’est noté<span data-prenom></span>.</p>
    {
      depart ? (
        <>
          <p class="mt-3">
            Offre choisie&nbsp;: <strong data-offre-ok>{offreParDefaut.nom}</strong>. Tom vous appelle sous 3&nbsp;h au <strong data-tel></strong> pour ouvrir votre compte avec vous.
          </p>
          <p class="mt-3">Rien à payer aujourd’hui. Besoin d’aller plus vite&nbsp;? Écrivez à Tom&nbsp;: <a href={`mailto:${SITE.email}`} class="font-semibold">{SITE.email}</a>.</p>
        </>
      ) : (
        <>
          <p class="mt-3">Tom vous rappelle sous 3&nbsp;h au <strong data-tel></strong> pour fixer votre démo de 30&nbsp;minutes.</p>
          <p class="mt-3">Besoin d’aller plus vite&nbsp;? Écrivez à Tom&nbsp;: <a href={`mailto:${SITE.email}`} class="font-semibold">{SITE.email}</a>.</p>
        </>
      )
    }
    {
      SITE.rendezVous && !depart && (
        <a href={SITE.rendezVous} class="dv-btn dv-btn-contour mt-5 w-full" rel="noopener">
          Choisir mon créneau maintenant
        </a>
      )
    }
  </div>
</div>

<script>
  // Validation, provenance (UTM, page, bouton cliqué) et envoi sans rechargement.
  type Champ = HTMLInputElement | HTMLSelectElement;
  const UTM = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'];

  function lireStockage(cle: string): string | null {
    try {
      return sessionStorage.getItem(cle);
    } catch {
      return null;
    }
  }
  function ecrireStockage(cle: string, valeur: string) {
    try {
      sessionStorage.setItem(cle, valeur);
    } catch {
      /* stockage indisponible : on garde seulement la page en cours */
    }
  }

  // UTM de la page d'arrivée, gardés le temps de la visite (pas de cookie).
  const params = new URLSearchParams(location.search);
  if (UTM.some((k) => params.get(k))) {
    ecrireStockage('dv_utm', JSON.stringify(Object.fromEntries(UTM.map((k) => [k, (params.get(k) || '').slice(0, 100)]))));
  }

  function telephoneValide(v: string): boolean {
    let t = v.replace(/[\s.\-()]/g, '');
    if (t.startsWith('00')) t = '+' + t.slice(2);
    return /^0[1-9]\d{8}$/.test(t) || /^\+33[1-9]\d{8}$/.test(t) || /^\+[1-9]\d{7,14}$/.test(t);
  }

  function valide(c: Champ): boolean {
    const v = c.value.trim();
    if (c.name === 'telephone') return telephoneValide(v);
    if (c.name === 'email') return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v);
    if (c.name === 'nom' || c.name === 'restaurant' || c.name === 'parrain') return v.length >= 2;
    if (c.name === 'points_de_vente') return v !== '';
    return true;
  }

  function afficher(c: Champ, message: string | null) {
    const p = document.getElementById(c.id + '-erreur');
    if (!p) return;
    if (message) {
      p.textContent = message;
      p.classList.remove('hidden');
      c.setAttribute('aria-invalid', 'true');
    } else {
      p.textContent = '';
      p.classList.add('hidden');
      c.removeAttribute('aria-invalid');
    }
  }

  document.querySelectorAll<HTMLElement>('.dv-form').forEach((bloc) => {
    const form = bloc.querySelector<HTMLFormElement>('form[data-formulaire-demo]');
    const ok = bloc.querySelector<HTMLElement>('.dv-form-ok');
    if (!form || !ok) return;
    form.noValidate = true;
    const champs = Array.from(form.querySelectorAll<Champ>('input[required], select[required]'));
    const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const generale = form.querySelector<HTMLElement>('.dv-erreur-generale')!;
    const message = (c: Champ) => document.getElementById(c.id + '-erreur')?.dataset.message || 'Vérifiez ce champ.';

    // Formulaire « Commencer » : l'offre de l'adresse (?offre=…) est cochée, le bouton dit l'offre choisie.
    const offres = Array.from(form.querySelectorAll<HTMLInputElement>('input[name="offre"]'));
    const offreChoisie = () => offres.find((x) => x.checked);
    if (offres.length) {
      const voulue = offres.find((x) => x.value === params.get('offre'));
      if (voulue) voulue.checked = true;
      const libelleBouton = () => {
        const o = offreChoisie();
        if (o && !bouton.disabled) bouton.textContent = 'Commencer avec ' + (o.dataset.nom || o.value);
      };
      offres.forEach((x) => x.addEventListener('change', libelleBouton));
      libelleBouton();
    }

    // Provenance : UTM de la visite, page, dernier bouton démo cliqué.
    try {
      const utm = JSON.parse(lireStockage('dv_utm') || '{}') as Record<string, string>;
      UTM.forEach((k) => {
        const h = form.elements.namedItem(k) as HTMLInputElement | null;
        if (h && utm[k]) h.value = utm[k];
      });
    } catch {
      /* valeur illisible : ignorée */
    }
    (form.elements.namedItem('page_origine') as HTMLInputElement).value = location.pathname.slice(0, 200);
    // Lien de parrainage (?par=…) : le nom du parrain est déjà écrit.
    const parrain = form.elements.namedItem('parrain') as HTMLInputElement | null;
    const par = (params.get('par') || '').trim().slice(0, 160);
    if (parrain && par && !parrain.value) parrain.value = par;
    const sectionCta = form.elements.namedItem('section_cta') as HTMLInputElement;
    const sectionParDefaut = sectionCta.value;

    champs.forEach((c) => {
      c.addEventListener('blur', () => {
        if (c.value.trim() === '' && !c.getAttribute('aria-invalid')) return;
        afficher(c, valide(c) ? null : message(c));
      });
      c.addEventListener('input', () => {
        if (c.getAttribute('aria-invalid') && valide(c)) afficher(c, null);
      });
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      generale.classList.add('hidden');
      const fautifs = champs.filter((c) => !valide(c));
      champs.forEach((c) => afficher(c, fautifs.includes(c) ? message(c) : null));
      if (fautifs.length) {
        fautifs[0].focus();
        return;
      }
      // Dernier bouton « Demander une démo » cliqué pendant la visite, lu au moment de l'envoi.
      sectionCta.value = (lireStockage('dv_section_cta') || sectionParDefaut).slice(0, 60);
      bouton.disabled = true;
      const texte = bouton.textContent;
      bouton.textContent = 'Envoi en cours…';
      const donnees = Object.fromEntries(new FormData(form).entries());
      try {
        const r = await fetch(form.dataset.endpoint || form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(donnees),
        });
        const corps = (await r.json().catch(() => ({}))) as { ok?: boolean; message?: string; erreurs?: Record<string, string> };
        if (r.ok && corps.ok) {
          const prenom = String(donnees.nom || '').trim().split(/\s+/)[0];
          const span = ok.querySelector('[data-prenom]');
          if (span && prenom) span.textContent = ', ' + prenom;
          const tel = ok.querySelector('[data-tel]');
          if (tel) tel.textContent = String(donnees.telephone || '');
          const o = offreChoisie();
          const offreOk = ok.querySelector('[data-offre-ok]');
          if (offreOk && o) offreOk.textContent = o.dataset.nom || o.value;
          form.classList.add('hidden');
          ok.classList.remove('hidden');
          ok.focus();
          return;
        }
        if (r.status === 422 && corps.erreurs) {
          const avecErreur = champs.filter((c) => corps.erreurs![c.name]);
          avecErreur.forEach((c) => afficher(c, corps.erreurs![c.name]));
          avecErreur[0]?.focus();
        } else {
          generale.textContent = corps.message || 'Votre demande n’a pas pu partir. Réessayez, ou écrivez à Tom\u00a0: tom.voisin@deliview.fr.';
          generale.classList.remove('hidden');
        }
      } catch {
        generale.textContent = 'La connexion a été coupée. Réessayez, ou écrivez à Tom\u00a0: tom.voisin@deliview.fr.';
        generale.classList.remove('hidden');
      }
      bouton.disabled = false;
      bouton.textContent = texte;
    });
  });
</script>
