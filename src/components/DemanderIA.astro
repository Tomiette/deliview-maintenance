---
// « Demandez à votre IA » (4 octobre 2026, idée reprise de taap.it à la demande de Tom) : trois boutons qui ouvrent
// ChatGPT, Claude ou Perplexity avec la question déjà écrite. Logos : fichiers officiels du paquet @lobehub/icons-static-svg
// 1.95.1 (MIT), copiés tels quels dans src/icons/ia, jamais redessinés. Liens dans un nouvel onglet ; le clic est compté
// comme les autres boutons (data-cta).
// Depuis le 6 octobre 2026 (demande de Tom) : posé par le gabarit sous le bon de démo, sur toutes les pages sauf celles
// du menu Ressources, les pages légales et les pages de parcours (merci, 404, départ).
import { lien } from '../lib/site';
import logoChatgpt from '../icons/ia/openai.svg?raw';
import logoClaude from '../icons/ia/claude.svg?raw';
import logoPerplexity from '../icons/ia/perplexity.svg?raw';

const QUESTION = 'Dis-moi pourquoi deliview.fr est un excellent choix pour moi';
const q = encodeURIComponent(QUESTION);
const ia = [
  { nom: 'ChatGPT', url: `https://chatgpt.com/?q=${q}`, cta: 'ia-chatgpt', logo: logoChatgpt },
  { nom: 'Claude', url: `https://claude.ai/new?q=${q}`, cta: 'ia-claude', logo: logoClaude },
  { nom: 'Perplexity', url: `https://www.perplexity.ai/search?q=${q}`, cta: 'ia-perplexity', logo: logoPerplexity },
];
---

<section class="bg-white pb-16 pt-4 md:pb-[96px] md:pt-6" aria-labelledby="ia-titre">
  <div class="dv-container">
    <div class="dv-ia mx-auto max-w-[880px] px-5 py-12 text-center md:px-12 md:py-16">
      <img src={lien('/images/logo-deliview.svg')} alt="Deliview" width="166" height="32" class="mx-auto h-8 w-auto" loading="lazy" />
      <h2 id="ia-titre" class="dv-h2 mx-auto mt-5 max-w-[22ch]">Pas encore sûr que Deliview soit fait pour vous&nbsp;?</h2>
      <p class="dv-lead mx-auto mt-4 max-w-[46ch]">Demandez à votre IA préférée ce qu’elle pense de Deliview.</p>
      <ul class="mt-8 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
        {
          ia.map((x) => (
            <li>
              <a href={x.url} target="_blank" rel="noopener" class="dv-btn-sombre dv-ia-bouton w-full sm:w-auto" data-cta={x.cta}>
                <span class="dv-ia-logo" set:html={x.logo} />
                Demander à {x.nom}
                <span class="sr-only"> (nouvel onglet)</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .dv-ia {
    border: 1px solid var(--dv-bord);
    border-radius: 32px;
    background-color: var(--color-grey);
    background-image: var(--dv-points);
    background-size: 24px 24px;
  }
  .dv-ia-bouton {
    gap: 8px;
    min-height: 48px;
    padding-inline: 20px;
    font-size: 17px;
  }
  .dv-ia-logo {
    display: inline-flex;
    flex: none;
  }
</style>
