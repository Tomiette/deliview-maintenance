---
// Bloc fonctionnalité des pages Solution, modèle unique (décision de Tom, 2 octobre 2026) : icône dessinée, nom,
// bénéfice en une phrase, 3 points au plus, un exemple chiffré tiré d'une vraie analyse (anonymisé) présenté en ticket,
// et la vraie capture. Texte et capture alternent d'un bloc à l'autre.
// Refonte en relief (3 octobre 2026) : la capture dans une tablette inclinée en 3D, une bulle reprend un chiffre de
// la capture ; ou, quand le haut de page montre déjà cet écran, une carte de l'app qui flotte (fragment).
// Le slot accueille un bouton utile à cet endroit (ex. le simulateur sous Pricing Menu).
import Scene3D from './Scene3D.astro';
import Flottant from './Flottant.astro';
import FragmentFlottant from './FragmentFlottant.astro';
import Bulle from './Bulle.astro';
import Pastille from './Pastille.astro';
import Ticket from './Ticket.astro';
import Coche from '../icons/coche.astro';
import { ICONES } from '../lib/registre-icones';
import { exposants, type CaptureApp, type Fonctionnalite } from '../lib/site';

interface Props {
  f: Fonctionnalite;
  inverse?: boolean;
  fond?: 'blanc' | 'gris';
  niveau?: 'h2' | 'h3';
  // Carte de l'app à montrer à la place de la tablette.
  fragment?: CaptureApp;
}
const { f, inverse = false, fond = 'blanc', niveau = 'h2', fragment } = Astro.props;
const Titre = niveau;
const Icone = ICONES[f.icone];
const sens = inverse ? 'gauche' : 'droite';
---

<section id={f.id} class={`dv-section scroll-mt-24 overflow-x-clip ${fond === 'gris' ? 'bg-grey dv-points' : 'bg-white'}`} aria-labelledby={`${f.id}-titre`}>
  <div class="dv-container grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
    <div class={inverse ? 'lg:order-2' : ''}>
      <Pastille icone={Icone}>{f.nom}</Pastille>
      <Titre id={`${f.id}-titre`} class="dv-h2 mt-4 max-w-[20ch] md:mt-5">{f.benefice}</Titre>
      <ul class="mt-6 grid gap-2.5 text-[16px] leading-[1.5] md:text-[17px]">
        {
          f.points.map((x) => (
            <li class="flex gap-2.5">
              <Coche taille={24} />
              <span>{x}</span>
            </li>
          ))
        }
      </ul>
      <Ticket class="mt-8 max-w-[440px]" inclinaison={inverse ? 1 : -1} papier="px-5 pb-5 pt-4 md:px-6 md:pb-6 md:pt-5" apparition="defilement">
        <p class="dv-ticket-entete"><span>Exemple réel</span></p>
        <p class="mt-3 font-accent text-[19px] font-bold leading-[1.35] md:text-[21px]">{f.exemple.texte}</p>
        <div class="dv-pointilles my-3.5" aria-hidden="true"></div>
        <p class="text-[14px] leading-[1.45] dv-muted md:text-[15px]" set:html={exposants(f.exemple.contexte) + '. Nom du restaurant masqué.'} />
      </Ticket>
      <slot />
    </div>
    <div class={`w-full ${inverse ? 'lg:order-1' : ''}`}>
      {
        fragment ? (
          <FragmentFlottant fragment={fragment} sens={sens} class="mx-auto max-w-[520px]" />
        ) : (
          <Scene3D capture={f.capture} sens={sens} ratio={1.14} ratioMobile={1.02} appareil={{ x: 5, y: 12, largeur: 90 }} sizes="(min-width: 1200px) 520px, (min-width: 1024px) 44vw, 92vw">
            <Flottant x={-3} y={66} xm={0} ym={68} droite={!inverse} z={14} duree={6.6}>
              <Bulle {...f.bulle} />
            </Flottant>
          </Scene3D>
        )
      }
    </div>
  </div>
</section>
