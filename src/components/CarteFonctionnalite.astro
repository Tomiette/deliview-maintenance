---
// Carte fonctionnalité, même gabarit partout : icône dessinée de 48 px, nom, bénéfice en une phrase, 3 points au plus,
// vraie capture dans le cadre tablette (format compact), lien « Voir comment ça marche ».
import CadreTablette from './CadreTablette.astro';
import Coche from '../icons/coche.astro';
import Fleche from '../icons/fleche.astro';
import { ICONES, type NomIcone } from '../lib/registre-icones';
import { lien, type CaptureApp } from '../lib/site';

interface Props {
  icone: NomIcone;
  nom: string;
  benefice: string;
  points: string[];
  capture: CaptureApp;
  href: string;
  niveau?: 'h2' | 'h3';
}

const { icone, nom, benefice, points, capture, href, niveau = 'h3' } = Astro.props;
const Icone = ICONES[icone];
const Titre = niveau;
---

<li class="dv-card flex flex-col p-[22px] md:p-7">
  <Icone taille={48} />
  <Titre class="mt-3.5 font-accent text-[21px] font-bold leading-[1.25] md:mt-5 md:text-[24px]">{nom}</Titre>
  <p class="mt-1.5 text-[17px] leading-[1.5] md:mt-2 md:text-[18px] md:leading-[1.55]">{benefice}</p>
  <ul class="mt-4 grid gap-2 text-[16px] leading-[1.45] dv-muted md:mt-5 md:gap-2.5 md:leading-[1.5]">
    {
      points.map((p) => (
        <li class="flex gap-2.5">
          <Coche taille={24} />
          <span>{p}</span>
        </li>
      ))
    }
  </ul>
  <CadreTablette capture={capture} compact class="mt-7" sizes="(min-width: 1200px) 320px, (min-width: 768px) 30vw, 90vw" />
  <a href={lien(href)} class="dv-lien-fort mt-4 self-start" aria-label={`Voir comment ça marche : ${nom.toLowerCase()}`}>
    Voir comment ça marche<Fleche taille={24} />
  </a>
</li>
