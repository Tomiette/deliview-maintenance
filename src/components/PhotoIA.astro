---
// Illustration générée par IA, toujours avec sa mention visible « Illustration générée par IA ».
// Elle montre une situation de restaurateur, jamais un client de Deliview ni une capture de l'app.
import { IMAGES_IA, lien, type ImageIA } from '../lib/site';

interface Props {
  nom: ImageIA;
  alt: string;
  // Attribut sizes : largeur affichée selon l'écran.
  sizes: string;
  // Format imposé (ex. « 4 / 3 ») : l'image est recadrée au centre.
  ratio?: string;
  // « carte » : sans arrondi propre, l'image prend le haut d'une carte arrondie.
  cadre?: 'arrondi' | 'carte';
  // Image visible dès l'arrivée sur la page (hero) : chargée en priorité.
  priorite?: boolean;
  class?: string;
}
const { nom, alt, sizes, ratio, cadre = 'arrondi', priorite = false, class: classe = '' } = Astro.props;
const image = IMAGES_IA[nom];
const base = lien(`/images/ia/${nom}`);
const largeurs: readonly number[] = image.largeurs;
const srcset = largeurs.map((w) => `${base}-${w}.webp ${w}w`).join(', ');
const defaut = `${base}-${largeurs[largeurs.length - 1]}.webp`;
---

<figure class={`dv-photo-ia ${cadre === 'carte' ? 'dv-photo-ia-carte' : ''} ${classe}`}>
  <img
    src={defaut}
    srcset={srcset}
    sizes={sizes}
    alt={alt}
    width={image.largeur}
    height={image.hauteur}
    loading={priorite ? 'eager' : 'lazy'}
    fetchpriority={priorite ? 'high' : 'auto'}
    decoding="async"
    style={ratio ? `aspect-ratio: ${ratio}` : undefined}
  />
  <figcaption class="dv-photo-ia-mention">Illustration générée par IA</figcaption>
</figure>

<style>
  .dv-photo-ia {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--color-grey);
  }
  .dv-photo-ia-carte {
    border-radius: 0;
  }
  .dv-photo-ia img {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  /* Mention lisible sur n'importe quelle photo : Grey 2 sur pastille blanche (8,6:1). */
  .dv-photo-ia-mention {
    position: absolute;
    left: 12px;
    bottom: 12px;
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--color-white);
    color: var(--color-grey-2);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.6;
  }
</style>
