---
import Base from "../layouts/Base.astro";
import BandeauPlateformes from "../components/BandeauPlateformes.astro";
import SectionDemo from "../components/SectionDemo.astro";
import { CONTENU } from "../content/contenu";

const d = CONTENU.donnees;
---

<Base title={d.metaTitle} description={d.metaDescription} ariane={[{ nom: "Nos données", chemin: "/donnees" }]}>
  <section class="container-dv pt-8 pb-16 md:pt-12 md:pb-24" aria-labelledby="titre-hero">
    <p class="surtitre text-blue">{d.surtitre}</p>
    <h1 id="titre-hero" class="texte mt-3">{d.h1}</h1>
    <p class="texte mt-6 text-lg md:text-xl">{d.sousTitre}</p>
    <a href="#demo" class="btn btn-plein mt-8" data-cta="donnees-hero">Demander une démo</a>
  </section>

  <BandeauPlateformes />

  <section class="section" aria-labelledby="titre-blocs">
    <div class="container-dv">
      <h2 id="titre-blocs" class="sr-only">Comment Deliview obtient et utilise ses données</h2>
      <ul class="grid gap-6 md:grid-cols-2">
        {
          d.blocs.map((b) => (
            <li class="carte">
              <h3>{b.titre}</h3>
              <p class="mt-3 texte-secondaire">{b.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <SectionDemo />
</Base>
