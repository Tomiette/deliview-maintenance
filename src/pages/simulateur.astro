---
// Simulateur de rentabilité, question par question (4 octobre 2026, logique du simulateur de Flynt reprise à la demande
// de Tom, contenu propre à Deliview) : structure, établissements, ventes en livraison, commission, coût matière, puis
// coordonnées, puis les résultats tout de suite à l'écran. Deux résultats : ce qui reste chaque mois sur Uber Eats et
// Deliveroo (avant salaires et charges), et ce qu'un prix bien placé ajouterait.
// Les coordonnées partent à la fonction « lead » (section « simulateur:<structure>:rappel|sans-rappel », résumé chiffré
// dans les notes de la demande) ; Tom n'appelle que si la case de rappel est cochée. Chaque valeur proposée est un
// exemple affiché comme tel, ou une valeur sourcée.
// 9 octobre 2026 (demande de Tom, après un premier lead sans rappel) : seconde case, décochée, pour recevoir par e-mail
// les plats vendus sous le prix du quartier (« :analyse » en fin de section). Sans rappel ni analyse, Tom ne contacte
// pas le restaurateur : c'est la promesse écrite sous les cases.
// Sans JavaScript : toutes les questions s'affichent à la suite et l'envoi passe par la fonction (page merci).
// 8 octobre 2026 (demande de Tom : plus aucun prix sur le site) : la ligne « l'abonnement est couvert N fois » laisse
// place à une phrase sur le prix, fixé avec Tom avant tout paiement.
import Base from '../layouts/Base.astro';
import BoutonDemo from '../components/BoutonDemo.astro';
import Pastille from '../components/Pastille.astro';
import Pieces from '../icons/pieces.astro';
import Toque from '../icons/toque.astro';
import SacLivraison from '../icons/sac-livraison.astro';
import Chevron from '../icons/chevron.astro';
import { IDS, SITE, lien } from '../lib/site';

// Hypothèses du gain de prix : exemple réel d'analyse (burgers, Paris, 1er octobre 2026), signalées sous le résultat.
const PART_SOUS_ZONE = 21;
const HAUSSE = 10;
const retour = new URL(import.meta.env.BASE_URL, SITE.url).href;
const commissionSource = { libelle: 'page tarifs d’Uber Eats', url: 'https://merchants.ubereats.com/fr/fr/pricing/' };

const description =
  'En 2 minutes : ce qui vous reste vraiment sur Uber Eats et Deliveroo après commission, TVA et coût matière, et ce qu’un prix bien placé vous rapporterait.';
const outil = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Simulateur de rentabilité Deliview',
  url: SITE.url + '/simulateur/',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  inLanguage: 'fr-FR',
  isAccessibleForFree: true,
  description,
  publisher: { '@type': 'Organization', '@id': IDS.organisation, name: 'Deliview', url: SITE.url },
};
const libelle = 'block text-[16px] font-semibold leading-[1.3]';
const erreur = 'dv-erreur mt-2 hidden text-[15px] font-semibold leading-[1.4]';
---

<Base title="Simulateur de rentabilité Uber Eats et Deliveroo | Deliview" description={description} ariane={[{ nom: 'Simulateur de rentabilité', chemin: '/simulateur/' }]} jsonld={[outil]} barreDemo={false}>
  <section class="overflow-x-clip bg-grey pb-16 pt-6 md:pb-[104px] md:pt-10" aria-labelledby="simulateur-titre" data-haut-de-page>
    <div class="dv-container max-w-[880px]">
      <div class="text-center">
        <Pastille icone={Pieces}>Simulateur de rentabilité</Pastille>
        <h1 id="simulateur-titre" class="dv-h1 mx-auto mt-5 max-w-[20ch] md:mt-6">Ce qui vous reste vraiment sur Uber&nbsp;Eats et Deliveroo</h1>
        <p class="dv-lead mx-auto mt-4 max-w-[52ch] md:mt-5">5 questions, 2 minutes. Vous n’avez pas un chiffre&nbsp;? Gardez l’exemple proposé.</p>
      </div>

      <div class="dv-relief dv-sim mt-8 px-5 pb-7 pt-6 sm:px-8 md:mt-10 md:px-12 md:pb-10 md:pt-8">
        <div class="dv-sim-progression" aria-hidden="true" hidden data-sim-progression>
          <span></span><span></span><span></span><span></span>
        </div>

        <form id="simulateur" action={SITE.formulaire} method="post" novalidate data-endpoint={SITE.formulaire}>
          <!-- 1. Structure -->
          <section class="dv-sim-etape" data-etape="1" data-categorie="Votre structure" aria-labelledby="q1">
            <fieldset>
              <legend id="q1" class="dv-sim-question" tabindex="-1">Quelle est votre structure&nbsp;?</legend>
              <p class="dv-sim-aide">Un restaurant avec salle, ou une cuisine qui ne vend qu’en livraison.</p>
              <div class="mt-6 grid gap-3 sm:grid-cols-2">
                <label class="dv-sim-choix">
                  <input type="radio" name="structure" value="restaurant" checked />
                  <Toque taille={48} />
                  <span>Restaurant</span>
                </label>
                <label class="dv-sim-choix">
                  <input type="radio" name="structure" value="dark-kitchen" />
                  <SacLivraison taille={48} />
                  <span>Dark kitchen</span>
                </label>
              </div>
            </fieldset>
          </section>

          <!-- 2. Établissements -->
          <section class="dv-sim-etape" data-etape="2" data-categorie="Votre structure" aria-labelledby="q2">
            <h2 id="q2" class="dv-sim-question" tabindex="-1">Combien d’établissements avez-vous&nbsp;?</h2>
            <p class="dv-sim-aide">Un établissement, c’est un lieu où vous cuisinez, même s’il porte plusieurs marques.</p>
            <label for="sim-etablissements" class={`${libelle} mt-6`}>Nombre d’établissements</label>
            <div class="mt-2 flex items-stretch gap-3">
              <button type="button" class="dv-sim-pas" data-pas="-1" aria-label="Un établissement de moins" hidden>−</button>
              <input id="sim-etablissements" name="etablissements" type="number" inputmode="numeric" min="1" max="200" step="1" value="1" required class="dv-champ text-center" aria-describedby="sim-etablissements-erreur" />
              <button type="button" class="dv-sim-pas" data-pas="1" aria-label="Un établissement de plus" hidden>+</button>
            </div>
            <p id="sim-etablissements-erreur" class={erreur} data-message="Indiquez un nombre entre 1 et 200."></p>
          </section>

          <!-- 3. Ventes -->
          <section class="dv-sim-etape" data-etape="3" data-categorie="Vos ventes" aria-labelledby="q3">
            <h2 id="q3" class="dv-sim-question" tabindex="-1">Combien vendez-vous en livraison chaque mois&nbsp;?</h2>
            <p class="dv-sim-aide">Uber Eats et Deliveroo réunis, tous établissements, TTC. Le chiffre est dans vos rapports de paiement.</p>
            <label for="sim-ventes" class={`${libelle} mt-6`}>Ventes en livraison par mois</label>
            <div class="dv-sim-unite mt-2">
              <input id="sim-ventes" name="ventes" type="number" inputmode="decimal" min="1" max="10000000" step="1" value="15000" required class="dv-champ" aria-describedby="sim-ventes-note sim-ventes-erreur" />
              <span aria-hidden="true">€ TTC</span>
            </div>
            <p id="sim-ventes-erreur" class={erreur} data-message="Indiquez vos ventes du mois, en euros."></p>
            <p id="sim-ventes-note" class="dv-sim-note"><strong>Exemple&nbsp;:</strong> 15&nbsp;000&nbsp;€, soit 600&nbsp;commandes à 25&nbsp;€ (panier moyen en livraison en 2024, <a href="https://www.cdlkservices.com/barometre-payment-data-zoom-sur-le-secteur-des-livraisons-repas-performances-2024/" rel="noopener">baromètre CDLK Services</a>).</p>
          </section>

          <!-- 4. Commission -->
          <section class="dv-sim-etape" data-etape="4" data-categorie="Vos coûts" aria-labelledby="q4">
            <h2 id="q4" class="dv-sim-question" tabindex="-1">Quelle commission payez-vous aux plateformes&nbsp;?</h2>
            <p class="dv-sim-aide">Le taux moyen, toutes plateformes. Il figure sur vos factures.</p>
            <label for="sim-commission" class={`${libelle} mt-6`}>Commission moyenne</label>
            <div class="dv-sim-unite mt-2">
              <input id="sim-commission" name="commission" type="number" inputmode="decimal" min="0" max="60" step="0.5" value="30" required class="dv-champ" aria-describedby="sim-commission-note sim-commission-erreur" />
              <span aria-hidden="true">%</span>
            </div>
            <p id="sim-commission-erreur" class={erreur} data-message="Indiquez un taux entre 0 et 60 %."></p>
            <p id="sim-commission-note" class="dv-sim-note"><strong>Exemple&nbsp;:</strong> 30&nbsp;%, le taux Standard de la <a href={commissionSource.url} rel="noopener">{commissionSource.libelle}</a>. Deliveroo ne publie pas le sien.</p>
          </section>

          <!-- 5. Coût matière -->
          <section class="dv-sim-etape" data-etape="5" data-categorie="Vos coûts" aria-labelledby="q5">
            <h2 id="q5" class="dv-sim-question" tabindex="-1">Quel est votre coût matière&nbsp;?</h2>
            <p class="dv-sim-aide">Ce que coûtent les ingrédients et les emballages, en part de vos ventes hors taxes.</p>
            <label for="sim-matiere" class={`${libelle} mt-6`}>Coût matière moyen</label>
            <div class="dv-sim-unite mt-2">
              <input id="sim-matiere" name="matiere" type="number" inputmode="decimal" min="0" max="90" step="0.5" value="30" required class="dv-champ" aria-describedby="sim-matiere-note sim-matiere-erreur" />
              <span aria-hidden="true">%</span>
            </div>
            <p id="sim-matiere-erreur" class={erreur} data-message="Indiquez une part entre 0 et 90 %."></p>
            <p id="sim-matiere-note" class="dv-sim-note"><strong>Exemple&nbsp;:</strong> 30&nbsp;%. Votre comptable a le chiffre exact.</p>
          </section>

          <!-- 6. Coordonnées -->
          <section class="dv-sim-etape" data-etape="6" data-categorie="Vos résultats" aria-labelledby="q6">
            <h2 id="q6" class="dv-sim-question" tabindex="-1">Vos résultats sont prêts</h2>
            <p class="dv-sim-aide">Laissez vos coordonnées&nbsp;: vos résultats s’affichent tout de suite. Pas de publicité.</p>
            <div class="mt-6 grid gap-[18px] sm:grid-cols-2">
              <div>
                <label for="dv-nom" class={libelle}>Prénom et nom</label>
                <input id="dv-nom" name="nom" type="text" autocomplete="name" required minlength="2" maxlength="120" class="dv-champ mt-2" aria-describedby="dv-nom-erreur" />
                <p id="dv-nom-erreur" class={erreur} data-message="Indiquez votre prénom et votre nom."></p>
              </div>
              <div>
                <label for="dv-restaurant" class={libelle}>Nom du restaurant et ville</label>
                <input id="dv-restaurant" name="restaurant" type="text" autocomplete="organization" required minlength="2" maxlength="200" placeholder="Pizzeria Roma, Lyon 6e" class="dv-champ mt-2 placeholder:text-grey-2/70" aria-describedby="dv-restaurant-erreur" />
                <p id="dv-restaurant-erreur" class={erreur} data-message="Indiquez le nom de votre restaurant et sa ville."></p>
              </div>
              <div>
                <label for="dv-email" class={libelle}>E-mail</label>
                <input id="dv-email" name="email" type="email" autocomplete="email" required maxlength="200" class="dv-champ mt-2" aria-describedby="dv-email-erreur" />
                <p id="dv-email-erreur" class={erreur} data-message="Cette adresse e-mail semble incomplète. Vérifiez-la."></p>
              </div>
              <div>
                <label for="dv-telephone" class={libelle}>Téléphone</label>
                <input id="dv-telephone" name="telephone" type="tel" inputmode="tel" autocomplete="tel" required maxlength="40" class="dv-champ mt-2" aria-describedby="dv-telephone-erreur" />
                <p id="dv-telephone-erreur" class={erreur} data-message="Ce numéro semble incomplet. Vérifiez qu’il a bien 10 chiffres."></p>
              </div>
            </div>
            <label class="mt-5 flex cursor-pointer items-start gap-3 text-[16px] leading-[1.45]">
              <input type="checkbox" name="rappel" value="oui" checked class="mt-0.5 h-6 w-6 shrink-0 accent-blue" />
              <span>Je souhaite que Tom me rappelle pour voir mes plats vendus trop bas (démo gratuite de 30&nbsp;minutes).</span>
            </label>
            <label class="mt-3 flex cursor-pointer items-start gap-3 text-[16px] leading-[1.45]">
              <input type="checkbox" name="analyse" value="oui" class="mt-0.5 h-6 w-6 shrink-0 accent-blue" />
              <span>Envoyez-moi par e-mail les plats que je vends sous le prix de mon quartier (analyse gratuite).</span>
            </label>
            <p class="mt-4 text-[14px] leading-[1.5] dv-muted">
              Vos coordonnées et votre simulation servent uniquement à vous recontacter si vous le demandez. Détails dans notre <a href={lien('/confidentialite/')}>politique de confidentialité</a>.
            </p>
          </section>

          <div class="sr-only" aria-hidden="true">
            <label for="sim-site-web">Ne remplissez pas ce champ</label>
            <input id="sim-site-web" name="site_web" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <input type="hidden" name="points_de_vente" value="1" />
          <input type="hidden" name="section_cta" value="simulateur" />
          <input type="hidden" name="simulation" value="" />
          <input type="hidden" name="page_origine" value="/simulateur/" />
          <input type="hidden" name="retour" value={retour} />
          <input type="hidden" name="utm_source" /><input type="hidden" name="utm_medium" /><input type="hidden" name="utm_campaign" /><input type="hidden" name="utm_content" />
          <input type="hidden" name="visiteur" />

          <p class="dv-erreur-generale mt-5 hidden rounded-[12px] border-2 border-grey-2 bg-white p-4 text-[16px] font-semibold" role="alert"></p>

          <div class="dv-sim-actions">
            <button type="button" class="dv-sim-retour" data-sim-retour hidden><Chevron taille={24} class="rotate-90" />Précédent</button>
            <button type="submit" class="dv-btn dv-btn-plein" data-sim-suivant>Voir mes résultats</button>
          </div>
        </form>

        <!-- Résultats -->
        <div class="dv-sim-resultats" hidden data-sim-resultats tabindex="-1" aria-labelledby="resultats-titre">
          <h2 id="resultats-titre" class="dv-sim-question">Chaque mois, il vous reste environ <span class="dv-sim-montant" data-r="reste"></span></h2>
          <p class="dv-sim-aide">Sur vos ventes Uber Eats et Deliveroo, avant salaires, loyer et charges.</p>
          <dl class="dv-sim-detail mt-6">
            <div><dt>Ventes en livraison (TTC)</dt><dd data-r="ventes"></dd></div>
            <div><dt>TVA (10&nbsp;%)</dt><dd data-r="tva"></dd></div>
            <div><dt>Commission des plateformes (<span data-r="commission-taux"></span>)</dt><dd data-r="commission"></dd></div>
            <div><dt>Coût matière (<span data-r="matiere-taux"></span>)</dt><dd data-r="matiere"></dd></div>
            <div class="dv-sim-total"><dt>Ce qui vous reste</dt><dd data-r="reste-detail"></dd></div>
          </dl>
          <p class="mt-3 text-[15px] leading-[1.5] dv-muted">Soit <span data-r="part"></span> de vos ventes. La commission est calculée sur le montant TTC, le coût matière sur le hors taxes.</p>

          <div class="dv-sim-gain mt-8">
            <p class="dv-overline">Avec des prix bien placés</p>
            <p class="mt-2 text-[22px] font-bold leading-[1.3] md:text-[26px]"><span data-r="gain"></span> de plus par mois, <span data-r="gain-an"></span> par an</p>
            <p class="mt-2 text-[16px] leading-[1.5]">Le prix de Deliview dépend de vos restaurants et de vos besoins&nbsp;: Tom le fixe avec vous, avant tout paiement.</p>
            <p class="mt-3 text-[15px] leading-[1.5] dv-muted">
              Hypothèse tirée d’une vraie analyse (burgers, Paris, 1<sup>er</sup>&nbsp;octobre 2026)&nbsp;: {PART_SOUS_ZONE}&nbsp;% des plats de la carte sous le prix médian du quartier, remontés de {HAUSSE}&nbsp;%, à ventes égales. Deliview calcule ce chiffre plat par plat pour votre restaurant.
            </p>
          </div>

          <div class="mt-8" data-r-rappel hidden>
            <p class="text-[17px] font-semibold leading-[1.5]">C’est noté. Tom vous appelle sous 3&nbsp;h au <span data-r="tel"></span> pour vous montrer vos plats vendus trop bas.</p>
          </div>
          <div class="mt-8" data-r-analyse hidden>
            <p class="text-[17px] font-semibold leading-[1.5]"><span data-r-analyse-note>C’est noté. </span>Tom compare les prix de votre carte à ceux de votre quartier, puis vous envoie à <span data-r="email"></span> les plats que vous vendez en dessous.</p>
          </div>
          <div class="mt-8" data-r-sans-rappel hidden>
            <BoutonDemo href={lien('/demo/')} cta="simulateur-resultats" libelle="Voir mes plats vendus trop bas" class="w-full sm:w-auto" />
          </div>
          <button type="button" class="mt-6 text-[16px] font-semibold underline underline-offset-4" data-sim-recommencer>Refaire la simulation</button>
        </div>
      </div>
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="methode-titre">
    <div class="dv-container max-w-[760px]">
      <h2 id="methode-titre" class="dv-h2">Comment le calcul est fait</h2>
      <p class="mt-5">On part de vos ventes en livraison du mois, TTC. On retire la TVA à 10&nbsp;% (repas préparés), la commission des plateformes calculée sur le TTC, puis le coût matière calculé sur le hors taxes. Ce qui reste paie vos salaires, votre loyer et vos charges&nbsp;: ils ne sont pas comptés ici.</p>
      <p class="mt-4">Le gain d’un prix bien placé&nbsp;: sur les plats vendus sous le prix médian de votre quartier, une hausse rapporte des ventes en plus sans coût matière en plus. On retire la TVA et la commission. Si un plat se vend moins après la hausse, le gain baisse. La méthode complète est dans le guide <a href={lien('/ressources/fixer-prix-uber-eats-deliveroo/')}>fixer ses prix sur Uber Eats et Deliveroo</a>.</p>
    </div>
  </section>
</Base>

<style is:global>
  .dv-sim-progression {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 8px;
    margin-bottom: 24px;
  }
  .dv-sim-progression span {
    height: 4px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-grey-2) 15%, transparent);
    background-image: linear-gradient(var(--color-blue), var(--color-blue));
    background-repeat: no-repeat;
    background-size: var(--rempli, 0%) 100%;
    transition: background-size 0.3s ease;
  }
  .dv-sim-categorie {
    display: block;
    width: fit-content;
    margin: 0 auto 14px;
    padding: 5px 14px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--color-blue) 10%, transparent);
    font-size: 15px;
    font-weight: 600;
  }
  .dv-sim-question {
    display: block;
    font-family: var(--font-accent);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .dv-sim-question:focus {
    outline: none;
  }
  .dv-sim-aide {
    margin-top: 8px;
    font-size: 16px;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-grey-2) 85%, transparent);
  }
  .dv-sim-note {
    margin-top: 10px;
    font-size: 15px;
    line-height: 1.5;
  }
  .dv-sim-note a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .dv-sim-etape + .dv-sim-etape {
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid var(--dv-bord);
  }
  /* Avec JavaScript : une question à la fois. */
  .dv-sim-js .dv-sim-etape + .dv-sim-etape {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .dv-sim-js .dv-sim-etape:not(.dv-sim-active) {
    display: none;
  }
  .dv-sim-js .dv-sim-etape {
    text-align: center;
  }
  .dv-sim-js .dv-sim-etape label.block,
  .dv-sim-js .dv-sim-etape [id^="sim-"][id$="-erreur"],
  .dv-sim-js .dv-sim-etape .dv-sim-note,
  .dv-sim-js .dv-sim-etape[data-etape="6"] .grid,
  .dv-sim-js .dv-sim-etape[data-etape="6"] label,
  .dv-sim-js .dv-sim-etape[data-etape="6"] p:last-child {
    text-align: left;
  }
  .dv-sim-choix {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    padding: 26px 16px 22px;
    border: 1.5px solid color-mix(in srgb, var(--color-grey-2) 30%, transparent);
    border-radius: 14px;
    background: var(--color-white);
    font-size: 18px;
    font-weight: 600;
    cursor: pointer;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .dv-sim-choix input {
    order: 3;
    width: 20px;
    height: 20px;
    margin: 0;
    accent-color: var(--color-blue);
  }
  .dv-sim-choix:hover {
    border-color: var(--color-grey-2);
  }
  .dv-sim-choix:has(input:checked) {
    border-color: var(--color-blue);
    box-shadow: 0 0 0 1px var(--color-blue), inset 0 0 0 100vmax color-mix(in srgb, var(--color-blue) 8%, transparent);
  }
  .dv-sim-pas {
    width: 52px;
    flex-shrink: 0;
    border: 1.5px solid var(--color-blue);
    border-radius: 12px;
    background: var(--color-white);
    color: var(--color-blue);
    font-size: 24px;
    font-weight: 700;
    cursor: pointer;
  }
  .dv-sim-pas:hover {
    box-shadow: inset 0 0 0 100vmax color-mix(in srgb, var(--color-blue) 8%, transparent);
  }
  .dv-sim-unite {
    position: relative;
  }
  .dv-sim-unite input {
    padding-right: 72px;
  }
  .dv-sim-unite span {
    position: absolute;
    right: 16px;
    top: 50%;
    translate: 0 -50%;
    font-weight: 600;
    pointer-events: none;
  }
  .dv-sim-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 32px;
  }
  .dv-sim-actions .dv-btn {
    margin-left: auto;
  }
  .dv-sim-retour {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    min-height: 48px;
    font-size: 17px;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
    cursor: pointer;
  }
  .dv-sim-montant {
    color: var(--color-blue);
    white-space: nowrap;
  }
  .dv-sim-detail > div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding-block: 12px;
    border-top: 1px solid var(--dv-bord);
    font-size: 16px;
  }
  .dv-sim-detail dd {
    font-weight: 700;
    white-space: nowrap;
  }
  .dv-sim-total {
    border-top: 2px solid var(--color-grey-2) !important;
    font-weight: 700;
  }
  .dv-sim-gain {
    padding: 20px 22px;
    border-radius: 14px;
    background: color-mix(in srgb, var(--color-blue) 8%, transparent);
  }
  @media (min-width: 768px) {
    .dv-sim-question {
      font-size: 32px;
    }
    .dv-sim-aide {
      font-size: 17px;
    }
  }
</style>

<!-- Valeurs du script en JSON (jamais exécuté) : un script à variables injectées (define:vars) n'aurait pas d'empreinte
     dans la politique de sécurité des contenus (6 octobre 2026). -->
<script type="application/json" id="dv-vars-simulateur" set:html={JSON.stringify({ partSousZone: 21, hausse: 10, tva: 0.1 })} />

<script>
  // @ts-nocheck : script repris tel quel, valeurs lues dans le bloc JSON ci-dessus.
  // 8 octobre 2026 (suivi des visites) : campagne de la visite et identifiant de visite selon le choix du bandeau.
  import { identifiants, utmVisite } from '../lib/suivi';
  const { partSousZone, hausse, tva } = JSON.parse(document.getElementById('dv-vars-simulateur')?.textContent || '{}');
  // Une question à la fois, barre de progression, retour arrière ; puis envoi des coordonnées et résultats sur place.
  const form = document.getElementById('simulateur');
  const carte = form?.closest('.dv-sim');
  if (form && carte) {
    carte.classList.add('dv-sim-js');
    const etapes = Array.from(form.querySelectorAll('.dv-sim-etape'));
    const progression = carte.querySelector('[data-sim-progression]');
    const barres = Array.from(progression.querySelectorAll('span'));
    const suivant = form.querySelector('[data-sim-suivant]');
    const retourBtn = form.querySelector('[data-sim-retour]');
    const generale = form.querySelector('.dv-erreur-generale');
    const resultats = carte.querySelector('[data-sim-resultats]');
    const categorie = document.createElement('span');
    categorie.className = 'dv-sim-categorie';
    progression.hidden = false;
    progression.after(categorie);
    form.querySelectorAll('.dv-sim-pas').forEach((b) => (b.hidden = false));
    let actuelle = 0;

    const euros = (n) => new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 }).format(Math.round(n)) + ' €';
    const pourcent = (n) => new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 1 }).format(n) + ' %';
    const nombre = (nom) => parseFloat(String(form.elements.namedItem(nom).value).replace(',', '.'));
    const telephoneValide = (v) => {
      let t = v.replace(/[\s.\-()]/g, '');
      if (t.startsWith('00')) t = '+' + t.slice(2);
      return /^0[1-9]\d{8}$/.test(t) || /^\+33[1-9]\d{8}$/.test(t) || /^\+[1-9]\d{7,14}$/.test(t);
    };
    const valide = (c) => {
      const v = String(c.value).trim();
      if (c.type === 'number') {
        const n = parseFloat(v.replace(',', '.'));
        return Number.isFinite(n) && n >= Number(c.min) && n <= Number(c.max);
      }
      if (c.name === 'telephone') return telephoneValide(v);
      if (c.name === 'email') return /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(v);
      return v.length >= 2;
    };
    const afficher = (c, ok) => {
      const p = document.getElementById(c.id + '-erreur');
      if (!p) return;
      p.textContent = ok ? '' : p.dataset.message;
      p.classList.toggle('hidden', ok);
      if (ok) c.removeAttribute('aria-invalid');
      else c.setAttribute('aria-invalid', 'true');
    };
    const montrer = (i, focus = true) => {
      actuelle = i;
      etapes.forEach((e, j) => e.classList.toggle('dv-sim-active', j === i));
      const cat = etapes[i].dataset.categorie;
      categorie.textContent = cat;
      // 4 segments : structure (1-2), ventes (3), coûts (4-5), résultats (6).
      const rempli = [[50, 0, 0, 0], [100, 0, 0, 0], [100, 100, 0, 0], [100, 100, 50, 0], [100, 100, 100, 0], [100, 100, 100, 60]][i];
      barres.forEach((b, j) => b.style.setProperty('--rempli', rempli[j] + '%'));
      retourBtn.hidden = i === 0;
      suivant.textContent = i === etapes.length - 1 ? 'Voir mes résultats' : 'Continuer';
      generale.classList.add('hidden');
      if (focus) etapes[i].querySelector('.dv-sim-question')?.focus({ preventScroll: true });
      if (focus && carte.getBoundingClientRect().top < 0) carte.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };
    const etapeValide = () => {
      const champs = Array.from(etapes[actuelle].querySelectorAll('input[required]'));
      const fautifs = champs.filter((c) => !valide(c));
      champs.forEach((c) => afficher(c, !fautifs.includes(c)));
      fautifs[0]?.focus();
      return fautifs.length === 0;
    };

    form.querySelectorAll('.dv-sim-pas').forEach((b) =>
      b.addEventListener('click', () => {
        const c = form.elements.namedItem('etablissements');
        const n = Math.min(200, Math.max(1, (parseInt(c.value, 10) || 1) + Number(b.dataset.pas)));
        c.value = String(n);
        afficher(c, true);
      }),
    );
    // Structure choisie au clic : on passe à la question suivante, comme une réponse.
    form.querySelectorAll('.dv-sim-choix').forEach((r) =>
      r.addEventListener('click', (e) => {
        // Clic à la souris ou au doigt seulement : les flèches du clavier changent le choix sans avancer.
        if (e.detail > 0) setTimeout(() => montrer(1), 180);
      }),
    );
    retourBtn.addEventListener('click', () => montrer(Math.max(0, actuelle - 1)));
    // L'erreur disparaît dès que la saisie est bonne (avant le clic sur « Continuer », pour que le bouton ne bouge pas) ;
    // elle n'apparaît qu'en quittant un champ mal rempli, ou au clic sur « Continuer ».
    form.querySelectorAll('input[required]').forEach((c) => {
      c.addEventListener('input', () => {
        if (c.getAttribute('aria-invalid') && valide(c)) afficher(c, true);
      });
      c.addEventListener('blur', () => {
        if (c.value.trim() !== '' && !valide(c)) afficher(c, false);
      });
    });

    const calculer = () => {
      const ventes = nombre('ventes');
      const commissionTaux = nombre('commission');
      const matiereTaux = nombre('matiere');
      const ht = ventes / (1 + tva);
      const commission = (ventes * commissionTaux) / 100;
      const matiere = (ht * matiereTaux) / 100;
      const reste = ht - commission - matiere;
      const ventesEnPlus = ventes * (partSousZone / 100) * (hausse / 100);
      const gain = Math.max(0, ventesEnPlus / (1 + tva) - (ventesEnPlus * commissionTaux) / 100);
      return { ventes, tva: ventes - ht, commission, commissionTaux, matiere, matiereTaux, reste, gain };
    };
    const tranche = (n) => (n <= 1 ? '1' : n <= 5 ? '2-5' : n <= 10 ? '6-10' : n <= 19 ? '11-19' : '20+');

    const afficherResultats = (r, rappel, tel, analyse, email) => {
      const ecrire = (cle, texte) => resultats.querySelectorAll(`[data-r="${cle}"]`).forEach((x) => (x.textContent = texte));
      ecrire('reste', euros(Math.max(0, r.reste)));
      ecrire('reste-detail', euros(r.reste));
      ecrire('ventes', euros(r.ventes));
      ecrire('tva', '− ' + euros(r.tva));
      ecrire('commission', '− ' + euros(r.commission));
      ecrire('commission-taux', pourcent(r.commissionTaux));
      ecrire('matiere', '− ' + euros(r.matiere));
      ecrire('matiere-taux', pourcent(r.matiereTaux));
      ecrire('part', pourcent(r.ventes > 0 ? (r.reste / r.ventes) * 100 : 0));
      ecrire('gain', '+ ' + euros(r.gain));
      ecrire('gain-an', euros(r.gain * 12));
      ecrire('tel', tel);
      ecrire('email', email);
      resultats.querySelector('[data-r-rappel]').hidden = !rappel;
      const blocAnalyse = resultats.querySelector('[data-r-analyse]');
      blocAnalyse.hidden = !analyse;
      // Après la confirmation du rappel : collé à elle, sans second « C’est noté ».
      blocAnalyse.classList.toggle('mt-8', !rappel);
      blocAnalyse.classList.toggle('mt-3', rappel);
      blocAnalyse.querySelector('[data-r-analyse-note]').hidden = rappel;
      // Le bouton de démo seulement à qui n'a rien demandé : la liste promise par e-mail suffit sinon.
      resultats.querySelector('[data-r-sans-rappel]').hidden = rappel || analyse;
      form.hidden = true;
      progression.hidden = true;
      categorie.hidden = true;
      resultats.hidden = false;
      resultats.focus({ preventScroll: true });
      carte.scrollIntoView({ behavior: 'smooth', block: 'start' });
    };

    resultats.querySelector('[data-sim-recommencer]').addEventListener('click', () => {
      resultats.hidden = true;
      form.hidden = false;
      progression.hidden = false;
      categorie.hidden = false;
      suivant.disabled = false;
      montrer(0);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!etapeValide()) return;
      if (actuelle < etapes.length - 1) return montrer(actuelle + 1);

      const r = calculer();
      const structure = form.elements.namedItem('structure').value;
      const nbEtab = parseInt(form.elements.namedItem('etablissements').value, 10);
      const rappel = form.elements.namedItem('rappel').checked;
      const analyse = form.elements.namedItem('analyse').checked;
      form.elements.namedItem('points_de_vente').value = tranche(nbEtab);
      form.elements.namedItem('section_cta').value = `simulateur:${structure}:${rappel ? 'rappel' : 'sans-rappel'}${analyse ? ':analyse' : ''}`;
      form.elements.namedItem('simulation').value =
        `Simulation (${structure === 'dark-kitchen' ? 'dark kitchen' : 'restaurant'}, ${nbEtab} établissement${nbEtab > 1 ? 's' : ''}) : ` +
        `ventes ${euros(r.ventes)} TTC par mois, commission ${pourcent(r.commissionTaux)}, coût matière ${pourcent(r.matiereTaux)}. ` +
        `Reste ${euros(r.reste)} par mois ; prix bien placés : +${euros(r.gain)} par mois.`;
      const utm = utmVisite();
      ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content'].forEach((k) => {
        if (utm[k]) form.elements.namedItem(k).value = utm[k];
      });
      form.elements.namedItem('visiteur').value = identifiants()?.visiteur || '';
      suivant.disabled = true;
      suivant.textContent = 'Calcul en cours…';
      const donnees = Object.fromEntries(new FormData(form).entries());
      try {
        const rep = await fetch(form.dataset.endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(donnees),
        });
        const corps = await rep.json().catch(() => ({}));
        if (rep.status === 422 && corps.erreurs) {
          const champs = Array.from(form.querySelectorAll('input[required]')).filter((c) => corps.erreurs[c.name]);
          champs.forEach((c) => afficher(c, false));
          champs[0]?.focus();
          suivant.disabled = false;
          suivant.textContent = 'Voir mes résultats';
          return;
        }
      } catch {
        /* coupure réseau : les résultats s'affichent quand même */
      }
      afficherResultats(r, rappel, String(donnees.telephone || ''), analyse, String(donnees.email || ''));
    });

    montrer(0, false);
  }
</script>
