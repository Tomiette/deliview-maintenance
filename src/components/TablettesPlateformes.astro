---
// Le quotidien : la tablette Uber Eats (sur son pied) et le terminal Deliveroo (avec son imprimante à tickets),
// dessinés au trait d'après les vrais appareils des restaurants (demande de Tom, 2 octobre 2026).
// Charte : trait Gris 2, ondes et touches en Bleu 1, remplissage Bleu 1 à 15 % au plus ; aucun fond, aucun logo redessiné :
// les plateformes sont nommées en toutes lettres sous chaque appareil. Les deux appareils flottent doucement,
// à des rythmes décalés, et leurs ondes « sonnent » (seulement si le visiteur n'a pas demandé moins d'animations).
interface Props {
  class?: string;
}
const { class: classe = '' } = Astro.props;
---

<div class={`dv-tp ${classe}`} role="img" aria-label="La tablette Uber Eats et le terminal Deliveroo qui sonnent en même temps">
  <div class="dv-tp-appareil dv-tp-uber">
    <div class="dv-tp-flotte">
      <svg viewBox="0 0 340 284" width="340" height="284" aria-hidden="true" focusable="false">
        <!-- Ondes -->
        <path class="b dv-tp-onde" d="M300 14c9.4 5.6 15.4 13.6 17.6 23.6M314 2c13.8 8.4 22 20.4 24.6 35" />
        <path class="b dv-tp-onde dv-tp-onde-2" d="M40 14c-9.4 5.6-15.4 13.6-17.6 23.6M26 2C12.2 10.4 4 22.4 1.4 37" />
        <!-- Support : socle, bras incliné, rotule -->
        <path class="p" d="M118 266.6c0-5 4-9 9-9.1l86-.4c5 0 9 4 9 9s-4 9-9 9.1l-86 .4c-5 0-9-4-9-9z" />
        <path class="p" d="M158.4 257.6l-6.8-41.2 34.4-.2 2.4 41.4" />
        <path class="p" d="M142 210.4c0-2.6 2-4.6 4.6-4.6l47-.4c2.6 0 4.6 2 4.6 4.6l.1 6.6c0 2.6-2 4.6-4.6 4.6l-47 .4c-2.6 0-4.6-2-4.6-4.6z" />
        <!-- Pinces latérales -->
        <path class="p" d="M14.4 92l-8.6.2.4 34.6 8.8-.2M325.6 91.4l8.6.2-.4 34.6-8.8-.2" />
        <!-- Tablette -->
        <path class="p" d="M12.6 36.4c-.2-9 6.6-15.8 15.6-16l283.2-3.4c9-.1 15.8 6.8 15.8 15.8l.6 158.4c0 9-6.8 15.8-15.8 15.8L28.8 210c-9 .1-15.8-6.8-15.8-15.8z" />
        <path d="M26.4 42c0-4 3-7 7-7.1l273-3c4-.1 7 3 7 7l.4 140.4c0 4-3 7-7 7l-273.2 2.4c-4 0-7-3-7-7z" />
        <path class="l" d="M167.2 25.6h4.2" />
        <!-- Écran : barre du haut -->
        <path d="M40 52.6l66-.8" />
        <path class="l" d="M252 51.8l46-.4" />
        <!-- Nouvelle commande -->
        <path class="b r" d="M40 70.4c0-3 2.4-5.4 5.4-5.4l251.2-2.4c3 0 5.4 2.4 5.4 5.4l.2 20c0 3-2.4 5.4-5.4 5.4L45.6 96c-3 0-5.4-2.4-5.4-5.4z" />
        <path class="b" d="M56.6 73.4c3.4 0 6 2.6 6 6s-2.6 6-6 6-6-2.6-6-6 2.6-6 6-6zM72 79.2l92-.8" />
        <path class="b" d="M262 79l26-.2" />
        <!-- Liste des commandes -->
        <path d="M40.4 109.6l10-.1.1 10-10 .1zM60 114.6l112-1.2M40.8 131.4l10-.1.1 10-10 .1zM60 136.2l86-.8M41 153.2l10-.1.1 10-10 .1zM60 158l124-1.2" />
        <path class="l" d="M256 113.4l40-.4M256 135.2l34-.4M256 157l42-.4" />
        <!-- Boutons de navigation de la tablette -->
        <path class="l" d="M146 173.2l7.4-4.4.2 8.8zM170.2 168.6c2.4 0 4.4 2 4.4 4.4s-2 4.4-4.4 4.4-4.4-2-4.4-4.4 2-4.4 4.4-4.4zM187.4 168.8l8.4-.1.1 8.4-8.4.1z" />
      </svg>
      <span class="dv-tp-ombre" aria-hidden="true"></span>
    </div>
    <span class="dv-tp-nom" aria-hidden="true">Uber Eats</span>
  </div>

  <div class="dv-tp-appareil dv-tp-deliveroo">
    <div class="dv-tp-flotte">
      <svg viewBox="0 0 220 360" width="220" height="360" aria-hidden="true" focusable="false">
        <!-- Ondes -->
        <path class="b dv-tp-onde dv-tp-onde-2" d="M190 86c9.6 6 15.6 14.6 17.4 25.2M204 72c14.2 9 22.4 21.6 24.4 37" />
        <path class="b dv-tp-onde" d="M30 86c-9.6 6-15.6 14.6-17.4 25.2M16 72C1.8 81-6.4 93.6-8.4 109" />
        <!-- Ticket qui sort de l'imprimante -->
        <path class="p" d="M79.4 96.6l-.6-74.8 6.4-6.8 6.4 6.6 6.4-6.8 6.4 6.6 6.4-6.8 6.4 6.6 6.4-6.8 6.4 6.6 6.4-6.8 6.4 6.6.4 75.4" />
        <path d="M90.6 38.6l38.4-.4" />
        <path class="l" d="M90.8 51.4l30.6-.4M90.8 62.6l36-.4" />
        <path class="b" d="M91 76.4l22.6-.2" />
        <!-- Tête d'imprimante -->
        <path class="p" d="M34.6 112.4c-.2-12 9.4-21.4 21.4-21.6l108.4-.8c12-.1 21.6 9.4 21.6 21.4l.2 30.4c0 5-4 9-9 9l-133.4.8c-5 0-9-4-9-9z" />
        <path d="M66.2 99.6l88-.6" />
        <path class="l" d="M42.6 129.8l135.6-.8" />
        <!-- Corps -->
        <path class="p" d="M45.4 150.8l129.6-.8-.6 178.4c0 10-7.8 17.8-17.8 17.8l-93.4.4c-10 0-17.8-7.8-17.8-17.8z" />
        <path class="l" d="M175.4 190.6l3.4-.1.2 22-3.4.1" />
        <!-- Écran -->
        <path d="M58 168c0-4 3-7 7-7l90.4-.6c4 0 7 3 7 7l.4 138.4c0 4-3 7-7 7l-90.6.6c-4 0-7-3-7-7z" />
        <path d="M68.6 178.4l46-.4" />
        <path class="b r" d="M149.8 173.8c2.6 0 4.6 2 4.6 4.6s-2 4.6-4.6 4.6-4.6-2-4.6-4.6 2-4.6 4.6-4.6z" />
        <!-- Commande -->
        <path d="M68 195.4c0-2.8 2.2-5 5-5l75.4-.6c2.8 0 5 2.2 5 5l.4 52.6c0 2.8-2.2 5-5 5l-75.6.6c-2.8 0-5-2.2-5-5z" />
        <path d="M77.6 205.4l44.4-.4" />
        <path class="l" d="M77.8 219.4l58-.4M77.8 231.4l34-.2" />
        <!-- Accepter -->
        <path class="b r" d="M68.4 268c0-2.8 2.2-5 5-5l75.4-.4c2.8 0 5 2.2 5 5l.1 14c0 2.8-2.2 5-5 5l-75.4.4c-2.8 0-5-2.2-5-5z" />
        <path class="b" d="M98.6 275.6l24-.2" />
        <path class="l" d="M100.6 331.6l20-.2" />
      </svg>
      <span class="dv-tp-ombre" aria-hidden="true"></span>
    </div>
    <span class="dv-tp-nom" aria-hidden="true">Deliveroo</span>
  </div>
</div>

<style>
  .dv-tp {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 6%;
    width: 100%;
    max-width: 560px;
    margin-inline: auto;
    padding-top: 12px;
  }
  .dv-tp-appareil {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .dv-tp-uber {
    width: 58%;
  }
  .dv-tp-deliveroo {
    width: 34%;
  }
  /* L'appareil penche, pas son nom. */
  .dv-tp-uber .dv-tp-flotte {
    rotate: -2deg;
  }
  .dv-tp-deliveroo .dv-tp-flotte {
    rotate: 4deg;
  }
  .dv-tp-flotte {
    position: relative;
    width: 100%;
  }
  .dv-tp svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
    fill: none;
    stroke: var(--color-grey-2);
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Pièces pleines (blanc) : le ticket passe derrière l'imprimante, l'écran devant le corps. */
  .dv-tp svg .p {
    fill: var(--color-white);
  }
  .dv-tp svg .b {
    stroke: var(--color-blue);
  }
  .dv-tp svg .r {
    fill: color-mix(in srgb, var(--color-blue) 15%, transparent);
  }
  .dv-tp svg .l {
    stroke-opacity: 0.4;
  }
  /* Ombre portée très légère sous chaque appareil (Gris 2 à 10 %), qui se resserre quand il monte. */
  .dv-tp-ombre {
    display: block;
    width: 64%;
    height: 12px;
    margin: 14px auto 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--color-grey-2) 10%, transparent);
  }
  .dv-tp-nom {
    margin-top: 10px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    white-space: nowrap;
  }
  @media (min-width: 768px) {
    .dv-tp-nom {
      font-size: 16px;
    }
  }

  @keyframes dv-tp-flotte {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -10px;
    }
  }
  @keyframes dv-tp-ombre {
    0%,
    100% {
      scale: 1;
      opacity: 1;
    }
    50% {
      scale: 0.84;
      opacity: 0.6;
    }
  }
  @keyframes dv-tp-sonne {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.25;
    }
  }
  :global(.dv-mouvement) .dv-tp-flotte svg {
    animation: dv-tp-flotte 5.2s ease-in-out infinite;
  }
  :global(.dv-mouvement) .dv-tp-ombre {
    animation: dv-tp-ombre 5.2s ease-in-out infinite;
  }
  :global(.dv-mouvement) .dv-tp-deliveroo svg,
  :global(.dv-mouvement) .dv-tp-deliveroo .dv-tp-ombre {
    animation-duration: 4.4s;
    animation-delay: -1.6s;
  }
  :global(.dv-mouvement) .dv-tp-onde {
    animation: dv-tp-sonne 1.4s ease-in-out infinite;
  }
  :global(.dv-mouvement) .dv-tp-onde-2 {
    animation-delay: -0.7s;
  }
</style>
