---
// Article : réponse directe en tête (ticket « En bref »), sommaire, contenu, sources datées, liens vers la fonction
// et la démo. Refonte en relief (3 octobre 2026) : pastille du thème, encadré « Dans Deliview » avec la vraie carte
// de l'app, inclinée en 3D. 6 octobre 2026 : la photo de l'article sous le titre (crédit Unsplash visible),
// reprise dans les données structurées ; « À lire aussi » avec la carte commune (CarteArticle). 7 octobre 2026 :
// l'encadré mène à la page de la fonction la plus proche de l'article (src/lib/site.ts, fonctionDeLArticle).
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionDemo from '../../components/SectionDemo.astro';
import Ticket from '../../components/Ticket.astro';
import CarteArticle from '../../components/CarteArticle.astro';
import Fleche from '../../icons/fleche.astro';
import { FRAGMENTS, SITE, THEMES, cheminFonction, dateFr, fonctionDeLArticle, lien, tempsLecture } from '../../lib/site';
import { PAGES } from '../../lib/fonctions';

export async function getStaticPaths() {
  const articles = await getCollection('ressources', (a) => !a.data.brouillon);
  return articles.map((a) => ({ params: { slug: a.id }, props: { article: a } }));
}

const { article } = Astro.props as { article: CollectionEntry<'ressources'> };
const { Content, headings } = await render(article);
const d = article.data;
// Fonction la plus proche de l'article ; sans fonction proche (TVA), l'encadré présente Deliview dans son ensemble.
const fonction = fonctionDeLArticle(article.id, d.theme);
const encadre = fonction
  ? { href: cheminFonction(fonction.id), titre: PAGES[fonction.id].h1, phrase: PAGES[fonction.id].lead, bouton: 'Voir comment ça marche', nom: `Voir comment ça marche : ${fonction.nom.toLowerCase()}` }
  : {
      href: '/solution/',
      titre: 'Vos données Uber Eats et Deliveroo sur un seul écran',
      phrase: 'Vos ventes, vos prix face à ceux de votre zone, vos avis et vos remboursements à contester.',
      bouton: 'Voir la solution',
      nom: undefined,
    };
const sommaire = headings.filter((h) => h.depth === 2);
// Vraie carte de l'app de la fonction (décorative ici : le texte de l'encadré dit déjà ce qu'elle montre).
const CARTE_DE_LA_FONCTION: Record<string, string> = { prix: 'prix', promotions: 'promotions', fraude: 'contestations', avis: 'avis' };
const fragment = fonction && CARTE_DE_LA_FONCTION[fonction.id] ? FRAGMENTS[CARTE_DE_LA_FONCTION[fonction.id]] : undefined;
const autres = (await getCollection('ressources', (a) => !a.data.brouillon && a.id !== article.id))
  .sort((a, b) => Number(b.data.theme === d.theme) - Number(a.data.theme === d.theme) || b.data.misAJourLe.getTime() - a.data.misAJourLe.getTime())
  .slice(0, 3);
const url = `${SITE.url}/ressources/${article.id}/`;
const iso = (x: Date) => x.toISOString().slice(0, 10);
const photo = d.image;
const photoBase = photo ? lien(photo.src) : '';
const photoMax = photo ? Math.max(...photo.largeurs) : 0;

const jsonArticle = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: d.titre,
  description: d.description,
  inLanguage: 'fr-FR',
  datePublished: iso(d.publieLe),
  dateModified: iso(d.misAJourLe),
  mainEntityOfPage: url,
  image: photo ? [SITE.url + photo.src + `-${photoMax}.webp`, SITE.url + '/images/partage.png'] : SITE.url + '/images/partage.png',
  author: { '@type': 'Person', name: d.auteur, url: SITE.url + '/qui-sommes-nous/#tom', sameAs: [SITE.linkedinTom] },
  publisher: { '@type': 'Organization', name: 'Deliview', url: SITE.url, logo: { '@type': 'ImageObject', url: SITE.url + '/images/logo-deliview.png' } },
  citation: d.sources.map((s) => s.url),
};
---

<Base
  title={`${d.titreSeo} | Deliview`}
  description={d.description}
  ogType="article"
  precharger={photo ? { srcset: photo.largeurs.map((w) => `${photoBase}-${w}.webp ${w}w`).join(', '), sizes: '(min-width: 860px) 820px, calc(100vw - 32px)' } : undefined}
  ariane={[
    { nom: 'Blog', chemin: '/ressources/' },
    { nom: d.titre, chemin: `/ressources/${article.id}/` },
  ]}
  jsonld={[jsonArticle]}
>
  <article>
    <header class="bg-grey">
      <div class={`dv-container max-w-[820px] pt-6 md:pt-10 ${photo ? 'pb-24 md:pb-40' : 'pb-10 md:pb-14'}`}>
        <p class="dv-overline dv-pastille">
          <span class="dv-pastille-point" aria-hidden="true"></span>
          <a href={lien(`/ressources/#${d.theme}`)}>{THEMES[d.theme]}</a>
        </p>
        <h1 class="dv-h1 mt-5 !text-[34px] md:mt-6 md:!text-[48px]">{d.titre}</h1>
        <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-[15px] dv-muted">
          <span>Par <a href={lien('/qui-sommes-nous/#tom')} class="font-semibold underline underline-offset-2">{d.auteur}</a>, fondateur de Deliview</span>
          <span aria-hidden="true" class="max-sm:hidden">·</span>
          <span>Publié le <time datetime={iso(d.publieLe)}>{dateFr(d.publieLe)}</time></span>
          {
            iso(d.misAJourLe) !== iso(d.publieLe) && (
              <>
                <span aria-hidden="true" class="max-sm:hidden">·</span>
                <span>
                  Mis à jour le <time datetime={iso(d.misAJourLe)}>{dateFr(d.misAJourLe)}</time>
                </span>
              </>
            )
          }
          <span aria-hidden="true" class="max-sm:hidden">·</span>
          <span>{tempsLecture(article.body || '')}&nbsp;min de lecture</span>
        </p>
      </div>
    </header>

    <div class={`dv-container max-w-[820px] pb-16 ${photo ? '' : 'pt-10 md:pt-14'}`}>
      {
        photo && (
          <figure class="dv-photo-article -mt-16 mb-10 md:-mt-32 md:mb-14">
            <img
              src={`${photoBase}-${photo.largeurs[photo.largeurs.length > 1 ? 1 : 0]}.webp`}
              srcset={photo.largeurs.map((w) => `${photoBase}-${w}.webp ${w}w`).join(', ')}
              sizes="(min-width: 860px) 820px, calc(100vw - 32px)"
              alt={photo.alt}
              width="1600"
              height="900"
              fetchpriority="high"
              decoding="async"
            />
            {photo.credit && (
              <figcaption class="dv-photo-credit">
                Photo&nbsp;: <a href={photo.credit.profil} rel="noopener">{photo.credit.nom}</a> sur <a href={photo.credit.page} rel="noopener">Unsplash</a>
              </figcaption>
            )}
          </figure>
        )
      }
      <aside aria-label="En bref">
        <Ticket papier="px-6 pb-6 pt-5 md:px-8 md:pb-7 md:pt-6">
          <p class="dv-ticket-entete"><span>En bref</span></p>
          <p class="mt-3">{d.enBref}</p>
        </Ticket>
      </aside>

      {
        sommaire.length >= 3 && (
          <nav aria-labelledby="sommaire-titre" class="dv-card mt-10 p-6">
            <p id="sommaire-titre" class="font-accent text-[19px] font-bold">Sommaire</p>
            <ol class="mt-3 list-decimal pl-5 text-[16px] xl:space-y-2">
              {sommaire.map((h) => (
                <li>
                  <a href={`#${h.slug}`} class="block py-2.5 underline underline-offset-2 xl:inline xl:py-0">
                    {h.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }

      <div class="prose-dv mt-4">
        <Content />
      </div>

      {
        article.id === 'fixer-prix-uber-eats-deliveroo' && (
          <p class="mt-10">
            <a href={lien('/simulateur/')} class="dv-btn dv-btn-contour" data-cta="article-simulateur">
              Combien vous rapporte un prix bien placé&nbsp;?
            </a>
          </p>
        )
      }

      <section class={`dv-card dv-article-pilier mt-14 ${fragment ? 'dv-article-pilier-image' : ''}`} aria-labelledby="pilier-titre">
        <div class="p-6 md:p-8">
          <p class="dv-overline dv-pastille"><span class="dv-pastille-point" aria-hidden="true"></span>Dans Deliview</p>
          <h2 id="pilier-titre" class="dv-h3 mt-4">{encadre.titre}</h2>
          <p class="mt-2 dv-muted">{encadre.phrase}</p>
          <div class="mt-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-6">
            <a href={lien(encadre.href)} class="dv-btn dv-btn-contour" aria-label={encadre.nom}>{encadre.bouton}</a>
            <a href="#demo" class="dv-lien-fort" data-cta={`article-${article.id}`}>
              Demander une démo<Fleche taille={24} />
            </a>
          </div>
        </div>
        {
          fragment && (
            <div class="dv-article-pilier-scene" aria-hidden="true">
              <div class="dv-pilier-3d">
                <img
                  class="dv-fragment"
                  src={lien(`${fragment.src}-${fragment.largeurs[0]}.webp`)}
                  srcset={fragment.largeurs.map((w) => `${lien(fragment.src)}-${w}.webp ${w}w`).join(', ')}
                  sizes="260px"
                  alt=""
                  width={fragment.largeur}
                  height={fragment.hauteur}
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </div>
          )
        }
      </section>

      <section class="mt-14" aria-labelledby="sources-titre">
        <h2 id="sources-titre" class="dv-h3">Sources</h2>
        <ol class="mt-4 list-decimal space-y-2 pl-5 text-[15px]">
          {
            d.sources.map((s) => (
              <li>
                <a href={s.url} rel="noopener" class="underline underline-offset-2">{s.titre}</a>, {s.editeur}, consulté le {s.consulteLe}.
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </article>

  {
    autres.length > 0 && (
      <section class="dv-section bg-grey dv-points" aria-labelledby="autres-articles">
        <div class="dv-container">
          <h2 id="autres-articles" class="dv-h2">À lire aussi</h2>
          <ul class="mt-8 grid gap-6 md:grid-cols-3">
            {autres.map((a) => (
              <CarteArticle article={a} theme infos={false} />
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <SectionDemo section={`article-${article.id}-formulaire`} />
</Base>
