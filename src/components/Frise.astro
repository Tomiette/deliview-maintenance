---
// Frise de la construction de Deliview (Qui sommes-nous) : verticale, points dessinés au trait, date en Inter 600,
// titre en Aspekta, une phrase, lien vers le post LinkedIn. Le point bleu marque l'étape la plus récente.
// Uniquement les étapes fournies par Tom (src/lib/chronologie.ts) : tant que la liste est vide, la frise n'apparaît
// pas sur le site public ; sur l'aperçu seulement, trois étapes « [À REMPLACER] » montrent sa place.
import Fleche from '../icons/fleche.astro';
import { dateFr } from '../lib/site';
import { CHRONOLOGIE } from '../lib/chronologie';

const apercu = import.meta.env.BASE_URL !== '/';
const etapes = CHRONOLOGIE.length
  ? CHRONOLOGIE
  : apercu
    ? [1, 2, 3].map((n) => ({ date: '', titre: `[À REMPLACER : titre de l’étape ${n}]`, phrase: '[À REMPLACER : une phrase sur ce qui a été construit]', lien: '' }))
    : [];
---

{
  etapes.length > 0 && (
    <ol class="dv-frise">
      {etapes.map((e, i) => (
        <li class={i === etapes.length - 1 ? 'dv-frise-en-cours' : ''}>
          <span class="dv-frise-point" aria-hidden="true" />
          <p class="text-[15px] font-semibold leading-[1.3]">
            {e.date ? <time datetime={e.date}>{dateFr(new Date(e.date + 'T12:00:00Z'))}</time> : <span class="dv-a-remplacer">[À REMPLACER : date]</span>}
          </p>
          <h3 class="mt-1 font-accent text-[20px] font-bold leading-[1.3]">{e.titre}</h3>
          <p class="mt-1 max-w-[60ch] text-[16px] leading-[1.5]">{e.phrase}</p>
          {e.lien ? (
            <a href={e.lien} class="dv-lien text-[15px]" rel="noopener">
              Voir sur LinkedIn<span class="sr-only"> : {e.titre}</span>
              <Fleche taille={24} class="ml-1.5" />
            </a>
          ) : (
            <p class="mt-2 text-[15px] font-semibold">
              <span class="dv-a-remplacer">[À REMPLACER : lien du post LinkedIn]</span>
            </p>
          )}
        </li>
      ))}
    </ol>
  )
}

<style>
  .dv-frise {
    display: grid;
    gap: 28px;
    margin-top: 40px;
    padding-left: 36px;
    border-left: 2px solid color-mix(in srgb, var(--color-grey-2) 30%, transparent);
  }
  li {
    position: relative;
  }
  .dv-frise-point {
    position: absolute;
    left: -46px;
    top: 2px;
    width: 16px;
    height: 16px;
    border: 2.2px solid var(--color-grey-2);
    border-radius: 50%;
    background: var(--color-white);
  }
  .dv-frise-en-cours .dv-frise-point {
    border-color: var(--color-blue);
    background: color-mix(in srgb, var(--color-blue) 15%, var(--color-white));
  }
</style>
