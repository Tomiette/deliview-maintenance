---
// Accueil (aperçu validé par Tom le 10 octobre 2026) : section « Démo » (#demo), dernier écran de l'accueil.
// Tête centrée (pastille « Démo », titre), puis un seul bloc gris à points : à gauche « Ce qui se passe ensuite » (frise
// des 3 étapes, la première en bleu) et Tom (vraie photo, pastille « En ligne », e-mail) ; à droite le bon de démo
// (#demo-formulaire), qui passe en premier sur téléphone (demo.css).
// Le formulaire est DemoForm tel quel (ids, name, messages d'erreur, script) : ne pas le dupliquer ici.
// SectionDemo garde l'ancienne mise en page pour les 7 autres pages.
// HTML repris tel quel de l'aperçu : la frise et la photo sont écrites sans espace entre les balises, comme dans l'aperçu.
import DemoForm from '../DemoForm.astro';
import { SITE, lien } from '../../lib/site';
import '../../styles/accueil/commun.css';
import '../../styles/accueil/demo.css';

// Mêmes étapes que SectionDemo (variante « demo »).
const etapes = [
  { titre: 'Tom vous rappelle sous 3 h', texte: 'On choisit ensemble un moment hors de vos services.' },
  { titre: 'La démo', texte: 'Présentation de Deliview pour votre activité.' },
  { titre: 'Si vous continuez', texte: 'Vous choisissez votre offre, et Tom vous accompagne pour la mise en place.' },
];
---

<section id="demo" class="dvd dv-section bg-white" aria-labelledby="demo-titre">
  <div class="dv-container">
    <div class="dvd-tete">
      <p class="dv-overline dv-pastille"><span class="dv-pastille-point" aria-hidden="true"></span>Démo</p>
      <h2 id="demo-titre" class="dv-h2">Demandez votre démo gratuite</h2>
    </div>
    <div class="dvd-bloc dv-points">
      <div class="dvd-cote">
        <h3 class="dvd-titre-etapes">Ce qui se passe ensuite</h3>
        <ol class="dvd-etapes">{etapes.map((e, i) => <li><span class="dvd-num" aria-hidden="true">{i + 1}</span><span class="dvd-etape"><b>{e.titre}</b><span>{e.texte}</span></span></li>)}</ol>
        <div class="dvd-tom">
          <span class="dvd-photo"><img src={lien('/images/tom-voisin.webp')} alt="Tom Voisin" width="400" height="400" loading="lazy" decoding="async" /><span class="dvd-en-ligne"><i aria-hidden="true"></i>En ligne</span></span>
          <a class="dvd-mail" href={`mailto:${SITE.email}`}><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"></rect><polyline points="3 7 12 13 21 7"></polyline></svg>{SITE.email}</a>
        </div>
      </div>
      <div id="demo-formulaire" class="dvd-carte dv-relief">
        <p class="dv-ticket-entete"><span>Bon de démo</span><span>30 min</span></p>
        <DemoForm section="accueil-formulaire" />
      </div>
    </div>
  </div>
</section>
