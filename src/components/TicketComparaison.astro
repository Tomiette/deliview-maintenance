---
// Ticket de l'exemple réel (accueil), le composant signature. Refait le 6 octobre 2026 (demande de Tom) : le plat et sa
// plateforme (logo officiel), votre prix, le prix de la zone, le prix proposé (seul chiffre entouré au marqueur) et ce
// qu'il rapporte pour 100 pizzas. En note, la source : nombre de concurrents et date du relevé.
// Chiffres en Aspekta, espaces insécables avant €. 320 px de large au plus sur téléphone, 360 px sur ordinateur.
import Ticket from './Ticket.astro';
import Marqueur from './Marqueur.astro';
import { logoPlateforme } from '../lib/logos';
import { dateFr, euros, type ExempleComparaison } from '../lib/site';

interface Props {
  exemple: ExempleComparaison;
  inclinaison?: number;
  apparition?: 'defilement' | 'arrivee';
  class?: string;
}

const { exemple: e, inclinaison, apparition = 'defilement', class: classe = '' } = Astro.props;
const releve = dateFr(new Date(e.releve + 'T12:00:00Z')).replace(/^1er /, '1<sup>er</sup> ');
const logo = logoPlateforme(e.plateforme.toLowerCase().replace(/\s+/g, '-'));
---

<Ticket class={`dv-tc dv-tc-standard ${classe}`} papier="dv-tc-papier" inclinaison={inclinaison} apparition={apparition}>
  <p class="dv-tc-plat">
    {e.plat}<span class="dv-tc-plateforme"><span aria-hidden="true">·</span>{logo && <img src={logo.src} alt="" width={logo.largeur} height={logo.hauteur} loading="lazy" decoding="async" />}{e.plateforme}</span>
  </p>
  <div class="dv-pointilles dv-tc-sep" aria-hidden="true"></div>
  <dl class="dv-tc-lignes">
    <dt>Votre prix</dt><dd>{euros(e.votrePrix)}</dd>
    <dt>Prix de la zone</dt><dd>{euros(e.mediane)}</dd>
  </dl>
  <div class="dv-pointilles dv-tc-sep" aria-hidden="true"></div>
  <dl class="dv-tc-ecart">
    <dt>Prix proposé</dt>
    <dd><span class="dv-tc-chiffre">{euros(e.prixPropose)}<Marqueur forme="cercle" moment={apparition === 'arrivee' ? 'arrivee' : 'defilement'} /></span></dd>
  </dl>
  <p class="dv-tc-gain">Pour 100&nbsp;pizzas&nbsp;: <strong>+{euros(e.gainPour100, 0)} de ventes</strong></p>
  <p class="dv-tc-note">{e.concurrents}&nbsp;concurrents · même plat, même taille · relevé du <Fragment set:html={releve} /></p>
</Ticket>
