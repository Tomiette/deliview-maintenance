---
// Page introuvable : liens utiles vers les piliers et la démo (direction « le passe »).
import Base from '../layouts/Base.astro';
import Fleche from '../icons/fleche.astro';
import { ICONES } from '../lib/registre-icones';
import { PILIERS, lien } from '../lib/site';
---

<Base title="Page introuvable | Deliview" description="Cette page n’existe pas ou plus. Retrouvez les fonctionnalités de Deliview ou demandez une démo de 15 minutes." noindex>
  <section class="bg-grey py-16 md:py-[104px]" aria-labelledby="introuvable-titre" data-haut-de-page>
    <div class="dv-container max-w-[760px]">
      <p class="dv-overline">Erreur 404</p>
      <h1 id="introuvable-titre" class="dv-h1 mt-3 md:mt-4">Cette page n’existe pas</h1>
      <p class="dv-lead mt-5">Le lien est peut-être ancien ou mal recopié. Voici où aller.</p>
      <ul class="mt-8 grid gap-3">
        {
          PILIERS.map((p) => {
            const Icone = ICONES[p.icone];
            return (
              <li>
                <a href={lien(`/solution/${p.slug}/`)} class="dv-card flex min-h-12 items-center gap-4 p-4 font-semibold hover:underline">
                  <Icone taille={32} />
                  {p.surtitre}
                </a>
              </li>
            );
          })
        }
      </ul>
      <ul class="mt-6 grid gap-1">
        <li><a href={lien('/ressources/')} class="dv-lien-fort">Ressources<Fleche taille={24} /></a></li>
        <li><a href={lien('/')} class="dv-lien-fort">Accueil<Fleche taille={24} /></a></li>
      </ul>
      <a href={lien('/demo/')} class="dv-btn dv-btn-plein mt-10 w-full sm:w-auto sm:px-7" data-cta="404" data-cta-principal>Demander une démo</a>
    </div>
  </section>
</Base>
