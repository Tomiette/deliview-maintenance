---
// Accueil, refonte en relief (3 octobre 2026) : même histoire et mêmes textes que la direction « le passe »
// (maquettes validées le 2 octobre 2026), mise en scène en 3D : vraies captures de l'app dans des tablettes inclinées,
// cartes flottantes qui reprennent les chiffres de ces captures, boutons et cartes en relief.
// Votre quotidien (deux tablettes, des chiffres éparpillés), une seule tablette, vos chiffres face à votre zone
// (ticket Margherita), quelqu'un de réel pour vous accompagner, puis tarifs, questions et bon de démo.
// Captures : compte d'essai, analyse réelle d'un restaurant de burgers à Paris (2 octobre 2026), noms anonymisés
// (« Burger Démo », « Concurrent A, B… », boissons de marque renommées), aucune vente affichée.
import Base from '../layouts/Base.astro';
import Scene3D from '../components/Scene3D.astro';
import Flottant from '../components/Flottant.astro';
import TablettesRelief from '../components/TablettesRelief.astro';
import CartePilier from '../components/CartePilier.astro';
import TicketComparaison from '../components/TicketComparaison.astro';
import HeroVideo from '../components/HeroVideo.astro';
import BlocFondateur from '../components/BlocFondateur.astro';
import Faq from '../components/Faq.astro';
import SectionDemo from '../components/SectionDemo.astro';
import EtiquettePrix from '../icons/etiquette-prix.astro';
import Ardoise from '../icons/ardoise.astro';
import LoupeZone from '../icons/loupe-zone.astro';
import Enveloppe from '../icons/enveloppe.astro';
import Toque from '../icons/toque.astro';
import Fleche from '../icons/fleche.astro';
import Lecture from '../icons/lecture.astro';
import { FAQ_ACCUEIL } from '../lib/faq';
import { ANONYME, EXEMPLE_MARGHERITA as ex, FRAGMENTS, OFFRES, PILIERS, PRIX_ENTREE, SITE, euros, jsonldLogiciel, lien, type CaptureApp } from '../lib/site';

// Le quotidien : trois constats du terrain (textes de Tom, 4 octobre 2026 : prix, promo, menu).
const constats = [
  { icone: LoupeZone, titre: 'Des prix non adaptés à la livraison', texte: 'Votre concurrent vend la même pizza plus cher, et vous ne le voyez pas. Montez votre prix juste sous le sien : vous restez moins cher, et vous gagnez plus.' },
  { icone: EtiquettePrix, titre: 'Une promo qui mange votre marge', texte: 'Sans promo, vous étiez déjà bien classé sur les plateformes. Celle-ci ne vous fait rien gagner, mais elle vous coûte sur chaque commande.' },
  { icone: Ardoise, titre: 'Un menu construit trop vite', texte: 'Sans belles photos ni bonnes descriptions, le client ne commande pas. Et moins de commandes, c’est moins de visibilité sur les plateformes.' },
];

const etapes = [
  { icone: Enveloppe, titre: 'La démo', texte: 'Sur votre restaurant, avec Tom.' },
  { icone: Toque, titre: 'La mise en place', texte: 'Tom ouvre votre compte.' },
  { icone: EtiquettePrix, titre: 'Vous gagnez plus', texte: 'Votre activité livraison devient plus rentable.' },
];

// Vraies captures de l'app (compte d'essai, restaurant anonymisé, analyse du 2 octobre 2026).
const captureCarte: CaptureApp = {
  src: '/images/scene-carte',
  largeurs: [800, 1200, 1600],
  largeur: 1600,
  hauteur: 1000,
  alt: `Écran Ma carte de Deliview : 21 plats moins chers que chez les concurrents, 17 plus chers que la zone, puis les plats à monter, Uber Eats et Deliveroo dans la même liste (dips bacon de 4,30 € à 5,60 €, milkshake de 6,40 € à 7,60 €). ${ANONYME}`,
};
// Une vraie carte de l'app par pilier (FRAGMENTS), dans l'ordre des maquettes.
const cartes = ['prix-et-concurrence', 'carte-et-marge', 'reputation'].map((slug) => PILIERS.find((p) => p.slug === slug)!);

const description = `Deliview centralise vos données Uber Eats et Deliveroo : vos prix face à votre zone, plat par plat, pour une livraison plus rentable. Dès ${PRIX_ENTREE} € HT par mois.`;

const video = {
  '@context': 'https://schema.org',
  '@type': 'VideoObject',
  name: 'Deliview en 1 minute',
  description: 'Présentation de Deliview : vos données Uber Eats et Deliveroo réunies, la veille de vos concurrents, un prix suggéré pour chaque plat et les alertes.',
  thumbnailUrl: SITE.url + '/video/deliview-video-couverture-v2-16x9.webp',
  uploadDate: '2026-10-01',
  duration: 'PT1M10S',
  contentUrl: SITE.url + '/video/deliview-video-v2-16x9.mp4',
  width: 1920,
  height: 1080,
  inLanguage: 'fr-FR',
};

const sousLaZone = euros(ex.mediane - ex.votrePrix, 0);
const nombreEnLettres = ['Zéro', 'Un', 'Deux', 'Trois', 'Quatre', 'Cinq', 'Six', 'Sept', 'Huit', 'Neuf', 'Dix'][ex.concurrents] ?? String(ex.concurrents);
const lienVideo = lien('/video/deliview-video-v2-16x9.mp4');
---

<Base
  title="Logiciel restaurant Uber Eats et Deliveroo | Deliview"
  description={description}
  jsonld={[jsonldLogiciel(SITE.definition, SITE.url + '/'), video]}
  precharger="/video/deliview-video-couverture-v2-16x9.webp"
>
  <!-- Haut de page : slogan, promesse de rentabilité, définition, le bouton démo (seul bouton plein) et « Voir Deliview
       en action » ; à droite, la vidéo de présentation (demande de Tom, 4 octobre 2026), lancée au clic sur l'image ou
       sur ce bouton. -->
  <section class="dv-hero" aria-labelledby="hero-titre" data-haut-de-page data-video-zone>
    <div class="dv-container dv-hero-grille">
      <div class="dv-hero-texte">
        <p class="dv-overline dv-pastille"><span class="dv-pastille-point" aria-hidden="true"></span>{SITE.slogan}</p>
        <h1 id="hero-titre" class="dv-h1 mt-5 md:mt-6 lg:max-w-[14ch]">Augmentez votre <span class="text-blue">rentabilité</span> sur Uber&nbsp;Eats et Deliveroo</h1>
        <p class="dv-lead mt-4 max-w-[46ch] md:mt-6">{SITE.definition}</p>
        <div class="dv-hero-boutons">
          <a href="#demo" class="dv-btn dv-btn-plein" data-cta="hero" data-cta-principal>Demander une démo</a>
          <a href={lienVideo} class="dv-btn dv-btn-contour dv-hero-video-bureau" data-video-lire data-cta="video-haut-de-page"><Lecture taille={24} />Voir Deliview en action</a>
        </div>
      </div>
      <div class="dv-hero-visuel">
        <span class="dv-hero-forme" aria-hidden="true"></span>
        <HeroVideo class="dv-hero-video" />
        <a href={lienVideo} class="dv-btn dv-btn-contour dv-hero-video-mobile" data-video-lire data-cta="video-haut-de-page"><Lecture taille={24} />Voir Deliview en action</a>
      </div>
    </div>
  </section>

  <!-- Le quotidien : les deux appareils qui sonnent, en relief, et trois constats dans leurs cartes. -->
  <section class="dv-section bg-grey dv-points overflow-x-clip" aria-labelledby="quotidien-titre">
    <div class="dv-container dv-quotidien">
      <div class="dv-quotidien-intro">
        <p class="dv-overline dv-pastille"><span class="dv-pastille-point" aria-hidden="true"></span>Le quotidien</p>
        <h2 id="quotidien-titre" class="dv-h2 mt-4 max-w-[16ch] md:mt-5">Deux tablettes. Des chiffres éparpillés partout.</h2>
        <p class="dv-lead mt-3.5 max-w-[46ch] md:mt-5">Le rapport de vos ventes livraison arrive. Vous avez des commandes. Et pourtant, la rentabilité n’est pas au <span class="whitespace-nowrap">rendez-vous…</span></p>
      </div>
      <div class="dv-quotidien-dessin">
        <TablettesRelief />
      </div>
      <ul class="dv-quotidien-bons grid gap-5 md:grid-cols-3 md:gap-6">
        {
          constats.map((c, i) => (
            <li class="dv-relief dv-constat" data-apparition="">
              <p class="flex items-center justify-between">
                <span class="dv-tuile">
                  <c.icone taille={32} />
                </span>
                <span class="font-accent text-[15px] font-semibold leading-none tracking-[0.08em] dv-muted" aria-hidden="true">
                  0{i + 1}
                </span>
              </p>
              <h3 class="mt-5 font-accent text-[20px] font-bold leading-[1.25] [text-wrap:balance] md:mt-6 md:text-[23px]">{c.titre}</h3>
              <p class="mt-2 text-[16px] leading-[1.5] dv-muted md:mt-2.5 md:text-[17px] md:leading-[1.55]">{c.texte}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- La bascule : le seul aplat Bleu 1 de la page. L'écran Ma carte, Uber Eats et Deliveroo dans la même liste. -->
  <section class="dv-section dv-bande-bleue" aria-labelledby="bascule-titre">
    <div class="dv-container dv-bascule">
      <div class="dv-bascule-texte">
        <p class="dv-overline dv-pastille"><span class="dv-pastille-point" aria-hidden="true"></span>La bascule</p>
        <h2 id="bascule-titre" class="mt-4 font-accent text-[36px] font-bold leading-[1.08] tracking-[-0.015em] md:mt-5 md:text-[44px]">Toutes vos données de livraison centralisées</h2>
        <p class="dv-bascule-lead mt-4 md:mt-6">Deliview regroupe vos données Uber&nbsp;Eats et Deliveroo. Vous voyez ce que font vos concurrents. Vous adoptez une stratégie de prix et de promotion intelligente, et vous rendez votre activité livraison plus rentable.</p>
      </div>
      <div class="dv-bascule-tablette">
        <Scene3D capture={captureCarte} sens="gauche" fond="bleu" ratio={1.18} ratioMobile={1.05} appareil={{ x: 6, y: 14, largeur: 88 }} sizes="(min-width: 1200px) 640px, (min-width: 1024px) 54vw, 92vw">
          <Flottant x={2} y={2} xm={0} ym={2} z={10} duree={6.2}><span class="dv-puce dv-puce-forte"><i></i>Uber&nbsp;Eats et Deliveroo, côte à côte</span></Flottant>
          <Flottant x={-3} y={60} xm={0} ym={68} droite z={15} duree={6.8} delai={-2}>
            <div class="dv-bulle">
              <p class="dv-bulle-sur">Dips Bacon · Deliveroo</p>
              <p class="dv-bulle-titre">4,30&nbsp;€ <span class="dv-bulle-fleche" aria-hidden="true">→</span> 5,60&nbsp;€</p>
              <span class="dv-bulle-gain">+1,30&nbsp;€</span>
            </div>
          </Flottant>
          <Flottant x={-4} y={74} xm={0} ym={76} z={12} duree={7.2} delai={-4} bureau>
            <div class="dv-bulle">
              <p class="dv-bulle-chiffre">21 plats</p>
              <p class="dv-bulle-texte">moins chers que chez vos concurrents</p>
            </div>
          </Flottant>
        </Scene3D>
      </div>
    </div>
  </section>

  <!-- Comment ça marche : 3 étapes en cartes, numéro dans sa tuile, icône dessinée (la vidéo est en haut de page). -->
  <section id="comment-ca-marche" class="dv-section bg-white" aria-labelledby="etapes-titre">
    <div class="dv-container">
      <p class="dv-overline dv-pastille"><span class="dv-pastille-point" aria-hidden="true"></span>Comment ça marche</p>
      <h2 id="etapes-titre" class="dv-h2 mt-4 max-w-[22ch] md:mt-5">De la démo à vos premiers résultats</h2>
      <ol class="dv-etapes mt-8 grid gap-5 md:mt-12 md:grid-cols-3 md:gap-6">
        {
          etapes.map((e, i) => (
            <li class="dv-relief dv-etape" data-apparition="">
              <p class="flex items-center justify-between">
                <span class="dv-tuile dv-tuile-numero" aria-hidden="true">
                  {i + 1}
                </span>
                <e.icone taille={48} />
              </p>
              <h3 class="mt-5 font-accent text-[20px] font-bold leading-[1.25] md:mt-6 md:text-[24px]">{e.titre}</h3>
              <p class="mt-1.5 text-[16px] leading-[1.55] dv-muted md:mt-2 md:text-[18px] md:leading-[1.6]">{e.texte}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Fonctionnalités : une carte par pilier, avec une vraie carte de l'app inclinée en 3D. -->
  <section class="dv-section bg-grey dv-points" aria-labelledby="fonctions-titre">
    <div class="dv-container">
      <p class="dv-overline dv-pastille"><span class="dv-pastille-point" aria-hidden="true"></span>Ce que fait Deliview</p>
      <h2 id="fonctions-titre" class="dv-h2 mt-4 max-w-[24ch] md:mt-5">Vos prix, votre carte, votre note. Face à votre zone.</h2>
      <ul class="mt-8 grid gap-6 md:mt-12 lg:grid-cols-3">
        {cartes.map((p, i) => <CartePilier icone={p.icone} nom={p.surtitre} benefice={p.carte.benefice} points={p.carte.points} fragment={FRAGMENTS[p.slug]} href={`/solution/${p.slug}/`} sens={i % 2 ? 'gauche' : 'droite'} />)}
      </ul>
    </div>
  </section>

  <!-- Exemple réel : le ticket Margherita (vraie analyse, restaurant anonymisé) flotte au-dessus de son plateau. -->
  <section class="dv-section bg-white overflow-x-clip" aria-labelledby="exemple-titre">
    <div class="dv-container dv-exemple">
      <div class="dv-exemple-intro">
        <p class="dv-overline dv-pastille"><span class="dv-pastille-point" aria-hidden="true"></span>Exemple réel</p>
        <h2 id="exemple-titre" class="dv-h2 mt-4 max-w-[18ch] md:mt-5">Une Margherita vendue {sousLaZone} sous le prix de sa zone</h2>
        <p class="dv-lead mt-3.5 max-w-[48ch] md:mt-5">
          Une pizzeria sur Uber&nbsp;Eats, analysée le 1<sup>er</sup>&nbsp;octobre 2026. {nombreEnLettres} concurrents directs vendent la même pizza, à la même taille, autour de {euros(ex.mediane)}. Elle la vend {euros(ex.votrePrix)}.
        </p>
      </div>
      <div class="dv-exemple-plateau" data-apparition="">
        <span class="dv-exemple-sol" aria-hidden="true"></span>
        <span class="dv-exemple-ombre" aria-hidden="true"></span>
        <div class="dv-exemple-ticket">
          <div class="dv-flotte">
            <TicketComparaison exemple={ex} proposition />
          </div>
        </div>
        <p class="dv-exemple-annotation max-w-full"><span class="dv-puce dv-puce-bleue">{sousLaZone} sous la zone, sur chaque pizza</span></p>
      </div>
      <div class="dv-exemple-suite">
        <p class="dv-lead max-w-[48ch]">
          Deliview propose de passer à {euros(ex.prixPropose)}. La pizza reste moins chère que chez les voisins, et sur 100&nbsp;Margherita vendues, c’est {euros(ex.gainPour100, 0)} de plus.
        </p>
        <a href={lien('/simulateur/')} class="dv-btn dv-btn-contour mt-6 w-full sm:w-auto md:mt-8" data-cta="exemple-simulateur">Combien vous rapporte un prix bien placé&nbsp;?</a>
      </div>
    </div>
  </section>

  <BlocFondateur />

  <!-- Tarifs en bref : trois offres en relief, Pro mise en avant. -->
  <section class="dv-section bg-white" aria-labelledby="tarifs-titre">
    <div class="dv-container">
      <p class="dv-overline dv-pastille"><span class="dv-pastille-point" aria-hidden="true"></span>Tarifs</p>
      <h2 id="tarifs-titre" class="dv-h2 mt-4 max-w-[24ch] md:mt-5">Un prix fixe, sans engagement</h2>
      <p class="dv-lead mt-3 md:mt-4">Mise en place offerte.</p>
      <ul class="dv-offres mt-8 grid items-end gap-5 md:mt-14 md:grid-cols-3 md:gap-6">
        {
          OFFRES.map((o) => (
            <li class={`dv-relief dv-offre ${o.recommandee ? 'dv-offre-pro' : ''}`}>
              <div class="flex items-center justify-between gap-3">
                <h3 class="font-accent text-[22px] font-bold leading-[1.2] md:text-[24px]">
                  {o.nom}
                  {o.recommandee && <span class="sr-only">, offre recommandée</span>}
                </h3>
                {o.recommandee && (
                  <span class="dv-badge" aria-hidden="true">
                    Recommandé
                  </span>
                )}
              </div>
              <p class="mt-1.5 text-[15px] leading-[1.4] dv-muted md:text-[16px]">{o.restaurants}</p>
              <p class="mt-5 flex items-baseline gap-2 md:mt-6">
                <span class="font-accent text-[40px] font-bold leading-none md:text-[48px]">{o.prix}&nbsp;€</span>
                <span class="text-[15px] leading-[1.3] md:text-[16px]">HT par mois</span>
              </p>
              <p class="mt-4 border-t border-grey-2/15 pt-4 text-[16px] leading-[1.5] md:mt-5 md:pt-5">{o.pour}.</p>
            </li>
          ))
        }
      </ul>
      <a href={lien('/tarifs/')} class="dv-lien-fort mt-6 md:mt-8">Voir le détail des offres<Fleche taille={24} /></a>
    </div>
  </section>

  <Faq questions={FAQ_ACCUEIL} titre="Ce qu’on demande à Tom avant une démo" id="questions" />

  <SectionDemo section="accueil-formulaire" />

</Base>
