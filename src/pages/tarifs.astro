---
// Tarifs, refaite le 7 octobre 2026 (demande de Tom : « améliore toute la page pricing… répartit les features de manière
// simple, écrite de manière concise… le restaurateur doit se sentir concerné… reprendre la technique d'autres SaaS »).
// Techniques reprises d'autres pages de tarifs (la structure seulement, aucun texte copié) :
// - un titre court sous chaque offre, qui dit ce qu'elle change (8 octobre 2026, à la place de « Pour vous si… ») ;
// - listes qui s'additionnent : « Tout Essentiel, plus : », « Tout Pro, plus : » (Linear, Otter) ;
// - ce qui est inclus quoi qu'il arrive, dont « aucun frais caché » (Sunday) ;
// - le coût de ne rien faire, relié aux offres, puis le simulateur (Sunday, Zenchef : calculateur) ;
// - offre pour un groupe de restaurants à part (Linear : « Contact sales ») ;
// - tableau comparatif à en-tête collant (Linear), lisible sur téléphone sans défilement horizontal ;
// - questions sur les objections : frais, paiement, arrêt, changement d'offre (Otter).
// Uniquement ce que Deliview fait aujourd'hui (OFFRES dans src/lib/site.ts, annexe 1 des CGV). Aucun chiffre inventé :
// l'exemple de prix est la vraie analyse de l'accueil (EXEMPLE_MARGHERITA), les engagements viennent des CGV (3.4, 9,
// 10, 12.2), l'argent rapporté est la carte de l'accueil de l'app (5 octobre 2026).
// Gardé : chaque offre mène au formulaire de départ /commencer/?offre=… (4 octobre, logique de taap.it) ; la démo reste
// proposée sous les offres et en bas de page ; « Un groupe de restaurants ? » dans la bulle de Tom, comme sur l'accueil.
// 8 octobre 2026 (demande de Tom : « Enlève les prix car chaque restaurateur peut avoir des besoins différents ») : plus
// aucun prix sur la page. À la place du prix, « Prix selon vos besoins, fixé avec Tom, avant tout paiement » (CGV 8.1
// et 8.2) ; « Combien me coûte Deliview ? » en tête des questions ; plus de données structurées d'offres.
// 8 octobre 2026, 15 h 26 (demande de Tom) : plus de nombre de restaurants par offre (cartes, raccourcis, comparatif,
// questions), et « Prix selon vos besoins » seul, sans « Fixé avec Tom, avant tout paiement ».
// 8 octobre 2026, 17 h 47 (demande de Tom) : sa phrase « Vous voulez… » revient sur chaque carte (OFFRES.pourVous) ;
// chapeau raccourci : « Avec Essentiel, vous voyez tout. Avec Pro et Groupe, Deliview agit pour vous. »
// 17 h 56 (Tom : « laisse le titre des offres qu'il y avait au début, Pour vous si ») : les cartes reprennent « Pour vous
// si » au-dessus de la phrase, à la place du titre court (qui reste sur l'accueil, « Commencer » et llms.txt).
// 8 octobre 2026, 15 h 50 (demande de Tom : « des titres simples, concis ») : un titre court par offre à la place de
// « Pour vous si », lignes plus courtes, et le comparatif avec les mêmes mots (OFFRES dans src/lib/site.ts).
// 9 octobre 2026, 18 h 44 (demande de Tom, après sa comparaison avec Savour, agence qui gère les plateformes sans outil) :
// deux offres qui se distinguent par qui décide. Autonomie : vous décidez dans Deliview, Deliview applique. Délégation
// (recommandée) : la stratégie se fixe avec Tom au point mensuel, puis Deliview gère, et vous voyez tout. Une phrase sous
// le nom de chaque offre (OFFRES.phrase), « Dans les deux offres », comparatif en deux colonnes avec un bloc « Qui
// décide », et deux questions : la différence entre les offres, le changement d'offre (CGV 5.3). Essentiel n'est plus
// proposée.
import Base from '../layouts/Base.astro';
import Pastille from '../components/Pastille.astro';
import Faq from '../components/Faq.astro';
import Coche from '../icons/coche.astro';
import Fleche from '../icons/fleche.astro';
import Plus from '../icons/plus.astro';
import Moins from '../icons/moins.astro';
import Courbe from '../icons/courbe.astro';
import Toque from '../icons/toque.astro';
import CadenasOuvert from '../icons/cadenas-ouvert.astro';
import EtiquettePrix from '../icons/etiquette-prix.astro';
import Bouclier from '../icons/bouclier.astro';
import Message from '../icons/message.astro';
import Telephone from '../icons/telephone.astro';
import BoutiqueArret from '../icons/boutique-arret.astro';
import TicketIcone from '../icons/ticket.astro';
import LoupeZone from '../icons/loupe-zone.astro';
import OffrePro from '../icons/offre-pro.astro';
import OffreGroupe from '../icons/offre-groupe.astro';
import { EXEMPLE_MARGHERITA as ex, OFFRES, SITE, dateFr, euros, jsonldLogiciel, lien } from '../lib/site';

const description = 'Deux offres pour vos restaurants sur Uber Eats et Deliveroo : vous gardez la main, ou vous déléguez tout. Sans engagement, mise en place offerte.';

// Une icône par offre, dessinée pour Deliview (7 octobre 2026, demande de Tom) : la même boutique, et ce que l'offre
// ajoute en bleu. Autonomie (ancienne icône de Pro) : deux boutiques et l'étincelle de l'IA (Deliview applique ce que
// vous décidez) ; Délégation (ancienne icône de Groupe) : deux boutiques et la bulle (la stratégie fixée chaque mois
// avec Tom). Validées par Tom le 7 octobre 2026 (21 h 58) : en ligne partout.
const ICONES_OFFRES: Record<string, typeof Courbe> = { pro: OffrePro, premium: OffreGroupe };

// Inclus dans les deux offres : CGV 3.4 (mise en place), 8.2 (mise en place offerte), 10.1 et 10.2 (durée, arrêt), 12.2 (réponses) ;
// accès par invitation (mêmes mots que la page Qui sommes-nous).
const inclusPartout = [
  { icone: Toque, titre: 'Mise en place offerte', texte: 'Tom crée votre compte avec vous et vous présente vos premiers résultats.' },
  { icone: CadenasOuvert, titre: 'Sans engagement', texte: 'Un abonnement au mois. Vous arrêtez quand vous voulez.' },
  { icone: EtiquettePrix, titre: 'Aucun frais caché', texte: 'Pas de frais de mise en place, pas d’option payante.' },
  { icone: Bouclier, titre: 'Jamais votre mot de passe', texte: 'Vous invitez Deliview dans Uber&nbsp;Eats et Deliveroo. Votre mot de passe reste à vous.' },
  { icone: Message, titre: 'Un humain qui répond', texte: 'Messagerie, <span class="whitespace-nowrap">e-mail</span> ou téléphone, les jours ouvrés de 9&nbsp;h à 18&nbsp;h.' },
  { icone: Telephone, titre: 'Rien à installer', texte: 'Deliview s’ouvre dans votre navigateur, sur ordinateur comme sur téléphone. Vos tablettes restent en place.' },
];

// Là où le restaurateur perd de l'argent, et ce que fait chaque offre (9 octobre 2026) : les deux offres repèrent ; ce
// qui change, c'est qui décide. Autonomie : vous décidez, en un clic. Délégation : Deliview agit selon la stratégie et
// les règles fixées avec vous au point mensuel (CGV 13.3). La relance suit vos règles : une pause voulue n'est pas relancée.
const releve = dateFr(new Date(ex.releve + 'T12:00:00Z')).replace(/^1er /, '1<sup>er</sup> ');
const fuites = [
  {
    icone: BoutiqueArret,
    titre: 'Fermé en plein service',
    constat: 'Votre restaurant passe fermé sur Uber&nbsp;Eats ou Deliveroo, et personne ne le voit.',
    autonomie: 'Deliview vous prévient. Vous le relancez en un clic.',
    delegation: 'Deliview le relance pour vous, selon les règles fixées ensemble.',
  },
  {
    icone: TicketIcone,
    titre: 'Un remboursement retenu',
    constat: 'Un client se plaint&nbsp;: la plateforme le rembourse et retire la somme de votre versement.',
    autonomie: 'Deliview le repère. Vous le contestez en un clic.',
    delegation: 'Deliview le repère et le conteste pour vous.',
  },
  {
    icone: LoupeZone,
    titre: 'Un plat sous le prix de sa zone',
    constat: `Exemple réel&nbsp;: une ${ex.plat} à ${euros(ex.votrePrix)} sur ${ex.plateforme.replace(' ', '&nbsp;')}, quand ${ex.concurrents} concurrents la vendent autour de ${euros(ex.mediane)}.`,
    source: `Relevé du ${releve}, restaurant anonymisé.`,
    autonomie: 'Deliview propose un prix. Il passe en ligne après votre accord.',
    delegation: 'Deliview ajuste le prix selon la stratégie fixée avec vous.',
  },
];
const [autonomie, delegation] = OFFRES;

// Case du comparatif : « oui » (coche), « non » (tiret), « bientot » (étiquette « Bientôt »), ou un texte court.
type Case = 'oui' | 'non' | 'bientot' | string;
// Comparatif en deux colonnes (9 octobre 2026), mêmes mots que les cartes des offres (OFFRES) : ce que vous voyez (tout,
// dans les deux offres), qui décide, l'accompagnement et l'accès. Ce qui est pareil partout (mise en place, engagement)
// est dans « Dans les deux offres ». Analyses à la demande, concurrents choisis, accès : règles de l'app
// (app/src/lib/offre.ts, offres « pro » et « premium »).
const comparatif: { groupe: string; lignes: { libelle: string; valeurs: [Case, Case] }[] }[] = [
  {
    groupe: 'Ce que vous voyez',
    lignes: [
      { libelle: 'Ventes Uber Eats et Deliveroo réunies', valeurs: ['oui', 'oui'] },
      { libelle: 'Score de votre fiche Uber Eats', valeurs: ['oui', 'oui'] },
      { libelle: 'Prix, promos et notes de vos concurrents', valeurs: ['oui', 'oui'] },
      { libelle: 'Analyses de zone à la demande', valeurs: ['oui', 'oui'] },
      { libelle: 'Concurrents de votre choix', valeurs: ['oui', 'oui'] },
      { libelle: 'Photos et descriptions revues', valeurs: ['oui', 'oui'] },
      { libelle: 'Remboursements et dates limites', valeurs: ['oui', 'oui'] },
      { libelle: 'Alerte fermeture en plein service', valeurs: ['oui', 'oui'] },
      { libelle: 'Objectifs et point du lundi', valeurs: ['oui', 'oui'] },
      { libelle: 'Assistant IA et rapports PDF', valeurs: ['oui', 'oui'] },
    ],
  },
  {
    groupe: 'Qui décide',
    lignes: [
      { libelle: 'Prix et promos', valeurs: ['Vous validez', 'Gérés pour vous'] },
      { libelle: 'Contestation des remboursements', valeurs: ['En un clic', 'Faite pour vous'] },
      { libelle: 'Réponses IA à vos avis', valeurs: ['Vous validez', 'Faites pour vous'] },
      { libelle: 'Relance du restaurant fermé', valeurs: ['En un clic', 'Faite pour vous'] },
    ],
  },
  {
    groupe: 'Accompagnement et accès',
    lignes: [
      { libelle: 'Point mensuel avec Tom', valeurs: ['non', 'oui'] },
      { libelle: 'Plan de promos préparé chaque mois', valeurs: ['non', 'oui'] },
      { libelle: 'Accès pour votre équipe', valeurs: ['10', 'Illimités'] },
    ],
  },
];

// Questions sur ce qui fait hésiter avant de payer : engagement et arrêt (CGV 10.1, 10.2), frais (3.4, 8.2), moment du
// paiement (/commencer/), moyens de paiement (9.1, 9.2), différence entre les offres (13.3), changement d'offre (5.3),
// tablettes, réseau, données.
const faq = [
  {
    q: 'Combien me coûte Deliview ?',
    r: 'Le prix dépend de vos restaurants et de vos besoins. Tom le fixe avec vous, avant tout paiement. L’abonnement est mensuel et sans engagement, et la mise en place est offerte.',
  },
  {
    q: 'Est-ce que je m’engage sur une durée ?',
    r: 'Non. L’abonnement est mensuel et sans engagement. Pour arrêter, écrivez à Tom ou passez par votre espace de facturation&nbsp;: l’arrêt prend effet à la fin du mois d’abonnement en cours.',
  },
  {
    q: 'Est-ce que je paie des frais en plus de l’abonnement ?',
    r: 'Non. La mise en place est offerte et aucune option n’est payante. Vous payez chaque mois le prix fixé avec Tom, plus la TVA.',
  },
  {
    q: 'Quand est-ce que je paie ?',
    r: 'Une fois votre prix fixé et votre compte ouvert avec Tom. Il vous envoie le lien de paiement et vous vous abonnez en ligne.',
  },
  {
    q: 'Comment se passe le paiement ?',
    r: 'Par carte bancaire ou par prélèvement SEPA, avec Stripe. La facture arrive chaque mois par e-mail.',
  },
  {
    q: 'Quelle différence entre Autonomie et Délégation ?',
    r: 'Qui décide. Avec Autonomie, Deliview vous propose prix, promos et réponses à vos avis&nbsp;: vous validez depuis votre téléphone, et Deliview les applique sur Uber&nbsp;Eats et Deliveroo. Avec Délégation, vous fixez la stratégie avec Tom chaque mois, puis Deliview gère sans vous demander à chaque fois. Dans les deux offres, vous voyez tout dans l’app.',
  },
  {
    q: 'Je peux changer d’offre ?',
    r: 'Oui, quand vous voulez. Le passage à Délégation s’applique tout de suite, et la différence est facturée au prorata. Le retour à Autonomie se fait au début du mois d’abonnement suivant.',
  },
  {
    q: 'Est-ce que je garde mes tablettes Uber Eats et Deliveroo ?',
    r: 'Oui. Vos tablettes restent là pour recevoir les commandes, et rien n’est à installer&nbsp;: Deliview s’ouvre dans votre navigateur.',
  },
  {
    q: 'J’ai un groupe de restaurants : comment je fais ?',
    r: `Tom vous prépare une offre pour tout votre groupe. Écrivez-lui à <a href="mailto:${SITE.email}">${SITE.email}</a> ou demandez une démo.`,
  },
  {
    q: 'Où sont hébergées mes données ?',
    r: 'Dans l’Union européenne&nbsp;: la base de données de Deliview est hébergée en Irlande. Le détail est dans notre <a href="' + lien('/confidentialite/') + '">politique de confidentialité</a>.',
  },
];

const texteBrut = (h: string) => h.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ');
// Trois questions sont aussi sur /questions-frequentes/ : elles restent affichées ici, mais ne sont balisées (FAQPage)
// qu'une fois sur le site, sur la page des questions fréquentes (8 octobre 2026, audit SEO, règle de Google).
const BALISEES_AILLEURS = ['Combien me coûte Deliview ?', 'Est-ce que je m’engage sur une durée ?', 'Où sont hébergées mes données ?'];
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq
    .filter((x) => !BALISEES_AILLEURS.includes(x.q))
    .map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: texteBrut(x.r) } })),
};
const logiciel = jsonldLogiciel(SITE.definition, SITE.url + '/tarifs/');
---

<Base title="Tarifs : un prix selon vos besoins, sans engagement | Deliview" description={description} ariane={[{ nom: 'Tarifs', chemin: '/tarifs/' }]} jsonld={[logiciel, faqPage]}>
  <section id="offres" class="bg-grey pb-16 pt-8 md:pb-[104px] md:pt-12" aria-labelledby="tarifs-titre" data-haut-de-page>
    <div class="dv-container">
      <div class="text-center">
        <Pastille>Tarifs</Pastille>
        <!-- Titre et sans les trois coches du dessous (7 octobre 2026, 15 h 14, demande de Tom). -->
        <h1 id="tarifs-titre" class="dv-h1 mx-auto mt-5 max-w-[20ch] md:mt-6 md:max-w-[27ch]">Améliorez la rentabilité de votre activité livraison</h1>
        <!-- Une phrase par offre (9 octobre 2026) : qui décide, qui applique. -->
        <p class="dv-lead mx-auto mt-4 max-w-[56ch] md:mt-5">
          Avec {autonomie.nom}, vous décidez et Deliview applique.<br class="max-sm:hidden" /> Avec {delegation.nom}, Deliview s’occupe de tout et vous voyez tout.
        </p>
      </div>

      <!-- Téléphone et tablette : les deux offres d'un coup d'œil, chacune mène à sa carte (les cartes sont empilées). -->
      <nav class="mx-auto mt-8 max-w-[520px] lg:hidden" aria-label="Aller à une offre">
        <ul class="grid grid-cols-2 gap-2.5 sm:gap-4">
          {
            OFFRES.map((o) => (
              <li>
                <a href={`#${o.slug}`} class={`dv-raccourci ${o.recommandee ? 'dv-raccourci-pro' : ''}`} data-cta={`tarifs-raccourci-${o.slug}`}>
                  <span class="dv-raccourci-nom">{o.nom}{o.recommandee && <span class="sr-only">, offre recommandée</span>}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <ul class="dv-offres-page mx-auto mt-12 grid max-w-[980px] items-stretch gap-6 md:mt-14 lg:mt-20 lg:grid-cols-2 lg:gap-8">
        {
          OFFRES.map((o) => {
            const Icone = ICONES_OFFRES[o.slug] ?? Courbe;
            return (
              <li id={o.slug} class={`dv-relief dv-offre flex scroll-mt-12 flex-col md:grid md:grid-cols-[1fr_1.15fr] lg:flex ${o.recommandee ? 'dv-offre-pro' : ''}`}>
                {o.recommandee && (
                  <p class="dv-offre-bandeau" aria-hidden="true">
                    Recommandé
                  </p>
                )}
                {/* Tablette (cartes empilées, larges) : l'offre à gauche, ce qu'elle contient à droite. */}
                <div class="flex flex-col">
                <div class="flex items-center gap-3.5">
                  <span class="dv-tuile dv-tuile-petite">
                    <Icone taille={32} />
                  </span>
                  <div class="min-w-0">
                    <h2 class="font-accent text-[26px] font-bold leading-[1.15] md:text-[28px]">{o.nom}{o.recommandee && <span class="sr-only">, offre recommandée</span>}</h2>
                  </div>
                </div>
                {/* Qui décide, qui applique (9 octobre 2026). */}
                <p class="dv-offre-phrase mt-4 lg:min-h-[54px]">{o.phrase}</p>
                {/* « Pour vous si » et la phrase de Tom, comme au début (8 octobre 2026, 17 h 56, demande de Tom). */}
                <p class="dv-overline mt-5">Pour vous si</p>
                <p class="mt-1.5 text-[16px] leading-[1.5] lg:min-h-[48px]">{o.pourVous}</p>
                {/* Plus de prix affiché (8 octobre 2026, demande de Tom) : le prix est fixé avec Tom, avant tout paiement. */}
                <div class="mt-5 border-t border-grey-2/15 pt-5">
                  <p class="dv-offre-sur-mesure">Prix selon vos besoins</p>
                </div>
                <a
                  href={lien(`/commencer/?offre=${o.slug}`)}
                  class={`dv-btn mt-5 w-full ${o.recommandee ? 'dv-btn-plein' : 'dv-btn-contour'}`}
                  data-cta={`tarifs-${o.slug}`}
                  {...(o.recommandee ? { 'data-cta-principal': '' } : {})}
                >
                  Commencer maintenant<span class="sr-only"> avec l’offre {o.nom}</span>
                </a>
                </div>
                <div class="dv-offre-contenu">
                <p class="text-balance text-[16px] font-bold leading-[1.4]">{o.base}</p>
                <ul class="dv-offre-liste mt-3 grid gap-2.5 text-[16px] leading-[1.45]">
                  {o.inclus.map((x) => (
                    <li class="flex gap-2.5">
                      <Coche taille={24} />
                      {typeof x === 'string' ? (
                        <span class="text-pretty">{x}</span>
                      ) : (
                        <span class="text-pretty">
                          {x.texte} <span class="dv-bientot">Bientôt</span>
                        </span>
                      )}
                    </li>
                  ))}
                </ul>
                </div>
              </li>
            );
          })
        }
      </ul>

      <!-- Sous les offres (7 octobre 2026, demande de Tom : « qu'on comprenne mieux ») : deux cas, deux cartes de même poids,
           chacune avec sa question, une phrase qui dit ce qui se passe, et son lien. -->
      <div class="mx-auto mt-12 grid max-w-[880px] gap-4 md:mt-14 md:grid-cols-2 md:gap-5">
        <div class="flex flex-col rounded-[16px] border border-[color-mix(in_srgb,var(--color-grey-2)_15%,transparent)] bg-white p-5 md:p-6">
          <div class="flex items-center gap-3">
            <img class="dv-bulle-groupe-tom" src={lien('/images/tom-voisin.webp')} alt="" width="400" height="400" loading="lazy" decoding="async" />
            <h2 class="font-accent text-[20px] font-bold leading-[1.25] md:text-[22px]">Un groupe de restaurants&nbsp;?</h2>
          </div>
          <p class="mt-3 flex-1 text-[16px] leading-[1.5] md:text-[17px]">Tom vous prépare une offre pour tout votre groupe.</p>
          <a href={lien('/demo/')} class="dv-lien-fort mt-4 self-start" data-cta="tarifs-plus-de-10">Parler à Tom<Fleche taille={24} /></a>
        </div>
        <div class="flex flex-col rounded-[16px] border border-[color-mix(in_srgb,var(--color-grey-2)_15%,transparent)] bg-white p-5 md:p-6">
          <h2 class="font-accent text-[20px] font-bold leading-[1.25] md:text-[22px]">Pas encore décidé&nbsp;?</h2>
          <p class="mt-3 flex-1 text-[16px] leading-[1.5] md:text-[17px]">Voyez Deliview sur votre propre restaurant avant de choisir une offre.</p>
          <a href={lien('/demo/')} class="dv-lien-fort mt-4 self-start" data-cta="tarifs-voir-avant">Demander une démo gratuite<Fleche taille={24} /></a>
        </div>
      </div>
      <p class="mt-6 text-center text-[14px] dv-muted">
        Abonnement mensuel soumis aux <a href={lien('/cgv/')}>conditions générales de vente</a>.
      </p>
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="inclus-titre">
    <div class="dv-container max-w-[1100px]">
      <h2 id="inclus-titre" class="dv-h2">Dans les deux offres</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 md:mt-10 md:gap-5 lg:grid-cols-3">
        {
          inclusPartout.map(({ icone: Icone, titre, texte }) => (
            <li class="flex gap-4 rounded-[16px] bg-grey p-4 md:p-6">
              <span class="dv-tuile dv-tuile-petite">
                <Icone taille={24} />
              </span>
              <div class="min-w-0">
                <h3 class="font-accent text-[19px] font-bold leading-[1.3]">{titre}</h3>
                <p class="mt-1.5 text-[16px] leading-[1.55]" set:html={texte} />
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="dv-section bg-grey dv-points" aria-labelledby="fuites-titre">
    <div class="dv-container max-w-[1100px]">
      <h2 id="fuites-titre" class="dv-h2 max-w-[22ch]">Là où vous perdez de l’argent sans le voir</h2>
      <p class="dv-lead mt-3 max-w-[56ch] md:mt-4">Deliview repère ces pertes dans les deux offres. Ce qui change, c’est qui décide.</p>
      <ul class="mt-8 grid gap-5 md:mt-10 md:grid-cols-3 md:gap-6">
        {
          fuites.map(({ icone: Icone, titre, constat, source, autonomie: parVous, delegation: pourVous }) => (
            <li class="dv-relief flex flex-col p-5 md:p-7">
              <!-- Téléphone : l'icône à côté du titre (carte plus courte) ; à partir de 768 px, au-dessus (cartes étroites). -->
              <div class="flex items-center gap-3.5 md:flex-col md:items-start md:gap-5">
                <span class="dv-tuile dv-tuile-petite">
                  <Icone taille={32} />
                </span>
                <h3 class="dv-h3">{titre}</h3>
              </div>
              <p class="mt-4 text-[16px] leading-[1.55] md:mt-3" set:html={constat} />
              {source && <p class="mt-2 text-[14px] leading-[1.45] dv-muted" set:html={source} />}
              <div class="mt-auto pt-5">
                <dl class="dv-fuite-offres">
                  <div>
                    <dt>{autonomie.nom}</dt>
                    <dd>{parVous}</dd>
                  </div>
                  <div>
                    <dt>{delegation.nom}</dt>
                    <dd>{pourVous}</dd>
                  </div>
                </dl>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="mt-8 flex flex-col items-start gap-2 md:mt-10 lg:flex-row lg:items-center lg:justify-between lg:gap-10">
        <p class="max-w-[62ch] text-[17px] leading-[1.55] md:text-[18px]">
          Dans les deux offres, l’accueil de l’app additionne ce que Deliview vous a rapporté&nbsp;: remboursements Uber&nbsp;Eats récupérés, ventes après une relance.
        </p>
        <a href={lien('/simulateur/')} class="dv-lien-fort shrink-0" data-cta="tarifs-simulateur">Calculer ce qui vous reste<Fleche taille={24} /></a>
      </div>
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="comparatif-titre">
    <div class="dv-container max-w-[1100px]">
      <h2 id="comparatif-titre" class="dv-h2">Comparer les offres</h2>
      <!-- Tableau replié sur téléphone (les cartes disent déjà tout, il s'ouvre d'un geste), ouvert d'office sur ordinateur
           par le script en bas de page ; sans JavaScript, il reste à ouvrir partout. Rôles ARIA explicites : sur téléphone,
           chaque ligne passe en grille (intitulé au-dessus, trois cases dessous), et certains navigateurs perdent alors la
           structure du tableau pour les lecteurs d'écran. -->
      <details class="dv-comparatif-details mt-6 md:mt-10" data-ouvert-ordinateur>
        <summary class="dv-relief dv-comparatif-bouton">
          <span>Voir le tableau complet</span>
          <Plus taille={24} class="dv-comparatif-plus" />
          <Moins taille={24} class="dv-comparatif-moins" />
        </summary>
      <div class="dv-comparatif-cadre mt-5 md:mt-0">
        <table class="dv-comparatif" role="table" aria-labelledby="comparatif-titre">
          <thead role="rowgroup">
            <tr role="row">
              <th scope="col" role="columnheader" class="dv-comparatif-coin">Ce qui est inclus</th>
              {
                OFFRES.map((o) => (
                  <th scope="col" role="columnheader" class={o.recommandee ? 'dv-comparatif-pro' : ''}>
                    <span class="dv-comparatif-nom">{o.nom}</span>
                  </th>
                ))
              }
            </tr>
          </thead>
          {
            comparatif.map((g) => (
              <tbody role="rowgroup">
                <tr role="row" class="dv-comparatif-groupe">
                  <th scope="rowgroup" role="rowheader" colspan={OFFRES.length + 1}>
                    {g.groupe}
                  </th>
                </tr>
                {g.lignes.map((l) => (
                  <tr role="row">
                    <th scope="row" role="rowheader">
                      {l.libelle}
                    </th>
                    {l.valeurs.map((c, i) => (
                      <td role="cell" class={OFFRES[i].recommandee ? 'dv-comparatif-pro' : ''}>
                        {c === 'oui' ? (
                          <span class="dv-comparatif-oui">
                            <Coche taille={24} />
                            <span class="sr-only">Inclus</span>
                          </span>
                        ) : c === 'non' ? (
                          <span class="dv-comparatif-non">
                            <span aria-hidden="true">—</span>
                            <span class="sr-only">Non inclus</span>
                          </span>
                        ) : c === 'bientot' ? (
                          <span class="dv-bientot">Bientôt</span>
                        ) : (
                          <span>{c}</span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))}
              </tbody>
            ))
          }
        </table>
      </div>
      </details>
    </div>
  </section>

  <Faq questions={faq} titre="Avant de choisir une offre" />
</Base>

<script>
  // Ordinateur et tablette : le tableau comparatif est ouvert d'office, sans le bouton qui le replie.
  const comparatif = document.querySelector<HTMLDetailsElement>('details[data-ouvert-ordinateur]');
  if (comparatif && window.matchMedia('(min-width: 768px)').matches) {
    comparatif.open = true;
    comparatif.classList.add('dv-comparatif-ouvert');
  }
</script>

<style>
