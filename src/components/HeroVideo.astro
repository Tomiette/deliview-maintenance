---
// Vidéo de présentation (16:9, 1 min 10, sans voix off, avec musique), dans le cadre tablette dessiné au trait
// (section « Comment ça marche » de l'accueil). Seule la couverture fournie par Tom (52 Ko) se charge avec la page ;
// la vidéo (5 à 7 Mo) ne se télécharge qu'au clic et se lance avec le son, jamais en automatique.
// Toute l'image est cliquable, avec au centre le signe « lecture » dessiné. Sans JavaScript, les contrôles natifs restent
// affichés. Le contenu de la vidéo reste disponible pour les lecteurs d'écran (bloc masqué, relié par aria-describedby).
import Lecture from '../icons/lecture.astro';
import { lien } from '../lib/site';

interface Props {
  class?: string;
}
const { class: classe = '' } = Astro.props;

const texte = [
  'Bon, j’ai 1 minute pour vous convaincre. Alors je vous la fais courte.',
  'Restaurateur, on vous a promis que la livraison serait rentable. Eh oui.',
  'Mais au quotidien ? Trop de tablettes. Pas le temps de tout analyser. Trop de concurrents. Trop de promos.',
  'Et surtout : être présent, mais être rentable… non.',
  'Alors on a créé Deliview. Toutes vos données livraison centralisées : votre carte, vos avis, vos concurrents, leurs prix.',
  'Deliview surveille vos concurrents : leurs prix, leurs notes, leurs promos.',
  'Et surtout, Deliview vous dit quoi faire : un prix suggéré pour chaque plat, face au prix de la zone.',
  'L’IA Deliview vous rend plus visible, plus rentable. À la question « Que font mes concurrents dans ma zone ? », elle répond par exemple : « Napoli Express lance −30 % sur ses pizzas. Passez votre Margherita à 10,90 € pour rester bien référencé et compétitif. »',
  'Et dès que ça bouge, Deliview vous alerte : promotions des concurrents, changements de prix, nouveau concurrent, avis négatif reçu.',
  'Résultat : vous réagissez immédiatement. Pas la semaine d’après.',
  'Deliview : votre activité livraison sur un seul écran. Demandez une démo sur deliview.fr.',
];
---

<div class={`hv ${classe}`}>
  <figure class="m-0">
    <div class="hv-cadre">
      <video
        class="hv-lecteur"
        controls
        playsinline
        preload="none"
        width="1920"
        height="1080"
        poster={lien('/video/deliview-video-couverture-16x9.webp')}
        aria-label="Vidéo de présentation de Deliview, 1 minute 10, sans voix off"
        aria-describedby="hv-legende"
      >
        <source src={lien('/video/deliview-video-16x9.webm')} type='video/webm; codecs="vp9, opus"' />
        <source src={lien('/video/deliview-video-16x9.mp4')} type="video/mp4" />
        <a href={lien('/video/deliview-video-16x9.mp4')}>Télécharger la vidéo de présentation (MP4, 7 Mo)</a>
      </video>
      <button class="hv-lire" type="button" aria-label="Lancer la vidéo de présentation de Deliview, 1 minute 10" hidden>
        <span class="hv-pastille" aria-hidden="true">
          <Lecture taille={48} class="hv-icone-grande" />
          <Lecture taille={32} class="hv-icone-petite" />
        </span>
      </button>
    </div>
    <figcaption class="hv-note">
      Deliview en 1&nbsp;min&nbsp;10. La vidéo se charge quand vous <span class="hv-geste-clic">cliquez</span><span class="hv-geste-toucher">touchez</span>.
    </figcaption>
  </figure>
  <!-- Contenu de la vidéo pour les lecteurs d'écran uniquement. -->
  <div id="hv-legende" class="sr-only">
    <p>Restaurants et chiffres d’exemple. Contenu de la vidéo&nbsp;:</p>
    <ol>
      {texte.map((t) => <li>{t}</li>)}
    </ol>
  </div>
</div>

<script>
  // Lecture au clic, avec le son. À la fin, retour à l'aperçu et à la pastille.
  document.querySelectorAll<HTMLElement>('.hv-cadre').forEach((cadre) => {
    const video = cadre.querySelector('video');
    const bouton = cadre.querySelector<HTMLButtonElement>('.hv-lire');
    if (!video || !bouton) return;
    video.controls = false;
    bouton.hidden = false;
    const lire = () => {
      bouton.hidden = true;
      video.controls = true;
      void video.play();
      video.focus();
    };
    bouton.addEventListener('click', lire);
    video.addEventListener('ended', () => {
      video.controls = false;
      video.load();
      bouton.hidden = false;
      bouton.focus();
    });
  });
</script>

<style>
  .hv {
    width: 100%;
    max-width: 880px;
    margin-inline: auto;
  }
  /* Cadre tablette dessiné au trait (Gris 2, 2,2 px), comme les captures de l'app. */
  .hv-cadre {
    position: relative;
    padding: 8px;
    border: 2.2px solid var(--color-grey-2);
    border-radius: 18px;
    background: var(--color-white);
  }
  .hv-lecteur {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    border-radius: 10px;
    object-fit: cover;
    background: var(--color-grey);
  }
  .hv-lire {
    position: absolute;
    inset: 0;
    padding: 0;
    border: 0;
    border-radius: 18px;
    background: transparent;
    cursor: pointer;
  }
  .hv-lire[hidden] {
    display: none;
  }
  /* Signe « lecture » dessiné, dans un cercle blanc au trait, au centre de l'image. */
  .hv-pastille {
    position: absolute;
    left: 50%;
    top: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border: 2.2px solid var(--color-grey-2);
    border-radius: 50%;
    background: var(--color-white);
    color: var(--color-grey-2);
    translate: -50% -50%;
    transition: scale 0.15s ease;
  }
  .hv-lire:hover .hv-pastille {
    scale: 1.05;
  }
  .hv-lire:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 4px;
  }
  .hv-lire:focus-visible .hv-pastille {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }
  .hv-pastille :global(.hv-icone-grande),
  .hv-geste-clic {
    display: none;
  }
  .hv-note {
    margin-top: 12px;
    text-align: center;
    font-size: 15px;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-grey-2) 85%, transparent);
  }
  @media (min-width: 768px) {
    .hv-cadre {
      padding: 12px;
      border-radius: 24px;
    }
    .hv-lecteur {
      border-radius: 14px;
    }
    .hv-lire {
      border-radius: 24px;
    }
    .hv-pastille {
      width: 92px;
      height: 92px;
    }
    .hv-pastille :global(.hv-icone-grande) {
      display: block;
    }
    .hv-pastille :global(.hv-icone-petite),
    .hv-geste-toucher {
      display: none;
    }
    .hv-geste-clic {
      display: inline;
    }
    .hv-note {
      margin-top: 16px;
      font-size: 16px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hv-pastille {
      transition: none;
    }
  }
</style>
