---
// Page par plateforme (motif Zapier) : ce que Deliview montre, comment démarrer, FAQ.
// Refonte en relief (3 octobre 2026) : en haut, la vraie carte « position » de la plateforme qui flotte en 3D.
import Base from '../../layouts/Base.astro';
import BoutonDemo from '../../components/BoutonDemo.astro';
import SectionDemo from '../../components/SectionDemo.astro';
import Faq from '../../components/Faq.astro';
import Pastille from '../../components/Pastille.astro';
import FragmentFlottant from '../../components/FragmentFlottant.astro';
import Coche from '../../icons/coche.astro';
import Fleche from '../../icons/fleche.astro';
import Enveloppe from '../../icons/enveloppe.astro';
import Cadenas from '../../icons/cadenas.astro';
import Courbe from '../../icons/courbe.astro';
import { FRAGMENTS, PLATEFORMES, SITE, jsonldLogiciel, lien } from '../../lib/site';

export function getStaticPaths() {
  return PLATEFORMES.map((p) => ({ params: { slug: p.slug }, props: { slug: p.slug } }));
}

const { slug } = Astro.props as { slug: string };
const p = PLATEFORMES.find((x) => x.slug === slug)!;
const autres = PLATEFORMES.filter((x) => x.slug !== slug);

// 8 octobre 2026 (audit SEO, quasi-doublons) : chaque page a ses propres étapes d'invitation et ses propres questions.
// Faits repris uniquement du site (article « gérer Uber Eats et Deliveroo ensemble », pages Solution, questions
// fréquentes) et du parcours de première connexion de l'app (doc projet « onboarding-acces », 5 octobre 2026) : l'adresse
// à inviter est donnée dans Deliview, avec le lien vers la plateforme ; rôle Administrateur ; jamais le mot de passe.
type Etape = { titre: string; texte: string };
const CONTENU: Record<string, { title: string; description: string; h1: string; lead: string; etapesTitre: string; etapes: Etape[]; faq: { q: string; r: string }[] }> = {
  'uber-eats': {
    title: 'Intégration Uber Eats pour restaurants | Deliview',
    description:
      'Ce que Deliview fait avec votre compte Uber Eats : ventes de la veille, avis, remboursements à contester, fermetures et prix face à votre zone.',
    h1: 'Intégration Uber Eats : ce que Deliview fait avec votre compte',
    lead: 'Chaque plat de votre carte Uber Eats face au même plat chez vos voisins. Votre note et vos offres aussi.',
    etapesTitre: 'Connecter votre compte Uber Eats',
    etapes: [
      { titre: 'Copiez l’adresse de Deliview', texte: 'À votre première connexion, Deliview vous donne l’adresse e-mail à inviter, avec un lien vers Uber Eats Manager.' },
      { titre: 'Ajoutez-la dans Uber Eats Manager', texte: 'Comme nouvel utilisateur, avec un nom et cet e-mail. Parmi les quatre niveaux d’accès, choisissez Administrateur.' },
      { titre: 'Vos ventes Uber Eats arrivent', texte: 'Deliview les ajoute chaque jour à 7 h. Votre mot de passe reste à vous, et vous retirez l’accès quand vous voulez.' },
    ],
    faq: [
      {
        q: 'Faut-il donner mon mot de passe Uber Eats ?',
        r: 'Non. Vous invitez Deliview comme utilisateur dans Uber&nbsp;Eats Manager, avec le rôle Administrateur. Vous retirez cet accès quand vous voulez, depuis Uber&nbsp;Eats Manager.',
      },
      {
        q: 'Combien de temps ai-je pour contester un remboursement Uber Eats ?',
        r: 'Jusqu’à 30&nbsp;jours après la commande. Deliview liste chaque remboursement avec sa date limite et vous montre d’abord les plus pressés. Avec l’offre Autonomie, vous contestez en un clic&nbsp;; avec Délégation, Deliview conteste pour vous.',
      },
      {
        q: 'Et si mon restaurant n’est que sur Uber Eats ?',
        r: 'Deliview fonctionne aussi avec une seule plateforme. L’analyse porte alors sur Uber&nbsp;Eats seulement.',
      },
    ],
  },
  deliveroo: {
    title: 'Intégration Deliveroo pour restaurants | Deliview',
    description:
      'Ce que Deliview fait avec votre compte Deliveroo : ventes de la veille, avis, remboursements à contester, fermetures et écarts de prix avec Uber Eats.',
    h1: 'Intégration Deliveroo : ce que Deliview fait avec votre compte',
    lead: 'Les mêmes analyses que sur Uber Eats. En plus, les écarts de prix entre vos deux cartes, plat par plat.',
    etapesTitre: 'Connecter votre compte Deliveroo',
    etapes: [
      { titre: 'Copiez l’adresse de Deliview', texte: 'À votre première connexion, Deliview vous donne l’adresse e-mail à inviter, avec un lien vers le Partner Hub de Deliveroo.' },
      { titre: 'Invitez-la dans votre équipe', texte: 'Dans le Partner Hub, invitez un membre depuis la gestion de l’équipe : cette adresse, le rôle Administrateur et vos restaurants.' },
      { titre: 'Vos ventes Deliveroo arrivent', texte: 'Deliview les ajoute chaque jour à 7 h. Votre mot de passe reste à vous, et vous retirez l’accès quand vous voulez.' },
    ],
    faq: [
      {
        q: 'Faut-il donner mon mot de passe Deliveroo ?',
        r: 'Non. Vous invitez Deliview comme membre de votre équipe dans le Partner Hub de Deliveroo, avec le rôle Administrateur. Vous retirez cet accès quand vous voulez, depuis le Partner Hub.',
      },
      {
        q: 'Combien de temps ai-je pour contester un remboursement Deliveroo ?',
        r: 'Jusqu’à 7&nbsp;jours après le remboursement, le délai le plus court des deux plateformes. Deliview vous montre d’abord les remboursements les plus pressés. Avec l’offre Autonomie, vous contestez en un clic&nbsp;; avec Délégation, Deliview conteste pour vous.',
      },
      {
        q: 'Mes prix ne sont pas les mêmes sur Deliveroo et sur Uber Eats. Est-ce que Deliview le voit ?',
        r: 'Oui. Deliview liste les plats à prix différent sur vos deux cartes, avec les deux prix. À vous de voir lesquels sont voulus.',
      },
    ],
  },
};
const c = CONTENU[slug];
---

<Base
  title={c.title}
  description={c.description}
  ariane={[
    { nom: 'Intégrations', chemin: '/integrations/' },
    { nom: p.nom, chemin: `/integrations/${p.slug}/` },
  ]}
  jsonld={[jsonldLogiciel(c.description, `${SITE.url}/integrations/${p.slug}/`)]}
>
  <section class="overflow-hidden bg-grey pb-14 pt-6 md:pb-[104px] md:pt-10" aria-labelledby="plateforme-titre" data-haut-de-page>
    <div class="dv-container grid items-center gap-x-12 gap-y-8 lg:grid-cols-[1.1fr_1fr]">
      <div>
        <Pastille>Intégration</Pastille>
        <h1 id="plateforme-titre" class="dv-h1 mt-5 max-w-[20ch] md:mt-6">{c.h1}</h1>
        <p class="dv-lead mt-4 max-w-[60ch] md:mt-6">{c.lead}</p>
        <div class="mt-7 md:mt-8">
          <BoutonDemo href="#demo" cta={`integration-${p.slug}`} principal class="w-full sm:w-auto" />
        </div>
      </div>
      <div class="w-full">
        <FragmentFlottant fragment={FRAGMENTS[p.slug]} priorite class="mx-auto max-w-[520px]" sizes="(min-width: 1024px) 440px, 84vw">
          <span slot="puce" class="dv-puce"><i></i>{p.nom}</span>
        </FragmentFlottant>
      </div>
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="perimetre-titre">
    <div class="dv-container">
      <h2 id="perimetre-titre" class="dv-h2 max-w-[24ch]">Ce que Deliview fait avec {p.nom}</h2>
      <div class="dv-card mt-8 max-w-[680px] px-6 pb-6 pt-5 md:mt-10 md:px-8 md:pb-8 md:pt-6" data-apparition="">
        <p class="dv-ticket-entete"><span>Avec Deliview</span><span>{p.nom}</span></p>
        <ul class="mt-4 grid gap-3">
          {p.disponible.map((x) => (
            <li class="flex gap-2.5">
              <Coche taille={24} />
              <span>{x}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  {
    c.etapes && (
      <section class="dv-section bg-grey dv-points" aria-labelledby="demarrer-titre">
        <div class="dv-container">
          <h2 id="demarrer-titre" class="dv-h2">{c.etapesTitre}</h2>
          <ol class="dv-etapes mt-8 grid gap-5 md:mt-10 md:grid-cols-3 md:gap-6">
            {c.etapes.map((e, i) => {
              const Icone = [Enveloppe, Cadenas, Courbe][i];
              return (
                <li class="dv-relief dv-etape" data-apparition="">
                  <p class="flex items-center justify-between">
                    <span class="dv-tuile dv-tuile-numero" aria-hidden="true">
                      {i + 1}
                    </span>
                    {Icone && <Icone taille={48} />}
                  </p>
                  <h3 class="mt-5 font-accent text-[20px] font-bold leading-[1.25] md:mt-6 md:text-[24px]">{e.titre}</h3>
                  <p class="mt-2 dv-muted">{e.texte}</p>
                </li>
              );
            })}
          </ol>
        </div>
      </section>
    )
  }

  <Faq questions={c.faq} titre={`Questions sur l’intégration ${p.nom}`} fond="blanc" />

  <section class="dv-section bg-grey dv-points" aria-labelledby="autres-integrations">
    <div class="dv-container">
      <h2 id="autres-integrations" class="dv-h2">Les autres intégrations</h2>
      <ul class="mt-8 grid gap-6 md:grid-cols-2">
        {
          autres.map((x) => (
            <li class="dv-card dv-carte-lien flex flex-col p-6 md:p-7">
              <p class="font-accent text-[22px] font-bold">{x.nom}</p>
              <p class="mt-3 flex-1 dv-muted">{x.resume}</p>
              <a href={lien(`/integrations/${x.slug}/`)} class="dv-lien-fort dv-etire mt-3 self-start">
                Voir {x.nom}<Fleche taille={24} />
              </a>
            </li>
          ))
        }
        <li class="dv-card dv-carte-lien flex flex-col p-6 md:p-7">
          <p class="font-accent text-[22px] font-bold">Uber Eats et Deliveroo côte à côte</p>
          <p class="mt-3 flex-1 dv-muted">Vos deux cartes côte à côte. Les écarts de prix, vos concurrents et votre note.</p>
          <a href={lien('/integrations/uber-eats-et-deliveroo/')} class="dv-lien-fort dv-etire mt-3 self-start">
            Voir les deux côte à côte<Fleche taille={24} />
          </a>
        </li>
      </ul>
      <p class="mt-8 text-[15px] dv-muted">Uber Eats et Deliveroo sont des marques de leurs propriétaires respectifs. Deliview est un logiciel indépendant qui regroupe vos plateformes de livraison.</p>
    </div>
  </section>

  <SectionDemo section={`integration-${p.slug}-formulaire`} />
</Base>
