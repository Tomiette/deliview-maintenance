---
// Ligne de réassurance, sous le bouton principal du haut de page : trois petites icônes dessinées de 24 px.
import CadenasOuvert from '../icons/cadenas-ouvert.astro';
import Toque from '../icons/toque.astro';
import EtiquettePrix from '../icons/etiquette-prix.astro';
import { PRIX_ENTREE } from '../lib/site';

interface Props {
  centre?: boolean;
  class?: string;
}
const { centre = false, class: classe = '' } = Astro.props;
---

<ul class={`flex flex-wrap gap-x-6 gap-y-2.5 text-[15px] font-semibold leading-[1.3] md:text-[16px] ${centre ? 'justify-center' : ''} ${classe}`}>
  <li class="flex items-center gap-2"><CadenasOuvert taille={24} />Sans engagement</li>
  <li class="flex items-center gap-2"><Toque taille={24} />Mise en place offerte</li>
  <li class="flex items-center gap-2"><EtiquettePrix taille={24} />Dès {PRIX_ENTREE}&nbsp;€&nbsp;HT par mois</li>
</ul>
