---
// Parrainage (4 octobre 2026, décision de Tom) : 2 restaurateurs parrainés = 1 mois offert au parrain. Un filleul compte
// quand il a payé son premier mois. Le parrain crée son lien (?par=Prénom, restaurant) et le partage ; le filleul arrive
// sur cette page, son formulaire est prérempli avec le parrain, et la fonction « lead » range le parrain dans les notes
// de la demande. Tom retire lui-même le mois offert de la facture suivante du parrain.
// Mise en page reprise de la logique de taap.it (curseur de gain, 3 étapes, conditions), contenu propre à Deliview.
import Base from '../../layouts/Base.astro';
import Pastille from '../../components/Pastille.astro';
import SectionDemo from '../../components/SectionDemo.astro';
import Faq from '../../components/Faq.astro';
import { OFFRES, SITE, lien } from '../../lib/site';

const PAR_MOIS = 2;
const pro = OFFRES.find((o) => o.slug === 'pro') ?? OFFRES[0];
const description =
  'Clients Deliview : recommandez Deliview à 2 restaurateurs et gagnez 1 mois d’abonnement offert. Sans limite : 4 parrainages, 2 mois offerts.';
const etapes = [
  { titre: 'Créez votre lien', texte: 'Votre prénom et votre restaurant, c’est tout. Le lien est prêt en 10 secondes.' },
  { titre: 'Partagez-le', texte: 'Par WhatsApp, par SMS, ou de vive voix à un restaurateur que vous connaissez. Il demande sa démo depuis votre lien.' },
  { titre: 'Votre mois est offert', texte: 'Dès que 2 de vos filleuls ont payé leur premier mois, Tom retire un mois de votre prochaine facture.' },
];
const faq = [
  { q: 'Qui peut parrainer ?', r: 'Tout restaurateur client de Deliview, avec un abonnement payant en cours.' },
  {
    q: 'Quand un filleul compte-t-il ?',
    r: 'Quand il a payé son premier mois. Il doit être un nouveau client&nbsp;: un restaurateur déjà abonné à Deliview ne compte pas.',
  },
  { q: 'Y a-t-il une limite ?', r: 'Non. 2 filleuls, 1 mois offert&nbsp;; 4 filleuls, 2 mois offerts&nbsp;; et ainsi de suite.' },
  { q: 'Comment le mois m’est-il offert ?', r: 'Tom le retire de votre prochaine facture, sur votre offre actuelle. Vous n’avez rien à demander.' },
  {
    q: 'Mon filleul a oublié d’utiliser mon lien.',
    r: `Écrivez à Tom (<a href="mailto:${SITE.email}">${SITE.email}</a>) avec le nom de son restaurant&nbsp;: il le rattache à votre parrainage.`,
  },
  { q: 'Puis-je être payé en argent ?', r: 'Non. Le parrainage donne des mois d’abonnement offerts, pas de versement.' },
];
const erreurs = [
  { id: 'erreur-champs', texte: 'Un champ est incomplet. Vérifiez vos informations, puis renvoyez le formulaire.' },
  { id: 'erreur-limite', texte: `Trop de demandes sont parties de cette connexion. Écrivez à Tom : ${SITE.email}.` },
  { id: 'erreur-serveur', texte: `Votre demande n’a pas pu être enregistrée. Écrivez à Tom : ${SITE.email}.` },
];
const pageUrl = SITE.url + '/parrainage/';
---

<Base title="Parrainage : 2 restaurateurs, 1 mois offert | Deliview" description={description} ariane={[{ nom: 'Parrainage', chemin: '/parrainage/' }]} fondHaut="blanc">
  {
    erreurs.map((e) => (
      <div id={e.id} class="dv-erreur-ancre dv-container pt-6" role="alert">
        <p class="rounded-[12px] border-2 border-grey-2 bg-grey p-4 font-semibold">
          <span class="dv-erreur block">{e.texte}</span>
        </p>
      </div>
    ))
  }

  <!-- Haut de page : l'offre et le curseur (mise en page de taap.it : titre centré, colonnes en fond, curseur pleine
       largeur avec la bulle sous le bouton du curseur et le gain en grand à droite) -->
  <section class="dv-parr-hero overflow-x-clip pb-16 pt-6 md:pb-[104px] md:pt-12" aria-labelledby="parrainage-titre" data-haut-de-page>
    <div class="dv-container max-w-[1100px] text-center">
      <h1 id="parrainage-titre" class="dv-h1 mx-auto max-w-[20ch]">
        <span class="text-blue">2&nbsp;parrainages</span> = 1&nbsp;mois offert.<br class="hidden sm:block" /> Sans limite.
      </h1>
      <p class="dv-lead mx-auto mt-4 max-w-[34ch] md:mt-5">
        Vos amis restaurateurs. Notre produit. Un mois d’abonnement offert tous les 2&nbsp;filleuls abonnés.
      </p>
      <a href="#lien" class="dv-btn-sombre mt-7 md:mt-8">Créer mon lien de parrainage</a>

      <div class="dv-parr-calcul mt-12 md:mt-16">
        <div class="dv-parr-piste">
          <label for="parr-nombre" class="sr-only">Nombre de restaurateurs parrainés</label>
          <input id="parr-nombre" type="range" min="0" max="20" step="1" value="10" class="dv-parr-curseur w-full" aria-describedby="parr-resultat" />
          <output for="parr-nombre" class="dv-parr-bulle" aria-hidden="true" data-parr-bulle><span id="parr-nombre-valeur">10</span>&nbsp;parrainages</output>
        </div>
        <div id="parr-resultat" class="dv-parr-gain" aria-live="polite">
          <p class="dv-parr-chiffre"><span data-parr-mois>5</span>&nbsp;mois</p>
          <p class="dv-parr-sous">offerts</p>
          <p class="mt-1 text-[15px] leading-[1.4] dv-muted">soit <strong class="font-chiffres font-semibold text-grey-2" data-parr-euros>{5 * pro.prix}&nbsp;€</strong> HT en offre {pro.nom}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Comment ça marche -->
  <section class="dv-section bg-white" aria-labelledby="parr-etapes-titre">
    <div class="dv-container">
      <div class="text-center">
        <Pastille>Comment ça marche</Pastille>
        <h2 id="parr-etapes-titre" class="dv-h2 mx-auto mt-4 max-w-[22ch] md:mt-5">Trois étapes, aucune démarche de votre côté</h2>
      </div>
      <ol class="mt-10 grid gap-5 md:mt-12 md:grid-cols-3 md:gap-6">
        {
          etapes.map((e, i) => (
            <li class="dv-relief px-6 pb-7 pt-6 md:px-7">
              <span class="dv-tuile dv-tuile-numero" aria-hidden="true">{i + 1}</span>
              <h3 class="mt-5 font-accent text-[20px] font-bold leading-[1.3] md:text-[22px]">{e.titre}</h3>
              <p class="mt-2 text-[16px] leading-[1.55] dv-muted md:text-[17px]">{e.texte}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Créer son lien -->
  <section id="lien" class="dv-section bg-grey" aria-labelledby="parr-lien-titre">
    <div class="dv-container max-w-[760px]">
      <div class="text-center">
        <Pastille>Votre lien</Pastille>
        <h2 id="parr-lien-titre" class="dv-h2 mx-auto mt-4 max-w-[22ch] md:mt-5">Créez votre lien de parrainage</h2>
        <p class="dv-lead mx-auto mt-4 max-w-[48ch]">Votre filleul verra votre nom en demandant sa démo. C’est ainsi que Tom sait qu’il vient de vous.</p>
      </div>
      <div class="dv-relief mt-8 px-5 py-7 sm:px-8 md:mt-10 md:px-10 md:py-9">
        <label for="parr-qui" class="block text-[16px] font-semibold leading-[1.3]">Votre prénom et votre restaurant</label>
        <input id="parr-qui" type="text" maxlength="160" autocomplete="off" placeholder="Exemple : Karim, Burger Factory Lyon" class="dv-champ mt-2 placeholder:text-grey-2/70" aria-describedby="parr-qui-aide" />
        <p id="parr-qui-aide" class="mt-2 text-[15px] leading-[1.4] dv-muted">Vous êtes client de Deliview&nbsp;: indiquez le nom sous lequel Tom vous connaît.</p>

        <div class="mt-6" data-parr-sortie hidden>
          <p class="block text-[16px] font-semibold leading-[1.3]" id="parr-lien-libelle">Votre lien</p>
          <p class="dv-parr-lien mt-2" aria-labelledby="parr-lien-libelle"><span data-parr-lien></span></p>
          <div class="mt-4 grid gap-3 sm:grid-cols-2">
            <button type="button" class="dv-btn dv-btn-plein w-full" data-parr-copier>Copier le lien</button>
            <a href="#" class="dv-btn dv-btn-contour w-full" target="_blank" rel="noopener" data-parr-whatsapp>Envoyer par WhatsApp<span class="sr-only"> (nouvel onglet)</span></a>
          </div>
          <p class="mt-3 min-h-[1.5em] text-[15px] font-semibold" role="status" data-parr-statut></p>
        </div>
      </div>
    </div>
  </section>

  <Faq questions={faq} titre="Les conditions" fond="blanc" />

  <SectionDemo
    section="page-parrainage"
    variante="parrainage"
    id="demo"
    surtitre="Vous êtes recommandé"
    titre="Un restaurateur vous a parlé de Deliview ?"
    sousTitre={'Demandez votre démo gratuite de 30 minutes. Indiquez qui vous recommande : c’est ce qui lui offre son mois.'}
  />
</Base>

<script define:vars={{ PAR_MOIS, prixPro: pro.prix, pageUrl }}>
  // Curseur : mois offerts = parrainages ÷ 2 (arrondi en dessous), et leur valeur sur l'offre Pro.
  const curseur = document.getElementById('parr-nombre');
  const valeur = document.getElementById('parr-nombre-valeur');
  const mois = document.querySelector('[data-parr-mois]');
  const euros = document.querySelector('[data-parr-euros]');
  const bulle = document.querySelector('[data-parr-bulle]');
  const nf = new Intl.NumberFormat('fr-FR');
  function majCurseur() {
    const n = Number(curseur.value);
    const m = Math.floor(n / PAR_MOIS);
    valeur.textContent = String(n);
    mois.textContent = String(m);
    euros.textContent = nf.format(m * prixPro) + ' €';
    const pct = (n / Number(curseur.max)) * 100;
    curseur.style.setProperty('--parr-rempli', pct + '%');
    bulle.lastChild.textContent = n > 1 ? '\u00a0parrainages' : '\u00a0parrainage';
    placerBulle();
    curseur.setAttribute('aria-valuetext', n + ' restaurateurs parrainés, ' + m + ' mois offerts');
  }
  // La bulle suit le bouton du curseur (32 px de large), sans jamais sortir de la piste.
  function placerBulle() {
    const w = curseur.clientWidth;
    const bw = bulle.offsetWidth;
    const x = 16 + (Number(curseur.value) / Number(curseur.max)) * (w - 32);
    bulle.style.left = Math.min(Math.max(x, bw / 2), w - bw / 2) + 'px';
  }
  addEventListener('resize', placerBulle);
  curseur.addEventListener('input', majCurseur);
  majCurseur();

  // Lien de parrainage : adresse de cette page avec ?par=…, renvoie au formulaire de démo.
  const qui = document.getElementById('parr-qui');
  const sortie = document.querySelector('[data-parr-sortie]');
  const lienTexte = document.querySelector('[data-parr-lien]');
  const copier = document.querySelector('[data-parr-copier]');
  const whatsapp = document.querySelector('[data-parr-whatsapp]');
  const statut = document.querySelector('[data-parr-statut]');
  let lienActuel = '';
  function majLien() {
    const v = qui.value.replace(/\s+/g, ' ').trim().slice(0, 160);
    sortie.hidden = v.length < 2;
    statut.textContent = '';
    if (v.length < 2) return;
    lienActuel = pageUrl + '?par=' + encodeURIComponent(v) + '#demo';
    lienTexte.textContent = lienActuel;
    const message = 'J’utilise Deliview pour mes prix et mes promos sur Uber Eats et Deliveroo. Demande ta démo gratuite avec mon lien : ' + lienActuel;
    whatsapp.href = 'https://wa.me/?text=' + encodeURIComponent(message);
  }
  qui.addEventListener('input', majLien);
  copier.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(lienActuel);
      statut.textContent = 'Lien copié. Collez-le dans un SMS ou un message.';
    } catch {
      const r = document.createRange();
      r.selectNodeContents(lienTexte);
      const s = getSelection();
      s.removeAllRanges();
      s.addRange(r);
      statut.textContent = 'Le lien est sélectionné : copiez-le avec votre appareil.';
    }
  });
</script>

<style>
  /* Fond du haut : colonnes fines (Gris 2 à 8 %) sur un dégradé blanc vers gris, comme taap.it, aux couleurs de la charte. */
  .dv-parr-hero {
    background-color: var(--color-grey);
    background-image:
      linear-gradient(to bottom, var(--color-white), color-mix(in srgb, var(--color-white) 0%, transparent) 70%),
      repeating-linear-gradient(to right, color-mix(in srgb, var(--color-grey-2) 8%, transparent) 0 1px, transparent 1px 176px);
    background-position: center top;
    border-bottom: 1px solid var(--dv-bord);
  }
  .dv-parr-calcul {
    display: grid;
    gap: 40px;
    align-items: center;
    text-align: left;
  }
  @media (min-width: 768px) {
    .dv-parr-calcul {
      grid-template-columns: 1fr auto;
      gap: 64px;
    }
  }
  .dv-parr-piste {
    position: relative;
    padding-bottom: 56px;
  }
  .dv-parr-bulle {
    position: absolute;
    top: 44px;
    transform: translateX(-50%);
    padding: 8px 12px;
    border: 1px solid var(--dv-bord);
    border-radius: 10px;
    background: var(--color-white);
    box-shadow: 0 4px 16px color-mix(in srgb, var(--color-grey-2) 10%, transparent);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    color: var(--color-grey-2);
  }
  .dv-parr-bulle span {
    font-family: var(--font-chiffres);
    font-weight: 700;
  }
  .dv-parr-gain {
    text-align: center;
  }
  @media (min-width: 768px) {
    .dv-parr-gain {
      min-width: 220px;
      text-align: left;
    }
  }
  .dv-parr-chiffre {
    font-family: var(--font-chiffres);
    font-size: 56px;
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--color-blue);
  }
  @media (min-width: 768px) {
    .dv-parr-chiffre {
      font-size: 64px;
    }
  }
  .dv-parr-sous {
    margin-top: 6px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.2;
  }
  .dv-parr-curseur {
    --parr-rempli: 50%;
    display: block;
    appearance: none;
    height: 44px;
    background: transparent;
    cursor: pointer;
  }
  .dv-parr-curseur::-webkit-slider-runnable-track {
    height: 16px;
    border-radius: 999px;
    background: linear-gradient(to right, var(--color-blue) var(--parr-rempli), var(--color-white) var(--parr-rempli));
    box-shadow: inset 0 0 0 1px var(--dv-bord);
  }
  .dv-parr-curseur::-moz-range-track {
    height: 16px;
    border-radius: 999px;
    background: var(--color-white);
    box-shadow: inset 0 0 0 1px var(--dv-bord);
  }
  .dv-parr-curseur::-moz-range-progress {
    height: 16px;
    border-radius: 999px;
    background: var(--color-blue);
  }
  .dv-parr-curseur::-webkit-slider-thumb {
    appearance: none;
    width: 32px;
    height: 32px;
    margin-top: -8px;
    border: 4px solid var(--color-blue);
    border-radius: 50%;
    background: var(--color-white);
  }
  .dv-parr-curseur::-moz-range-thumb {
    box-sizing: border-box;
    width: 32px;
    height: 32px;
    border: 4px solid var(--color-blue);
    border-radius: 50%;
    background: var(--color-white);
  }
  .dv-parr-curseur:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 4px;
  }
  .dv-parr-lien {
    padding: 14px 16px;
    border: 1px dashed var(--dv-bord);
    border-radius: 12px;
    background: var(--color-grey);
    font-size: 15px;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }
</style>
