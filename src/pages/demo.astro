---
// Page Démo : cible de tous les boutons hors accueil (direction « le passe ») : le formulaire en bon de démo à gauche,
// « Ce qui se passe ensuite » en 3 étapes et la photo de Tom à droite. Messages d'erreur sans JavaScript via #erreur-… (:target).
import Base from '../layouts/Base.astro';
import SectionDemo from '../components/SectionDemo.astro';
import Faq from '../components/Faq.astro';
import { PRIX_ENTREE, SITE, lien } from '../lib/site';

const description =
  'Une démo de 15 minutes sur votre restaurant : vos prix, vos concurrents, votre note. Tom vous rappelle sous 24 h.';

const faq = [
  {
    q: 'La démo est-elle vraiment faite sur mon restaurant ?',
    r: 'Oui. Tom prépare la démo sur votre restaurant. Vous voyez vos prix face à ceux de votre zone, pas un exemple.',
  },
  {
    q: 'Dois-je préparer quelque chose ?',
    r: 'Non. Le nom et la ville de votre restaurant suffisent.',
  },
  {
    q: 'Deliview remplace-t-il mes tablettes Uber Eats et Deliveroo ?',
    r: 'Non. Deliview centralise vos prix, vos notes et ceux de vos concurrents. Vos tablettes restent là pour recevoir les commandes.',
  },
  {
    q: 'Combien coûte Deliview ?',
    r: `Dès ${PRIX_ENTREE}&nbsp;€ HT par mois, sans engagement. La mise en place est offerte. Le détail est sur la page <a href="${lien('/tarifs/')}">Tarifs</a>.`,
  },
];
const erreurs = [
  { id: 'erreur-champs', texte: 'Un champ est incomplet. Vérifiez vos informations, puis renvoyez le formulaire.' },
  { id: 'erreur-limite', texte: `Trop de demandes sont parties de cette connexion. Écrivez à Tom : ${SITE.email}.` },
  { id: 'erreur-serveur', texte: `Votre demande n’a pas pu être enregistrée. Écrivez à Tom : ${SITE.email}.` },
];
---

<Base title="Demander une démo gratuite de 15 minutes | Deliview" description={description} ariane={[{ nom: 'Demander une démo', chemin: '/demo/' }]} fondHaut="blanc">
  {
    erreurs.map((e) => (
      <div id={e.id} class="dv-erreur-ancre dv-container pt-6" role="alert">
        <p class="rounded-[12px] border-2 border-grey-2 bg-grey p-4 font-semibold"><span class="dv-erreur block">{e.texte}</span></p>
      </div>
    ))
  }
  <SectionDemo
    section="page-demo"
    niveau="h1"
    titre="Demander une démo de Deliview"
    sousTitre="15 minutes sur votre restaurant : vos prix, vos concurrents, votre note. Tom vous rappelle sous 24 h."
  />
  <Faq questions={faq} titre="Avant la démo" fond="gris" />
</Base>
