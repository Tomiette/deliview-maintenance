---
// Tarifs (maquette « le passe » validée le 2 octobre 2026) : 3 abonnements selon le nombre de restaurants (OFFRES dans
// src/lib/site.ts), présentés comme trois tickets côte à côte (empilés sur téléphone), Pro mis en avant par un trait
// de marqueur « Recommandé », tableau comparatif, lien vers le simulateur, questions (FAQPage), bandeau final.
// Uniquement ce que Deliview fait aujourd'hui.
import Base from '../layouts/Base.astro';
import Ticket from '../components/Ticket.astro';
import Marqueur from '../components/Marqueur.astro';
import Reassurance from '../components/Reassurance.astro';
import Faq from '../components/Faq.astro';
import Coche from '../icons/coche.astro';
import Pieces from '../icons/pieces.astro';
import Enveloppe from '../icons/enveloppe.astro';
import { OFFRES, PRIX_ENTREE, SITE, jsonldLogiciel, lien } from '../lib/site';

const description = `Trois offres selon votre nombre de restaurants, dès ${PRIX_ENTREE} € HT par mois : sans engagement, mise en place offerte. Comparez Essentiel, Pro et Premium.`;

type Case = 'oui' | 'non' | string;
const comparatif: { libelle: string; valeurs: [Case, Case, Case] }[] = [
  { libelle: 'Restaurants inclus', valeurs: ['1', 'Jusqu’à 5', 'Jusqu’à 10'] },
  { libelle: 'Vos données Uber Eats et Deliveroo sur un seul écran', valeurs: ['oui', 'oui', 'oui'] },
  { libelle: 'Concurrents analysés par restaurant', valeurs: ['Jusqu’à 20', 'Jusqu’à 20', 'Jusqu’à 20'] },
  { libelle: 'Concurrents de votre choix suivis', valeurs: ['non', '3 par restaurant', '3 par restaurant'] },
  { libelle: 'Pricing Menu : chaque plat comparé, prix proposé avec ses sources', valeurs: ['oui', 'oui', 'oui'] },
  { libelle: 'Optimiseur menu : photos et descriptions passées en revue', valeurs: ['oui', 'oui', 'oui'] },
  { libelle: 'Promos des concurrents et classement des notes', valeurs: ['oui', 'oui', 'oui'] },
  { libelle: 'Changements depuis la dernière analyse', valeurs: ['oui', 'oui', 'oui'] },
  { libelle: 'Analyses', valeurs: ['1 par semaine', 'À la demande', 'À la demande'] },
  { libelle: 'Assistant Deliview', valeurs: ['non', 'oui', 'oui'] },
  { libelle: 'Historique des décisions de prix', valeurs: ['non', 'oui', 'oui'] },
  { libelle: 'Accès pour votre équipe', valeurs: ['2', '10', 'Illimités'] },
  { libelle: 'Un point chaque mois avec Tom', valeurs: ['non', 'non', 'oui'] },
  { libelle: 'Mise en place avec Tom', valeurs: ['Offerte', 'Offerte', 'Offerte'] },
  { libelle: 'Engagement', valeurs: ['Aucun', 'Aucun', 'Aucun'] },
];

const faq = [
  {
    q: 'Y a-t-il un engagement ?',
    r: 'Non. L’abonnement est mensuel et sans engagement&nbsp;: vous arrêtez quand vous voulez.',
  },
  {
    q: 'La mise en place est-elle payante ?',
    r: 'Non, elle est offerte. Tom crée votre compte avec vous et vous montre comment lire les résultats. Rien à installer&nbsp;: Deliview s’ouvre dans le navigateur.',
  },
  {
    q: 'J’ai un seul restaurant : puis-je choisir Pro ou Premium ?',
    r: 'Oui. Le nombre de restaurants de chaque offre est un maximum, pas un minimum. Vous pouvez changer d’offre à tout moment.',
  },
  {
    q: 'Deliview remplace-t-il mes tablettes Uber Eats et Deliveroo ?',
    r: 'Non. Deliview centralise vos prix, vos notes et ceux de vos concurrents. Vos tablettes restent là pour recevoir les commandes.',
  },
  {
    q: 'J’ai plus de 10 restaurants.',
    r: `Tom vous fait une offre sur mesure. Écrivez-lui à <a href="mailto:${SITE.email}">${SITE.email}</a> ou demandez une démo.`,
  },
  {
    q: 'Où sont hébergées mes données ?',
    r: 'Dans l’Union européenne&nbsp;: la base de données de Deliview est hébergée en Irlande. Le détail est dans notre <a href="' + lien('/confidentialite/') + '">politique de confidentialité</a>.',
  },
];

const texteBrut = (h: string) => h.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ');
const faqPage = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((x) => ({ '@type': 'Question', name: x.q, acceptedAnswer: { '@type': 'Answer', text: texteBrut(x.r) } })),
};
const logiciel = {
  ...jsonldLogiciel(SITE.definition, SITE.url + '/tarifs/'),
  offers: OFFRES.map((o) => ({
    '@type': 'Offer',
    name: `Deliview ${o.nom}`,
    description: `${o.restaurants}. ${o.pour}.`,
    price: o.prix.toFixed(2),
    priceCurrency: 'EUR',
    url: `${SITE.url}/tarifs/#${o.slug}`,
    priceSpecification: {
      '@type': 'UnitPriceSpecification',
      price: o.prix,
      priceCurrency: 'EUR',
      unitText: 'mois',
      valueAddedTaxIncluded: false,
    },
  })),
};
---

<Base title="Tarifs : 3 offres selon vos restaurants | Deliview" description={description} ariane={[{ nom: 'Tarifs', chemin: '/tarifs/' }]} jsonld={[logiciel, faqPage]}>
  <section id="offres" class="bg-grey pb-16 pt-8 md:pb-[104px] md:pt-12" aria-labelledby="tarifs-titre" data-haut-de-page>
    <div class="dv-container">
      <div class="text-center">
        <p class="dv-overline">Tarifs</p>
        <h1 id="tarifs-titre" class="dv-h1 mx-auto mt-3 max-w-[20ch] md:mt-4">Un prix clair, selon le nombre de vos restaurants</h1>
        <p class="dv-lead mx-auto mt-4 max-w-[52ch] md:mt-5">Trois offres, selon le nombre de restaurants que vous suivez. Les prix sont HT, par mois.</p>
        <Reassurance centre class="mt-5 md:mt-[22px]" />
      </div>

      <ul class="mt-16 grid items-stretch gap-14 md:mt-[104px] lg:grid-cols-3 lg:gap-8">
        {
          OFFRES.map((o) => (
            <li id={o.slug} class={`relative flex scroll-mt-32 flex-col ${o.recommandee ? 'mt-14 lg:mt-0' : ''}`}>
              {o.recommandee && (
                <>
                  <p class="dv-annotation absolute -top-[70px] right-3 -rotate-3" aria-hidden="true">Recommandé</p>
                  <Marqueur forme="fleche" class="dv-tarifs-fleche" />
                </>
              )}
              <Ticket class="flex flex-1 flex-col" papier="flex flex-1 flex-col px-6 pb-7 pt-6 md:px-7 md:pb-[30px] md:pt-[26px]">
                <h2 class="font-accent text-[26px] font-bold leading-[1.2] md:text-[28px]">
                  {o.nom}
                  {o.recommandee && <span class="sr-only">, offre recommandée</span>}
                </h2>
                <p class="mt-1.5 text-[16px] font-semibold leading-[1.4]">{o.restaurants}</p>
                <p class="mt-1 text-[16px] leading-[1.5] dv-muted lg:min-h-[48px]">{o.pour}.</p>
                <div class="dv-pointilles my-[18px]" aria-hidden="true" />
                <p class="flex items-baseline gap-2">
                  <span class="font-accent text-[44px] font-bold leading-none md:text-[52px]">{o.prix}&nbsp;€</span>
                  <span class="text-[16px] leading-[1.3]">HT par mois</span>
                </p>
                <a
                  href={lien('/demo/')}
                  class={`dv-btn mt-6 w-full ${o.recommandee ? 'dv-btn-plein' : 'dv-btn-contour'}`}
                  data-cta={`tarifs-${o.slug}`}
                  {...(o.recommandee ? { 'data-cta-principal': '' } : {})}
                >
                  Choisir {o.nom}
                </a>
                <div class="dv-pointilles mt-6" aria-hidden="true" />
                {o.base && <p class="mt-5 text-[16px] font-bold leading-[1.4]">{o.base.replace(' :', ' :')}</p>}
                <ul class={`${o.base ? 'mt-3' : 'mt-5'} grid gap-3 text-[16px] leading-[1.5]`}>
                  {o.inclus.map((x) => (
                    <li class="flex gap-2.5">
                      <Coche taille={24} />
                      <span>{x}</span>
                    </li>
                  ))}
                </ul>
              </Ticket>
            </li>
          ))
        }
      </ul>

      <div class="dv-card mt-12 flex flex-col gap-5 p-6 md:flex-row md:items-center md:justify-between md:gap-8 md:px-7">
        <p class="flex items-center gap-4 text-[17px] font-semibold leading-[1.45] md:text-[18px]">
          <Pieces taille={48} />
          <span>Plus de 10&nbsp;restaurants&nbsp;? Tom vous fait une offre sur mesure&nbsp;: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</span>
        </p>
        <a href={lien('/simulateur/')} class="dv-btn dv-btn-contour shrink-0" data-cta="tarifs-simulateur">Combien vous rapporte un prix bien placé&nbsp;?</a>
      </div>
      <p class="mt-5 text-center text-[14px] dv-muted">
        Prix HT. Abonnement soumis aux <a href={lien('/cgv/')}>conditions générales de vente</a>.
      </p>
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="comparatif-titre">
    <div class="dv-container">
      <h2 id="comparatif-titre" class="dv-h2">Comparer les offres</h2>
      <div class="relative mt-8 overflow-x-auto rounded-[16px] border border-grey-2/15 md:mt-9" tabindex="0" role="region" aria-label="Comparatif des offres, défile horizontalement">
        <table class="w-full min-w-[680px] border-collapse text-[16px] leading-[1.45] tabular-nums" aria-labelledby="comparatif-titre">
          <thead class="bg-grey">
            <tr>
              <th scope="col" class="px-6 py-[18px] text-left font-bold">Ce qui est inclus</th>
              {OFFRES.map((o) => (
                <th scope="col" class={`w-[200px] px-4 py-[18px] text-center font-accent text-[20px] font-bold leading-[1.2] ${o.recommandee ? 'bg-blue/10' : ''}`}>
                  {o.nom}
                  <span class="mt-1 block font-sans text-[15px] font-normal">{o.prix}&nbsp;€&nbsp;HT</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {
              comparatif.map((l) => (
                <tr class="border-t border-grey-2/12">
                  <th scope="row" class="px-6 py-4 text-left font-normal">{l.libelle}</th>
                  {l.valeurs.map((c, i) => (
                    <td class={`px-4 py-4 text-center ${OFFRES[i].recommandee ? 'bg-blue/10' : ''}`}>
                      {c === 'oui' ? (
                        <span class="inline-flex justify-center">
                          <Coche taille={24} />
                          <span class="sr-only">Inclus</span>
                        </span>
                      ) : c === 'non' ? (
                        <span>
                          <span aria-hidden="true">—</span>
                          <span class="sr-only">Non inclus</span>
                        </span>
                      ) : (
                        <span>{c}</span>
                      )}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <Faq questions={faq} titre="Avant de choisir une offre" />

  <section id="demo" class="dv-section bg-white" aria-labelledby="final-titre">
    <div class="dv-container max-w-[760px] text-center">
      <Enveloppe taille={48} class="mx-auto" />
      <h2 id="final-titre" class="dv-h2 mt-4">Voyez d’abord ce que vos prix peuvent vous rapporter</h2>
      <p class="dv-lead mt-4">15&nbsp;minutes avec Tom, sur votre restaurant, avant tout paiement.</p>
      <a href={lien('/demo/')} class="dv-btn dv-btn-plein mt-7 w-full sm:w-auto sm:px-7" data-cta="tarifs-final" data-cta-principal>Demander une démo</a>
    </div>
  </section>
</Base>
