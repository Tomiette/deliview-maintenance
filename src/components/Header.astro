---
// En-tête collant : logo, navigation (méga-menus « Notre solution » et « Ressources »), connexion en bouton contour,
// bouton démo plein. Plus de barre d'annonce ni de simulateur en haut du site (décision de Tom, 2 octobre 2026).
// Menus en <details> : utilisables sans JavaScript et au clavier ; Échap les ferme (script ci-dessous).
import Icone from './Icone.astro';
import { MENU_RESSOURCES, NAV, PILIERS, SITE, lien } from '../lib/site';

const MENUS: Record<string, { href: string; titre: string; phrase: string; icone?: (typeof PILIERS)[number]['icone'] }[]> = {
  solution: PILIERS.map((p) => ({ href: `/solution/${p.slug}/`, titre: p.surtitre, phrase: p.phrase, icone: p.icone })),
  ressources: MENU_RESSOURCES.map((r) => ({ href: r.href, titre: r.libelle, phrase: r.phrase })),
};
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-grey-2/15">
  <div class="dv-container flex h-[72px] items-center justify-between gap-4">
    <a href={lien('/')} class="shrink-0" aria-label="Deliview, accueil">
      <img src={lien('/images/logo-deliview.png')} alt="Deliview" width="128" height="27" />
    </a>

    <nav aria-label="Navigation principale" class="hidden lg:block">
      <ul class="flex items-center gap-1 whitespace-nowrap text-[16px] font-semibold">
        {
          NAV.map((item) =>
            item.menu ? (
              <li class="relative">
                <details class="dv-menu group">
                  <summary class="flex cursor-pointer list-none items-center gap-1 rounded-lg px-3 py-2 hover:bg-grey [&::-webkit-details-marker]:hidden">
                    {item.libelle}
                    <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transition-transform group-open:rotate-180"><path d="m6 9 6 6 6-6" /></svg>
                  </summary>
                  <div class="absolute left-0 top-full mt-2 w-[400px] rounded-[16px] border border-grey-2/15 bg-white p-3 shadow-[0_12px_32px_rgba(76,76,76,0.12)]">
                    <ul class="space-y-1">
                      {MENUS[item.menu].map((x) => (
                        <li>
                          <a href={lien(x.href)} class="flex gap-3 rounded-xl p-3 hover:bg-grey">
                            {x.icone && (
                              <span class="mt-0.5 inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-[8px] bg-blue/10 text-blue">
                                <Icone nom={x.icone} taille={18} />
                              </span>
                            )}
                            <span class="whitespace-normal">
                              <span class="block font-semibold">{x.titre}</span>
                              <span class="mt-0.5 block text-[15px] font-normal leading-snug dv-muted">{x.phrase}</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                    {item.menu === 'solution' && (
                      <p class="mt-1 border-t border-grey-2/10 px-3 pt-3 pb-1 text-[15px]">
                        <a href={lien('/solution/')} class="underline underline-offset-2">Voir toute la solution</a>
                      </p>
                    )}
                  </div>
                </details>
              </li>
            ) : (
              <li>
                <a href={lien(item.href)} class="block rounded-lg px-3 py-2 hover:bg-grey">
                  {item.libelle}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a href={SITE.app} class="dv-btn dv-btn-contour !min-h-[44px] !px-4 !py-2 !text-[16px] hidden whitespace-nowrap sm:inline-flex">Se connecter</a>
      <a href={lien('/demo/')} class="dv-btn dv-btn-plein !min-h-[44px] !px-4 !py-2 hidden whitespace-nowrap sm:inline-flex" data-cta="header">Demander une démo</a>

      <details class="dv-menu lg:hidden">
        <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-grey-2/20 [&::-webkit-details-marker]:hidden" aria-label="Ouvrir le menu">
          <svg aria-hidden="true" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <div class="fixed inset-x-0 top-[72px] max-h-[calc(100dvh-72px)] overflow-y-auto border-b border-grey-2/15 bg-white px-4 pb-6 pt-2">
          <p class="dv-overline pt-2 pb-1">Notre solution</p>
          <ul>
            {
              PILIERS.map((p) => (
                <li>
                  <a href={lien(`/solution/${p.slug}/`)} class="flex items-center gap-3 py-3 font-semibold border-b border-grey-2/10">
                    <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-[8px] bg-blue/10 text-blue">
                      <Icone nom={p.icone} taille={18} />
                    </span>
                    {p.surtitre}
                  </a>
                </li>
              ))
            }
            {
              NAV.filter((x) => !x.menu).map((item) => (
                <li>
                  <a href={lien(item.href)} class="block py-3 font-semibold border-b border-grey-2/10">{item.libelle}</a>
                </li>
              ))
            }
          </ul>
          <p class="dv-overline pt-5 pb-1">Ressources</p>
          <ul>
            {
              MENU_RESSOURCES.map((r) => (
                <li>
                  <a href={lien(r.href)} class="block py-3 font-semibold border-b border-grey-2/10">{r.libelle}</a>
                </li>
              ))
            }
            <li><a href={SITE.app} class="block py-3 font-semibold">Se connecter</a></li>
          </ul>
          <a href={lien('/demo/')} class="dv-btn dv-btn-plein mt-4 w-full" data-cta="menu-mobile">Demander une démo</a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Un seul menu ouvert à la fois ; Échap ou un clic ailleurs le referme.
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.dv-menu'));
  menus.forEach((m) =>
    m.addEventListener('toggle', () => {
      if (m.open) menus.filter((x) => x !== m).forEach((x) => (x.open = false));
    }),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    menus.forEach((m) => {
      if (m.open) {
        m.open = false;
        m.querySelector('summary')?.focus();
      }
    });
  });
  document.addEventListener('click', (e) => {
    menus.forEach((m) => {
      if (m.open && !m.contains(e.target as Node)) m.open = false;
    });
  });
</script>
