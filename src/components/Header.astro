---
// En-tête collant et flottant (4 octobre 2026, logique de taap.it) : une barre blanche arrondie posée au-dessus de la
// page, le logo, la navigation au centre avec les méga-menus « Solution » et « Ressources » (Intégrations rangée dans Ressources, 4 octobre 2026), « Se connecter » en
// lien souligné et « Demander une démo » en bouton sombre. Menu Solution refait le 6 octobre 2026 (leviers et veille). Le bouton bleu en pastille reste celui des pages.
// Menus en <details> : utilisables sans JavaScript et au clavier (Entrée ou Espace pour ouvrir) ; Échap les ferme.
// 8 octobre 2026 (audit responsive) : navigation complète dès 1024 px (avant : 1280 px) ; en dessous, le menu du
// téléphone montre une croix et « Fermer le menu » quand il est ouvert, bloque la page derrière et garde « Demander une
// démo » collé en bas du panneau.
// 8 octobre 2026, 16 h 19 (demande de Tom, d'après le méga-menu de « SEO Sans Migraine » : « faut des photos, ça doit
// rester simple et efficace ») : chaque méga-menu a une carte bleue à gauche (Solution : l'app sur téléphone et la
// vidéo ; Ressources : Tom et son histoire), des photos de plats pour les trois leviers et les guides, le guide complet
// mis en avant, et les menus centrés sous la barre. Photos : public/images/menu/ (recadrées dans les images du site).
// 8 octobre 2026, 16 h 52 (demande de Tom : « montre juste de manière simple l'app Deliview », « enlève le fondateur,
// sois plus simple ») : la carte Solution montre l'écran d'accueil de l'app à plat et « Lire la vidéo » ouvre la vidéo
// dans une fenêtre (VideoDialogue, sur toutes les pages) ; plus de carte Tom ni de « Qui suis-je » dans les menus (reste
// dans le pied de page) ; Ressources en deux colonnes, trois guides présentés de la même façon.
import Cadenas from '../icons/cadenas.astro';
import Chevron from '../icons/chevron.astro';
import BoutonDemo from './BoutonDemo.astro';
import Menu from '../icons/menu.astro';
import Plus from '../icons/plus.astro';
import { ICONES, type NomIcone } from '../lib/registre-icones';
import Fleche from '../icons/fleche.astro';
import Lecture from '../icons/lecture.astro';
import { LEVIERS, MENU_RESSOURCES, NAV, SITE, VEILLE, cheminFonction, lien } from '../lib/site';

// Menu Solution (6 octobre 2026, demande de Tom) : à gauche les trois leviers de rentabilité en grand, à droite ce que
// Deliview surveille pour vous, en compact ; en bas, toute la solution et le simulateur. Depuis le 7 octobre 2026, chaque
// entrée mène à la page de sa fonction (/solution/<slug>/).
// Photo de chaque levier (plats de vrais restaurants, déjà sur le site) et des guides mis en avant dans Ressources.
const PHOTO_LEVIER: Record<string, string> = { promotions: 'promotions', fraude: 'fraude', prix: 'prix' };
const vignette = (nom: string) => lien(`/images/menu/${nom}-128.webp`);
const leviers = LEVIERS.map((l) => ({ href: cheminFonction(l.id), titre: l.nom, phrase: l.menu, icone: l.icone, photo: PHOTO_LEVIER[l.id] }));
// Ressources : trois guides avec leur photo (le guide complet en premier), puis les outils et réponses en compact. Le blog
// est dans le pied du menu (« Voir tous les guides »).
const GUIDES = [
  { href: '/ressources/augmenter-ventes-uber-eats-deliveroo/', titre: 'Augmenter vos ventes', phrase: 'Les leviers qui comptent, dans le bon ordre', photo: 'ventes' },
  { href: '/ressources/commission-uber-eats-restaurant/', titre: 'Commission Uber Eats', phrase: 'Le vrai calcul, commande par commande', photo: 'commission' },
  { href: '/ressources/ameliorer-note-uber-eats-deliveroo/', titre: 'Améliorer votre note', phrase: 'Sur Uber Eats et Deliveroo', photo: 'note' },
];
const OUTILS = MENU_RESSOURCES.filter((r) => r.href !== '/ressources/').map((r) => ({ href: r.href, titre: r.libelle, phrase: r.phrase, icone: r.icone as NomIcone }));
const veille = VEILLE.map((v) => ({ href: cheminFonction(v.id), titre: v.nom.replace(/ \?$/, ''), phrase: v.menu, icone: v.icone }));
// Page en cours (sans la base de l'aperçu), pour marquer l'entrée active de la navigation.
const chemin = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '') || '/';
const actif = (href: string) => chemin === href;
const dansMenu = (menu: string) =>
  menu === 'solution' ? chemin.startsWith('/solution/') : MENU_RESSOURCES.some((r) => chemin.startsWith(r.href));
---

<header class="dv-entete sticky top-0 z-40">
  <div class="dv-container">
  <div class="dv-entete-barre flex h-16 items-center justify-between gap-4 xl:h-[72px] xl:gap-4">
    <a href={lien('/')} class="flex min-h-12 shrink-0 items-center" aria-label="Deliview, accueil">
      <img src={lien('/images/logo-deliview.svg')} alt="Deliview" width="140" height="27" />
    </a>

    <nav aria-label="Navigation principale" class="hidden flex-1 lg:block">
      <ul class="flex items-center justify-center gap-0 whitespace-nowrap text-[16px] font-medium leading-none">
        {
          NAV.map((item) =>
            item.menu ? (
              <li>
                <details class="dv-menu group">
                  <summary class={`dv-nav-lien flex min-h-12 cursor-pointer list-none items-center gap-1.5 rounded-[10px] px-3 hover:bg-grey [&::-webkit-details-marker]:hidden ${dansMenu(item.menu) ? 'dv-nav-actif' : ''}`}>
                    {item.libelle}
                    <Chevron taille={24} class="transition-transform group-open:rotate-180" />
                  </summary>
                  {item.menu === 'solution' ? (
                    <div class="dv-mega" data-mega>
                      <div class="dv-mega-grille">
                        <a href={lien('/#video-deliview')} class="dv-mega-vedette" data-video-ouvrir aria-haspopup="dialog">
                          <img class="dv-mega-app" src={lien('/images/menu/app-512.webp')} alt="" width="512" height="320" loading="lazy" decoding="async" />
                          <span class="dv-mega-vedette-titre">Uber Eats et Deliveroo sur un seul écran</span>
                          <span class="dv-mega-vedette-bouton"><Lecture taille={24} />Lire la vidéo</span>
                        </a>
                        <div>
                          <p class="dv-menu-titre">Gagnez en rentabilité</p>
                          <ul class="mt-1 grid gap-1">
                            {leviers.map((x) => (
                              <li>
                                <a href={lien(x.href)} class="dv-mega-lien" aria-current={actif(x.href) ? 'page' : undefined}>
                                  <img class="dv-mega-photo" src={vignette(x.photo)} alt="" width="128" height="128" loading="lazy" decoding="async" />
                                  <span class="whitespace-normal">
                                    <span class="dv-mega-lien-titre">{x.titre}</span>
                                    <span class="dv-mega-lien-phrase">{x.phrase}</span>
                                  </span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                        <div class="dv-mega-gris">
                          <p class="dv-menu-titre">Rien ne vous échappe</p>
                          <ul class="mt-1 grid gap-0.5">
                            {veille.map((x) => {
                              const Icone = ICONES[x.icone];
                              return (
                                <li>
                                  <a href={lien(x.href)} class="dv-mega-compact" aria-current={actif(x.href) ? 'page' : undefined}>
                                    <Icone taille={24} />
                                    <span class="whitespace-normal">
                                      <span class="dv-mega-lien-titre">{x.titre}</span>
                                      <span class="dv-mega-lien-phrase">{x.phrase}</span>
                                    </span>
                                  </a>
                                </li>
                              );
                            })}
                          </ul>
                        </div>
                      </div>
                      <p class="dv-mega-pied">
                        <a href={lien('/solution/')} class="dv-lien gap-1.5">Voir toute la solution<Fleche taille={24} /></a>
                      </p>
                    </div>
                  ) : (
                    <div class="dv-mega dv-mega-etroit" data-mega>
                      <div class="dv-mega-grille dv-mega-grille-2">
                        <div>
                          <p class="dv-menu-titre">Guides pour restaurateurs</p>
                          <ul class="mt-1 grid gap-1">
                            {GUIDES.map((x) => (
                              <li>
                                <a href={lien(x.href)} class="dv-mega-lien" aria-current={actif(x.href) ? 'page' : undefined}>
                                  <img class="dv-mega-photo" src={vignette(x.photo)} alt="" width="128" height="128" loading="lazy" decoding="async" />
                                  <span class="whitespace-normal">
                                    <span class="dv-mega-lien-titre">{x.titre}</span>
                                    <span class="dv-mega-lien-phrase">{x.phrase}</span>
                                  </span>
                                </a>
                              </li>
                            ))}
                          </ul>
                        </div>
                        <div class="dv-mega-gris">
                          <p class="dv-menu-titre">Outils et réponses</p>
                          <ul class="mt-1 grid gap-0.5">
                            {OUTILS.map((x) => {
                              const Icone = ICONES[x.icone];
                              return (
                                <li>
                                  <a href={lien(x.href)} class="dv-mega-compact" aria-current={actif(x.href) ? 'page' : undefined}>
                                    <Icone taille={24} />
                                    <span class="whitespace-normal">
                                      <span class="dv-mega-lien-titre">{x.titre}</span>
                                      <span class="dv-mega-lien-phrase">{x.phrase}</span>
                                    </span>
                                  </a>
                                </li>
                              );
                            })}
                          </ul>
                        </div>
                      </div>
                      <p class="dv-mega-pied">
                        <a href={lien('/ressources/')} class="dv-lien gap-1.5">Voir tous les guides<Fleche taille={24} /></a>
                      </p>
                    </div>
                  )}
                </details>
              </li>
            ) : (
              <li>
                <a href={lien(item.href)} class={`dv-nav-lien flex min-h-12 items-center rounded-[10px] px-3 hover:bg-grey ${chemin.startsWith(item.href) ? 'dv-nav-actif' : ''}`} aria-current={actif(item.href) ? 'page' : undefined}>
                  {item.libelle}
                </a>
              </li>
            ),
          )
        }
      </ul>
    </nav>

    <div class="flex items-center gap-2 lg:gap-4">
      <a href={SITE.app} class="hidden min-h-12 items-center px-2 text-[17px] font-medium leading-none whitespace-nowrap rounded-[10px] px-3 hover:bg-grey sm:inline-flex">Connexion</a>
      <a href={lien('/demo/')} class="dv-btn-sombre hidden sm:inline-flex" data-cta="header">Demander une démo</a>

      <details class="dv-menu dv-burger lg:hidden">
        <summary class="flex h-12 w-12 cursor-pointer list-none items-center justify-center rounded-[12px] hover:bg-grey [&::-webkit-details-marker]:hidden" aria-label="Ouvrir le menu" data-burger>
          <span class="dv-burger-ouvrir"><Menu taille={32} /></span>
          <span class="dv-burger-fermer"><Plus taille={32} class="rotate-45" /></span>
        </summary>
        <div class="dv-burger-panneau fixed inset-x-2 top-[80px] max-h-[calc(100dvh-92px)] overflow-y-auto rounded-[18px] border border-grey-2/15 bg-white px-4 pb-0 pt-2 shadow-[0_12px_32px_rgba(76,76,76,0.12)]">
          <p class="dv-overline pt-3 pb-1">Solution</p>
          <ul>
            {
              leviers.map((x) => (
                <li>
                  <a href={lien(x.href)} class="flex min-h-12 items-center gap-3 border-b border-grey-2/10 py-2 font-semibold" aria-current={actif(x.href) ? 'page' : undefined}>
                    <img class="dv-mobile-photo" src={vignette(x.photo)} alt="" width="128" height="128" loading="lazy" decoding="async" />
                    {x.titre}
                  </a>
                </li>
              ))
            }
          </ul>
          <ul class="mt-3 grid grid-cols-2 gap-2">
            {
              veille.map((x) => {
                const Icone = ICONES[x.icone];
                return (
                  <li>
                    <a href={lien(x.href)} class="flex min-h-12 items-center gap-2 rounded-[12px] bg-grey px-3 py-2 text-[15px] font-semibold leading-snug" aria-current={actif(x.href) ? 'page' : undefined}>
                      <Icone taille={24} />
                      {x.titre}
                    </a>
                  </li>
                );
              })
            }
          </ul>
          <p class="pt-1">
            <a href={lien('/solution/')} class="dv-lien gap-1.5">Voir toute la solution<Fleche taille={24} /></a>
          </p>
          <p class="dv-overline pt-5 pb-1">Deliview</p>
          <ul>
            {
              NAV.filter((x) => !x.menu).map((item) => (
                <li>
                  <a href={lien(item.href)} class="flex min-h-12 items-center border-b border-grey-2/10 py-2 font-semibold" aria-current={actif(item.href) ? 'page' : undefined}>
                    {item.libelle}
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="dv-overline pt-6 pb-1">Ressources</p>
          <ul>
            {
              MENU_RESSOURCES.map((r) => {
                const Icone = ICONES[r.icone];
                return (
                  <li>
                    <a href={lien(r.href)} class="flex min-h-12 items-center gap-3 border-b border-grey-2/10 py-2 font-semibold" aria-current={actif(r.href) ? 'page' : undefined}>
                      <Icone taille={32} />
                      {r.libelle}
                    </a>
                  </li>
                );
              })
            }
            <li>
              <a href={SITE.app} class="flex min-h-12 items-center gap-2 py-2 font-semibold"><Cadenas taille={24} />Connexion</a>
            </li>
          </ul>
          <!-- Action principale collée en bas du panneau : visible dès l'ouverture, même quand le panneau défile. Le panneau n'a
               pas de marge basse : un bloc collé s'arrête à la marge de son conteneur, et le texte défilait dessous. -->
          <div class="sticky bottom-0 -mx-4 mt-5 border-t border-grey-2/10 bg-white px-4 pb-4 pt-3">
            <BoutonDemo href={lien('/demo/')} cta="menu-mobile" class="w-full" />
          </div>
        </div>
      </details>
    </div>
  </div>
  </div>
</header>

<style>
  /* Barre flottante : blanche, arrondie, bordure Gris 2 à 12 %, ombre très légère, posée 10 px sous le haut. */
  .dv-entete {
    padding-top: 10px;
  }
  .dv-entete-barre {
    padding-inline: 12px 8px;
    border: 1px solid color-mix(in srgb, var(--color-grey-2) 12%, transparent);
    border-radius: 18px;
    background: var(--color-white);
    box-shadow: 0 6px 24px rgba(76, 76, 76, 0.07);
  }
  @media (min-width: 640px) {
    .dv-entete-barre {
      padding-inline: 18px 10px;
    }
  }
  .dv-menu-titre {
    padding: 8px 12px 0;
    font-family: var(--font-accent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--color-grey-2) 85%, transparent);
  }
  .dv-tuile-petite {
    width: 44px;
    height: 44px;
  }
  /* La barre est le repère des méga-menus : ils se centrent dessous, quelle que soit l'entrée ouverte. */
  .dv-entete-barre {
    position: relative;
  }
  .dv-mega {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    width: min(960px, calc(100vw - 32px));
    translate: -50% 0;
    border: 1px solid color-mix(in srgb, var(--color-grey-2) 15%, transparent);
    border-radius: 20px;
    background: var(--color-white);
    box-shadow: 0 12px 32px rgba(76, 76, 76, 0.12);
    white-space: normal;
  }
  .dv-menu[open] > .dv-mega {
    animation: dv-mega-ouvre 0.18s ease-out;
  }
  @keyframes dv-mega-ouvre {
    from {
      opacity: 0;
      translate: -50% -6px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dv-menu[open] > .dv-mega {
      animation: none;
    }
  }
  .dv-mega-grille {
    display: grid;
    grid-template-columns: 284px minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 12px;
    padding: 12px;
  }
  /* Ressources : deux colonnes (guides, outils) dans un menu moins large. */
  .dv-mega-etroit {
    width: min(720px, calc(100vw - 32px));
  }
  .dv-mega-grille-2 {
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
  }
  /* Carte vedette : aplat Bleu 1, l'écran d'accueil de l'app à plat, texte blanc en grand uniquement (contraste), bouton
     blanc qui ouvre la vidéo. */
  .dv-mega-vedette {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 14px;
    padding: 14px 14px 18px;
    border-radius: 16px;
    background: var(--color-blue);
    color: var(--color-white);
    text-decoration: none;
  }
  .dv-mega-app {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    background: var(--color-white);
  }
  .dv-mega-vedette-titre {
    font-family: var(--font-accent);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.25;
    text-wrap: balance;
  }
  .dv-mega-vedette-bouton {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 6px;
    margin-top: auto;
    padding: 0 16px;
    border-radius: 12px;
    background: var(--color-white);
    color: var(--color-grey-2);
    font-size: 17px;
    font-weight: 700;
    line-height: 1;
  }
  .dv-mega-vedette:hover .dv-mega-vedette-bouton {
    background: var(--color-grey);
  }
  .dv-mega-vedette:focus-visible {
    outline: 2px solid var(--color-blue);
    outline-offset: 2px;
  }
  /* Entrées avec photo (leviers, guides) et entrées compactes avec icône (veille, outils). */
  .dv-mega-lien,
  .dv-mega-compact {
    display: flex;
    gap: 12px;
    border-radius: 12px;
    text-decoration: none;
  }
  .dv-mega-lien {
    align-items: center;
    padding: 8px;
  }
  .dv-mega-compact {
    align-items: flex-start;
    padding: 10px 12px;
  }
  .dv-mega-lien:hover {
    background: var(--color-grey);
  }
  .dv-mega-compact:hover {
    background: var(--color-white);
  }
  .dv-mega-photo {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border-radius: 12px;
    object-fit: cover;
  }
  .dv-mega-lien-titre {
    display: block;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.3;
  }
  .dv-mega-lien-phrase {
    display: block;
    margin-top: 2px;
    text-wrap: pretty;
    font-size: 15px;
    font-weight: 400;
    line-height: 1.35;
    color: color-mix(in srgb, var(--color-grey-2) 85%, transparent);
  }
  .dv-mega-gris {
    padding: 4px;
    border-radius: 14px;
    background: var(--color-grey);
  }
  .dv-mega-pied {
    display: flex;
    justify-content: flex-end;
    padding: 2px 20px 6px;
    border-top: 1px solid color-mix(in srgb, var(--color-grey-2) 10%, transparent);
    font-size: 16px;
  }
  /* Menu du téléphone : vignettes photo à la place des icônes pour les leviers. */
  .dv-mobile-photo {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    border-radius: 10px;
    object-fit: cover;
  }
  /* Bouton du menu (sous 1024 px) : trois traits fermé, croix ouvert (8 octobre 2026, audit responsive). */
  .dv-burger-ouvrir,
  .dv-burger-fermer {
    display: inline-flex;
  }
  .dv-burger-fermer,
  details[open] > summary .dv-burger-ouvrir {
    display: none;
  }
  details[open] > summary .dv-burger-fermer {
    display: inline-flex;
  }
  /* Entrée de la navigation correspondant à la page : soulignée en Bleu 1. */
  .dv-nav-actif {
    text-decoration: underline;
    text-decoration-color: var(--color-blue);
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
</style>

<script>
  // Un seul menu ouvert à la fois ; Échap ou un clic ailleurs le referme. Le bouton du menu du téléphone dit ce qu'il
  // fait : « Ouvrir le menu », puis « Fermer le menu » (la page derrière est bloquée par global.css tant qu'il est ouvert).
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.dv-menu'));
  menus.forEach((m) =>
    m.addEventListener('toggle', () => {
      if (m.open) menus.filter((x) => x !== m).forEach((x) => (x.open = false));
      m.querySelector('summary[data-burger]')?.setAttribute('aria-label', m.open ? 'Fermer le menu' : 'Ouvrir le menu');
    }),
  );
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    menus.forEach((m) => {
      if (m.open) {
        m.open = false;
        m.querySelector('summary')?.focus();
      }
    });
  });
  document.addEventListener('click', (e) => {
    menus.forEach((m) => {
      if (m.open && !m.contains(e.target as Node)) m.open = false;
    });
  });
  menus.forEach((m) =>
    m.querySelectorAll('a[href]').forEach((a) =>
      a.addEventListener('click', () => {
        m.open = false;
      }),
    ),
  );
</script>
