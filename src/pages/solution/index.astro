---
// Page Solution, refaite le 6 octobre 2026 (demande de Tom) : les trois leviers de rentabilité (promotions, fraude
// client, prix), chacun dans sa section avec une vraie carte de l'app, puis ce que Deliview surveille pour vous
// (fermeture, avis, assistant, objectifs). Chaque section a son ancre, reprise par le menu Solution et le pied de page.
// 7 octobre 2026 (demande de Tom : « fait leur page chacune ») : chaque fonction a sa page, /solution/<slug>/, liée
// depuis sa section (« Voir comment ça marche ») ; les anciennes pages détaillées sont redirigées vers ces pages.
// 6 octobre 2026 (demande de Tom : des visuels variés, des écrans sur des appareils) : chaque levier sur son appareil
// (tablette, téléphone, ordinateur) avec ses bulles ; ce que Deliview surveille, chacun avec le haut de son écran sur
// téléphone.
import Base from '../../layouts/Base.astro';
import BoutonDemo from '../../components/BoutonDemo.astro';
import BandeauPlateformes from '../../components/BandeauPlateformes.astro';
import Vitrine from '../../components/Vitrine.astro';
import Pastille from '../../components/Pastille.astro';
import SectionDemo from '../../components/SectionDemo.astro';
import Coche from '../../icons/coche.astro';
import Fleche from '../../icons/fleche.astro';
import { ICONES } from '../../lib/registre-icones';
import { LEVIERS, SITE, VEILLE, cheminFonction, jsonldLogiciel, lien } from '../../lib/site';

const description =
  'Promotions, fraude client, prix : Deliview repère où part votre marge sur Uber Eats et Deliveroo. Vous validez, Deliview l’applique. Demandez une démo.';
const sommaire = [...LEVIERS.map((l) => ({ id: l.id, nom: l.nom, icone: l.icone })), ...VEILLE.map((v) => ({ id: v.id, nom: v.nom.replace(/ \?$/, ''), icone: v.icone }))];
---

<Base
  title="Rentabilité Uber Eats et Deliveroo : la solution | Deliview"
  description={description}
  ariane={[{ nom: 'Solution', chemin: '/solution/' }]}
  jsonld={[jsonldLogiciel(SITE.definition, SITE.url + '/solution/')]}
>
  <section class="bg-grey pb-14 pt-6 md:pb-20 md:pt-10" aria-labelledby="solution-titre" data-haut-de-page>
    <div class="dv-container">
      <Pastille>Solution</Pastille>
      <h1 id="solution-titre" class="dv-h1 mt-5 max-w-[20ch] md:mt-6">Plus de rentabilité sur votre activité livraison</h1>
      <p class="dv-lead mt-4 max-w-[52ch] md:mt-6">Deliview repère où part votre marge sur Uber&nbsp;Eats et Deliveroo. Vous validez, Deliview l’applique.</p>
      <div class="mt-7 md:mt-8">
        <BoutonDemo href="#demo" cta="solution" principal class="w-full sm:w-auto" />
      </div>
      <nav aria-label="Sur cette page" class="mt-10 md:mt-14">
        <ul class="flex flex-wrap gap-2.5">
          {
            sommaire.map((x) => {
              const Icone = ICONES[x.icone];
              return (
                <li>
                  <a href={`#${x.id}`} class="dv-relief dv-sommaire">
                    <Icone taille={24} />
                    {x.nom}
                  </a>
                </li>
              );
            })
          }
        </ul>
      </nav>
    </div>
  </section>

  {
    LEVIERS.map((l, i) => {
      const Icone = ICONES[l.icone];
      return (
        <section id={l.id} class={`dv-section scroll-mt-24 overflow-x-clip ${i % 2 === 0 ? 'bg-white' : 'bg-grey dv-points'}`} aria-labelledby={`${l.id}-titre`}>
          <div class={`dv-container grid items-center gap-10 lg:grid-cols-2 lg:gap-16 ${i % 2 ? 'dv-inverse' : ''}`}>
            <div>
              <Pastille icone={Icone}>{l.nom}</Pastille>
              <h2 id={`${l.id}-titre`} class="dv-h2 mt-4 max-w-[22ch] md:mt-5">{l.benefice.replace(/\.$/, '')}</h2>
              <ul class="mt-6 grid gap-3 text-[17px] leading-[1.5] md:mt-8 md:text-[18px]">
                {l.points.map((p) => (
                  <li class="flex gap-3">
                    <Coche taille={24} />
                    <span>{p}</span>
                  </li>
                ))}
              </ul>
              <a href={lien(cheminFonction(l.id))} class="dv-lien-fort mt-6 md:mt-8" aria-label={`Voir comment ça marche : ${l.nom.toLowerCase()}`}>
                Voir comment ça marche
                <Fleche taille={24} />
              </a>
            </div>
            <Vitrine
              type={l.vitrine.appareil}
              capture={l.vitrine.capture}
              ratio={l.vitrine.page.ratio}
              ratioMobile={l.vitrine.page.ratioMobile}
              place={l.vitrine.page.place}
              placeMobile={l.vitrine.page.placeMobile}
              bulles={l.vitrine.page.bulles}
              priorite={i === 0}
              class="mx-auto w-full max-w-[600px]"
              sizes={l.vitrine.appareil === 'navigateur' ? '(min-width: 1024px) 560px, 92vw' : '(min-width: 1024px) 300px, 50vw'}
            />
          </div>
        </section>
      );
    })
  }

  <section class="dv-section bg-white" aria-labelledby="veille-titre">
    <div class="dv-container">
      <Pastille>Et pour ne rien laisser filer</Pastille>
      <h2 id="veille-titre" class="dv-h2 mt-4 max-w-[24ch] md:mt-5">Deliview surveille le reste pour vous</h2>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 md:mt-12 md:gap-6">
        {
          VEILLE.map((v) => {
            const Icone = ICONES[v.icone];
            return (
              <li id={v.id} class="dv-relief dv-relief-lien dv-veille-carte scroll-mt-24">
                <Vitrine
                  type={v.vitrine.appareil}
                  capture={v.vitrine.capture}
                  ratio={1.7}
                  ratioMobile={1.25}
                  place={v.vitrine.place}
                  placeMobile={v.vitrine.placeMobile}
                  bulles={v.vitrine.bulle ? [v.vitrine.bulle] : []}
                  coupe
                  coins="haut"
                  sizes={v.vitrine.appareil === 'telephone' ? '(min-width: 768px) 230px, 56vw' : '(min-width: 768px) 560px, 100vw'}
                />
                <div class="flex flex-1 flex-col border-t border-grey-2/15 p-5 md:p-6">
                  <h3 class="flex items-center gap-3 font-accent text-[20px] font-bold leading-[1.3] md:text-[22px]">
                    <span class="dv-tuile dv-tuile-petite">
                      <Icone taille={24} />
                    </span>
                    {v.nom}
                  </h3>
                  <p class="mt-3 text-[16px] leading-[1.55] dv-muted md:text-[17px]">{v.texte}</p>
                  <a href={lien(cheminFonction(v.id))} class="dv-lien-fort dv-pilier-lien mt-auto self-start pt-2" aria-label={`Voir comment ça marche : ${v.nom.replace(/ \?$/, '').toLowerCase()}`}>
                    Voir comment ça marche
                    <Fleche taille={24} />
                  </a>
                </div>
              </li>
            );
          })
        }
      </ul>
    </div>
  </section>

  <BandeauPlateformes fond="gris" />

  <SectionDemo section="solution-formulaire" />
</Base>

<style>
  .dv-sommaire {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 6px 14px 6px 10px;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.2;
    text-decoration: none;
  }
  .dv-sommaire:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (min-width: 1024px) {
    .dv-inverse > :first-child {
      order: 2;
    }
  }
</style>
