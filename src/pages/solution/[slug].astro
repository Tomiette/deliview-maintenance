---
// Page pilier, gabarit unique pour les 3 piliers : icône, bénéfice, 3 points, vraie capture, un bloc par fonctionnalité
// (exemple réel en ticket), la méthode, les questions du pilier, les autres piliers et le bon de démo.
// Refonte en relief (3 octobre 2026) : en haut, un autre écran de l'app que ceux des blocs, incliné en 3D, avec des
// bulles qui reprennent ses chiffres ; les autres piliers en cartes avec leur carte de l'app.
import { getCollection } from 'astro:content';
import BoutonDemo from '../../components/BoutonDemo.astro';
import Base from '../../layouts/Base.astro';
import Scene3D from '../../components/Scene3D.astro';
import Flottant from '../../components/Flottant.astro';
import Bulle from '../../components/Bulle.astro';
import Pastille from '../../components/Pastille.astro';
import CartePilier from '../../components/CartePilier.astro';
import BlocFonctionnalite from '../../components/BlocFonctionnalite.astro';
import BandeauPlateformes from '../../components/BandeauPlateformes.astro';
import SectionDemo from '../../components/SectionDemo.astro';
import Faq from '../../components/Faq.astro';
import Coche from '../../icons/coche.astro';
import { ICONES } from '../../lib/registre-icones';
import { CAPTURE_POSITION, FONCTIONNALITES, FRAGMENTS, PILIERS, SITE, jsonldLogiciel, lien, type BulleCapture, type CaptureApp, type Pilier } from '../../lib/site';

export function getStaticPaths() {
  return PILIERS.map((p) => ({ params: { slug: p.slug }, props: { pilier: p } }));
}

const { pilier } = Astro.props as { pilier: Pilier };
const autres = PILIERS.filter((p) => p.slug !== pilier.slug);
// Articles d'un autre thème qui servent aussi ce pilier (ex. la méthode pour fixer ses prix sous Carte et marge).
const ARTICLES_LIES: Record<string, string[]> = { 'carte-et-marge': ['fixer-prix-uber-eats-deliveroo'] };
const articles = (
  await getCollection('ressources', (a) => !a.data.brouillon && (a.data.theme === pilier.slug || (ARTICLES_LIES[pilier.slug] ?? []).includes(a.id)))
).sort((a, b) => b.data.misAJourLe.getTime() - a.data.misAJourLe.getTime());

// Méthode (réponse directe d'abord) et questions propres à chaque pilier. Rien sur la façon dont les données sont obtenues.
const CONTENU: Record<string, { methodeTitre: string; reponse: string; points: string[]; faq: { q: string; r: string }[] }> = {
  'prix-et-concurrence': {
    methodeTitre: 'Comment Deliview compare vos prix',
    reponse:
      'Deliview ne compare que des plats comparables&nbsp;: même type, même taille. Il calcule la médiane des prix de la zone, puis l’écart avec votre prix.',
    points: [
      'Au moins 2 concurrents pour conclure. Sinon, Deliview le dit.',
      'Plus de 10&nbsp;% au-dessus de la médiane&nbsp;: trop cher. Plus de 10&nbsp;% en dessous&nbsp;: sous-évalué.',
      'Une recette unique est située parmi les plats de sa famille&nbsp;: pizzas, pâtes, desserts.',
      'Chaque prix comparé cite ses sources.',
    ],
    faq: [
      {
        q: 'Comment Deliview choisit-il mes concurrents ?',
        r: 'Il retient jusqu’à 20 restaurants de votre secteur, les plus proches. Avec Pro et Premium, vous ajoutez 3 restaurants de votre choix, même plus loin.',
      },
      {
        q: 'À quelle fréquence les prix sont-ils mis à jour ?',
        r: 'À chaque analyse&nbsp;: une par semaine avec Essentiel, à la demande avec Pro et Premium. Deliview montre ce qui a changé depuis la précédente.',
      },
      {
        q: 'Mes prix en livraison sont plus chers qu’en salle. Est-ce un problème ?',
        r: 'Non. Deliview compare vos prix de livraison à ceux de vos voisins, sur la même plateforme.',
      },
    ],
  },
  'carte-et-marge': {
    methodeTitre: 'Comment Deliview propose un prix',
    reponse:
      'Deliview propose un prix dès que 2 concurrents vendent le même plat, à taille égale. Trop cher&nbsp;: il propose la médiane. Sous-évalué&nbsp;: une hausse en deux temps.',
    points: [
      'Chaque proposition cite les plats comparés et leur prix.',
      'Le gain est donné pour 100 ventes du plat. Vous l’appliquez à vos volumes.',
      'Une recette unique n’a pas de prix proposé, seulement un repère.',
      'Vous validez ou écartez chaque proposition. Deliview garde votre décision.',
    ],
    faq: [
      {
        q: 'Deliview modifie-t-il mes prix sur Uber Eats ou Deliveroo ?',
        r: 'Oui, quand vous le décidez. Vous validez le prix dans Deliview, et Deliview l’applique pour vous sur Uber&nbsp;Eats ou Deliveroo, sous 10&nbsp;minutes. Rien ne change sans votre accord.',
      },
      {
        q: 'Que faire d’un plat que personne d’autre ne vend ?',
        r: 'Deliview le compare aux plats de la même famille dans votre zone. C’est un repère, pas un prix conseillé.',
      },
    ],
  },
  reputation: {
    methodeTitre: 'Comment lire votre place au classement',
    reponse:
      'Deliview classe les restaurants de votre zone par note, plateforme par plateforme. Vous voyez votre rang et la note moyenne de la zone.',
    points: [
      'Uber Eats et Deliveroo sont classés à part&nbsp;: les clients n’y sont pas les mêmes.',
      'Le nombre d’avis compte. Un 4,8 sur 12 avis ne vaut pas un 4,6 sur 900.',
      'Les concurrents que vous suivez entrent aussi dans le classement.',
    ],
    faq: [
      {
        q: 'Deliview répond-il à mes avis clients ?',
        r: 'Non. Deliview compare votre note et vos avis à ceux de votre zone, plateforme par plateforme.',
      },
      {
        q: 'Pourquoi comparer ma note à celle des voisins ?',
        r: 'Parce que le client choisit parmi les restaurants qu’il voit. Un 4,5 ne pèse pas pareil si vos voisins sont à 4,7.',
      },
    ],
  },
};

// Écran du haut de page et bulles (chiffres lus sur cet écran). Réputation : l'écran des notes est en haut,
// le bloc de la fonctionnalité montre alors la carte de l'app (fragment).
type Flot = { x: number; y: number; xm?: number; ym?: number; droite?: boolean; z: number; bureau?: boolean } & ({ puce: string } | { bulle: BulleCapture });
const HAUT: Record<string, { capture: CaptureApp; flottants: Flot[] }> = {
  'prix-et-concurrence': {
    capture: CAPTURE_POSITION,
    flottants: [
      { x: 2, y: 5, xm: 2, ym: 5, z: 9, puce: 'Uber Eats' },
      { x: -3, y: 18, xm: 0, ym: 10, droite: true, z: 14, puce: 'Deliveroo' },
      { x: -4, y: 58, xm: 0, ym: 64, z: 16, bulle: { sur: 'Prix · Uber Eats', chiffre: '14,40 €', texte: '52 % au-dessus de la zone' } },
      { x: -2, y: 72, droite: true, z: 11, bureau: true, bulle: { chiffre: '10 sur 14', texte: 'concurrents avec une offre' } },
    ],
  },
  'carte-et-marge': {
    capture: FONCTIONNALITES['prix-concurrents'].capture,
    flottants: [
      { x: 2, y: 5, xm: 2, ym: 5, z: 9, puce: 'Uber Eats' },
      { x: -3, y: 18, xm: 0, ym: 10, droite: true, z: 14, puce: 'Deliveroo' },
      { x: -4, y: 56, xm: 0, ym: 64, z: 16, bulle: { sur: 'Uber Eats', titre: 'Passez 4 boissons à 4,50 €', gain: '+1,00 € par article vendu' } },
      { x: -2, y: 72, droite: true, z: 11, bureau: true, bulle: { chiffre: '16 à faire', texte: 'jusqu’à +1,30 € par commande' } },
    ],
  },
  reputation: {
    capture: FONCTIONNALITES['note-avis'].capture,
    flottants: [
      { x: -4, y: 52, xm: 0, ym: 62, z: 16, bulle: { chiffre: '4,2', etoile: true, texte: '8e sur 14 · Uber Eats' } },
      { x: -3, y: 66, xm: 0, ym: 66, droite: true, z: 12, bulle: { chiffre: '4,3', etoile: true, texte: '4e sur 8 · Deliveroo' } },
      { x: 4, y: 4, z: 8, bureau: true, puce: 'Moyenne de la zone : 4,1 sur Uber Eats' },
    ],
  },
};
const haut = HAUT[pilier.slug];
const c = CONTENU[pilier.slug];
const url = `${SITE.url}/solution/${pilier.slug}/`;
const Icone = ICONES[pilier.icone];
// Fonds alternés après le haut de page (gris) : blanc, gris, blanc…
let n = 0;
const fond = (): 'blanc' | 'gris' => (n++ % 2 === 0 ? 'blanc' : 'gris');
const fondsBlocs = pilier.fonctionnalites.map(() => fond());
const fondMethode = fond();
const fondFaq = fond();
const fondArticles = articles.length > 0 ? fond() : fondFaq;
const fondAutres = fond();
---

<Base
  title={pilier.meta.title}
  description={pilier.meta.description}
  ariane={[
    { nom: 'Solution', chemin: '/solution/' },
    { nom: pilier.surtitre, chemin: `/solution/${pilier.slug}/` },
  ]}
  jsonld={[jsonldLogiciel(pilier.description, url)]}
>
  <section class="overflow-hidden bg-grey pb-14 pt-6 md:pb-[104px] md:pt-10" aria-labelledby="pilier-titre" data-haut-de-page>
    <div class="dv-container grid items-center gap-x-12 gap-y-10 lg:grid-cols-[1fr_1.05fr]">
      <div>
        <Pastille icone={Icone}>{pilier.surtitre}</Pastille>
        <h1 id="pilier-titre" class="dv-h1 mt-5 max-w-[16ch] md:mt-6">{pilier.titre}</h1>
        <p class="dv-lead mt-4 max-w-[54ch] md:mt-6">{pilier.description}</p>
        <ul class="mt-6 grid gap-2.5 text-[16px] leading-[1.5] md:text-[17px]">
          {
            pilier.carte.points.map((x) => (
              <li class="flex gap-2.5">
                <Coche taille={24} />
                <span>{x}</span>
              </li>
            ))
          }
        </ul>
        <div class="mt-7 md:mt-8">
          <BoutonDemo href="#demo" cta={`pilier-${pilier.slug}`} principal class="w-full sm:w-auto" />
        </div>
      </div>
      <div class="w-full">
        <Scene3D capture={haut.capture} priorite suiviPointeur ratio={1.14} ratioMobile={1.02} appareil={{ x: 4, y: 14, largeur: 92 }} sizes="(min-width: 1200px) 540px, (min-width: 1024px) 46vw, 92vw">
          {
            haut.flottants.map((f, i) => (
              <Flottant x={f.x} y={f.y} xm={f.xm} ym={f.ym} droite={f.droite} z={f.z} bureau={f.bureau} duree={5.6 + i * 0.6} delai={-i * 1.3}>
                {'puce' in f ? (
                  <span class="dv-puce">
                    <i />
                    {f.puce}
                  </span>
                ) : (
                  <Bulle {...f.bulle} />
                )}
              </Flottant>
            ))
          }
        </Scene3D>
      </div>
    </div>
  </section>

  {
    pilier.fonctionnalites.map((f, i) => (
      <BlocFonctionnalite f={f} fond={fondsBlocs[i]} inverse={i % 2 === 1} fragment={f.capture.src === haut.capture.src ? FRAGMENTS[pilier.slug] : undefined}>
        {f.id === 'pricing-menu' && (
          <p class="mt-8">
            <a href={lien('/simulateur/')} class="dv-btn dv-btn-contour w-full sm:w-auto" data-cta="pilier-simulateur">Combien vous rapporte un prix bien placé&nbsp;?</a>
          </p>
        )}
      </BlocFonctionnalite>
    ))
  }

  <section class={`dv-section ${fondMethode === 'gris' ? 'bg-grey dv-points' : 'bg-white'}`} aria-labelledby="methode-titre">
    <div class="dv-container grid gap-10 lg:grid-cols-2 lg:gap-14">
      <div>
        <Pastille>La méthode</Pastille>
        <h2 id="methode-titre" class="dv-h2 mt-4 max-w-[20ch] md:mt-5">{c.methodeTitre}</h2>
        <p class="dv-lead mt-4 dv-texte md:mt-5" set:html={c.reponse} />
      </div>
      <ol class="dv-card grid self-center p-2 md:p-3">
        {
          c.points.map((p, i) => (
            <li class="flex items-start gap-4 border-t border-grey-2/12 p-4 first:border-t-0 md:p-5">
              <span class="dv-tuile dv-tuile-numero dv-tuile-petite" aria-hidden="true">
                {i + 1}
              </span>
              <span class="pt-1.5" set:html={p} />
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <BandeauPlateformes fond={fondMethode} />

  <Faq questions={c.faq} fond={fondFaq} />

  {
    articles.length > 0 && (
      <section class={`dv-section ${fondArticles === 'gris' ? 'bg-grey dv-points' : 'bg-white'}`} aria-labelledby="articles-titre">
        <div class="dv-container">
          <Pastille>Ressources</Pastille>
          <h2 id="articles-titre" class="dv-h2 mt-4 md:mt-5">Pour aller plus loin</h2>
          <ul class="mt-8 grid gap-6 md:grid-cols-3">
            {articles.slice(0, 3).map((a) => (
              <li class="dv-card dv-carte-lien flex flex-col p-6">
                <h3 class="dv-h3 !text-[20px]">
                  <a href={lien(`/ressources/${a.id}/`)} class="dv-etire hover:underline">
                    {a.data.titre}
                  </a>
                </h3>
                <p class="mt-2 flex-1 text-[16px] dv-muted">{a.data.description}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }

  <section class={`dv-section ${fondAutres === 'gris' ? 'bg-grey dv-points' : 'bg-white'}`} aria-labelledby="autres-titre">
    <div class="dv-container">
      <Pastille>Solution</Pastille>
      <h2 id="autres-titre" class="dv-h2 mt-4 md:mt-5">Le reste de Deliview</h2>
      <ul class="mt-8 grid gap-6 md:grid-cols-2">
        {autres.map((p, i) => <CartePilier icone={p.icone} nom={p.surtitre} benefice={p.carte.benefice} points={p.carte.points} fragment={FRAGMENTS[p.slug]} href={`/solution/${p.slug}/`} sens={i % 2 ? 'gauche' : 'droite'} />)}
      </ul>
    </div>
  </section>

  <SectionDemo section={`pilier-${pilier.slug}-formulaire`} />
</Base>
