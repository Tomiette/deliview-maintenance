---
// Roadmap publique (7 octobre 2026, demande de Tom, sur le modèle de celle de taap.it) : trois colonnes, Fait,
// Prochainement, Plus tard. Aucune date promise : « Fait » liste ce qui est déjà dans l'app ; « Prochainement », nos
// prochaines priorités ; « Plus tard » reste une direction, pas un engagement. À mettre à jour à chaque sortie.
// 8 octobre 2026 : contenu validé (src/lib/roadmap.ts, copié tel quel) : 47 fonctions « Fait » en 6 thèmes, 8
// « Prochainement », 9 « Plus tard ». En haut, trois compteurs cliquables vers chaque colonne, calculés depuis les
// tableaux. Sur ordinateur, trois colonnes (« Fait » plus large, ses cartes sur deux colonnes à partir de 1280 px) ;
// sur téléphone et tablette, les colonnes s'empilent.
import Base from '../layouts/Base.astro';
import Pastille from '../components/Pastille.astro';
import LogoContact from '../components/LogoContact.astro';
import { SITE } from '../lib/site';
import { FAIT, INTRO, PLUS_TARD, PROCHAINEMENT } from '../lib/roadmap';

type Element = { titre: string; texte: string; offre?: 'Pro' };
type Groupe = { theme?: string; elements: Element[] };

const nbFait = FAIT.reduce((n, t) => n + t.elements.length, 0);
const colonnes: { id: string; titre: string; pastille: string; compteur: string; groupes: Groupe[]; total: number }[] = [
  { id: 'fait', titre: 'Fait', pastille: 'Dans l’app', compteur: 'en ligne', groupes: FAIT.map((t) => ({ theme: t.theme, elements: t.elements })), total: nbFait },
  { id: 'prochainement', titre: 'Prochainement', pastille: 'Nos prochaines priorités', compteur: 'en préparation', groupes: [{ elements: PROCHAINEMENT }], total: PROCHAINEMENT.length },
  { id: 'plus-tard', titre: 'Plus tard', pastille: 'À l’étude', compteur: 'à l’étude', groupes: [{ elements: PLUS_TARD }], total: PLUS_TARD.length },
];
const description = `La roadmap publique de Deliview : les ${nbFait} fonctions déjà dans l’app, nos prochaines priorités et ce qui viendra plus tard pour les restaurants qui livrent.`;
---

<Base title="Roadmap : ce qu’on construit | Deliview" description={description} ariane={[{ nom: 'Roadmap', chemin: '/roadmap/' }]}>
  <section class="bg-grey pb-16 pt-6 md:pb-24 md:pt-10" aria-labelledby="roadmap-titre" data-haut-de-page>
    <div class="dv-container">
      <Pastille>Roadmap publique</Pastille>
      <h1 id="roadmap-titre" class="dv-h1 mt-5 max-w-[22ch] md:mt-6">Ce qu’on construit pour vous</h1>
      <p class="dv-lead mt-4 max-w-[62ch] md:mt-6">{INTRO}</p>

      <nav aria-label="Colonnes de la roadmap" class="mt-7 md:mt-8">
        <ul class="flex flex-wrap gap-2.5">
          {
            colonnes.map((c) => (
              <li>
                <a href={`#${c.id}`} class="dv-puce-lien gap-2.5">
                  <span class={`dv-rm-point dv-rm-point-${c.id}`} aria-hidden="true" />
                  <span>
                    <strong class="font-bold">{c.total}</strong> {c.compteur}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="dv-rm-colonnes mt-8 grid items-start gap-5 md:mt-10">
        {
          colonnes.map((c) => (
            <section id={c.id} class={`dv-rm-colonne dv-rm-colonne-${c.id} rounded-[20px] border border-grey-2/10 bg-white p-4 md:p-5`} aria-labelledby={`col-${c.id}`}>
              <div class="flex items-center justify-between gap-3 px-1">
                <h2 id={`col-${c.id}`} class="flex items-center gap-2.5 font-accent text-[20px] font-bold md:text-[22px]">
                  <span class={`dv-rm-point dv-rm-point-${c.id}`} aria-hidden="true" />
                  {c.titre}
                </h2>
                <span class="rounded-full bg-grey px-3 py-1 text-[14px] font-semibold">{c.total}</span>
              </div>
              {c.groupes.map((g) => (
                <div class={g.theme ? 'dv-rm-theme' : ''}>
                  {g.theme && <h3 class="dv-rm-intertitre">{g.theme}</h3>}
                  <ul class={`dv-rm-cartes ${g.theme ? 'mt-2.5' : 'mt-4'}`}>
                    {g.elements.map((e: Element) => (
                      <li class="dv-rm-carte">
                        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[16px] font-semibold leading-[1.35]">
                          <span>{e.titre}</span>
                          {e.offre && <span class="dv-rm-offre">Offre {e.offre}</span>}
                        </p>
                        <p class="mt-1 text-[15px] leading-[1.45] dv-muted">{e.texte}</p>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
              <p class="mt-4 px-1">
                <span class="dv-rm-pied">{c.pastille}</span>
              </p>
            </section>
          ))
        }
      </div>

      <div class="mt-10 rounded-[20px] border border-grey-2/10 bg-white p-6 md:mt-12 md:p-8">
        <h2 class="font-accent text-[20px] font-bold md:text-[22px]">Une fonction vous manque&nbsp;?</h2>
        <p class="mt-2 max-w-[62ch] text-[16px] leading-[1.5]">Dites-le à Tom. Les demandes des restaurateurs décident de ce qui passe en chantier.</p>
        <p class="mt-4 text-[16px] font-semibold">
          <a href={`mailto:${SITE.email}?subject=${encodeURIComponent('Idée pour la roadmap Deliview')}`} class="dv-lien gap-2.5"><LogoContact type="email" />{SITE.email}</a>
        </p>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Colonnes : empilées sur téléphone et tablette ; côte à côte à partir de 1024 px, « Fait » plus large à partir de
     1280 px, ses cartes sur deux colonnes. */
  @media (min-width: 1024px) {
    .dv-rm-colonnes {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .dv-rm-colonnes {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    }
  }
  .dv-rm-cartes {
    display: grid;
    gap: 10px;
  }
  @media (min-width: 640px) and (max-width: 1023.98px) {
    .dv-rm-colonne-fait .dv-rm-cartes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .dv-rm-colonne-fait .dv-rm-cartes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* Carte compacte : le titre, l'étiquette d'offre s'il y en a une, et une ligne. */
  .dv-rm-carte {
    padding: 12px 14px 13px;
    border: 1px solid color-mix(in srgb, var(--color-grey-2) 10%, transparent);
    border-radius: 14px;
    background: var(--color-grey);
  }
  .dv-rm-theme + .dv-rm-theme {
    margin-top: 6px;
  }
  .dv-rm-intertitre {
    margin-top: 18px;
    padding-inline: 4px;
    font-family: var(--font-accent);
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
  }
  .dv-rm-offre {
    display: inline-block;
    padding: 1px 8px;
    border: 1px solid color-mix(in srgb, var(--color-grey-2) 20%, transparent);
    border-radius: 999px;
    background: var(--color-white);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.45;
    white-space: nowrap;
  }
  @media (min-width: 768px) {
    .dv-rm-offre {
      font-size: 13px;
    }
  }
  /* Pastille du pied de colonne. */
  .dv-rm-pied {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 4px 12px;
    border: 1px solid var(--dv-bord);
    border-radius: 999px;
    background: var(--color-white);
    font-size: 14px;
    font-weight: 600;
    line-height: 1.2;
    color: color-mix(in srgb, var(--color-grey-2) 85%, transparent);
  }
  /* Point d'état : Bleu 1 plein (fait), cerclé de Bleu 1 (prochainement), Gris 2 à 35 % (plus tard). */
  .dv-rm-point {
    width: 10px;
    height: 10px;
    flex-shrink: 0;
    border-radius: 50%;
  }
  .dv-rm-point-fait {
    background: var(--color-blue);
  }
  .dv-rm-point-prochainement {
    border: 2px solid var(--color-blue);
    background: var(--color-white);
  }
  .dv-rm-point-plus-tard {
    background: color-mix(in srgb, var(--color-grey-2) 35%, transparent);
  }
</style>
