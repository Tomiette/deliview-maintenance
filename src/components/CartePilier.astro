---
// Carte d'un pilier (pages Solution détaillées, « Le reste de Deliview ») : la même carte que les leviers de l'accueil
// (CarteLevier). En haut, la vitrine du pilier, chacun sur son appareil (6 octobre 2026, demande de Tom : varier) :
// l'ordinateur pour la carte, la tablette couchée pour la zone, le téléphone pour les avis. Dessous, le nom, une phrase
// et « Voir comment ça marche ». Toute la carte est cliquable (lien étiré) ; au survol, elle se soulève.
import Vitrine from './Vitrine.astro';
import Fleche from '../icons/fleche.astro';
import { ICONES, type NomIcone } from '../lib/registre-icones';
import { VISUELS_PILIERS, lien } from '../lib/site';

interface Props {
  slug: string;
  icone: NomIcone;
  nom: string;
  benefice: string;
  href: string;
  niveau?: 'h2' | 'h3';
}

const { slug, icone, nom, benefice, href, niveau = 'h3' } = Astro.props;
const Icone = ICONES[icone];
const Titre = niveau;
const v = VISUELS_PILIERS[slug];
---

<li class="dv-relief dv-relief-lien dv-levier">
  <div class="dv-levier-plateau">
    <Vitrine
      type={v.appareil}
      capture={v.capture}
      ratio={1.45}
      ratioMobile={1.3}
      place={v.place}
      bulles={[v.bulle]}
      coupe
      coins="haut"
      sizes={v.appareil === 'telephone' ? '(min-width: 768px) 260px, 50vw' : '(min-width: 768px) 600px, 100vw'}
    />
  </div>
  <div class="dv-levier-corps">
    <Titre class="flex items-center gap-3 font-accent text-[21px] font-bold leading-[1.25] md:text-[23px]">
      <span class="dv-tuile dv-tuile-petite"><Icone taille={24} /></span>
      {nom}
    </Titre>
    <p class="mt-3 text-[17px] leading-[1.5] dv-muted">{benefice}</p>
    <a href={lien(href)} class="dv-lien-fort dv-pilier-lien mt-auto self-start pt-3" aria-label={`Voir comment ça marche : ${nom.toLowerCase()}`}>
      Voir comment ça marche<Fleche taille={24} />
    </a>
  </div>
</li>
