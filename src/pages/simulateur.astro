---
// Simulateur de rentabilité (décisions de Tom, 2 octobre 2026) : pensé pour le restaurateur qui n'a pas ses chiffres
// sous la main. Chaque champ propose « Je ne sais pas » : il prend alors une valeur affichée sous le champ, avec sa source.
// Une valeur sans source fiable est présentée comme un exemple, jamais comme une moyenne.
// Calcul dans le navigateur, rien n'est envoyé. Sans JavaScript, le résultat des valeurs affichées reste lisible.
import Base from '../layouts/Base.astro';
import SectionDemo from '../components/SectionDemo.astro';
import { PRIX_ENTREE, SITE, lien } from '../lib/site';

const TVA = 0.1;

type Champ = {
  id: 'commandes' | 'panier' | 'part' | 'hausse' | 'commission';
  libelle: string;
  aide: string;
  unite: string;
  min: number;
  max: number;
  pas: number;
  valeur: number;
  // « moyenne » : valeur sourcée ; « exemple » : valeur sans moyenne fiable.
  nature: 'moyenne' | 'exemple';
  explication: string;
  source?: { libelle: string; url: string };
};

const champs: Champ[] = [
  {
    id: 'commandes',
    libelle: 'Vos commandes en livraison par mois',
    aide: 'Uber Eats et Deliveroo réunis.',
    unite: 'commandes',
    min: 0,
    max: 100000,
    pas: 10,
    valeur: 600,
    nature: 'exemple',
    explication: '600 commandes, soit 20 par jour. Aucune moyenne fiable n’est publiée.',
  },
  {
    id: 'panier',
    libelle: 'Votre panier moyen',
    aide: 'Ce que paie le client par commande.',
    unite: '€ TTC',
    min: 0,
    max: 500,
    pas: 0.5,
    valeur: 25,
    nature: 'moyenne',
    explication: '25 € par commande en 2024, sur 350 000 paiements par carte.',
    source: { libelle: 'CDLK Services, baromètre de la livraison de repas, février 2025', url: 'https://www.cdlkservices.com/barometre-payment-data-zoom-sur-le-secteur-des-livraisons-repas-performances-2024/' },
  },
  {
    id: 'part',
    libelle: 'Part de votre carte vendue sous le prix du quartier',
    aide: 'Deliview vous donne ce chiffre pour votre restaurant.',
    unite: '%',
    min: 0,
    max: 100,
    pas: 1,
    valeur: 21,
    nature: 'exemple',
    explication: '11 plats sur 52 sous la médiane de la zone. Vraie analyse : burgers, Paris, 1er octobre 2026.',
  },
  {
    id: 'hausse',
    libelle: 'Hausse de prix sur ces plats',
    aide: 'Vous choisissez la hausse.',
    unite: '%',
    min: 0,
    max: 100,
    pas: 1,
    valeur: 10,
    nature: 'exemple',
    explication: '10 %, l’écart à partir duquel Deliview signale un plat sous-évalué.',
  },
  {
    id: 'commission',
    libelle: 'Commission de vos plateformes',
    aide: 'Votre taux figure sur vos factures.',
    unite: '%',
    min: 0,
    max: 60,
    pas: 1,
    valeur: 30,
    nature: 'exemple',
    explication: '30 %, le taux Standard de la page tarifs d’Uber Eats. Deliveroo ne publie pas le sien.',
    source: { libelle: 'Uber Eats, page tarifs', url: 'https://merchants.ubereats.com/fr/fr/pricing/' },
  },
];

function calcul(v: Record<string, number>) {
  const ventes = v.commandes * v.panier * (v.part / 100) * (v.hausse / 100);
  const marge = Math.max(0, ventes / (1 + TVA) - ventes * (v.commission / 100));
  return { ventes, marge, an: marge * 12, fois: marge / PRIX_ENTREE };
}
const defaut = Object.fromEntries(champs.map((c) => [c.id, c.valeur]));
const r = calcul(defaut);
const arrondi = (n: number) => (n >= 100 ? Math.round(n / 10) * 10 : Math.round(n));
const euros = (n: number) => new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 }).format(Math.round(n)) + ' €';
const phrase = (marge: number) => (marge > 0 ? `Environ ${euros(arrondi(marge))} de plus par mois` : 'Pas de gain avec ces chiffres');
const fois = (f: number) => (f >= 1 ? `couvre ${new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 1 }).format(f)} fois` : 'ne couvre pas');

const description =
  'Combien vous rapporte un prix bien placé sur Uber Eats et Deliveroo ? Vos chiffres, ou des valeurs sourcées si vous ne les avez pas. Rien n’est envoyé.';
const outil = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'Simulateur de rentabilité Deliview',
  url: SITE.url + '/simulateur/',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Web',
  inLanguage: 'fr-FR',
  isAccessibleForFree: true,
  description,
  publisher: { '@type': 'Organization', name: 'Deliview', url: SITE.url },
};
---

<Base title="Simulateur de rentabilité Uber Eats et Deliveroo | Deliview" description={description} ariane={[{ nom: 'Simulateur de rentabilité', chemin: '/simulateur/' }]} jsonld={[outil]}>
  <section class="bg-white">
    <div class="dv-container pb-10 pt-8 md:pb-12 md:pt-12">
      <p class="dv-overline dv-muted">Simulateur de rentabilité</p>
      <h1 class="dv-h1 mt-4 max-w-[20ch]">Combien vous rapporte un prix bien placé&nbsp;?</h1>
      <p class="dv-lead mt-5 max-w-[56ch]">Vous n’avez pas vos chiffres sous la main&nbsp;? Cochez «&nbsp;Je ne sais pas&nbsp;». Rien n’est envoyé.</p>
    </div>
  </section>

  <section class="dv-section bg-grey !pt-12" aria-labelledby="calcul-titre">
    <div class="dv-container grid items-start gap-8 lg:grid-cols-[1.1fr_0.9fr]">
      <form id="simulateur" class="dv-card p-6 md:p-8" aria-labelledby="calcul-titre" novalidate>
        <h2 id="calcul-titre" class="dv-h3">Vos chiffres</h2>
        <div class="mt-6 space-y-8">
          {
            champs.map((c) => (
              <fieldset class="space-y-2" data-champ={c.id}>
                <legend class="font-semibold">{c.libelle}</legend>
                <p id={`sim-${c.id}-aide`} class="text-[15px] dv-muted">{c.aide}</p>
                <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
                  <span class="flex items-center gap-3">
                    <input
                      id={`sim-${c.id}`}
                      name={c.id}
                      type="number"
                      inputmode="decimal"
                      min={c.min}
                      max={c.max}
                      step={c.pas}
                      value={String(c.valeur)}
                      readonly
                      aria-label={c.libelle}
                      aria-describedby={`sim-${c.id}-aide sim-${c.id}-valeur`}
                      class="h-12 w-36 rounded-[12px] border border-grey-2/30 bg-white px-4 text-[18px] font-semibold read-only:bg-grey"
                      data-valeur={c.valeur}
                    />
                    <span class="font-semibold">{c.unite}</span>
                  </span>
                  <label class="inline-flex min-h-[44px] cursor-pointer items-center gap-2 font-semibold">
                    <input type="checkbox" name={`${c.id}-inconnu`} checked class="h-5 w-5 accent-blue" />
                    Je ne sais pas
                  </label>
                </div>
                <p id={`sim-${c.id}-valeur`} class="text-[15px]" data-explication>
                  <strong>{c.nature === 'moyenne' ? 'En moyenne' : 'Exemple'}&nbsp;:</strong> {c.explication}
                  {c.source && (
                    <>
                      {' '}Source&nbsp;: <a href={c.source.url} rel="noopener" class="underline underline-offset-2">{c.source.libelle}</a>.
                    </>
                  )}
                </p>
              </fieldset>
            ))
          }
        </div>
      </form>

      <div class="lg:sticky lg:top-28">
        <div class="rounded-[16px] bg-blue p-6 text-white md:p-8" aria-live="polite">
          <p class="text-[19px] font-bold">Votre marge en plus</p>
          <p class="mt-2 text-[32px] font-bold leading-tight md:text-[40px]" data-sim="phrase">{phrase(r.marge)}</p>
        </div>
        <details class="mt-4 dv-card px-6 py-4">
          <summary class="cursor-pointer font-semibold">Voir le détail du calcul</summary>
          <dl class="mt-3 divide-y divide-grey-2/15">
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt>Ventes en plus par mois (TTC)</dt>
              <dd class="font-semibold" data-sim="ventes">{euros(r.ventes)}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt>Marge en plus, après TVA (10&nbsp;%) et commission</dt>
              <dd class="font-semibold" data-sim="marge">{euros(r.marge)}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt>Sur un an</dt>
              <dd class="font-semibold" data-sim="an">{euros(r.an)}</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3">
              <dt>Abonnement Essentiel ({PRIX_ENTREE}&nbsp;€ HT par mois)</dt>
              <dd class="font-semibold" data-sim="fois">{fois(r.fois)}</dd>
            </div>
          </dl>
          <p class="mt-3 text-[15px] dv-muted">
            Ventes en plus = commandes × panier moyen × part de la carte sous le prix du quartier × hausse. On retire la TVA, puis la commission. À ventes égales&nbsp;: si un plat se vend moins après la hausse, le gain baisse.
            La méthode complète est dans le guide <a href={lien('/ressources/fixer-prix-uber-eats-deliveroo/')} class="underline underline-offset-2">fixer ses prix sur Uber Eats et Deliveroo</a>.
          </p>
        </details>
        <a href="#demo" class="dv-btn dv-btn-plein mt-6 w-full" data-cta="simulateur" data-cta-principal>Trouver mes plats vendus trop bas</a>
        <p class="mt-3 text-center text-[15px] dv-muted">Démo de 15&nbsp;minutes sur votre restaurant · Sans engagement</p>
      </div>
    </div>
  </section>

  <SectionDemo section="simulateur-formulaire" titre="Trouvez vos plats vendus trop bas" sousTitre="Une démo de 15 minutes sur votre restaurant. Tom vous montre, plat par plat, ce que vous pouvez ajuster." />
</Base>

<script define:vars={{ tva: 0.1, prixEntree: PRIX_ENTREE }}>
  // « Je ne sais pas » coché : la valeur affichée sous le champ est utilisée et le champ est verrouillé.
  // Décoché : le champ se vide et attend votre chiffre. Recalcul à chaque saisie.
  const form = document.getElementById('simulateur');
  const sortie = (cle) => document.querySelector(`[data-sim="${cle}"]`);
  const euros = (n) => new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 0 }).format(Math.round(n)) + ' €';
  const arrondi = (n) => (n >= 100 ? Math.round(n / 10) * 10 : Math.round(n));
  const lire = (nom) => {
    const champ = form.elements.namedItem(nom);
    const v = parseFloat(String(champ.value).replace(',', '.'));
    if (!Number.isFinite(v)) return null;
    return Math.min(Math.max(v, Number(champ.min)), Number(champ.max));
  };
  const maj = () => {
    const noms = ['commandes', 'panier', 'part', 'hausse', 'commission'];
    const v = Object.fromEntries(noms.map((n) => [n, lire(n)]));
    if (noms.some((n) => v[n] === null)) {
      sortie('phrase').textContent = 'Complétez les champs, ou cochez « Je ne sais pas »';
      ['ventes', 'marge', 'an', 'fois'].forEach((k) => (sortie(k).textContent = '—'));
      return;
    }
    const ventes = v.commandes * v.panier * (v.part / 100) * (v.hausse / 100);
    const marge = Math.max(0, ventes / (1 + tva) - ventes * (v.commission / 100));
    const fois = marge / prixEntree;
    sortie('phrase').textContent = marge > 0 ? `Environ ${euros(arrondi(marge))} de plus par mois` : 'Pas de gain avec ces chiffres';
    sortie('ventes').textContent = euros(ventes);
    sortie('marge').textContent = euros(marge);
    sortie('an').textContent = euros(marge * 12);
    sortie('fois').textContent = fois >= 1 ? `couvre ${new Intl.NumberFormat('fr-FR', { maximumFractionDigits: 1 }).format(fois)} fois` : 'ne couvre pas';
  };
  if (form) {
    form.querySelectorAll('fieldset[data-champ]').forEach((f) => {
      const champ = f.querySelector('input[type=number]');
      const case_ = f.querySelector('input[type=checkbox]');
      const explication = f.querySelector('[data-explication]');
      const appliquer = () => {
        if (case_.checked) {
          champ.value = champ.dataset.valeur;
          champ.readOnly = true;
          explication.hidden = false;
        } else {
          champ.readOnly = false;
          champ.value = '';
          explication.hidden = true;
          champ.focus();
        }
        maj();
      };
      case_.addEventListener('change', appliquer);
    });
    form.addEventListener('input', maj);
    form.addEventListener('submit', (e) => e.preventDefault());
    maj();
  }
</script>
