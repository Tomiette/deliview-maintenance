---
// Qui sommes-nous (décisions de Tom, 2 octobre 2026) : le projet en 3 phrases, le fondateur, la chronologie de la
// construction (frise verticale, étapes fournies par Tom seulement), puis un bouton démo et l'e-mail de Tom.
// Ancre #tom : page auteur des articles.
import Base from '../layouts/Base.astro';
import Icone from '../components/Icone.astro';
import { SITE, dateFr, lien } from '../lib/site';
import { CHRONOLOGIE } from '../lib/chronologie';

const apercu = import.meta.env.BASE_URL !== '/';
// Sur l'aperçu seulement, tant que la liste est vide : trois étapes à remplacer, pour voir la frise.
const etapes = CHRONOLOGIE.length
  ? CHRONOLOGIE
  : apercu
    ? [1, 2, 3].map((n) => ({ date: '', titre: `[À REMPLACER : titre de l’étape ${n}]`, phrase: '[À REMPLACER : une phrase sur ce qui a été construit]', lien: '' }))
    : [];

const description =
  'Le projet Deliview, son fondateur Tom Voisin et la construction du logiciel, étape par étape, pour les restaurants sur Uber Eats et Deliveroo.';

const personne = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Tom Voisin',
  jobTitle: 'Fondateur de Deliview',
  description: 'Fondateur de Deliview. A lui-même été sur Uber Eats et Deliveroo, et a passé un an sur le terrain auprès des restaurants qui livrent.',
  knowsAbout: ['Uber Eats', 'Deliveroo', 'Livraison de repas', 'Prix des restaurants en livraison'],
  url: SITE.url + '/qui-sommes-nous/#tom',
  image: SITE.url + '/images/tom-voisin.jpg',
  email: SITE.email,
  sameAs: [SITE.linkedinTom],
  worksFor: { '@type': 'Organization', name: 'Deliview', url: SITE.url },
};
const aPropos = { '@context': 'https://schema.org', '@type': 'AboutPage', name: 'Qui sommes-nous', url: SITE.url + '/qui-sommes-nous/', inLanguage: 'fr-FR' };
---

<Base title="Qui sommes-nous | Deliview" description={description} ariane={[{ nom: 'Qui sommes-nous', chemin: '/qui-sommes-nous/' }]} jsonld={[aPropos, personne]}>
  <section class="bg-white" aria-labelledby="projet-titre">
    <div class="dv-container pb-14 pt-8 md:pb-20 md:pt-12">
      <p class="dv-overline dv-muted">{SITE.slogan}</p>
      <h1 id="projet-titre" class="dv-h1 mt-4 max-w-[18ch]">Rendre la livraison rentable pour chaque restaurant</h1>
      <div class="mt-6 max-w-[60ch] space-y-3 dv-lead">
        <p>Sur Uber Eats et Deliveroo, les commissions pèsent sur chaque plat vendu.</p>
        <p>Les chiffres utiles sont éparpillés entre une tablette et un espace par plateforme.</p>
        <p>Deliview les réunit, pour que chaque restaurant vende au bon prix.</p>
      </div>
    </div>
  </section>

  <section id="tom" class="dv-section scroll-mt-24 bg-grey" aria-labelledby="tom-titre">
    <div class="dv-container grid gap-10 md:grid-cols-[200px_1fr]">
      <img src={lien('/images/tom-voisin.webp')} alt="Portrait de Tom Voisin, fondateur de Deliview" width="200" height="200" loading="lazy" class="h-40 w-40 rounded-full object-cover md:h-[200px] md:w-[200px]" />
      <div>
        <p class="dv-overline dv-muted">Qui je suis</p>
        <h2 id="tom-titre" class="dv-h2 mt-3">Tom Voisin, fondateur de Deliview</h2>
        <div class="mt-5 max-w-[60ch] space-y-3 [text-wrap:pretty]">
          <p>J’ai moi-même été sur Uber Eats et Deliveroo.</p>
          <p>J’ai passé un&nbsp;an sur le terrain, auprès des restaurants qui livrent.</p>
          <p>Partout, deux tablettes en plein rush et des prix fixés à l’instinct.</p>
          <p>Deliview est le résultat de cette année. Je fais la mise en place avec chaque restaurant.</p>
        </div>
        <p class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
          <a href={`mailto:${SITE.email}`} class="font-semibold underline underline-offset-2">{SITE.email}</a>
          <a href={SITE.linkedinTom} class="font-semibold underline underline-offset-2" rel="noopener">Tom sur LinkedIn</a>
          <a href={SITE.linkedinEntreprise} class="font-semibold underline underline-offset-2" rel="noopener">Deliview sur LinkedIn</a>
        </p>
      </div>
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="chronologie-titre">
    <div class="dv-container max-w-[880px]">
      <p class="dv-overline dv-muted">En public, sur LinkedIn</p>
      <h2 id="chronologie-titre" class="dv-h2 mt-3 max-w-[22ch]">La construction de Deliview, étape par étape</h2>
      <p class="mt-4 max-w-[60ch]">Je partage chaque étape sur LinkedIn&nbsp;: ce qui marche, ce qui ne marche pas.</p>
      {
        etapes.length > 0 && (
          <ol class="relative mt-10 space-y-10 border-l-2 border-blue/20 pl-8">
            {etapes.map((e) => (
              <li class="relative">
                <span class="absolute -left-[41px] top-1 h-4 w-4 rounded-full border-4 border-white bg-blue ring-2 ring-blue/20" aria-hidden="true" />
                <p class="text-[15px] font-semibold dv-muted">{e.date ? <time datetime={e.date}>{dateFr(new Date(e.date + 'T12:00:00Z'))}</time> : '[À REMPLACER : date]'}</p>
                <h3 class="dv-h3 mt-1">{e.titre}</h3>
                <p class="mt-1 max-w-[60ch]">{e.phrase}</p>
                {e.lien ? (
                  <a href={e.lien} class="mt-2 inline-flex items-center gap-2 font-semibold underline underline-offset-4" rel="noopener">
                    Lire le post <Icone nom="fleche" taille={18} />
                  </a>
                ) : (
                  <p class="mt-2 font-semibold">[À REMPLACER : lien du post LinkedIn]</p>
                )}
              </li>
            ))}
          </ol>
        )
      }
      <p class="mt-10">
        <a href={SITE.linkedinEntreprise} class="inline-flex items-center gap-2 text-[19px] font-bold underline underline-offset-4" rel="noopener">
          Suivre la construction sur LinkedIn <Icone nom="fleche" taille={20} />
        </a>
      </p>
    </div>
  </section>

  <section class="dv-section bg-grey" aria-labelledby="bref-titre">
    <div class="dv-container max-w-[880px]">
      <h2 id="bref-titre" class="dv-h2">Deliview en bref</h2>
      <dl class="mt-8 divide-y divide-grey-2/15 border-y border-grey-2/15">
        <div class="grid gap-1 py-4 sm:grid-cols-[220px_1fr]">
          <dt class="font-semibold">Ce que fait Deliview</dt>
          <dd>{SITE.argument} Vos prix, votre carte et votre note face à votre zone.</dd>
        </div>
        <div class="grid gap-1 py-4 sm:grid-cols-[220px_1fr]">
          <dt class="font-semibold">Fondateur</dt>
          <dd>Tom Voisin</dd>
        </div>
        <div class="grid gap-1 py-4 sm:grid-cols-[220px_1fr]">
          <dt class="font-semibold">Origine</dt>
          <dd>Un&nbsp;an sur le terrain, auprès des restaurants qui livrent</dd>
        </div>
        <div class="grid gap-1 py-4 sm:grid-cols-[220px_1fr]">
          <dt class="font-semibold">Plateformes</dt>
          <dd>Uber Eats et Deliveroo, en France</dd>
        </div>
        <div class="grid gap-1 py-4 sm:grid-cols-[220px_1fr]">
          <dt class="font-semibold">Hébergement des données</dt>
          <dd>Union européenne (Irlande)</dd>
        </div>
        <div class="grid gap-1 py-4 sm:grid-cols-[220px_1fr]">
          <dt class="font-semibold">Société</dt>
          <dd>DELIVIEW SAS, <a href={lien('/mentions-legales/')} class="underline underline-offset-2">mentions légales</a></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="dv-section bg-white" aria-labelledby="contact-titre">
    <div class="dv-container text-center">
      <h2 id="contact-titre" class="dv-h2 mx-auto max-w-[20ch]">Parlons de votre restaurant</h2>
      <p class="dv-lead mx-auto mt-4 max-w-[48ch]">Une démo de 15&nbsp;minutes, sur vos prix et votre zone.</p>
      <p class="mt-8"><a href={lien('/demo/')} class="dv-btn dv-btn-plein" data-cta="qui-sommes-nous">Demander une démo</a></p>
      <p class="mt-5">Ou écrivez-moi&nbsp;: <a href={`mailto:${SITE.email}`} class="font-semibold underline underline-offset-2">{SITE.email}</a></p>
    </div>
  </section>
</Base>
